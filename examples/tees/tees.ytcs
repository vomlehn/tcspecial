# yaml-language-server: $schema=../../tcslib-protocol/schema/tcspecial.schema.json

description: "Tees and null nodes: a command copied back to the ground, a
  reading copied aboard, and data dropped"

tcspecial:
  # Every port is in the eight thousands, which no other example uses, so this
  # one can be left running while another is looked at.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:8510"
    reset_interval: "1 s"
    send: "0.0.0.0:8500"
  gateway: "radio"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:8300"
    source_base: "127.0.0.1:8310"
  payload_telemetry:
    dest_base: "127.0.0.1:8410"
    source_base: "0.0.0.0:8400"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle.
  state_file: "/tmp/tcspecial-tees.state"
  tcs_cmd:
    recv: "0.0.0.0:8200"
    send: "127.0.0.1:8210"

gateways:
  - type gateway_radio:
      # The ground's end of the link, both ways. What the ground sends goes up
      # to address:port, which this node binds aboard, and leaves it by
      # moc-out for the tee. What comes down arrives at ground_base plus the
      # device id of the node that sent it.
      - gateway: moc
        address: "127.0.0.1"
        ground_base: "127.0.0.1:8700"
        port: "8600"
        moc-out:
          - echo.moc
        world-in: [echo, readings]

payloads:
  - type network:
      # A heater, driven by what the ground sends: the far end of a UDP socket.
      - payload: heater
        address: "127.0.0.1"
        port: "8001"
        protocol: "udp"
        moc-in: [echo]
      # A sensor whose readings go to the ground and are copied aboard.
      - payload: sensor
        address: "127.0.0.1"
        port: "8002"
        protocol: "udp"
        world-out:
          - readings.sensor
      # A payload whose data nobody wants yet.
      - payload: spare
        address: "127.0.0.1"
        port: "8003"
        protocol: "udp"
        world-out:
          - unheard.spare

vehicle:
  - type null-gateway:
      # Takes what arrives from the ground's side and drops it.
      - compute: dropped
        moc-in: [readings]
  - type null-payload:
      # Takes the spare payload's data and drops it.
      - compute: unheard
        world-in: [spare]
  - type tee-gateway:
      # Each command the ground sends goes on to the heater, as it was going,
      # and back down to the ground as payload data, so that the ground sees
      # what the vehicle was told. A tee has two data sources, so each link
      # names its own.
      - compute: echo
        moc-out:
          - heater.echo
        world-out:
          - moc.echo
        moc-in: [moc]
  - type tee-payload:
      # Each reading goes on to the ground, as it was going, and again
      # vehicleward -- here to a node that drops it, standing where something
      # aboard that took readings as commands would be.
      - compute: readings
        moc-out:
          - dropped.readings
        world-out:
          - moc.readings
        world-in: [sensor]

tcs-gui:
  nodes:
    - { node: dropped, x: 234, y: 134 }
    - { node: echo, x: 34, y: 34 }
    - { node: moc, x: 469, y: 34 }
    - { node: heater, x: 34, y: 34 }
    - { node: readings, x: 34, y: 134 }
    - { node: sensor, x: 34, y: 134 }
    - { node: spare, x: 34, y: 234 }
    - { node: unheard, x: 34, y: 234 }
