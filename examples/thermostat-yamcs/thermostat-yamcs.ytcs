# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "The thermostat, through Yamcs, over CCSDS"

tcspecial:
  # The thermostat example with Yamcs at the ground end. The gateway is
  # yamcs, so every packet on every link to the ground carries a CCSDS
  # primary header: the beacon, the commands and their answers, and each
  # reading and decision the gateway node sends down. Each link says its
  # APID; the gateway node's sources count theirs on from its apid_base.
  #
  # Every port is in the seventeen thousands, which no other example uses,
  # so this one can be left running beside the thermostat example itself.
  beacon:
    apid: "0x110"
    default_interval: "5 s"
    recv: "127.0.0.1:17510"
    reset_interval: "1 s"
    send: "0.0.0.0:17500"
  gateway: "yamcs"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:17300"
    source_base: "127.0.0.1:17310"
  # A payload nothing in the drawing touches would report to dest_base plus
  # its device id, as telemetry of APID apid_base plus that device id. This
  # vehicle has none, but a configuration that answers to Yamcs says where
  # their APIDs would begin all the same.
  payload_telemetry:
    apid_base: "0x500"
    dest_base: "127.0.0.1:17410"
    source_base: "0.0.0.0:17400"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-thermostat-yamcs.state"
  # Yamcs sends its commands from a port the system chooses, and takes the
  # answers on the same socket, so the commands are taken from any port of
  # this host -- port 0 -- and each answer goes back to the port its command
  # came from.
  tcs_cmd:
    apid: "0x111"
    recv: "0.0.0.0:17200"
    send: "127.0.0.1:0"

payload_groups:
  - name: "zone_temps"
    interval: "100 ms"

gateways:
  - type gateway_yamcs:
      # Yamcs's end of the link. Each reading and decision drawn into this
      # node comes down to Yamcs at ground_base plus its source's device id
      # -- thermostat_2 is the last of the thirteen names, device id 12, so
      # 17712 -- as telemetry of APID apid_base plus that device id, 0x40c.
      # What Yamcs sends up to address:port goes as a telecommand of APID
      # apid_base.
      - gateway: gateway
        address: "127.0.0.1"
        apid_base: "0x400"
        ground_base: "127.0.0.1:17700"
        port: "17600"
        payload-in: true

vehicle:
  - type compute:
      # One temperature out of the three, by the algorithm named: median
      # takes the middle reading, closest_mean the mean of the two that
      # agree best. Either leaves a sensor that has gone wrong out of the
      # answer, which a mean over all three would not, and it produces a
      # value on every arrival, so one sensor that stops reporting is
      # outvoted rather than stopping the vehicle from deciding anything.
      - compute: ambient
        algorithm: "median"
        function: "vote"
        inputs: "in0,in1,in2"
        payload-out:
          - target: gateway
          - target: thermostat_1
          - target: thermostat_2
        payload-in: true
      - compute: temp1
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        payload-out:
          - target: ambient
            input: in0
          - target: gateway
          - target: housekeeping
        payload-in: true
      - compute: temp2
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        payload-out:
          - target: ambient
            input: in1
          - target: gateway
          - target: housekeeping
        payload-in: true
      - compute: temp3
        format: "u24_be"
        function: "to_kelvin"
        offset: "255.37"
        scale: "0.0078"
        payload-out:
          - target: ambient
            input: in2
          - target: gateway
          - target: housekeeping
        payload-in: true
      # Two stages, each a hysteresis of its own, so that the second heater
      # comes on only when the first cannot hold the zone alone, and the
      # ground can see which are on. In each, setpoint is set from the
      # ground, and half_band is how far either side of it the stage
      # switches, the setpoint being in the middle of the band.
      #
      # The first stage, driving heaters_1: on below 291.15 K, off above
      # 295.15 K.
      - compute: thermostat_1
        function: "hysteresis"
        half_band: "2.0"
        setpoint: "293.15"
        # asserted below the band, unasserted above it.
        gateway-out:
          - target: heaters_1
        payload-out:
          - target: gateway
          - target: housekeeping
        payload-in: true
      # The second stage, for when heaters_1 alone cannot hold the zone:
      # heaters_2 on below 289.15 K, two half bands of the first stage
      # under its setpoint, and off above 291.15 K, where the first stage
      # comes on. Its band lies under that of the first stage, so heaters_2
      # is on only while heaters_1 is.
      - compute: thermostat_2
        function: "hysteresis"
        half_band: "1.0"
        setpoint: "290.15"
        # asserted below the band, unasserted above it.
        gateway-out:
          - target: heaters_2
        payload-out:
          - target: gateway
          - target: housekeeping
        payload-in: true
  - type log:
      - compute: housekeeping
        directory: "/tmp/telemetry"
        format: "variable_ts_rc"
        payload-in: true

payloads:
  # Every payload is the far end of a UDP socket, which tcssim stands in for
  # with nothing more than a socket, so that the example runs on any desk
  # and touches no hardware. The buses these parts would be on aboard --
  # I2C, SPI, GPIO -- are flown against stand-ins by make stand-ins-test
  # and make kernel-stand-ins-test.
  - type network:
      # Two heaters, both near the sensors on the same thermal mass, each
      # driven by what its stage of the thermostat decides -- 1 for on, 0 for
      # off. Two, because one failing must not leave the mass with no way to
      # be warmed; separate nodes, so that one can be stopped from the ground
      # while the other goes on warming the zone.
      - payload: heaters_1
        address: "127.0.0.1"
        port: "17804"
        protocol: "udp"
        gateway-in: true
      - payload: heaters_2
        address: "127.0.0.1"
        port: "17805"
        protocol: "udp"
        gateway-in: true
      # One of three sensors of the same place, a trio, so that the
      # temperature survives one of them going wrong. Two bytes, signed,
      # big endian.
      - payload: temp_1
        address: "127.0.0.1"
        group: "zone_temps"
        port: "17801"
        protocol: "udp"
        payload-out:
          - target: temp1
      # The second of the trio; the same part as temp_1.
      - payload: temp_2
        address: "127.0.0.1"
        group: "zone_temps"
        port: "17802"
        protocol: "udp"
        payload-out:
          - target: temp2
      # The third. A different part: three bytes, unsigned, its own scale and
      # so its own conversion, so that no one part number can take the whole
      # trio out.
      - payload: temp_3
        address: "127.0.0.1"
        group: "zone_temps"
        port: "17803"
        protocol: "udp"
        payload-out:
          - target: temp3

commands:
  # the middle of the first stage band, in kelvin
  - { from: gateway, sets: thermostat_1.setpoint }
  # the middle of the second stage band, in kelvin
  - { from: gateway, sets: thermostat_2.setpoint }

tcsgui:
  nodes:
    - { node: ambient, x: 469, y: 166 }
    - { node: gateway, x: 790, y: 34 }
    - { node: heaters_1, x: 34, y: 393 }
    - { node: heaters_2, x: 34, y: 470 }
    - { node: housekeeping, x: 469, y: 374 }
    - { node: temp1, x: 242, y: 34 }
    - { node: temp2, x: 242, y: 166 }
    - { node: temp3, x: 242, y: 280 }
    - { node: temp_1, x: 34, y: 34 }
    - { node: temp_2, x: 34, y: 166 }
    - { node: temp_3, x: 34, y: 280 }
    - { node: thermostat_1, x: 601, y: 166 }
    - { node: thermostat_2, x: 601, y: 300 }
