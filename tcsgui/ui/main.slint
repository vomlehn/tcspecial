import { Button, ScrollView, ListView } from "std-widgets.slint";

// What a node looks like on the canvas, and the rules the looks obey.
//
// Two rules, and both are enforced in Rust as well -- see style.rs, whose
// tests fail if either is broken:
//
//   * nothing is told apart by colour alone. Every node type differs from
//     every other in at least two of outline, border width, shading and size,
//     so a reader who sees no colour still sees distinguishable shapes.
//   * red means something is wrong. No type, no selection and no link is red.
//
// Everything here is drawn from Slint's own primitives: a Rectangle with
// square corners, one with a border-radius, one with a radius of half its
// width for a circle, and Rectangles a pixel or two wide for lines. No images
// and no icon font, so nothing can fail to load.

export struct NodeView {
    name: string,
    // The type's spelling, which is the configuration's word for it.
    node-type: string,
    x: length,
    y: length,
    width: length,
    height: length,
    // square | rounded | circle | keyed
    outline: string,
    // solid | hatched | open | double
    shading: string,
    border: length,
    // How the label is set: the fifth channel that is not colour. A face, a
    // size, a weight and an italic, chosen per type in style.rs.
    face: string,
    label-size: length,
    label-weight: int,
    label-italic: bool,
    tint: color,
    // Something is wrong with this node. The one thing drawn in red.
    faulty: bool,
    fault: string,
    selected: bool,
    // What somebody wrote about this node, shown under it -- or, for a
    // subdiagram that is closed, what is inside it.
    comment: string,
    // Whether this node is a diagram of its own and can be opened.
    openable: bool,
}

export struct LinkView {
    // The two ends, already in canvas coordinates: the window draws, and
    // where things are is Rust's business.
    x1: length,
    y1: length,
    x2: length,
    y2: length,
    // A link into a named input is drawn wide, one into a node's only input
    // narrow. A second channel beside the label, so a crowded diagram can be
    // read without tracing every line to its end.
    wide: bool,
    label: string,
    // What somebody wrote about this connection.
    comment: string,
}

// Diagonal hatching, drawn with narrow lines inside whatever shape asks for
// it.
//
// A Path rather than a row of rotated rectangles: a Rectangle has no rotation,
// and a Path is what Slint draws lines with. The pattern is stated once in a
// hundred-by-hundred viewbox and scaled to the element, so one string serves
// every size of node, and the parent clips it so a circle's hatching stays
// inside the circle.
component Hatching inherits Rectangle {
    in property <color> ink;
    clip: true;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: ink;
        stroke-width: 1px;
        commands: "M 0 40 L 40 0 M 0 70 L 70 0 M 0 100 L 100 0 M 30 100 L 100 30 M 60 100 L 100 60";
    }
}

// One node.
//
// The outline is chosen by name rather than by a number so that the markup
// reads as the table in style.rs does: square corners are hardware, rounded
// are software aboard, a circle is an end of the graph, and a keyed rectangle
// is an interface that is driven rather than read.
component NodeShape inherits Rectangle {
    in property <NodeView> node;
    // Whether this one can be dragged. False in the palette, where a press
    // places a node rather than moving this one.
    in property <bool> draggable: false;
    // Told once, when the gesture finishes: one edit for one drag, so undo
    // takes a node back to where it started rather than one pixel back.
    callback dragged(length, length);
    // This node is a diagram of its own and somebody asked to see it.
    callback open-requested();
    // A link is being drawn: pressed on the handle of one node, released over
    // another.
    callback link-from();
    callback link-to();

    // The error colour, and the only place in this file it appears.
    //
    // A single definition so that "is anything red" is a question with one
    // answer: if this is the only red, then red on the canvas means a fault
    // and nothing else.
    property <color> error-ink: #c0392b;

    property <color> ink: node.faulty ? error-ink : node.tint;

    // While a drag is running the node follows the pointer by this much, and
    // the document still says where it was: nothing is recorded until the
    // gesture ends.
    property <length> drag-x: draggable && grip.pressed
        ? grip.mouse-x - grip.pressed-x
        : 0px;
    property <length> drag-y: draggable && grip.pressed
        ? grip.mouse-y - grip.pressed-y
        : 0px;

    x: node.x + drag-x;
    y: node.y + drag-y;
    width: node.width;
    height: node.height;
    background: transparent;

    // The shape itself. One Rectangle, with the corner radius saying which
    // outline this is: 0 for square, a quarter of the height for rounded,
    // half the width for a circle. A keyed shape is this with a corner
    // squared off by the triangle below it.
    body := Rectangle {
        width: 100%;
        height: 100%;
        border-width: node.border;
        border-color: ink;
        border-radius: node.outline == "circle"
            ? self.width / 2
            : node.outline == "rounded"
                ? self.height / 4
                : 0px;
        background: node.shading == "solid"
            ? ink.with-alpha(0.18)
            : node.shading == "double"
                ? ink.with-alpha(0.08)
                : transparent;

        // Hatched shading, inside whatever the outline turned out to be.
        if node.shading == "hatched": Hatching {
            width: 100%;
            height: 100%;
            ink: ink.with-alpha(0.45);
            border-radius: parent.border-radius;
        }

        // The second outline of a doubled shape, which is the third
        // non-colour channel at work: a doubled square and a solid square
        // differ without either of them being a different colour.
        if node.shading == "double": Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-width: 1px;
            border-color: ink;
            border-radius: max(0px, parent.border-radius - 3px);
            background: transparent;
        }
    }

    // The key: a square corner cut into an otherwise rounded shape, which is
    // what says "driven" without a word or a colour.
    if node.outline == "keyed": Rectangle {
        x: 0;
        y: 0;
        width: root.width / 4;
        height: node.border;
        background: ink;
    }
    if node.outline == "keyed": Rectangle {
        x: 0;
        y: 0;
        width: node.border;
        height: root.height / 4;
        background: ink;
    }

    // The name, and under it the type. The type is shown always and not only
    // on hover: a diagram whose shapes have to be remembered is a diagram that
    // is read wrongly under pressure.
    VerticalLayout {
        padding: 6px;
        spacing: 1px;
        alignment: center;

        Text {
            text: node.name;
            font-family: node.face == "mono" ? "monospace" : "";
            font-size: node.label-size;
            font-weight: node.label-weight;
            font-italic: node.label-italic;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: node.node-type;
            font-family: node.face == "mono" ? "monospace" : "";
            font-size: 9px;
            horizontal-alignment: center;
            overflow: elide;
        }
        // What somebody wrote about this node. Shown rather than hidden behind
        // a hover: a note explaining why a sensor is at an odd address is
        // worth reading before the address is changed, and a note nobody
        // finds is a note nobody wrote.
        if node.comment != "": Text {
            text: node.comment;
            font-size: 9px;
            font-italic: true;
            color: #555555;
            horizontal-alignment: center;
            overflow: elide;
        }
        // What is wrong, where something is. In red, beside the shape that is
        // also in red, so the colour is never the only thing carrying it.
        if node.faulty: Text {
            text: node.fault;
            color: error-ink;
            font-size: 9px;
            font-italic: true;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // The handle a link is drawn from: a small circle on the right edge,
    // where a link leaves.
    //
    // A handle rather than a modifier key or a mode: a diagram is edited by
    // people who use it rarely, and a thing that is visible is a thing that
    // does not have to be remembered. On the right because a link is drawn
    // left to right, which is the direction the canvas lays a graph out in.
    out-handle := Rectangle {
        x: root.width - 7px;
        y: root.height / 2 - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: ink;
        background: out-touch.has-hover ? ink : white;

        out-touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.crosshair;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    link-from();
                }
            }
        }
    }

    // And where one arrives: the left edge. A release over this says which
    // node the link reaches.
    in-handle := Rectangle {
        x: -7px;
        y: root.height / 2 - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: ink;
        background: in-touch.has-hover ? ink : white;

        in-touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.crosshair;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up) {
                    link-to();
                }
            }
        }
    }

    // A subdiagram is opened from a mark in its own corner.
    //
    // Not a double press on the box: a single press already drags it, and a
    // gesture that means one thing or another depending on timing is a
    // gesture that does the wrong one under pressure. A mark that says
    // "there is more in here" is also the only hint a closed box gives that
    // it can be opened at all.
    if node.openable: Rectangle {
        x: root.width - 20px;
        y: 6px;
        width: 14px;
        height: 14px;
        border-width: 1px;
        border-color: ink;
        background: open-touch.has-hover ? ink.with-alpha(0.25) : transparent;

        // Two narrow lines making a cross, which reads as "expand" without a
        // word or an icon file.
        Rectangle {
            x: 3px;
            y: 6px;
            width: 8px;
            height: 1px;
            background: ink;
        }
        Rectangle {
            x: 6px;
            y: 3px;
            width: 1px;
            height: 8px;
            background: ink;
        }

        open-touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: MouseCursor.pointer;
            clicked => { open-requested(); }
        }
    }

    // The area a drag is taken from, over the whole node so that a press
    // anywhere on it moves it.
    //
    // Last so it is above the shape and the label; a TouchArea under them
    // would be a node that can only be dragged by its edges.
    grip := TouchArea {
        width: 100%;
        height: 100%;
        enabled: draggable;
        mouse-cursor: draggable ? MouseCursor.grab : MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }

    // Selection, which is a third outline rather than a colour change: a
    // selected node and a faulty one must not be confusable, and a selected
    // faulty node has to show both.
    if node.selected: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: 2px;
        border-color: #333333;
        border-radius: body.border-radius + 4px;
        background: transparent;
    }
}

// One link, drawn as a line between its two ends.
//
// A Path with a MoveTo and a LineTo, which draws a line at any angle and takes
// a stroke width -- the wide and narrow weights asked for. A rotated Rectangle
// was tried first and a Rectangle has no rotation.
//
// The Path is placed at the bounding box of the two ends and given a viewbox
// the same size, so a coordinate in the box is a pixel on the screen. A
// vertical or horizontal link has a box of no width or no height, which would
// be a viewbox that divides by nothing, so each is held at one pixel least.
component LinkLine inherits Rectangle {
    in property <LinkView> link;
    in property <color> ink: #555555;

    property <length> left: min(link.x1, link.x2);
    property <length> top: min(link.y1, link.y2);
    property <length> box-width: max(1px, abs(link.x2 - link.x1));
    property <length> box-height: max(1px, abs(link.y2 - link.y1));

    background: transparent;

    line := Path {
        x: left;
        y: top;
        width: box-width;
        height: box-height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: box-width / 1px;
        viewbox-height: box-height / 1px;
        stroke: ink;
        stroke-width: link.wide ? 3px : 1px;

        MoveTo {
            x: (link.x1 - left) / 1px;
            y: (link.y1 - top) / 1px;
        }
        LineTo {
            x: (link.x2 - left) / 1px;
            y: (link.y2 - top) / 1px;
        }
    }

    // Which input the link arrives at, where it says so. Text rather than
    // only a line weight, because a name is what the configuration file will
    // show and the two should agree.
    if link.label != "": Text {
        x: (link.x1 + link.x2) / 2;
        y: (link.y1 + link.y2) / 2 - 14px;
        text: link.label;
        font-size: 9px;
        color: ink;
    }
    // And what somebody wrote about the connection, under the line.
    if link.comment != "": Text {
        x: (link.x1 + link.x2) / 2;
        y: (link.y1 + link.y2) / 2 + 4px;
        text: link.comment;
        font-size: 9px;
        font-italic: true;
        color: #555555;
    }
}

// The editing surface: a bar, a palette and a canvas.
//
// One component because there are two windows that need it -- the top diagram
// and each open subdiagram -- and two copies of a canvas would be two places
// for a drawing rule to be changed in. What differs between the windows is
// only what they are given: a subdiagram's window is handed its own nodes and
// its own name, and is otherwise this.
component Surface inherits Rectangle {
    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    in property <[NodeView]> palette: [];

    // How deep undo currently goes, shown rather than guessed at: a person
    // about to abandon an afternoon's work deserves to know how much of it is
    // still reachable. One history for the whole configuration, so every
    // window shows the same two numbers.
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    // What went wrong with saving, if anything. The window's one red text.
    in property <string> trouble: "";
    // What this surface is editing: empty for the top diagram, the
    // subdiagram's name otherwise. Shown in the bar so that two windows side
    // by side cannot be confused for one another.
    in property <string> editing: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string);
    callback node-moved(string, length, length);
    callback open-subdiagram(string);
    // Drawing a link: pressed on one node, released on another.
    callback link-started(string);
    callback link-finished(string);

    background: #fbfbfa;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // The bar: what can be taken back, and anything wrong.
        bar := HorizontalLayout {
            spacing: 8px;
            min-height: 34px;

            if editing != "": Text {
                text: editing;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Button {
                text: undo-label == "" ? "Undo" : "Undo " + undo-label;
                enabled: undo-depth > 0;
                clicked => { undo-clicked(); }
            }
            Button {
                text: redo-label == "" ? "Redo" : "Redo " + redo-label;
                enabled: redo-depth > 0;
                clicked => { redo-clicked(); }
            }
            Text {
                text: undo-depth + " edits can be undone";
                font-size: 11px;
                vertical-alignment: center;
            }
            // Saving needs no button: every edit is written as it is made.
            // What it needs is somewhere to say when that failed.
            Text {
                text: trouble == "" ? "saved" : trouble;
                color: trouble == "" ? #2d6a4f : #c0392b;
                font-size: 11px;
                font-weight: trouble == "" ? 400 : 700;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Rectangle { }
        }

        HorizontalLayout {
            spacing: 8px;

            // The palette: one of every node type, drawn as it will be drawn
            // on the canvas, so that what a shape means can be looked up
            // rather than remembered.
            Rectangle {
                width: 180px;
                background: #f2f2f0;
                border-width: 1px;
                border-color: #d8d8d4;

                palette-list := ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text {
                            text: "Node types";
                            font-size: 11px;
                            font-weight: 700;
                            height: 18px;
                        }
                        for p in palette: Rectangle {
                            height: 54px;
                            background: transparent;
                            NodeShape {
                                node: p;
                            }
                            // The whole row, so the hit area is the row and
                            // not only the shape: a circle's corners are not
                            // part of the circle, and a press there should
                            // still place one.
                            TouchArea {
                                clicked => { place-node(p.node-type); }
                            }
                        }
                        Rectangle { }
                    }
                }
            }

            // The canvas.
            canvas := Rectangle {
                background: white;
                border-width: 1px;
                border-color: #d8d8d4;
                horizontal-stretch: 1;
                clip: true;

                // Links under nodes, so a line never crosses a label.
                for l in links: LinkLine {
                    link: l;
                }
                for n in nodes: NodeShape {
                    node: n;
                    draggable: true;
                    dragged(dx, dy) => { node-moved(n.name, dx, dy); }
                    open-requested => { open-subdiagram(n.name); }
                    link-from => { link-started(n.name); }
                    link-to => { link-finished(n.name); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "TCSpecial Configuration";
    background: #fbfbfa;
    min-width: 900px;
    min-height: 600px;

    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    in property <[NodeView]> palette: [];
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    in property <string> trouble: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string);
    callback node-moved(string, length, length);
    callback open-subdiagram(string);
    callback link-started(string);
    callback link-finished(string);

    Surface {
        width: 100%;
        height: 100%;
        nodes: root.nodes;
        links: root.links;
        palette: root.palette;
        undo-depth: root.undo-depth;
        redo-depth: root.redo-depth;
        undo-label: root.undo-label;
        redo-label: root.redo-label;
        trouble: root.trouble;
        undo-clicked => { root.undo-clicked(); }
        redo-clicked => { root.redo-clicked(); }
        place-node(t) => { root.place-node(t); }
        node-moved(n, dx, dy) => { root.node-moved(n, dx, dy); }
        open-subdiagram(n) => { root.open-subdiagram(n); }
        link-started(n) => { root.link-started(n); }
        link-finished(n) => { root.link-finished(n); }
    }
}

// One open subdiagram.
//
// The same surface as the top diagram, given that subdiagram's nodes. Several
// may be open at once, and they cannot disagree with each other or with the
// top diagram: there is one document behind all of them, and each window is
// redrawn from it after every edit.
export component SubWindow inherits Window {
    title: "TCSpecial Configuration -- " + root.editing;
    background: #fbfbfa;
    min-width: 760px;
    min-height: 520px;

    in property <string> editing: "";
    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    in property <[NodeView]> palette: [];
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    in property <string> trouble: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string);
    callback node-moved(string, length, length);
    callback link-started(string);
    callback link-finished(string);

    Surface {
        width: 100%;
        height: 100%;
        editing: root.editing;
        nodes: root.nodes;
        links: root.links;
        palette: root.palette;
        undo-depth: root.undo-depth;
        redo-depth: root.redo-depth;
        undo-label: root.undo-label;
        redo-label: root.redo-label;
        trouble: root.trouble;
        undo-clicked => { root.undo-clicked(); }
        redo-clicked => { root.redo-clicked(); }
        place-node(t) => { root.place-node(t); }
        node-moved(n, dx, dy) => { root.node-moved(n, dx, dy); }
        link-started(n) => { root.link-started(n); }
        link-finished(n) => { root.link-finished(n); }
    }
}
