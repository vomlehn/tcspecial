<?xml version="1.0" encoding="UTF-8"?>
<!-- Every command the MOC sends tcspecial and every answer tcspecial sends
     back, as they go on the link: the whole of each datagram.

     Each is a CCSDS Space Packet, so that a ground system that reads them
     from an XTCE mission database, Yamcs among them, reads them with no code
     of its own:

       primary header   6 bytes: version 0, packet type (1 for a command, 0
                        for an answer), no secondary header, APID 0x100,
                        sequence flags 3 (unsegmented), sequence count (the
                        low 14 bits of the sequence below), packet length
       opcode or kind   1 byte: which command, or which answer
       sequence         4 bytes: the command's number, which its answer
                        carries back; a command older than one this start
                        of tcspecial has taken, PING and CONNECT aside, is
                        answered Stale and not acted on
       generation       4 bytes, an answer only: the generation of
                        tcspecial that made it, so that the ground hears of
                        a restart from any answer, a refusal among them. A
                        command carries no generation: its sequence is all
                        that numbers it
       status           1 byte, an answer only: how the command went
       timestamp        8 bytes, an answer only: microseconds since the UNIX
                        epoch when the answer was made, all ones where the
                        vehicle could not tell the time
       ...              what that command or answer carries

     Every number is most significant byte first, as CCSDS and the beacon
     have it. A packet carries no CRC of its own: the transport under it,
     UDP's checksum on this link, refuses a damaged datagram before it is
     read. One whose header or length does not match is refused, and nothing
     in it is acted on.

     The Rust in tcslibgs/src/link_packet.rs is generated from this file by
     `make link-packet` in tcslibgs/: change this, and regenerate it. See
     tcslibgs/src/link.rs, and "The Interface, the Fallback and Switching
     Over" in docs/design.rst. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="TcsLink">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <IntegerParameterType name="U1Type" signed="false">
        <IntegerDataEncoding sizeInBits="1" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U2Type" signed="false">
        <IntegerDataEncoding sizeInBits="2" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U3Type" signed="false">
        <IntegerDataEncoding sizeInBits="3" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U11Type" signed="false">
        <IntegerDataEncoding sizeInBits="11" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U14Type" signed="false">
        <IntegerDataEncoding sizeInBits="14" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U8Type" signed="false">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U16Type" signed="false">
        <IntegerDataEncoding sizeInBits="16" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U32Type" signed="false">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U64Type" signed="false">
        <IntegerDataEncoding sizeInBits="64" encoding="unsigned"/>
      </IntegerParameterType>
      <BooleanParameterType name="FlagType">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </BooleanParameterType>
      <BinaryParameterType name="DigestType">
        <BinaryDataEncoding>
          <SizeInBits>
            <FixedValue>128</FixedValue>
          </SizeInBits>
        </BinaryDataEncoding>
      </BinaryParameterType>
      <BinaryParameterType name="SampleBytesType">
        <BinaryDataEncoding>
          <SizeInBits>
            <FixedValue>64</FixedValue>
          </SizeInBits>
        </BinaryDataEncoding>
      </BinaryParameterType>
      <!-- Why a SET_NODE was refused, in the vehicle's words: up to 160
           bytes of UTF-8, after a byte saying how many. -->
      <StringParameterType name="ReasonType">
        <StringDataEncoding encoding="UTF-8">
          <Variable maxSizeInBits="1288">
            <LeadingSize sizeInBitsOfSizeTag="8"/>
          </Variable>
        </StringDataEncoding>
      </StringParameterType>
      <EnumeratedParameterType name="StatusType">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
        <EnumerationList>
          <Enumeration value="0" label="Success"/>
          <Enumeration value="1" label="Failure"/>
          <Enumeration value="2" label="InvalidCommand"/>
          <Enumeration value="3" label="InvalidParameter"/>
          <Enumeration value="4" label="NotArmed"/>
          <Enumeration value="5" label="NotFound"/>
          <Enumeration value="6" label="AlreadyExists"/>
          <Enumeration value="7" label="Timeout"/>
          <!-- 8 is not used: it was WrongGeneration, when a command
               carried a generation. -->
          <!-- Older than a command this start has already taken, and
               not acted on. -->
          <Enumeration value="9" label="Stale"/>
        </EnumerationList>
      </EnumeratedParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="Version" parameterTypeRef="U3Type"/>
      <Parameter name="PacketType" parameterTypeRef="U1Type"/>
      <Parameter name="SecHdrFlag" parameterTypeRef="U1Type"/>
      <Parameter name="APID" parameterTypeRef="U11Type"/>
      <Parameter name="SeqFlags" parameterTypeRef="U2Type"/>
      <Parameter name="SeqCount" parameterTypeRef="U14Type"/>
      <Parameter name="PacketLength" parameterTypeRef="U16Type">
        <!-- CCSDS: bytes in the packet data field, minus 1 -->
        <AncillaryDataSet>
          <AncillaryData name="tcs-xtce.length">-1</AncillaryData>
        </AncillaryDataSet>
      </Parameter>
      <Parameter name="Kind" parameterTypeRef="U8Type"/>
      <Parameter name="Sequence" parameterTypeRef="U32Type"/>
      <Parameter name="Status" parameterTypeRef="StatusType"/>
      <Parameter name="Timestamp" parameterTypeRef="U64Type"/>
      <Parameter name="Major" parameterTypeRef="U8Type"/>
      <Parameter name="Minor" parameterTypeRef="U8Type"/>
      <Parameter name="Patch" parameterTypeRef="U8Type"/>
      <Parameter name="Digest" parameterTypeRef="DigestType"/>
      <Parameter name="Generation" parameterTypeRef="U32Type"/>
      <!-- The newest command sequence this start has taken, or the
           CONNECT's own where it has taken none: where a ground station
           whose count has gone back starts again. -->
      <Parameter name="NewestTaken" parameterTypeRef="U32Type"/>
      <Parameter name="Node" parameterTypeRef="U32Type"/>
      <Parameter name="Reason" parameterTypeRef="ReasonType"/>
      <Parameter name="Enabled" parameterTypeRef="FlagType"/>
      <Parameter name="TakenBytes" parameterTypeRef="U64Type"/>
      <Parameter name="Reads" parameterTypeRef="U64Type"/>
      <Parameter name="ReadsFailed" parameterTypeRef="U64Type"/>
      <Parameter name="GivenBytes" parameterTypeRef="U64Type"/>
      <Parameter name="Writes" parameterTypeRef="U64Type"/>
      <Parameter name="WritesFailed" parameterTypeRef="U64Type"/>
      <Parameter name="Dropped" parameterTypeRef="U64Type"/>
      <Parameter name="Asks" parameterTypeRef="U64Type"/>
      <Parameter name="AsksFailed" parameterTypeRef="U64Type"/>
      <Parameter name="Strangers" parameterTypeRef="U64Type"/>
      <!-- Whether the node has moved anything, and when it last did: the
           time is nought where it has not, and is read only where the flag
           says it has. -->
      <Parameter name="MovedKnown" parameterTypeRef="FlagType"/>
      <Parameter name="LastMoved" parameterTypeRef="U64Type"/>
      <!-- The last datum a node moved each way: whether one has, when, how
           many bytes of it are shown, how many it had, and the first eight
           of them. -->
      <Parameter name="TakenKnown" parameterTypeRef="FlagType"/>
      <Parameter name="TakenTime" parameterTypeRef="U64Type"/>
      <Parameter name="TakenLength" parameterTypeRef="U8Type"/>
      <Parameter name="TakenTotal" parameterTypeRef="U32Type"/>
      <Parameter name="TakenBytesShown" parameterTypeRef="SampleBytesType"/>
      <Parameter name="GivenKnown" parameterTypeRef="FlagType"/>
      <Parameter name="GivenTime" parameterTypeRef="U64Type"/>
      <Parameter name="GivenLength" parameterTypeRef="U8Type"/>
      <Parameter name="GivenTotal" parameterTypeRef="U32Type"/>
      <Parameter name="GivenBytesShown" parameterTypeRef="SampleBytesType"/>
    </ParameterSet>
    <ContainerSet>
