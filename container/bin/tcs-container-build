#!/bin/sh
# tcs-container-build: tcs-container build, as a command of its own: build the
# image.
#
#   tcs-container-build [--distro kubuntu|fedora] [ARGUMENT...]
#
# Runs bin/tcs-container beside it with the command build, passing --distro,
# when it comes first, and every other argument as tcs-container takes them.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = --distro ]; then
	[ $# -ge 2 ] || {
		echo "usage: tcs-container-build [--distro DISTRO]" \
			"[ARGUMENT...]" >&2
		exit 2
	}
	distro=$2
	shift 2
	exec "$here/tcs-container" --distro "$distro" build "$@"
fi
exec "$here/tcs-container" build "$@"
