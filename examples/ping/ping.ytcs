# yaml-language-server: $schema=../../tcslib-protocol/schema/tcspecial.schema.json

description: "A ping, and a ground station that sends one and times the answer"

tcspecial:
  # Every port is in the seven thousands, which no other example uses, so this
  # one can be left running while another is looked at.
  #
  # The beacon is here as it is in the beacon example: the ground station
  # shows the same panel, so that it says whether the vehicle is alive before
  # anybody presses Ping.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:7510"
    reset_interval: "1 s"
    send: "0.0.0.0:7500"
  gateway: "radio"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:7300"
    source_base: "127.0.0.1:7310"
  payload_telemetry:
    dest_base: "127.0.0.1:7410"
    source_base: "0.0.0.0:7400"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle.
  state_file: "/tmp/tcspecial-ping.state"
  tcs_cmd:
    recv: "0.0.0.0:7200"
    send: "127.0.0.1:7210"

include:
  - subdiagram: ping-common
    path: ../ping-common/ping

gateways:
  - type gateway_radio:
      # The ground's end of the link, both ways. A ping goes up to address:port,
      # which this node binds aboard, and leaves it by moc-out for the ping
      # node. The answer comes back to the ground at ground_base plus the ping
      # node's device id: ping is the second name of the two, device id 1, so 7701.
      - gateway: gateway
        address: "127.0.0.1"
        ground_base: "127.0.0.1:7700"
        port: "7600"
        moc-out:
          - ping.gateway
        world-in: [ping]

tcs-gui:
  nodes:
    - { node: ping-common, x: 34, y: 34 }
    - { node: gateway, x: 469, y: 34 }
