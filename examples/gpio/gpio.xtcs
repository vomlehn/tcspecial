<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <description>Discrete lines of a GPIO chip: a switch's level to the ground, and the ground's 1 or 0 driving a lamp</description>
    <tcspecial>
        <!-- Every port is in the thirty-two hundreds to thirty-seven
             hundreds, ending in 20 or 30, which no other example uses, so
             this one can be left running while another is looked at. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:3530</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:3520</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c4d65b8e01d6d67e37dac523e739f09a</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:3320</dest_base>
            <source_base>127.0.0.1:3330</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:3430</dest_base>
            <source_base>0.0.0.0:3420</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-gpio.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:3220</recv>
            <send>127.0.0.1:3230</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <!-- The ground's end of the link, both ways. What the ground
                 sends goes up to address:port, which this node binds
                 aboard, and leaves it by moc-out for the lamp. What
                 comes down arrives at ground_base plus the device id of the
                 node that sent it: the switch, device id 2, at
                 127.0.0.1:3722. -->
            <gateway name="moc">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:3720</ground_base>
                <port>3620</port>
                <moc-out>lamp.moc</moc-out>
                <world-in>switch</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <type name="gpio_in">
            <!-- Two lines of one chip: a lamp the ground drives, a
                 gpio_out, and a switch the ground is told about, a
                 gpio_in. The chip here is /dev/gpiochip1, which is what the
                 kernel's gpio-sim chip is numbered on a host with one chip
                 of its own; bin/mk-kernel-dummies makes that chip and
                 prints the number it was given, which is the path to write
                 here.

                 A switch on line 0. Twice a second what it is goes to the
                 ground, as the u8 its one line is bit 0 of. -->
            <payload name="switch">
                <lines>0</lines>
                <path>/dev/gpiochip1</path>
                <state_interval>500 ms</state_interval>
                <world-out>moc.switch</world-out>
            </payload>
        </type>
        <type name="gpio_out">
            <!-- A lamp on line 1, driven by what the ground sends: the u8 1
                 to light it, 0 to put it out, and anything else refused. -->
            <payload name="lamp">
                <lines>1</lines>
                <path>/dev/gpiochip1</path>
                <moc-in>moc</moc-in>
            </payload>
        </type>
    </payloads>
    <tcsgui>
        <nodes>
            <node name="moc" x="469" y="34"/>
            <node name="lamp" x="34" y="134"/>
            <node name="switch" x="34" y="34"/>
        </nodes>
    </tcsgui>
</configuration>
