# yaml-language-server: $schema=../../tcslibgs/schema/tcspecial.schema.json


tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  # tcspecial counts its starts in this file, which must be on
  # storage that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-thermostat.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

include:
  - subdiagram: thermostat-common
    path: ../thermostat-common/thermostat

gateways:
  - type gateway_radio:
      - gateway: gateway
        address: "127.0.0.1"
        ground_base: "127.0.0.1:5100"
        port: "5000"
        world-in: [consensus_temp, gpio-out-tmass1, gpio-out-tmass2, to_k1, to_k2, to_k3]

tcsgui:
  nodes:
    - { node: gateway, x: 790, y: 34 }
    - { node: thermostat-common, x: 299, y: 53 }
