<?xml version="1.0" encoding="UTF-8"?>
<!-- What the vehicle sends the ground, flying the configuration
     thermostat: each node whose data reaches it, as a parameter named
     for the node, of the type the node sends, in a container of its own.
     The types are tcslibgs/xtce/types.xtce's, copied: a string or bytes
     after a 32-bit count of its bytes, as each is sent where the ground
     decodes it by XTCE (under Yamcs). Where no XTCE decodes it, the count
     is sent in groups of seven bits instead, least significant first, each
     in a byte whose top bit says another follows. How each gateway frames
     what it sends is the ground station's to add.

     Written by tcsverify, asked for it by its xtce option, from the
     configuration and types.xtce, and not to be edited: see "The
     configuration's own XTCE" in tcspecial's docs/design.rst. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="thermostat">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <IntegerParameterType name="u8" signed="false" sizeInBits="8">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </IntegerParameterType>
      <FloatParameterType name="kelvin" sizeInBits="64"
          shortDescription="Temperature.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">kelvin</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-kelvin</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>K</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="ambient" parameterTypeRef="kelvin"/>
      <Parameter name="temp1" parameterTypeRef="kelvin"/>
      <Parameter name="temp2" parameterTypeRef="kelvin"/>
      <Parameter name="temp3" parameterTypeRef="kelvin"/>
      <Parameter name="thermostat" parameterTypeRef="u8"/>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="ambient_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="ambient"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="temp1_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="temp1"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="temp2_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="temp2"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="temp3_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="temp3"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="thermostat_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="thermostat"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
</SpaceSystem>
