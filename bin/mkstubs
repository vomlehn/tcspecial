#!/bin/bash
#
# Make the kernel stand-ins a simulated I2C device, GPIO chip and IIO sensor
# need.
#
# Three of the nine payload kinds are ones the simulator cannot simply be the
# far end of. A serial line has a pty and a socket has another socket, but a
# device on an I2C bus has to answer when a master addresses it, a discrete
# line is a wire, and a sensor's buffer is filled by the sensor -- user space
# is none of those. What the kernel offers instead is three modules:
#
#   i2c-stub   an adapter whose chips are a bank of registers in memory, so
#              the bank is the payload: tcssim writes it and tcspecial reads it
#   gpio-sim   a chip whose lines exist in memory, with a file per line saying
#              what the line is pulled to, so tcssim writes that file and a
#              handler watching the same chip sees an edge
#   iio_dummy  a sensor with no sensor in it, whose buffer a software trigger
#              fills on a timer. Unlike the other two there is no simulator
#              side to this one: a buffer is a stream from the device and an
#              IIO payload cannot be triggered, so the dummy *is* the payload
#              and tcspecial reads it
#
# Both are the kernel's and configuring either needs root, so tcssim does not
# make them: it finds them and says how to make one if there is none. This is
# that, as bin/mkvcan is for the virtual CAN bus.
#
# What it does not do is let the unit tests cover any more than they do now.
# The tests scan a tree handed to them rather than the real one -- see
# find_stub() in tcssim/src/payload_i2c.rs and lines_of() in
# tcssim/src/payload_gpio.rs -- so they pass with no module loaded and would
# pass with one. This is for running a payload set that names an I2C, GPIO or
# IIO payload, which is the part that needs the real thing.
#
# Nothing here survives a reboot.

set -euo pipefail

# The chip the I2C stub answers for, and how many lines the simulated chip has.
#
# 0x48 because that is the address every message in the source offers as the
# example, so a configuration written from those messages works against this
# without being told a different number. Eight lines because a set of
# discretes is a handful of them -- a deployment switch, an arming line, an
# "alive" line -- and eight is the smallest round number larger than a
# handful.
#
# The stub's chips are fixed when the module is loaded, so an address given
# here is applied by reloading it. That is why the address is worth passing:
#   ./bin/mkstubs 0x50
#   ./bin/mkstubs 0x50 16
address="${1:-0x48}"
lines="${2:-8}"

# What this script's own simulated chip is called in configfs, and the bank
# under it.
#
# A name of its own so that cleanup can be its own and not everybody's: a
# gpio-sim device another program made is left alone, where unloading the
# module would take it away. The I2C stub has no such luxury -- the module is
# the adapter -- so that one is reloaded whole.
sim_device="tcssim"
sim_bank="bank0"

configfs="/sys/kernel/config"
gpio_sim="$configfs/gpio-sim"

# The dummy sensor and the trigger that fills its buffer, both named so that
# this script can find what it made among whatever else the host has. A laptop
# commonly has a real IIO device or two -- an ambient light sensor, an
# accelerometer -- and those are not ours to touch, so nothing here goes by
# device number: a device is ours if its name is this one.
iio_device="tcssim"
iio_trigger="tcssim-hr"
iio_devices="$configfs/iio/devices/dummy"
iio_triggers="$configfs/iio/triggers/hrtimer"

# How often the trigger fires, in Hz, and how many sample sets the buffer
# holds. A hundred a second is faster than any payload interval worth setting
# and slow enough to be nothing on a host; the length only has to be more than
# a reader will fall behind by.
iio_rate=100
iio_length=128

# What find_stub() in tcssim matches an adapter's name against. The same
# string, because a stub this script made and a stub tcssim will not recognise
# is worse than no stub at all.
stub_name="SMBus stub driver"

if [ "$(id -u)" -ne 0 ]; then
	echo "mkstubs: re-running under sudo, which is what loading a module needs"
	exec sudo -- "$0" "$@"
fi

# ------------------------------------------------------------- what was there

# configfs is where a simulated chip is described. Mounted already on a
# systemd host; mounted here if not, because the alternative is a mkdir that
# fails with nothing to say why. Before the cleanup rather than after, because
# the cleanup looks in there.
if [ ! -d "$configfs/." ] || ! mountpoint -q "$configfs"; then
	echo "mkstubs: mounting configfs on $configfs"
	mount -t configfs none "$configfs"
fi

# Remove what a previous run left, which is bin/rmstubs and is called rather
# than copied.
#
# Not only tidiness on the I2C side: the stub's chips are fixed when the module
# is loaded, so an address differing from the loaded one can only be had by
# unloading it first, and a reload is what makes running this twice with two
# addresses do what it looks like it does.
#
# By the directory this script is in, so that a tree moved or run from
# elsewhere still finds its sibling; already root here, so rmstubs' own check
# passes through.
here="$(cd -- "$(dirname -- "$0")" && pwd)"
"$here/rmstubs"

# ---------------------------------------------------------------- the I2C stub

# The character devices an adapter is reached through. Built into most
# kernels, in which case modprobe succeeds and does nothing; a kernel with it
# as a module needs it, because without it there is no /dev/i2c-N to open.
modprobe i2c-dev

echo "mkstubs: loading i2c-stub with a chip at $address"
modprobe i2c-stub "chip_addr=$address"

# Find what it became, the way tcssim finds it: the adapter whose name is the
# stub's, lowest number first. Numeric names only -- some adapters are called
# things like i2c-ELAN2097:00, which is not a number and not a stub.
stub=""
for dir in /sys/bus/i2c/devices/i2c-*; do
	number="${dir##*/i2c-}"
	case "$number" in
	'' | *[!0-9]*) continue ;;
	esac
	[ -r "$dir/name" ] || continue
	if [ "$(cat "$dir/name")" = "$stub_name" ]; then
		if [ -z "$stub" ] || [ "$number" -lt "$stub" ]; then
			stub="$number"
		fi
	fi
done

if [ -z "$stub" ]; then
	echo "mkstubs: i2c-stub loaded but no adapter of its is listed, which should" >&2
	echo "mkstubs: not happen -- look in /sys/bus/i2c/devices" >&2
	exit 1
fi

# ------------------------------------------------------------ the GPIO stand-in

modprobe gpio-sim

echo "mkstubs: making a simulated chip of $lines lines"
mkdir "$gpio_sim/$sim_device"
mkdir "$gpio_sim/$sim_device/$sim_bank"
echo "$lines" > "$gpio_sim/$sim_device/$sim_bank/num_lines"
echo 1 > "$gpio_sim/$sim_device/live"

# Which platform device it became, and which character device that is.
#
# Both are assigned as devices appear and neither is an identity, which is why
# this reads them rather than assuming gpio-sim.0 and gpiochip0: the number a
# payload set names has to be the number of the run it is in. dev_name is what
# configfs says the device is called once it is live, and chip_name is the node
# the bank became -- the same file lines_of() matches against.
dev_name="$(cat "$gpio_sim/$sim_device/dev_name")"
bank="/sys/devices/platform/$dev_name/$sim_bank"
chip="$(cat "$bank/chip_name")"

# The file a simulated payload writes. If this is missing the chip is live but
# not usable, and saying so here beats a payload failing on it later.
if [ ! -w "$bank/sim_gpio0/pull" ]; then
	echo "mkstubs: $chip has no line files under $bank, which should not happen" >&2
	exit 1
fi

# ------------------------------------------------------------- the IIO sensor

# The configfs root for IIO comes from its own module, which the others do not
# pull in; the dummy sensor is a software device and the hrtimer trigger a
# software trigger, each registered by its module under that root.
modprobe industrialio-configfs
modprobe iio-trig-hrtimer
modprobe iio_dummy

# The trigger first, because a buffer with no trigger has nothing to fill it
# and the device wants a trigger named before the buffer is enabled.
echo "mkstubs: making a software trigger at $iio_rate Hz"
mkdir "$iio_triggers/$iio_trigger"

# Its rate, where the trigger has one to set. A software trigger does; a
# device's own trigger does not, which is why this is conditional rather than
# assumed.
trigger=""
for dir in /sys/bus/iio/devices/trigger*; do
	[ -r "$dir/name" ] || continue
	if [ "$(cat "$dir/name")" = "$iio_trigger" ]; then
		trigger="$dir"
		break
	fi
done
if [ -z "$trigger" ]; then
	echo "mkstubs: the trigger was made but is not listed, which should not" >&2
	echo "mkstubs: happen -- look in /sys/bus/iio/devices" >&2
	exit 1
fi
if [ -w "$trigger/sampling_frequency" ]; then
	echo "$iio_rate" > "$trigger/sampling_frequency"
fi

echo "mkstubs: making a dummy sensor"
mkdir "$iio_devices/$iio_device"

# Which IIO device it became. By name, not by number: the number is assigned as
# devices appear and a host's own sensors are in the same range.
device=""
for dir in /sys/bus/iio/devices/iio:device*; do
	[ -r "$dir/name" ] || continue
	if [ "$(cat "$dir/name")" = "$iio_device" ]; then
		device="$dir"
		break
	fi
done
if [ -z "$device" ]; then
	echo "mkstubs: the dummy sensor was made but is not listed, which should" >&2
	echo "mkstubs: not happen -- look in /sys/bus/iio/devices" >&2
	exit 1
fi

# Where the scan elements and the buffer controls are.
#
# Two layouts, and this kernel has both: a buffer used to be one per device,
# with its switches in buffer/ and its channels in scan_elements/, and is now
# one directory per buffer with both in it. Prefer the newer, because the older
# pair are kept only for the first buffer and only for compatibility.
if [ -d "$device/buffer0" ] && compgen -G "$device/buffer0/*_en" > /dev/null; then
	scan="$device/buffer0"
	buffer="$device/buffer0"
elif [ -d "$device/scan_elements" ]; then
	scan="$device/scan_elements"
	buffer="$device/buffer"
else
	echo "mkstubs: $device has no buffer to enable, so the dummy was built" >&2
	echo "mkstubs: without one: a kernel needs CONFIG_IIO_SIMPLE_DUMMY_BUFFER" >&2
	exit 1
fi

# Enable every channel the dummy offers, and the timestamp none of them.
#
# Every one rather than a named list, because which channels a dummy has is the
# kernel's business and a list here would go stale. The timestamp is left off
# deliberately: it is a scan element like the others, but switching it on adds
# eight bytes and a padding rule to every sample set, and a reader told how
# many channels there are would then be told something that does not describe
# the bytes.
channels=0
for en in "$scan"/*_en; do
	[ -e "$en" ] || continue
	case "${en##*/}" in
	in_timestamp_en) continue ;;
	esac
	echo 1 > "$en"
	channels=$((channels + 1))
done
if [ "$channels" -eq 0 ]; then
	echo "mkstubs: $device offers no channels to enable, which should not happen" >&2
	exit 1
fi

echo "$iio_trigger" > "$device/trigger/current_trigger"
echo "$iio_length" > "$buffer/length"
echo 1 > "$buffer/enable"

# The node a handler opens, and the proof the buffer took.
#
# A buffer that refused to enable leaves the file reading 0, and an IIO
# endpoint opening the node then polls something that will never be ready --
# which is a far worse thing to discover later than here.
node="${device##*/}"
if [ "$(cat "$buffer/enable")" != "1" ]; then
	echo "mkstubs: $node has a buffer that will not enable" >&2
	exit 1
fi
if [ ! -r "/dev/$node" ]; then
	echo "mkstubs: $node has no /dev/$node to read, so the buffer is there and" >&2
	echo "mkstubs: the character device is not" >&2
	exit 1
fi

# ------------------------------------------------------------------ what to use

echo "mkstubs: done"
echo
echo "  an I2C payload:   path: /dev/i2c-$stub"
echo "                    bus_address: $address"
echo
echo "  a GPIO payload:   path: /dev/$chip"
echo "                    lines: 0-$((lines - 1)) are simulated"
echo
echo "  an IIO payload:   path: /dev/$node"
echo "                    channels: $channels"
echo "                    sample_rate: $iio_rate"
echo
echo "Every number is assigned as devices appear, so they can differ from one"
echo "run of this to the next; a payload set that names them has to name these."
