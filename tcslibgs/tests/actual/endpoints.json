{
  "general": {
    "version": "1.0",
    "description": "Flight payload endpoints"
  },

  "endpoint_groups": [
    {
      "name": "rs422_payload",
      "type": "serial",
      "datarate": 115200,
      "stop_bits": 1,
      "byte_length": 8,
      "packet_size": 512,
      "stream": {
        "max_length": 512,
        "timeout": "250ms",
        "terminators": ["0x0D", "0x0A"]
      }
    },
    {
      "name": "rs422_blockmode",
      "type": "serial",
      "datarate": 38400,
      "stop_bits": 2,
      "byte_length": 8,
      "packet_size": 64,
      "stream": {
        "max_length": 64,
        "timeout": "none"
      }
    },
    {
      "name": "payload_tcp",
      "type": "network",
      "protocol": "tcp",
      "packet_size": 1024,
      "stream": {
        "max_length": 4096,
        "timeout": "1s"
      }
    },
    {
      "name": "payload_udp",
      "type": "network",
      "protocol": "udp",
      "packet_size": 256
    },
    {
      "name": "payload_unix",
      "type": "network",
      "protocol": "unix_stream",
      "stream": {
        "max_length": 1024,
        "terminators": ["0x0A"]
      }
    },
    {
      "name": "payload_i2c",
      "type": "i2c",
      "packet_size": 32,
      "pec": true,
      "retries": 2,
      "timeout": "50ms",
      "bus_speed": 400000
    },
    {
      "name": "payload_spi",
      "type": "spi",
      "packet_size": 64,
      "max_speed": 10000000,
      "mode": 3,
      "bits_per_word": 8,
      "cs_active": "low"
    }
  ],

  "endpoints": [
    { "name": "magnetometer", "group": "rs422_payload",   "device": "/dev/ttyS0" },
    { "name": "star_tracker", "group": "rs422_payload",   "device": "/dev/ttyS1" },
    { "name": "spectrometer", "group": "rs422_blockmode", "device": "/dev/ttyUSB0" },
    { "name": "camera",       "group": "payload_tcp",     "address": "10.0.0.20", "port": 5000 },
    { "name": "housekeeping", "group": "payload_udp",     "address": "10.0.0.21", "port": 5001 },
    { "name": "recorder",     "group": "payload_unix",    "device": "/run/tcspecial/recorder.sock" },
    { "name": "thermal_a",    "group": "payload_i2c",     "device": "/dev/i2c-2", "address": "0x48" },
    { "name": "thermal_b",    "group": "payload_i2c",     "device": "/dev/i2c-2", "address": "0x49" },
    { "name": "imu",          "group": "payload_spi",     "device": "/dev/spidev0.1" }
  ]
}
