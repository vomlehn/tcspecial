<?xml version="1.0" encoding="UTF-8"?>
<!-- The beacon, as it goes on the link: what tcspecial sends every
     beacon.default_interval to beacon.recv, and the whole of the datagram.

     57 bytes, in this order:

       "tcspecial "    10 bytes of text, the space included
       major           1 byte, unsigned
       minor           1 byte, unsigned
       patch           1 byte, unsigned
       " "             1 byte
       digest          16 bytes, the MD5 of the configuration tcspecial read
       sequence        4 bytes, unsigned, most significant byte first
       generation      4 bytes, unsigned, most significant byte first
       restarting      1 bit, the most significant of its byte
       spare           7 bits, nought
       interface       16 bytes, the digest of the interface tcspecial speaks
       crc             2 bytes, CRC-16 over every byte before it

     The name and the space are constants: tcs-xtce writes them when a beacon
     is packed and refuses a datagram without them when one is unpacked, so
     they are not fields of the generated Beacon, and so is the spare, which
     a beacon is refused for if it is not nought. The sequence counts the
     beacons this tcspecial has sent, from one, so that the ground can tell a
     beacon it missed from a vehicle that restarted. The generation counts the
     times tcspecial has started, kept in its state file, and the restarting
     bit says a restart has been initiated and the process is about to end:
     see "The generation number and the state file" in docs/design.rst. The
     CRC is the CCSDS one, polynomial 0x1021 and initial remainder 0xFFFF,
     and a beacon that fails it is refused.

     The Rust in tcslibgs/src/beacon_packet.rs and the Python in
     python/tcslibgs/beacon_packet.py are generated from this file by
     `make beacon-packet` in tcslibgs/: change this, and regenerate them. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="TcsBeacon">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <StringParameterType name="NameType">
        <StringDataEncoding encoding="US-ASCII">
          <SizeInBits>
            <Fixed>
              <FixedValue>80</FixedValue>
            </Fixed>
          </SizeInBits>
        </StringDataEncoding>
      </StringParameterType>
      <StringParameterType name="SeparatorType">
        <StringDataEncoding encoding="US-ASCII">
          <SizeInBits>
            <Fixed>
              <FixedValue>8</FixedValue>
            </Fixed>
          </SizeInBits>
        </StringDataEncoding>
      </StringParameterType>
      <IntegerParameterType name="U8Type" signed="false">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U32Type" signed="false">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="U16Type" signed="false">
        <IntegerDataEncoding sizeInBits="16" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="SpareType" signed="false">
        <IntegerDataEncoding sizeInBits="7" encoding="unsigned"/>
      </IntegerParameterType>
      <BooleanParameterType name="FlagType">
        <IntegerDataEncoding sizeInBits="1" encoding="unsigned"/>
      </BooleanParameterType>
      <BinaryParameterType name="DigestType">
        <BinaryDataEncoding>
          <SizeInBits>
            <FixedValue>128</FixedValue>
          </SizeInBits>
        </BinaryDataEncoding>
      </BinaryParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="Name" parameterTypeRef="NameType"/>
      <Parameter name="Major" parameterTypeRef="U8Type"/>
      <Parameter name="Minor" parameterTypeRef="U8Type"/>
      <Parameter name="Patch" parameterTypeRef="U8Type"/>
      <Parameter name="Separator" parameterTypeRef="SeparatorType"/>
      <Parameter name="Digest" parameterTypeRef="DigestType"/>
      <Parameter name="Sequence" parameterTypeRef="U32Type"/>
      <Parameter name="Generation" parameterTypeRef="U32Type"/>
      <Parameter name="Restarting" parameterTypeRef="FlagType"/>
      <Parameter name="Spare" parameterTypeRef="SpareType"/>
      <Parameter name="Interface" parameterTypeRef="DigestType"/>
      <Parameter name="Crc" parameterTypeRef="U16Type"/>
    </ParameterSet>
    <ContainerSet>
      <!-- Everything a beacon holds, constants and all. Abstract: what is
           packed and unpacked is the Beacon below, which is this with the
           constants fixed. -->
      <SequenceContainer name="BeaconLayout" abstract="true">
        <BinaryEncoding>
          <ErrorDetectCorrect>
            <CRC width="16" parameterRef="Crc">
              <Polynomial>1021</Polynomial>
              <InitRemainder>FFFF</InitRemainder>
            </CRC>
          </ErrorDetectCorrect>
        </BinaryEncoding>
        <EntryList>
          <ParameterRefEntry parameterRef="Name"/>
          <ParameterRefEntry parameterRef="Major"/>
          <ParameterRefEntry parameterRef="Minor"/>
          <ParameterRefEntry parameterRef="Patch"/>
          <ParameterRefEntry parameterRef="Separator"/>
          <ParameterRefEntry parameterRef="Digest"/>
          <ParameterRefEntry parameterRef="Sequence"/>
          <ParameterRefEntry parameterRef="Generation"/>
          <ParameterRefEntry parameterRef="Restarting"/>
          <ParameterRefEntry parameterRef="Spare"/>
          <ParameterRefEntry parameterRef="Interface"/>
          <ParameterRefEntry parameterRef="Crc"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="Beacon">
        <EntryList/>
        <BaseContainer containerRef="BeaconLayout">
          <RestrictionCriteria>
            <ComparisonList>
              <Comparison parameterRef="Name" value="tcspecial "/>
              <Comparison parameterRef="Separator" value=" "/>
              <Comparison parameterRef="Spare" value="0"/>
            </ComparisonList>
          </RestrictionCriteria>
        </BaseContainer>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
</SpaceSystem>
