#!/bin/sh
# tcs-container-copy: tcs-container copy, as a command of its own: copy
# checkouts into the container.
#
#   tcs-container-copy [--distro kubuntu|fedora] [ARGUMENT...]
#
# Runs bin/tcs-container beside it with the command copy, passing --distro,
# when it comes first, and every other argument as tcs-container takes them.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = --distro ]; then
	[ $# -ge 2 ] || {
		echo "usage: tcs-container-copy [--distro DISTRO]" \
			"[ARGUMENT...]" >&2
		exit 2
	}
	distro=$2
	shift 2
	exec "$here/tcs-container" --distro "$distro" copy "$@"
fi
exec "$here/tcs-container" copy "$@"
