# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "The thermostat, through Yamcs, over CCSDS"

tcspecial:
  # The thermostat example with Yamcs at the ground end. The gateway is
  # yamcs, so every packet on every link to the ground carries a CCSDS
  # primary header: the beacon, the commands and their answers, and each
  # reading and decision the gateway node sends down. Each link says its
  # APID; the gateway node's sources count theirs on from its apid_base.
  #
  # Every port is in the seventeen thousands, which no other example uses,
  # so this one can be left running beside the thermostat example itself.
  beacon:
    apid: "0x110"
    default_interval: "5 s"
    recv: "127.0.0.1:17510"
    reset_interval: "1 s"
    send: "0.0.0.0:17500"
  gateway: "yamcs"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:17300"
    source_base: "127.0.0.1:17310"
  # A payload nothing in the drawing touches would report to dest_base plus
  # its device id, as telemetry of APID apid_base plus that device id. This
  # vehicle has none, but a configuration that answers to Yamcs says where
  # their APIDs would begin all the same.
  payload_telemetry:
    apid_base: "0x500"
    dest_base: "127.0.0.1:17410"
    source_base: "0.0.0.0:17400"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-thermostat-yamcs.state"
  # Yamcs sends its commands from a port the system chooses, and takes the
  # answers on the same socket, so the commands are taken from any port of
  # this host -- port 0 -- and each answer goes back to the port its command
  # came from.
  tcs_cmd:
    apid: "0x111"
    recv: "0.0.0.0:17200"
    send: "127.0.0.1:0"

include:
  - subdiagram: thermostat-common
    path: ../thermostat-common/thermostat

gateways:
  - type gateway_yamcs:
      # Yamcs's end of the link. Each reading drawn into this node comes
      # down to Yamcs at ground_base plus its source's device id -- temp3 is
      # the eighth of the twelve names, here and in the file this one
      # includes, device id 7, so 17707 -- as telemetry of APID apid_base
      # plus that device id, 0x407. What Yamcs sends up to address:port goes
      # as a telecommand of APID apid_base.
      - gateway: gateway
        address: "127.0.0.1"
        apid_base: "0x400"
        ground_base: "127.0.0.1:17700"
        port: "17600"
        world-in: [ambient, gpio-out-tmass1, gpio-out-tmass2, temp1, temp2, temp3]

payloads:
  # The three sensors of the zone, two on an I2C bus and one on a SPI bus,
  # as a vehicle would carry them. On a desk each is reached over UDP at its
  # sim_address, where tcssim answers with the zone's temperature, so that they
  # touch no hardware; flown, with no simulated devices, the buses are
  # opened.
  - type i2c_tmass:
      # One of three sensors of the same place, a trio, so that the
      # temperature survives one of them going wrong. Two bytes, signed,
      # big endian.
      - payload: temp_1
        address: "0x48"
        group: "zone_temps"
        path: "/dev/i2c-1"
        read_size: "2"
        sim_address: "127.0.0.1:17801"
        world-out:
          - temp1.temp_1
      # The second of the trio; the same part as temp_1, on the same bus.
      - payload: temp_2
        address: "0x49"
        group: "zone_temps"
        path: "/dev/i2c-1"
        read_size: "2"
        sim_address: "127.0.0.1:17802"
        world-out:
          - temp2.temp_2
  - type spi_tmass:
      # The third. A different part on a different bus: three bytes,
      # unsigned, its own scale and so its own conversion, so that no one
      # bus and no one part number can take the whole trio out.
      - payload: temp_3
        group: "zone_temps"
        max_speed: "1000000"
        path: "/dev/spidev0.0"
        read_size: "3"
        spi_mode: "0"
        sim_address: "127.0.0.1:17803"
        world-out:
          - temp3.temp_3

tcsgui:
  nodes:
    - { node: thermostat-common, x: 242, y: 166 }
    - { node: gateway, x: 790, y: 34 }
    - { node: temp_1, x: 34, y: 34 }
    - { node: temp_2, x: 34, y: 166 }
    - { node: temp_3, x: 34, y: 280 }
