# yaml-language-server: $schema=tcsgui/share/schema/tcspecial.schema.json

description: "The ground link alone, ready for payloads to be added"

tcspecial:
  beacon:
    default_interval: "1 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "93b26cb0221440317c27e209657a5dcc"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  state_file: "/tmp/tcspecial-example.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

gateways:
  - type gateway_radio:
      - gateway: gateway-1
        address: "127.0.0.1"
        ground_base: "127.0.0.1:5100"
        port: "5000"
        world-in: [spi-1]

payloads:
  - type spi:
      - payload: spi-1
        max_speed: "1000000"
        path: "/dev/spidev0.0"
        spi_mode: "0"
        sim_address: "127.0.0.1:7951"
        world-out:
          - gateway-1.spi-1

tcsgui:
  nodes:
    - { node: gateway-1, x: 469, y: 34 }
    - { node: spi-1, x: 15, y: 34 }
