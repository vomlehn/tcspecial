# yaml-language-server: $schema=../../tcsprotocol/schema/tcspecial.schema.json

# The vehicle the two thermostat examples share, which each includes:
# the three sensors, the three conversions and the vote between them,
# the thermostat, the heaters' switches, the group the
# sensors are read in, and the setpoint the ground may set. What
# differs between the two is in each example's own file: the tcspecial
# section and the gateway node. The gateway node is called
# gateway in both, which is the name the links here send to it by and
# the command binding takes the setpoint from.

# What the examples that include this file may join: every reading that
# leaves for the gateway node there. Nothing arrives from outside, the
# sensors being here.
exports:
  world-out: [consensus_temp, gpio-out-tmass1, gpio-out-tmass2, to_k1, to_k2, to_k3]

payload_groups:
  - name: "zone_temps"
    interval: "1 s"

vehicle:
  - type compute:
      # One temperature out of the three, by the algorithm named: median
      # takes the middle reading, closest_mean the mean of the two that
      # agree best. Either leaves a sensor that has gone wrong out of the
      # answer, which a mean over all three would not, and it produces a
      # value on every arrival, so one sensor that stops reporting is
      # outvoted rather than stopping the vehicle from deciding anything.
      - compute: consensus_temp
        algorithm: "median"
        carries: "kelvin"
        function: "vote"
        world-out:
          - gateway.consensus_temp
          - thermostat.consensus_temp
        world-in: [in0, in1, in2]
      # setpoint is set from the ground; half_band is how far either side
      # of it the heaters are switched at, the setpoint being in the middle
      # of the band.
      - compute: thermostat
        function: "thermostat"
        half_band: "2.0"
        setpoint: "293.15"
        type-in: "kelvin"
        type-out: "u8"
        # asserted below the setpoint, unasserted above it. Two heaters, because
        # one failing must not leave the mass with no way to be warmed: either
        # alone holds the band while the orbit is warm, and both together hold
        # it in the cold too, each switched through a line of its own. What it
        # decides goes to the heaters, and the ground is told it by
        # the heaters' switches, each reporting what it was last told.
        moc-out:
          - gpio-out-tmass1.thermostat
          - gpio-out-tmass2.thermostat
        world-in: [consensus_temp]
      # Each sensor's reading, to kelvin, for the vote and the gateway node:
      # the parts differ in format and scale, so each has a conversion of
      # its own.
      - compute: to_k1
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        type-in: "i16"
        world-out:
          - consensus_temp.in0
          - gateway.to_k1
        world-in: [temp_1]
      - compute: to_k2
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        type-in: "i16"
        world-out:
          - consensus_temp.in1
          - gateway.to_k2
        world-in: [temp_2]
      - compute: to_k3
        function: "to_kelvin"
        offset: "255.37"
        scale: "0.0078"
        type-in: "u32"
        world-out:
          - consensus_temp.in2
          - gateway.to_k3
        world-in: [temp_3]

payloads:
  # The heaters' switches, on the thermal mass: lines 4 and 5 of
  # /dev/gpiochip1. On a desk tcs-sim answers for them over UDP at their
  # sim_address, so that no dummy chip is needed; flown, the chip is
  # opened.
  - type gpio_inout:
      # Each a line the thermostat drives -- 1 for on, 0 for off -- and tells
      # the heater it switches, and every second the ground what it was last
      # told, so the ground follows the heaters on a beat and a lost report is
      # made good by the next. One payload each, so that one can be stopped
      # from the ground while the other goes on warming the mass.
      - payload: gpio-out-tmass1
        lines: "4"
        path: "/dev/gpiochip1"
        sim_address: "127.0.0.1:5204"
        state_interval: "1 s"
        moc-in: [thermostat]
        world-out:
          - gateway.gpio-out-tmass1
      - payload: gpio-out-tmass2
        lines: "5"
        path: "/dev/gpiochip1"
        sim_address: "127.0.0.1:5205"
        state_interval: "1 s"
        moc-in: [thermostat]
        world-out:
          - gateway.gpio-out-tmass2
  # The three sensors of the zone, two on an I2C bus and one on a SPI bus,
  # as a vehicle would carry them, each converted to kelvin for the
  # vote. On a desk each is reached over UDP at its sim_address, where
  # tcs-sim answers with the zone's temperature, so that no bus and no dummy
  # device is needed; flown, the buses are opened.
  - type i2c_tmass:
      # One of three sensors of the same place, a trio, so that the
      # temperature survives one of them going wrong. Two bytes, signed,
      # big endian.
      - payload: temp_1
        address: "0x48"
        group: "zone_temps"
        path: "/dev/i2c-1"
        read_size: "2"
        sim_address: "127.0.0.1:5201"
        world-out-type: "i16"
        world-out:
          - to_k1.temp_1
      # The second of the trio; the same part as temp_1, on the same bus.
      - payload: temp_2
        address: "0x49"
        group: "zone_temps"
        path: "/dev/i2c-1"
        read_size: "2"
        sim_address: "127.0.0.1:5202"
        world-out-type: "i16"
        world-out:
          - to_k2.temp_2
  - type spi_tmass:
      # The third. A different part on a different bus: three bytes,
      # unsigned, its own scale and so its own conversion, so that no one
      # bus and no one part number can take the whole trio out.
      - payload: temp_3
        format: "u24_be"
        group: "zone_temps"
        max_speed: "1000000"
        path: "/dev/spidev0.0"
        read_size: "3"
        spi_mode: "0"
        sim_address: "127.0.0.1:5203"
        world-out-type: "u32"
        world-out:
          - to_k3.temp_3

commands:
  # the zone temperature the heaters are held at, in kelvin
  - { from: gateway, sets: thermostat.setpoint }

tcs-gui:
  nodes:
    - { node: consensus_temp, x: 525, y: 204 }
    - { node: gpio-out-tmass1, x: 34, y: 393 }
    - { node: gpio-out-tmass2, x: 34, y: 469 }
    - { node: temp_1, x: 53, y: 72 }
    - { node: temp_2, x: 34, y: 166 }
    - { node: temp_3, x: 53, y: 280 }
    - { node: thermostat, x: 601, y: 242 }
    - { node: to_k1, x: 299, y: 166 }
    - { node: to_k2, x: 299, y: 242 }
    - { node: to_k3, x: 299, y: 317 }
