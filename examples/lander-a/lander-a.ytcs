# yaml-language-server: $schema=../../tcsprotocol/schema/tcspecial.schema.json

# The lander example: one of two tcspecials flying a lunar lander in two
# dimensions, this one its X axis, the other, lander-b, its Y axis. Each
# reads its axis of a joystick in tcs-sim's lander window and drives that
# axis's thrust with it, the pilot in the loop, and sends its axis's
# position, velocity and acceleration, and the joystick's value, down
# through Yamcs. Their payloads are simulated by one tcs-sim, from the
# simulator file they share, ../lander-common/lander-sim.yaml, whose world
# is the lander and its landscape. See docs/lander-design.rst.

description: "The lander example's X, across: a tcspecial flying one axis of a
  lunar lander, its joystick's X driving the thrust, its X position, velocity
  and acceleration sent down through Yamcs"

tcspecial:
  beacon:
    apid: "0x110"
    default_interval: "5 s"
    recv: "127.0.0.1:19510"
    reset_interval: "1 s"
    send: "127.0.0.24:19500"
  gateway: "yamcs"
  interface: "b03f49878bcc9c45e7b854c7da1bce47"
  log:
    directory: "/tmp/telemetry/lander-a"
    segment_size: "65536"
  max_consolidator_inputs: "32"
  payload_command:
    dest_base: "127.0.0.24:19300"
    source_base: "127.0.0.1:0"
  payload_telemetry:
    apid_base: "0x500"
    dest_base: "127.0.0.1:19410"
    source_base: "127.0.0.24:19400"
  state_file: "/tmp/tcspecial-lander-a.state"
  tcs_cmd:
    apid: "0x111"
    recv: "127.0.0.24:19200"
    send: "127.0.0.1:0"

gateways:
  - type gateway_yamcs:
      - gateway: gateway
        address: "127.0.0.24:19600"
        apid_base: "0x400"
        ground_base: "127.0.0.1:19700"
        world-in: [sky, to_accel_x, to_fuel, to_joystick_3_4_x, to_velocity_x,
          to_x]
      - gateway: gateway_sky
        address: "127.0.0.24:19601"
        apid_base: "0x480"
        ground_base: "127.0.0.1:19750"
        moc-out:
          - sky_quench.gateway_sky

vehicle:
  - type compute:
      - compute: to_accel_x
        function: "to_value"
        offset: "0"
        scale: "0.001"
        type-in: "i16"
        type-out: "metre_per_second_squared"
        world-out:
          - gateway.to_accel_x
        world-in: [accel_x]
      - compute: to_fuel
        function: "to_value"
        offset: "0"
        scale: "0.0001"
        type-in: "i16"
        type-out: "ratio"
        world-out:
          - gateway.to_fuel
        world-in: [fuel]
      - compute: to_joystick_3_4_x
        function: "to_value"
        offset: "0"
        scale: "0.0001"
        type-in: "i16"
        type-out: "ratio"
        moc-out:
          - thruster_x.to_joystick_3_4_x
        world-out:
          - gateway.to_joystick_3_4_x
        world-in: [joystick_3_4_x]
      - compute: to_velocity_x
        function: "to_value"
        offset: "0"
        scale: "0.01"
        type-in: "i16"
        type-out: "metre_per_second"
        world-out:
          - gateway.to_velocity_x
        world-in: [velocity_x]
      - compute: to_x
        function: "to_value"
        offset: "0"
        scale: "0.1"
        type-in: "i16"
        type-out: "metre"
        world-out:
          - gateway.to_x
        world-in: [x]

payloads:
  - type network:
      - payload: accel_x
        address: "127.0.0.24:19803"
        protocol: "udp"
        world-out-type: "i16"
        world-out:
          - to_accel_x.accel_x
      - payload: fuel
        address: "127.0.0.24:19804"
        protocol: "udp"
        world-out-type: "i16"
        world-out:
          - to_fuel.fuel
      - payload: joystick_3_4_x
        address: "127.0.0.24:19805"
        protocol: "udp"
        world-out-type: "i16"
        world-out:
          - to_joystick_3_4_x.joystick_3_4_x
      - payload: sky
        read_size: "64"
        address: "127.0.0.24:19808"
        protocol: "udp"
        world-out:
          - gateway.sky
      - payload: sky_quench
        address: "127.0.0.24:19809"
        protocol: "udp"
        moc-in: [gateway_sky]
      - payload: thruster_x
        address: "127.0.0.24:19806"
        moc-in-type: "ratio"
        protocol: "udp"
        moc-in: [to_joystick_3_4_x]
      - payload: velocity_x
        address: "127.0.0.24:19802"
        protocol: "udp"
        world-out-type: "i16"
        world-out:
          - to_velocity_x.velocity_x
      - payload: x
        address: "127.0.0.24:19801"
        protocol: "udp"
        world-out-type: "i16"
        world-out:
          - to_x.x
