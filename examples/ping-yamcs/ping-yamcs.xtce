<?xml version="1.0" encoding="UTF-8"?>
<!-- What the vehicle sends the ground, flying the configuration
     ping-yamcs: each node whose data reaches it, as a parameter named
     for the node, of the type the node sends, in a container of its own.
     The types are tcslibgs/xtce/types.xtce's, copied. A string or bytes
     is all of what carries it, and no count is sent before it: its
     length, and bytes_length, are what the ground is given by how it is
     framed. How each gateway frames what it sends is the ground
     station's to add.

     Written by tcsverify, asked for it by its xtce option, from the
     configuration and types.xtce, and not to be edited: see "The
     configuration's own XTCE" in tcspecial's docs/design.rst. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="ping-yamcs">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <StringParameterType name="string">
        <StringDataEncoding encoding="UTF-8">
          <Variable maxSizeInBits="32800">
            <LeadingSize sizeInBitsOfSizeTag="32"/>
          </Variable>
        </StringDataEncoding>
      </StringParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="ping" parameterTypeRef="string"/>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="ping_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="ping"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
</SpaceSystem>
