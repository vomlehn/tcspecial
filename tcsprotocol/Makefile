# Makefile for the tcsprotocol crate's README, and the link's packing code
#
# Cargo builds the crate itself, from the repository's root: see README.md.
# This builds the page, and regenerates the code that packs and unpacks the
# commands and answers from the XTCE that describes them. The beacon is text,
# and its layout is in xtce/beacon.xtce, as text fields: see src/beacon.rs.

.PHONY: all
all:	docs

# Display help
.PHONY: help
help:
	@echo "Makefile for the tcsprotocol README"
	@echo ""
	@echo "Usage:"
	@echo "  make README.html     - Build README.html from README.md"
	@echo "  make link-packet     - Regenerate the commands' and answers'" \
		"Rust codec"
	@echo "                         from xtce/link.xtce"
	@echo "  make fixed-packet    - Regenerate the fixed commands' Rust" \
		"and Python codecs"
	@echo "                         from xtce/fixed.xtce"
	@echo "  make beacon-packet   - Regenerate the beacon's Rust and" \
		"Python codecs"
	@echo "                         from xtce/beacon.xtce"
	@echo "  make ping-packet     - Regenerate the ping's Rust and Python" \
		"codecs"
	@echo "                         from xtce/ping.xtce"
	@echo "  make types-packet    - Regenerate the link types' Rust," \
		"src/types_packet.rs,"
	@echo "                         from xtce/types.xtce"
	@echo "  make unit-table      - Regenerate the units," \
		"src/unit_table.rs, from"
	@echo "                         xtce/types.xtce"
	@echo "  make interface-digest - Regenerate the digest of the" \
		"interface,"
	@echo "                         src/interface_digest.rs, from" \
		"xtce/link.xtce and xtce/types.xtce"
	@echo "  make clean           - Remove README.html"

.PHONY: docs
docs: README.html

# A page of its own, so pandoc's --standalone: it carries its own head and
# styling, and reads the same wherever it is copied to.
README.html: README.md
	pandoc --standalone --metadata pagetitle=tcsprotocol README.md \
		-o README.html

# The code that packs and unpacks the link's packets is generated by tcs-xtce
# and committed, so that building needs no Python; run this after changing the
# XML, and commit what it writes. The generator is tcs-xtce's Python package,
# used from a checkout of https://github.com/vomlehn/tcs-xtce beside this
# repository, at the release tcsxtce, the runtime the code it writes calls, is
# pinned to in Cargo.toml: see the tcs-xtce target. Always the one
# beside the main checkout, from a worktree too (../beside.mk), because that is
# where python/tcsprotocol/_xtce finds its Python runtime, and a link cannot
# follow a variable.
include $(CURDIR)/../beside.mk
TCS_XTCE := $(BESIDE)/tcs-xtce
XTCE_PIN := $(shell sed -n \
	's/^tcsxtce = { version = "=\([^"]*\)".*/\1/p' Cargo.toml)
XTCE_COMPILE := cd $(TCS_XTCE)/python && python3 -m tcs_xtce
XTCE_DIGEST := cd $(TCS_XTCE)/python && python3 -m tcs_xtce.digest_cli
# What makes the Python the generator writes import the runtime from
# python/tcsprotocol/_xtce, where it imports tcsxtce.
PY_RUNTIME := \
	's/^from tcsxtce import packet as pk$$/from ._xtce import packet as pk/'

# Stop, saying what to do, unless the tcs-xtce checkout is there, at the
# version Cargo.toml pins the crate to, and has its XML binding,
# python/tcs_xtce/generated.py, which git does not keep and the generator
# reads XTCE with.
.PHONY: tcs-xtce
tcs-xtce:
	@if [ ! -f "$(TCS_XTCE)/pyproject.toml" ]; then \
		echo "No tcs-xtce checkout at $(TCS_XTCE): clone" \
			"https://github.com/vomlehn/tcs-xtce beside this" \
			"repository." >&2; \
		exit 1; \
	fi
	@version=$$(sed -n 's/^version = "\(.*\)"$$/\1/p' \
		"$(TCS_XTCE)/pyproject.toml"); \
	if [ "$$version" != "$(XTCE_PIN)" ]; then \
		echo "The tcs-xtce checkout at $(TCS_XTCE) is version" \
			"$$version, and tcsprotocol/Cargo.toml pins" \
			"tcsxtce to $(XTCE_PIN): check out v$(XTCE_PIN)" \
			"there, or change the pin and regenerate." >&2; \
		exit 1; \
	fi
	@if [ ! -f "$(TCS_XTCE)/python/tcs_xtce/generated.py" ]; then \
		echo "The tcs-xtce checkout at $(TCS_XTCE) has no" \
			"python/tcs_xtce/generated.py: run make" \
			"python/tcs_xtce/generated.py there." >&2; \
		exit 1; \
	fi

# Every ordinary command and answer on the link is stated once, in
# xtce/link.xtce, and
# packed and unpacked by the Rust tcs-xtce generates from it, without dynamic
# allocation, because tcspecial decodes each command in its main loop.
#
# The Rust is formatted after it is generated: the generator writes lines
# wider than the 80 columns ../rustfmt.toml allows, and what is committed is
# formatted, so without this a regenerated file would differ from it and
# fail cargo fmt --check. rustfmt finds ../rustfmt.toml from the file's own
# directory; the edition is the crate's, from Cargo.toml.
LINK_XML := xtce/link.xtce
LINK_RS := src/link_packet.rs

.PHONY: link-packet
link-packet: $(LINK_RS)

$(LINK_RS): $(LINK_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(LINK_XML) $(CURDIR)/$(LINK_RS) \
		--lang rust --dynamic-allocations false \
		--source-name tcsprotocol/$(LINK_XML)
	rustfmt --edition 2021 $(LINK_RS)

# The fixed commands -- CONNECT, RESTART_ARM and RESTART -- and their
# answers are stated in xtce/fixed.xtce, which never changes, and packed and
# unpacked by the Rust and the Python tcs-xtce generates from it. The Python
# is for the ground stations written in Python; it imports the runtime
# through python/tcsprotocol/_xtce, whose links into the tcs-xtce checkout
# installing copies, so that an installed package needs nothing from the
# source tree.
FIXED_XML := xtce/fixed.xtce
FIXED_RS := src/fixed_packet.rs
FIXED_PY := ../python/tcsprotocol/fixed_packet.py

.PHONY: fixed-packet
fixed-packet: $(FIXED_RS) $(FIXED_PY)

$(FIXED_RS): $(FIXED_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(FIXED_XML) $(CURDIR)/$(FIXED_RS) \
		--lang rust --dynamic-allocations false \
		--source-name tcsprotocol/$(FIXED_XML)
	rustfmt --edition 2021 $(FIXED_RS)

$(FIXED_PY): $(FIXED_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(FIXED_XML) $(abspath $(FIXED_PY)) \
		--lang python --source-name tcsprotocol/$(FIXED_XML)
	sed -i $(PY_RUNTIME) \
		$(FIXED_PY)

# The beacon is stated in xtce/beacon.xtce, which never changes either, and
# packed and unpacked by the code generated from it in the same way.
BEACON_XML := xtce/beacon.xtce
BEACON_RS := src/beacon_packet.rs
BEACON_PY := ../python/tcsprotocol/beacon_packet.py

.PHONY: beacon-packet
beacon-packet: $(BEACON_RS) $(BEACON_PY)

$(BEACON_RS): $(BEACON_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(BEACON_XML) $(CURDIR)/$(BEACON_RS) \
		--lang rust --dynamic-allocations false \
		--source-name tcsprotocol/$(BEACON_XML)
	rustfmt --edition 2021 $(BEACON_RS)

$(BEACON_PY): $(BEACON_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(BEACON_XML) $(abspath $(BEACON_PY)) \
		--lang python --source-name tcsprotocol/$(BEACON_XML)
	sed -i $(PY_RUNTIME) \
		$(BEACON_PY)

# A ping and the ping node's answer are stated in xtce/ping.xtce, the ping
# node's own interface document. tcspecial and the ground stations write and
# read them with src/node/vehicle/ping/mod.rs and
# ../python/tcsprotocol/ping.py; the code generated from the document is
# what holds it to those, in their tests, and what
# python/tcsprotocol/yamcs.py's ground station splits a ping into the fields
# it sends with.
PING_XML := xtce/ping.xtce
PING_RS := src/ping_packet.rs
PING_PY := ../python/tcsprotocol/ping_packet.py

.PHONY: ping-packet
ping-packet: $(PING_RS) $(PING_PY)

$(PING_RS): $(PING_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(PING_XML) $(CURDIR)/$(PING_RS) \
		--lang rust --dynamic-allocations false \
		--source-name tcsprotocol/$(PING_XML)
	rustfmt --edition 2021 $(PING_RS)

$(PING_PY): $(PING_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(PING_XML) $(abspath $(PING_PY)) \
		--lang python --source-name tcsprotocol/$(PING_XML)
	sed -i $(PY_RUNTIME) \
		$(PING_PY)

# Every type a link between two nodes can carry is stated once, in
# xtce/types.xtce, and held and checked by the Rust tcs-xtce generates from
# it, without dynamic allocation, as the commands are. See "Typed links" in
# ../docs/tcspecial-design.rst.
TYPES_XML := xtce/types.xtce
TYPES_RS := src/types_packet.rs

.PHONY: types-packet
types-packet: $(TYPES_RS)

$(TYPES_RS): $(TYPES_XML) | tcs-xtce
	$(XTCE_COMPILE) $(CURDIR)/$(TYPES_XML) $(CURDIR)/$(TYPES_RS) \
		--lang rust --dynamic-allocations false \
		--source-name tcsprotocol/$(TYPES_XML)
	rustfmt --edition 2021 $(TYPES_RS)

# The units are the value types of xtce/types.xtce, and src/unit_table.rs,
# which src/unit.rs includes, is written from them by unit-table.py, so that
# a unit is stated in one place. A test in src/unit.rs reads the document
# again and fails if this has not been rerun.
UNIT_RS := src/unit_table.rs

.PHONY: unit-table
unit-table: $(UNIT_RS)

$(UNIT_RS): $(TYPES_XML) unit-table.py
	python3 unit-table.py $(TYPES_XML) $@
	rustfmt --edition 2021 $@

# The digest of the interface: the tcs-xtce digest of xtce/link.xtce and
# xtce/types.xtce together, which every beacon carries and every configuration
# names as its `interface`, so that the ground can tell whether it read the
# document tcspecial was built from. fixed.xtce and beacon.xtce are not part
# of it: no change to the ordinary interface can touch the fixed commands or
# the beacon, and their own digests are pinned by a test in src/link.rs.
# Generated, and committed, for the reason the codecs are; a test in
# src/interface.rs computes it again from the document and fails if this has
# not been rerun.
INTERFACE_XML := xtce/link.xtce xtce/types.xtce
INTERFACE_RS := src/interface_digest.rs

.PHONY: interface-digest
interface-digest: $(INTERFACE_RS)

$(INTERFACE_RS): $(INTERFACE_XML) | tcs-xtce
	digest=$$($(XTCE_DIGEST) --set \
		$(addprefix $(CURDIR)/,$(INTERFACE_XML))) && \
	{ echo "// @generated by \`make interface-digest\` in" \
	       "tcsprotocol/ from"; \
	  echo "// $(INTERFACE_XML): change those and rerun it."; \
	  echo "pub(crate) const INTERFACE_DIGEST: [u8; 16] = ["; \
	  echo "$$digest" | sed 's/../0x&, /g'; \
	  echo "];"; \
	} > $@
	rustfmt --edition 2021 $@

.PHONY: clean
clean:
	rm -f README.html
