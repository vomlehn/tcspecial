<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsprotocol/schema/tcspecial.xsd">
    <description>Three sensors' readings sent to the ground as one datum, a consolidation, and taken apart again there</description>
    <tcspecial>
        <!-- Three sensors' readings, put together aboard as one datum, a
             consolidation, and taken apart again on the ground.

             The sun sensor reports every second, the reaction wheel's speed
             four times a second and the battery every five. housekeeping, a
             consolidator, takes all three and sends one datum to the ground
             when every input has something new, or every two seconds whatever
             has arrived: each input marked new, held (the reading before, sent
             again) or none. The datum is packed to the bit, which is what a
             thin link to the ground wants.

             The ground station's receive takes the datum apart and hands out
             each new reading as though its sensor had sent it the ground
             itself, so tcs-moc shows the three in panels of their own, and
             housekeeping's Configuration, after a Query, how often each went in
             new, held and none. The battery, slowest, is the one most often
             held. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>85b9e713bed11d3415d182a4742a26b2</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <max_consolidator_inputs>32</max_consolidator_inputs>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <state_file>/tmp/tcspecial-consolidator.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <!-- Each node drawn in arrives at ground_base plus its device
                 id: housekeeping, device id 2, at 5102. Its inputs reach
                 the ground only in its datum. -->
            <gateway name="gateway">
                <ground_base>127.0.0.1:5100</ground_base>
                <world-in>housekeeping</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <type name="network">
            <!-- A sun sensor's angle, a whole number of two bytes. -->
            <payload name="sun">
                <address>127.0.0.1:5001</address>
                <protocol>udp</protocol>
                <world-out-type>u16</world-out-type>
                <world-out>housekeeping.sun</world-out>
            </payload>
            <!-- The reaction wheel's speed, signed: it turns either way. -->
            <payload name="wheel">
                <address>127.0.0.1:5002</address>
                <protocol>udp</protocol>
                <world-out-type>i32</world-out-type>
                <world-out>housekeeping.wheel</world-out>
            </payload>
            <!-- The battery's charge, a byte. -->
            <payload name="battery">
                <address>127.0.0.1:5003</address>
                <protocol>udp</protocol>
                <world-out-type>u8</world-out-type>
                <world-out>housekeeping.battery</world-out>
            </payload>
        </type>
    </payloads>
    <vehicle>
        <type name="compute">
            <!-- Sends when all three are new, and every two seconds
                 otherwise: all_new alone is refused, since one sensor that
                 stopped would stop it for good. Until a sensor has
                 reported, its default goes down in its place: the
                 battery's charge is 0 to 100, so 255 says "never read" by
                 being impossible, and so does 65535 for a sun angle in
                 hundredths of a degree; a wheel at rest reads 0, so its
                 default cannot be told from a reading. -->
            <compute name="housekeeping">
                <function>consolidator</function>
                <defaults>sun=65535</defaults>
                <defaults>wheel=0</defaults>
                <defaults>battery=255</defaults>
                <interval>2 s</interval>
                <send>all_new</send>
                <send>interval</send>
                <world-out>gateway.housekeeping</world-out>
                <world-in>sun</world-in>
                <world-in>wheel</world-in>
                <world-in>battery</world-in>
            </compute>
        </type>
    </vehicle>
    <tcs-cfge>
        <nodes>
            <node name="sun" x="34" y="34"/>
            <node name="wheel" x="34" y="134"/>
            <node name="battery" x="34" y="234"/>
            <node name="housekeeping" x="242" y="134"/>
            <node name="gateway" x="469" y="134"/>
        </nodes>
    </tcs-cfge>
</configuration>
