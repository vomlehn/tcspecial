<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcslib-protocol/schema/tcspecial.xsd">
    <description>The thermostat, through Yamcs, over CCSDS</description>
    <tcspecial>
        <!-- The thermostat example with Yamcs at the ground end. The
             gateway is yamcs, so every packet on every link to the ground
             carries a CCSDS primary header: the beacon, the commands and
             their answers, and each reading and decision the gateway node
             sends down. Each link says its APID; the gateway node's
             sources count theirs on from its apid_base.

             Every port of its own is in the seventeen thousands, which no
             other example uses. Its sensors are the ones in
             thermostat-common, at the thermostat example's simulated
             devices, and its heaters are the same lines of the same GPIO
             chip, so the two examples are not run at once. -->
        <beacon>
            <apid>0x110</apid>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:17510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:17500</send>
        </beacon>
        <gateway>yamcs</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:17300</dest_base>
            <source_base>127.0.0.1:17310</source_base>
        </payload_command>
        <!-- A payload nothing in the drawing touches would report to
             dest_base plus its device id, as telemetry of APID apid_base
             plus that device id. This vehicle has none, but a
             configuration that answers to Yamcs says where their APIDs
             would begin all the same. -->
        <payload_telemetry>
            <apid_base>0x500</apid_base>
            <dest_base>127.0.0.1:17410</dest_base>
            <source_base>0.0.0.0:17400</source_base>
        </payload_telemetry>
        <!-- tcspecial keeps in this file which configuration the next start is
             to run, the last one the ground confirmed, and how many starts of
             it have ended before a matching CONNECT, so on a vehicle it must be
             on storage that survives a power cycle. -->
        <state_file>/tmp/tcspecial-thermostat-yamcs.state</state_file>
        <!-- Yamcs sends its commands from a port the system chooses, and
             takes the answers on the same socket, so the commands are taken
             from any port of this host - port 0 - and each answer goes back
             to the port its command came from. -->
        <tcs_cmd>
            <apid>0x111</apid>
            <recv>0.0.0.0:17200</recv>
            <send>127.0.0.1:0</send>
        </tcs_cmd>
    </tcspecial>
    <include name="thermostat-common" path="../thermostat-common/thermostat"/>
    <gateways>
        <type name="gateway_yamcs">
            <!-- Yamcs's end of the link. Each reading drawn into this node
                 comes down to Yamcs at ground_base plus its source's device
                 id (to_k3 is the last of the eleven names, here and in the
                 file this one includes, device id 10, so 17710) as
                 telemetry of APID apid_base plus that device id, 0x40a.
                 What Yamcs sends up to address:port goes as a telecommand
                 of APID apid_base. -->
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <apid_base>0x400</apid_base>
                <ground_base>127.0.0.1:17700</ground_base>
                <port>17600</port>
                <world-in>consensus_temp</world-in>
                <world-in>gpio-out-tmass1</world-in>
                <world-in>gpio-out-tmass2</world-in>
                <world-in>to_k1</world-in>
                <world-in>to_k2</world-in>
                <world-in>to_k3</world-in>
            </gateway>
        </type>
    </gateways>
    <tcs-gui>
        <nodes>
            <node name="thermostat-common" x="242" y="166"/>
            <node name="gateway" x="790" y="34"/>
        </nodes>
    </tcs-gui>
</configuration>
