<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcslib-protocol/schema/tcspecial.xsd">
    <description>A ping, and a ground station that sends one and times the answer</description>
    <tcspecial>
        <!-- Every port is in the seven thousands, which no other example
             uses, so this one can be left running while another is looked
             at.

             The beacon is here as it is in the beacon example: the ground
             station shows the same panel, so that it says whether the
             vehicle is alive before anybody presses Ping. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:7510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:7500</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:7300</dest_base>
            <source_base>127.0.0.1:7310</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:7410</dest_base>
            <source_base>0.0.0.0:7400</source_base>
        </payload_telemetry>
        <!-- tcspecial keeps in this file which configuration the next start is
             to run, the last one the ground confirmed, and how many starts of
             it have ended before a matching CONNECT, so on a vehicle it must be
             on storage that survives a power cycle. -->
        <state_file>/tmp/tcspecial-ping.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:7200</recv>
            <send>127.0.0.1:7210</send>
        </tcs_cmd>
    </tcspecial>
    <include name="ping-common" path="../ping-common/ping"/>
    <gateways>
        <type name="gateway_radio">
            <!-- The ground's end of the link, both ways. A ping goes up to
                 address:port, which this node binds aboard, and leaves it
                 by moc-out for the ping node. The answer comes back to
                 the ground at ground_base plus the ping node's device id:
                 ping is the second name of the two, device id 1, so 7701. -->
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:7700</ground_base>
                <port>7600</port>
                <moc-out>ping.gateway</moc-out>
                <world-in>ping</world-in>
            </gateway>
        </type>
    </gateways>
    <tcs-gui>
        <nodes>
            <node name="ping-common" x="34" y="34"/>
            <node name="gateway" x="469" y="34"/>
        </nodes>
    </tcs-gui>
</configuration>
