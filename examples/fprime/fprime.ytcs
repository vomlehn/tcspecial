# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "Answering to an F´ flight computer: a reading, and the
  temperature made of it, to its bridge component, and a command from it to
  a heater"

tcspecial:
  # Every port is in the nine thousands, which no other example uses, so this
  # one can be left running while another is looked at.
  #
  # The vehicle answers to an F´ flight computer rather than to the ground.
  # Its links are the radio's -- UDP, in the radio's protocol -- because the
  # far end of each is the F´ deployment's TcsBridge component, which is a
  # ground station built on tcslib-c as far as tcspecial can tell.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:9510"
    reset_interval: "1 s"
    send: "0.0.0.0:9500"
  gateway: "fprime"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:9300"
    source_base: "127.0.0.1:9310"
  payload_telemetry:
    dest_base: "127.0.0.1:9410"
    source_base: "0.0.0.0:9400"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-fprime.state"
  tcs_cmd:
    recv: "0.0.0.0:9200"
    send: "127.0.0.1:9210"

gateway:
  # The F´ bridge's end of the link, both ways. What the bridge sends goes up
  # to address:port, which this node binds aboard, and leaves it by gateway-out
  # for the heater. What comes down arrives at bridge_base plus the device id
  # of the node that sent it, and the bridge gives it the F´ ID
  # fprime_id_base plus that same id: the thermometer, device id 2, arrives
  # at 127.0.0.1:9702 as 0x3002, and cabin_temp, device id 3, at
  # 127.0.0.1:9703 as 0x3003.
  - name: fsw
    type: gateway_fprime
    address: "127.0.0.1"
    port: "9600"
    bridge_base: "127.0.0.1:9700"
    fprime_id_base: "0x3000"
    payload-in: true
    gateway-out:
      - target: heater

payloads:
  # A heater, driven by what the flight computer sends -- 1 for on, 0 for
  # off -- the far end of a UDP socket.
  - name: heater
    type: network
    protocol: "udp"
    address: "127.0.0.1"
    port: "9001"
    gateway-in: true
  # A thermometer, two bytes, signed, big endian, in sixteenths of a degree,
  # whose readings go to the flight computer as they are, and to cabin_temp
  # to be made a temperature.
  - name: thermometer
    type: network
    protocol: "udp"
    address: "127.0.0.1"
    port: "9002"
    payload-out:
      - target: fsw
      - target: cabin_temp

# After the payloads, so that the thermometer keeps device id 2: a node's
# device id is its place in the file.
vehicle:
  # The thermometer's readings made a value, a temperature in kelvin, which
  # the bridge's channel for it holds as one.
  - name: cabin_temp
    type: compute
    format: "i16_be"
    function: "to_kelvin"
    offset: "273.15"
    scale: "0.0625"
    payload-in: true
    payload-out:
      - target: fsw

tcsgui:
  nodes:
    - { name: fsw, x: 469, y: 34 }
    - { name: heater, x: 34, y: 34 }
    - { name: thermometer, x: 34, y: 134 }
    - { name: cabin_temp, x: 242, y: 134 }
