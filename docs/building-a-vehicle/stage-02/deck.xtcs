<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../tcsprotocol/schema/tcspecial.xsd">
    <!-- Stage 2 of "Building a Vehicle" (docs/building-a-vehicle.rst): a
         second payload, the regolith thermometer, on a serial line.
         Nothing is drawn from either payload, so each reports to the
         ground over payload_telemetry, on a port of its own. -->

    <description>A lunar lander's science deck</description>
    <tcspecial>
        <!-- tcspecial sends beacons from the interface the send attribute
             names, and the MOC receives them on the address the recv
             attribute names. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <!-- Commands to a node are sent from source_base to tcspecial at
             dest_base: one link for every node, each command naming its node by
             its device id, and its answer going back to source_base.

             Simple payloads, such as these, do not use payload commands:
             what a simple payload is configured with is in this file, and
             it is not changed while tcspecial is running. At present only
             applications use the payload_command values. -->
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <!-- tcspecial sends telemetry from the network interface
             source_base names, plus the payload's device id, and the MOC
             receives it on the network interface dest_base names, plus the
             payload's device id. -->
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial keeps in this file which configuration the next start is
             to run, the last one the ground confirmed, and how many starts of
             it have ended before a matching CONNECT, so on a vehicle it must be
             on storage that survives a power cycle. Each stage of the guide has
             a file of its own, so that one stage's starts are not counted as
             another's. -->
        <state_file>/tmp/tcspecial-deck-stage-02.state</state_file>
        <!-- Commands to tcspecial are sent from the MOC's address,
             tcs_cmd.send, to tcspecial at tcs_cmd.recv, and tcspecial
             sends its responses back to tcs_cmd.send. -->
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <payloads>
        <type name="network">
            <!-- The seismometer: software on the deck's science computer
                 that sends each reading over UDP of its own accord, so
                 nothing here says when to read it. No line is drawn from
                 it, so tcspecial sends what it reads to the ground over
                 the tcspecial section's payload_telemetry: from
                 source_base plus the seismometer's device id to dest_base
                 plus the same id. A device id is a node's place among the
                 names of all the nodes, sorted, counting from nought.
                 regolith_thermometer sorts before seismometer, so adding
                 it made the seismometer 1, and the ground now hears it on
                 127.0.0.1:6101 where in stage 1 it heard it on 6100. -->
            <payload name="seismometer">
                <address>127.0.0.1</address>
                <port>5401</port>
                <protocol>udp</protocol>
            </payload>
        </type>
        <type name="serial">
            <!-- The regolith thermometer: a probe pushed into the ground
                 beside the lander, on a serial line. Asked for its
                 temperature with T?, it answers two bytes, signed, most
                 significant first, in sixteenths of a degree Celsius. It
                 is asked once a second, by its own trigger_interval. It is
                 device 0, the first name sorted, so the ground hears it on
                 127.0.0.1:6100. -->
            <payload name="regolith_thermometer">
                <byte_length>8</byte_length>
                <datarate>9600</datarate>
                <max_length>2</max_length>
                <path>/tmp/tcs-deck-regolith</path>
                <read_timeout>none</read_timeout>
                <stop_bits>1</stop_bits>
                <trigger>"T?\r"</trigger>
                <trigger_interval>1 s</trigger_interval>
                <world-out-type>i16</world-out-type>
            </payload>
        </type>
    </payloads>
    <tcs-gui>
        <nodes>
            <node name="regolith_thermometer" x="34" y="129"/>
            <node name="seismometer" x="34" y="34"/>
        </nodes>
    </tcs-gui>
</configuration>
