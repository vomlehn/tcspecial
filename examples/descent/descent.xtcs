<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcslibgs/schema/tcspecial.xsd">
    <description>A lander's terminal descent: a radar altimeter's altitude flown down by a guidance program throttling the engine, a Doppler velocimeter for the ground, and a switch that says when it is down</description>
    <tcspecial>
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-descent.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:5100</ground_base>
                <port>5000</port>
                <world-in>altitude</world-in>
                <world-in>descent_rate</world-in>
                <world-in>guidance</world-in>
                <world-in>touchdown</world-in>
            </gateway>
        </type>
    </gateways>
    <vehicle>
        <type name="compute">
            <!-- The radar's two bytes are centimetres, unsigned, most
                 significant first: up to 655 metres, which is above where
                 the descent starts. -->
            <compute name="altitude">
                <function>to_value</function>
                <offset>0</offset>
                <scale>0.01</scale>
                <type-in>u16</type-in>
                <type-out>metre</type-out>
                <world-out>gateway.altitude</world-out>
                <world-out>guidance.altitude</world-out>
                <world-in>radar</world-in>
            </compute>
            <!-- The velocimeter's two bytes are centimetres a second,
                 signed: up is more than nought, so a descent is less. -->
            <compute name="descent_rate">
                <function>to_value</function>
                <offset>0</offset>
                <scale>0.01</scale>
                <type-in>i16</type-in>
                <type-out>metre_per_second</type-out>
                <world-out>gateway.descent_rate</world-out>
                <world-in>doppler</world-in>
            </compute>
            <!-- The throttle, from the altitude: a program, flying a
                 descent that slows as the ground nears and cutting the
                 engine half a metre up. A Python 3 script beside this file,
                 named relative to the repository's root because that is
                 where tcspecial is run from. Its answers are a ratio, which
                 is what the engine's throttle takes. -->
            <compute name="guidance">
                <executable>examples/descent/guidance.py</executable>
                <function>process</function>
                <timeout>1 s</timeout>
                <type-in>metre</type-in>
                <type-out>ratio</type-out>
                <moc-out>engine.guidance</moc-out>
                <world-out>gateway.guidance</world-out>
                <world-in>altitude</world-in>
            </compute>
        </type>
    </vehicle>
    <payloads>
        <type name="network">
            <!-- The Doppler velocimeter, five a second. -->
            <payload name="doppler">
                <address>127.0.0.1</address>
                <port>5402</port>
                <protocol>udp</protocol>
                <world-out-type>i16</world-out-type>
                <world-out>descent_rate.doppler</world-out>
            </payload>
            <!-- The engine's throttle, driven by what guidance answers. -->
            <payload name="engine">
                <address>127.0.0.1</address>
                <moc-in-type>ratio</moc-in-type>
                <port>5404</port>
                <protocol>udp</protocol>
                <moc-in>guidance</moc-in>
            </payload>
            <!-- The radar altimeter, which sends ten readings a second. -->
            <payload name="radar">
                <address>127.0.0.1</address>
                <port>5401</port>
                <protocol>udp</protocol>
                <world-out-type>u16</world-out-type>
                <world-out>altitude.radar</world-out>
            </payload>
            <!-- The switch on a landing leg, whose 1 is the ground's word
                 that the lander is down: straight to the ground. -->
            <payload name="touchdown">
                <address>127.0.0.1</address>
                <port>5403</port>
                <protocol>udp</protocol>
                <world-out>gateway.touchdown</world-out>
            </payload>
        </type>
    </payloads>
</configuration>
