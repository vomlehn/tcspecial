{
    "version": "1.0",
    "description": "Two data handlers, one of each endpoint kind",
    "tcspecial": {
        "address": "0.0.0.0",
        "port": 4000,
        "protocol": "udp",
        "beacon_interval_ms": 5000,
        "log_dir": "/var/log/tcspecial",
        "log_segment_bytes": 65536
    },
    "payload_groups": [
        {
            "name": "udp_localhost",
            "type": "network",
            "protocol": "udp",
            "address": "localhost",
            "packet_size": 12
        }
    ],
    "payloads": [
        {
            "dh_id": 0,
            "name": "DH0",
            "group": "udp_localhost",
            "port": 5000
        },
        {
            "dh_id": 1,
            "name": "DH1",
            "type": "device",
            "path": "/dev/ttyS0",
            "packet_size": 64
        }
    ]
}
