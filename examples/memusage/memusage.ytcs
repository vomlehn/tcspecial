# yaml-language-server: $schema=../../tcsprotocol/schema/tcspecial.schema.json

description: "How much memory tcspecial has, and each thread's stack, in Yamcs"

tcspecial:
  # A vehicle to watch the memory of: a gateway node and three ping nodes,
  # each a thread of its own, answering to Yamcs. memusage.py asks it
  # QUERY_THREADS through Yamcs: the memory the whole process has, and how
  # deep each thread has been into its stack.
  #
  # Every port is in the eighteen thousands, which no other example uses,
  # and it keeps no log, so it can run beside another example -- ping-yamcs
  # among them, which memusage.py can watch in the same Yamcs: tcs-conflict
  # says the two can run at once.
  beacon:
    apid: "0x100"
    default_interval: "5 s"
    recv: "127.0.0.1:18510"
    reset_interval: "1 s"
    send: "0.0.0.0:18500"
  gateway: "yamcs"
  interface: "b03f49878bcc9c45e7b854c7da1bce47"
  max_consolidator_inputs: "32"
  # Yamcs sends QUERY_THREADS, on this link, from a port the system
  # chooses, as it sends its other commands: so they are taken from any port
  # of this host -- port 0 -- and each answer goes back to the port its
  # command came from.
  payload_command:
    dest_base: "0.0.0.0:18300"
    source_base: "127.0.0.1:0"
  # A payload nothing in the drawing touches would report to dest_base plus
  # its device id, as telemetry of APID apid_base plus that device id. This
  # vehicle has none, but a configuration that answers to Yamcs says where
  # their APIDs would begin all the same.
  payload_telemetry:
    apid_base: "0x300"
    dest_base: "127.0.0.1:18410"
    source_base: "0.0.0.0:18400"
  # tcspecial keeps in this file its configuration stack and how many
  # starts of the top have ended before a matching CONNECT, so on a vehicle
  # it must be on storage that survives a power cycle.
  state_file: "/tmp/tcspecial-memusage.state"
  # Yamcs sends its commands from a port the system chooses, and takes the
  # answers on the same socket, so the commands are taken from any port of
  # this host -- port 0 -- and each answer goes back to the port its command
  # came from.
  tcs_cmd:
    apid: "0x101"
    recv: "0.0.0.0:18200"
    send: "127.0.0.1:0"

gateways:
  - type gateway_yamcs:
      # Yamcs's end of the link to the ping nodes, both ways. Nothing pings
      # them here: they are three threads with stacks to measure, and what
      # the example shows is those stacks. Each answers to Yamcs at
      # ground_base plus its device id -- gateway is 0, and ping1, ping2 and
      # ping3 are 1, 2 and 3 -- as telemetry of APID apid_base plus that id.
      - gateway: gateway
        address: "127.0.0.1:18600"
        apid_base: "0x200"
        ground_base: "127.0.0.1:18700"
        moc-out:
          - ping1.gateway
          - ping2.gateway
          - ping3.gateway
        world-in: [ping1, ping2, ping3]

vehicle:
  - type ping:
      - compute: ping1
        world-out:
          - gateway.ping1
        moc-in: [gateway]
      - compute: ping2
        world-out:
          - gateway.ping2
        moc-in: [gateway]
      - compute: ping3
        world-out:
          - gateway.ping3
        moc-in: [gateway]

tcs-cfge:
  nodes:
    - { node: gateway, x: 34, y: 34 }
    - { node: ping1, x: 469, y: 34 }
    - { node: ping2, x: 469, y: 200 }
    - { node: ping3, x: 469, y: 366 }
