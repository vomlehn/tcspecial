#!/bin/bash
#
# Remove the IIO stand-in bin/mkiio makes.
#
# The cleanup half of bin/mkiio, which calls this rather than carrying a copy,
# as each of the other three pairs does: remaking a stand-in means removing the
# old one first, and removing it is also worth doing on its own -- after a run,
# or before leaving a host the way it was found.
#
# A dummy sensor is one device of a module that may hold others, so the sensor
# goes by name and the module stays unless nothing is left for it to hold.
# bin/rmi2c cannot be so careful: there, the module is the adapter.
#
# Note this takes the buffer out from under anything reading it. A tcspecial
# polling that node sees it end, so do not run this while one is up.

set -euo pipefail

# The same names bin/mkiio makes, because only what it made is this script's
# to remove. A host's own sensors sit in the same numbering and are not ours.
iio_device="tcssim"
iio_trigger="tcssim-hr"

configfs="/sys/kernel/config"
iio_devices="$configfs/iio/devices/dummy"
iio_triggers="$configfs/iio/triggers/hrtimer"

if [ "$(id -u)" -ne 0 ]; then
	echo "rmiio: re-running under sudo, which is what unloading a module needs"
	exec sudo -- "$0" "$@"
fi

# Stop the buffer before taking the device, so that a reader holding the node
# sees it end rather than having it pulled away mid-sample.
#
# By name again: the one this removes is the one bin/mkiio named.
for dir in /sys/bus/iio/devices/iio:device*; do
	[ -r "$dir/name" ] || continue
	[ "$(cat "$dir/name")" = "$iio_device" ] || continue
	for buffer in "$dir/buffer0/enable" "$dir/buffer/enable"; do
		if [ -w "$buffer" ]; then
			echo 0 > "$buffer"
			break
		fi
	done
done

if [ -d "$iio_devices/$iio_device" ]; then
	echo "rmiio: removing the dummy IIO sensor"
	rmdir "$iio_devices/$iio_device"
else
	echo "rmiio: no dummy IIO sensor of ours to remove"
fi

if [ -d "$iio_triggers/$iio_trigger" ]; then
	echo "rmiio: removing the software trigger"
	rmdir "$iio_triggers/$iio_trigger"
fi

# Unload only what now holds nothing, and leave industrialio-configfs and
# industrialio alone whatever happens. Those two are how every real sensor on
# the host is reached, and this script's business is its own sensor and not the
# subsystem.
if [ -d /sys/module/iio_dummy ] && [ -z "$(ls -A "$iio_devices" 2>/dev/null)" ]; then
	echo "rmiio: unloading iio_dummy, which now holds no sensors"
	modprobe -r iio_dummy || echo "rmiio: iio_dummy is in use, so it stays loaded"
fi
if [ -d /sys/module/iio_trig_hrtimer ] && [ -z "$(ls -A "$iio_triggers" 2>/dev/null)" ]; then
	echo "rmiio: unloading iio-trig-hrtimer, which now holds no triggers"
	modprobe -r iio-trig-hrtimer || echo "rmiio: iio-trig-hrtimer is in use, so it stays loaded"
fi

echo "rmiio: done"
