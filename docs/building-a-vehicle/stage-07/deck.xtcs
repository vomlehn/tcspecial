<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../tcslib-protocol/schema/tcspecial.xsd">
    <!-- Stage 7 of "Building a Vehicle" (docs/building-a-vehicle.rst): the
         vehicle of stage 6, split into files. Each subsystem is a file of
         its own in ../common, included here as a subdiagram, and this file
         keeps what is the vehicle's as a whole: the tcspecial section and
         the gateway node, which the subsystems' links name. Every node,
         link and device id is what stage 6 had. -->

    <description>A lunar lander's science deck</description>
    <tcspecial>
        <!-- tcspecial sends beacons from the interface the send attribute
             names, and the MOC receives them on the address the recv
             attribute names.

             default_interval is how often a beacon goes while all is well:
             how long the ground may wait to learn the vehicle is alive,
             paid for with a beacon's few dozen bytes on the link each
             time. reset_interval is how often one goes after a start,
             until the ground has connected, so that a restart is seen
             quickly. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <!-- Commands to a node are sent from source_base to tcspecial at
             dest_base: one link for every node, each command naming its node by
             its device id, and its answer going back to source_base.

             Simple payloads, such as these, do not use payload commands:
             what a simple payload is configured with is in this file, and
             it is not changed while tcspecial is running. At present only
             applications use the payload_command values. -->
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <!-- tcspecial sends telemetry from the network interface
             source_base names, plus the payload's device id, and the MOC
             receives it on the network interface dest_base names, plus the
             payload's device id. -->
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial keeps in this file which configuration the next start is
             to run, the last one the ground confirmed, and how many starts of
             it have ended before a matching CONNECT, so on a vehicle it must be
             on storage that survives a power cycle. Each stage of the guide has
             a file of its own, so that one stage's starts are not counted as
             another's. -->
        <state_file>/tmp/tcspecial-deck-stage-07.state</state_file>
        <!-- Commands to tcspecial are sent from the MOC's address,
             tcs_cmd.send, to tcspecial at tcs_cmd.recv, and tcspecial
             sends its responses back to tcs_cmd.send. -->
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <!-- Each path is the file's from this file's directory, without its
         extension; the file is read in this file's spelling. Nothing in a
         path is expanded, so a path is written as it is. -->
    <include name="science" path="../common/science"/>
    <include name="thermal" path="../common/thermal"/>
    <gateways>
        <type name="gateway_radio">
            <!-- The ground's end of the vehicle's data. tcspecial sends
                 what each node drawn into it produces to ground_base's
                 address, at its port plus that node's device id, so each
                 source arrives on a port of its own: hull_temp, id 4, on
                 127.0.0.1:5104, and the seismometer, id 12, on 5112. What
                 the ground sends up arrives at address and port, which the
                 ground's setpoint command needs. -->
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:5100</ground_base>
                <port>5000</port>
                <world-in>hull_kelvin_1</world-in>
                <world-in>hull_kelvin_2</world-in>
                <world-in>hull_kelvin_3</world-in>
                <world-in>hull_temp</world-in>
                <world-in>probe_heater</world-in>
                <world-in>regolith_kelvin</world-in>
                <world-in>seismometer</world-in>
            </gateway>
        </type>
    </gateways>
    <tcs-gui>
        <nodes>
            <node name="gateway" x="790" y="34"/>
            <node name="science" x="299" y="53"/>
            <node name="thermal" x="299" y="336"/>
        </nodes>
    </tcs-gui>
</configuration>
