<?xml version="1.0" encoding="UTF-8"?>
<!-- Equivalent to tcspecial.yaml. Both must deserialize into an identical
     PayloadConfig; tests/format_equivalence.rs enforces it.

     Conventions this file must follow, which are what XML and YAML agree
     on, a payload configuration being writable in either:
       - every value is a child element, never an attribute
       - a sequence is repeated sibling elements named for the field
         (<payloads> here), and the repeats must be contiguous
       - an absent optional field is simply an omitted element -->
<payload>
    <version>1.0</version>
    <description>Two data handlers, one of each endpoint kind</description>
    <tcspecial>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
        <payload_command>
            <source_base>127.0.0.1:4300</source_base>
            <dest_base>0.0.0.0:4200</dest_base>
        </payload_command>
        <payload_telemetry>
            <source_base>0.0.0.0:6000</source_base>
            <dest_base>127.0.0.1:6100</dest_base>
        </payload_telemetry>
        <beacon>
            <interval>5 s</interval>
            <send>0.0.0.0:6550</send>
            <recv>127.0.0.1:6650</recv>
        </beacon>
        <log>
            <directory>/var/log/tcspecial</directory>
            <segment_size>65536</segment_size>
        </log>
    </tcspecial>
    <payload_groups>
        <name>udp_localhost</name>
        <type>network</type>
        <protocol>udp</protocol>
        <packet_size>12</packet_size>
    </payload_groups>
    <payloads>
        <name>udp-grouped</name>
        <group>udp_localhost</group>
        <payload_interface>localhost:5000</payload_interface>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
    <payloads>
        <name>device-alone</name>
        <type>device-file</type>
        <path>/dev/ttyS0</path>
        <packet_size>64</packet_size>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
</payload>
