// The beacon panel: a light, when the last beacon arrived, and what it said.
//
// Shared markup rather than a copy in each window. Two programs show it --
// tcsmoc, beside its command link, and the `beacon` example, which shows this
// and nothing else -- and an operator who has read one has read the other:
// a light in a different place or a label in different words would be two
// things to learn about one spacecraft.
//
// Imported by path, which is what Slint resolves relative to the importing
// file:
//
//     import { BeaconPanel } from "../../tcsui/ui/beacon.slint";
//
// Nothing is computed here. What colour the light is and what the two lines
// say are worked out in Rust, from what `tcslib::beacon` reports, and set as
// properties: see the crate's `shown`.

import { Fonts } from "fonts.slint";
import { TitledBox } from "titled.slint";

export component BeaconPanel inherits TitledBox {
    // The light's colour, which says how stale the last beacon is. Grey
    // before any has arrived and never after: once one has, the dark half of
    // a blink is white. See `tcsui::indicator`.
    in property <color> indicator-color: #c0c0c0;
    // When the last beacon arrived, as a time of day, and the placeholder
    // until one has.
    in property <string> last-received: "--:--:--";
    // What that beacon said: the build flying, the version of the
    // configuration it is serving, and the digest of the files it read.
    in property <string> last-message: "<none>";

    // Titled and boxed, because this is not part of whatever sits beside it:
    // the beacon has a socket of its own and keeps arriving after a
    // disconnect, which is a window worth being able to read rather than one
    // to be puzzled by. The title says what the box is, so the rows need not.
    title: "Beacon";

    GridLayout {
        spacing-horizontal: 12px;
        spacing-vertical: 4px;

        Row {
            Text { text: "Status:"; vertical-alignment: center; }
            // Sized from the type rather than in pixels, so that the light
            // stands as tall as the line beside it at any type size.
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: Fonts.window * 1.5;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: indicator-color;
                    border-color: #808080;
                    border-width: 1px;
                }
            }
        }

        Row {
            Text { text: "Last rcvd:"; vertical-alignment: center; }
            Text { text: last-received; vertical-alignment: center; }
        }

        // What that beacon said, under when it arrived: the two read as one
        // message, received then and saying this.
        Row {
            Text { text: "Last msg:"; vertical-alignment: center; }
            // Wrapped at its spaces where the box is narrower than the line,
            // as it is beside tcsmoc's command link: the digest goes to a
            // line of its own rather than off the edge of the window.
            Text {
                text: last-message;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
