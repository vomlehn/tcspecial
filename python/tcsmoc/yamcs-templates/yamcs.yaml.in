# Yamcs's server configuration for a tcspecial example: an instance for each
# tcspecial, and the web interface and REST API on $http_port. Written by
# $writer from python/tcsmoc/yamcs-templates/yamcs.yaml.in; the names after
# a dollar sign are filled in from the tcspecial configurations and the run
# directory.
services:
  - class: org.yamcs.http.HttpServer
    args:
      port: $http_port
instances:
$instances
dataDir: $data_dir
