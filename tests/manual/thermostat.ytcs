# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json


tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/var/log/tcspecial"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  state_file: "/tmp/tcspecial-thermostat.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

payload_groups:
  - name: "zone_temps"
    interval: "100 ms"

gateways:
  - type gateway_radio:
      - gateway: gateway
        address: "10.0.0.1"
        ground_base: "10.0.0.2:5100"
        port: "5000"
        world-in: [ambient, temp1, temp2, temp3, thermostat]

vehicle:
  - type compute:
      # One temperature out of the three, by the algorithm named:
      # median takes the middle reading, closest_mean the mean of
      # the two that agree best. Either leaves a sensor that has
      # gone wrong out of the answer, which a mean over all three
      # would not, and it produces a value on every arrival, so one
      # sensor that stops reporting is outvoted rather than
      # stopping the vehicle from deciding anything.
      - compute: ambient
        algorithm: "median"
        function: "vote"
        world-out:
          - gateway.ambient
          - thermostat.ambient
        world-in: [in0, in1, in2]
      - compute: temp1
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        world-out:
          - ambient.in0
          - gateway.temp1
          - housekeeping.temp1
        world-in: [temp_1]
      - compute: temp2
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        world-out:
          - ambient.in1
          - gateway.temp2
          - housekeeping.temp2
        world-in: [temp_2]
      - compute: temp3
        format: "u24_be"
        function: "to_kelvin"
        offset: "255.37"
        scale: "0.0078"
        world-out:
          - ambient.in2
          - gateway.temp3
          - housekeeping.temp3
        world-in: [temp_3]
      # setpoint is set from the ground; half_band is how far
      # either side of it the heaters are switched at, the setpoint
      # being in the middle of the band.
      - compute: thermostat
        function: "thermostat"
        half_band: "2.0"
        setpoint: "293.15"
        # asserted below the setpoint, unasserted above it. Two
        # heaters, because one failing must not leave the mass
        # with no way to be warmed: either alone holds the band
        # while the orbit is warm, and both together hold it in
        # the cold too.
        moc-out:
          - heaters_1.thermostat
          - heaters_2.thermostat
        world-out:
          - gateway.thermostat
          - housekeeping.thermostat
        world-in: [ambient]
  - type log:
      - compute: housekeeping
        directory: "/var/log/tcspecial"
        format: "variable_ts_rc"
        world-in: [temp1, temp2, temp3, thermostat]

payloads:
  - type gpio_out:
      # Two heaters, each three circuits driven together, both near
      # the sensors on the same thermal mass. Separate nodes rather
      # than six lines on one, so that one can be stopped from the
      # ground while the other goes on warming the mass.
      - payload: heaters_1
        lines: "3,4,5"
        path: "/dev/gpiochip0"
        moc-in: [thermostat]
      - payload: heaters_2
        lines: "6,7,8"
        path: "/dev/gpiochip0"
        moc-in: [thermostat]
  - type i2c:
      # One of three sensors of the same place, a trio, so that the
      # temperature survives one of them going wrong. Two bytes,
      # signed, big endian.
      - payload: temp_1
        address: "0x48"
        group: "zone_temps"
        path: "/dev/i2c-1"
        read_size: "2"
        world-out:
          - temp1.temp_1
      # The second of the trio; the same part as temp_1, on the
      # same bus.
      - payload: temp_2
        address: "0x49"
        group: "zone_temps"
        path: "/dev/i2c-1"
        read_size: "2"
        world-out:
          - temp2.temp_2
  - type spi:
      # The third. A different part on a different bus: three
      # bytes, unsigned, its own scale and so its own conversion,
      # so that no one bus and no one part number can take the
      # whole trio out.
      - payload: temp_3
        group: "zone_temps"
        max_speed: "1000000"
        path: "/dev/spidev0.0"
        read_size: "3"
        spi_mode: "0"
        world-out:
          - temp3.temp_3

commands:
  # the zone temperature the heaters are held at, in kelvin
  - { from: gateway, sets: thermostat.setpoint }

tcsgui:
  nodes:
    - { node: ambient, x: 469, y: 166 }
    - { node: gateway, x: 790, y: 34 }
    - { node: heaters_1, x: 34, y: 393 }
    - { node: heaters_2, x: 34, y: 470 }
    - { node: housekeeping, x: 469, y: 374 }
    - { node: temp1, x: 242, y: 34 }
    - { node: temp2, x: 242, y: 166 }
    - { node: temp3, x: 242, y: 280 }
    - { node: temp_1, x: 34, y: 34 }
    - { node: temp_2, x: 34, y: 166 }
    - { node: temp_3, x: 34, y: 280 }
    - { node: thermostat, x: 601, y: 242 }
