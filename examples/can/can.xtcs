<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsprotocol/schema/tcspecial.xsd">
    <description>A payload on a CAN bus: its frames to the ground, and the ground's commands to it as frames</description>
    <tcspecial>
        <!-- Every port is in the thirty-two hundreds to thirty-seven
             hundreds, ending in 00 or 10, which no other example uses, so
             this one can be left running while another is looked at. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:3510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:3500</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:3300</dest_base>
            <source_base>127.0.0.1:3310</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:3410</dest_base>
            <source_base>0.0.0.0:3400</source_base>
        </payload_telemetry>
        <!-- tcspecial keeps in this file which configuration the next start is
             to run, the last one the ground confirmed, and how many starts of
             it have ended before a matching CONNECT, so on a vehicle it must be
             on storage that survives a power cycle. -->
        <state_file>/tmp/tcspecial-can.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:3200</recv>
            <send>127.0.0.1:3210</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <!-- The ground's end of the link, both ways. What the ground
                 sends goes up to address:port, which this node binds
                 aboard, and leaves it by moc-out for the motor's
                 commands. What comes down arrives at ground_base plus the
                 device id of the node that sent it: the motor's status,
                 device id 2, at 127.0.0.1:3702. -->
            <gateway name="moc">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:3700</ground_base>
                <port>3600</port>
                <moc-out>motor_command.moc</moc-out>
                <world-in>motor_status</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <type name="can">
            <!-- Each command the ground sends goes to the motor as one
                 frame, so a command is at most eight bytes, which is all a
                 classic frame carries. -->
            <payload name="motor_command">
                <can_id>0x124</can_id>
                <interface>vcan0</interface>
                <moc-in>moc</moc-in>
            </payload>
            <!-- A motor controller on the CAN bus vcan0, which sends its
                 status in frames carrying the identifier 0x123 and takes
                 commands in frames carrying 0x124: two identifiers, so two
                 payloads, each of whose sockets hears its own identifier
                 and nothing else on the bus. vcan0 is the kernel's virtual
                 bus, which bin/mk-kernel-dummies makes; on a vehicle it
                 is the controller's interface, such as can0.

                 Each status frame goes to the ground as it arrives. -->
            <payload name="motor_status">
                <can_id>0x123</can_id>
                <interface>vcan0</interface>
                <world-out>moc.motor_status</world-out>
            </payload>
        </type>
    </payloads>
    <tcs-gui>
        <nodes>
            <node name="moc" x="469" y="34"/>
            <node name="motor_command" x="34" y="134"/>
            <node name="motor_status" x="34" y="34"/>
        </nodes>
    </tcs-gui>
</configuration>
