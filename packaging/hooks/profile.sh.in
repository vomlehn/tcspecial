# shellcheck shell=sh
# Puts @PREFIX@/bin on the search path, for @PACKAGE@.
#
# Each TCS package installs one of these, named after itself, so that no two
# packages own the same file. They all say the same thing, so each adds the
# directory only if it is not already there: a login shell reads every one of
# them, and the second must change nothing.
case ":${PATH}:" in
*:@PREFIX@/bin:*) ;;
*) PATH="${PATH:+${PATH}:}@PREFIX@/bin"; export PATH ;;
esac
