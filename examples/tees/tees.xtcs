<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <description>Tees and null nodes: a command copied back to the ground, a reading copied aboard, and data dropped</description>
    <tcspecial>
        <!-- Every port is in the eight thousands, which no other example
             uses, so this one can be left running while another is looked
             at. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:8510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:8500</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>55ad11486347bc8efc163e1ba051e577</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:8300</dest_base>
            <source_base>127.0.0.1:8310</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:8410</dest_base>
            <source_base>0.0.0.0:8400</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-tees.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:8200</recv>
            <send>127.0.0.1:8210</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <!-- The ground's end of the link, both ways. What the ground
                 sends goes up to address:port, which this node binds
                 aboard, and leaves it by moc-out for the tee. What
                 comes down arrives at ground_base plus the device id of the
                 node that sent it. -->
            <gateway name="moc">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:8700</ground_base>
                <port>8600</port>
                <moc-out>echo.moc</moc-out>
                <world-in>echo</world-in>
                <world-in>readings</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <type name="network">
            <!-- A heater, driven by what the ground sends: the far end of a UDP
                 socket. -->
            <payload name="heater">
                <address>127.0.0.1</address>
                <port>8001</port>
                <protocol>udp</protocol>
                <moc-in>echo</moc-in>
            </payload>
            <!-- A sensor whose readings go to the ground and are copied -->
            <!-- aboard. -->
            <payload name="sensor">
                <address>127.0.0.1</address>
                <port>8002</port>
                <protocol>udp</protocol>
                <world-out>readings.sensor</world-out>
            </payload>
            <!-- A payload whose data nobody wants yet. -->
            <payload name="spare">
                <address>127.0.0.1</address>
                <port>8003</port>
                <protocol>udp</protocol>
                <world-out>unheard.spare</world-out>
            </payload>
        </type>
    </payloads>
    <vehicle>
        <type name="null-gateway">
            <!-- Takes what arrives from the ground's side and drops it. -->
            <compute name="dropped">
                <moc-in>readings</moc-in>
            </compute>
        </type>
        <type name="null-payload">
            <!-- Takes the spare payload's data and drops it. -->
            <compute name="unheard">
                <world-in>spare</world-in>
            </compute>
        </type>
        <type name="tee-gateway">
            <!-- Each command the ground sends goes on to the heater, as it
                 was going, and back down to the ground as payload data, so
                 that the ground sees what the vehicle was told. A tee has
                 two data sources, so each link names its own. -->
            <compute name="echo">
                <moc-out>heater.echo</moc-out>
                <world-out>moc.echo</world-out>
                <moc-in>moc</moc-in>
            </compute>
        </type>
        <type name="tee-payload">
            <!-- Each reading goes on to the ground, as it was going, and
                 again vehicleward: here to a node that drops it, standing
                 where something aboard that took readings as commands would
                 be. -->
            <compute name="readings">
                <moc-out>dropped.readings</moc-out>
                <world-out>moc.readings</world-out>
                <world-in>sensor</world-in>
            </compute>
        </type>
    </vehicle>
    <tcsgui>
        <nodes>
            <node name="dropped" x="234" y="134"/>
            <node name="echo" x="34" y="34"/>
            <node name="moc" x="469" y="34"/>
            <node name="heater" x="34" y="34"/>
            <node name="readings" x="34" y="134"/>
            <node name="sensor" x="34" y="134"/>
            <node name="spare" x="34" y="234"/>
            <node name="unheard" x="34" y="234"/>
        </nodes>
    </tcsgui>
</configuration>
