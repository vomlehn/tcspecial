# Yamcs's server configuration for a tcspecial example: one instance,
# "$instance", and the web interface and REST API on $http_port. Written by
# $writer from python/tcslib/yamcs-templates/yamcs.yaml.in; the names after
# a dollar sign are filled in from the tcspecial configuration and the run
# directory.
services:
  - class: org.yamcs.http.HttpServer
    args:
      port: $http_port
instances:
  - $instance
dataDir: $data_dir
