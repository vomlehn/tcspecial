<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <description>Answering to an F´ flight computer: a reading, the temperature made of it and what a thermostat would decide of that, to its bridge component, and a command from it to a heater</description>
    <tcspecial>
        <!-- Every port is in the nine thousands, which no other example
             uses, so this one can be left running while another is looked
             at.

             The vehicle answers to an F´ flight computer rather than to the
             ground. Its links are the radio's - UDP, in the radio's protocol
             - because the far end of each is the F´ deployment's TcsBridge
             component, which is a ground station built on tcslib-c as far as
             tcspecial can tell. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:9510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:9500</send>
        </beacon>
        <gateway>fprime</gateway>
        <interface>ad9aac4dd5a6d88dd5e78824ba8a83ac</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:9300</dest_base>
            <source_base>127.0.0.1:9310</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:9410</dest_base>
            <source_base>0.0.0.0:9400</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-fprime.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:9200</recv>
            <send>127.0.0.1:9210</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_fprime">
            <!-- The F´ bridge's end of the link, both ways. What the bridge
                 sends goes up to address:port, which this node binds
                 aboard, and leaves it by moc-out for the heater. What
                 comes down arrives at bridge_base plus the device id of the
                 node that sent it, and the bridge gives it the F´ ID
                 fprime_id_base plus that same id: heater_wanted, device id
                 2, arrives at 127.0.0.1:9702 as 0x3002, the thermometer,
                 device id 3, at 127.0.0.1:9703 as 0x3003, and
                 zone_temp, device id 4, at 127.0.0.1:9704 as 0x3004. -->
            <gateway name="fsw">
                <address>127.0.0.1</address>
                <bridge_base>127.0.0.1:9700</bridge_base>
                <fprime_id_base>0x3000</fprime_id_base>
                <port>9600</port>
                <moc-out>heater.fsw</moc-out>
                <world-in>heater_wanted</world-in>
                <world-in>thermometer</world-in>
                <world-in>zone_temp</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <type name="network">
            <!-- A heater, driven by what the flight computer sends - 1 for
                 on, 0 for off - the far end of a UDP socket. -->
            <payload name="heater">
                <address>127.0.0.1</address>
                <port>9001</port>
                <protocol>udp</protocol>
                <moc-in>fsw</moc-in>
            </payload>
            <!-- A thermometer, two bytes, signed, big endian, in sixteenths
                 of a degree, whose readings go to the flight computer as
                 they are, and to zone_temp to be made a temperature. -->
            <payload name="thermometer">
                <address>127.0.0.1</address>
                <port>9002</port>
                <protocol>udp</protocol>
                <world-out>fsw.thermometer</world-out>
                <world-out>zone_temp.thermometer</world-out>
            </payload>
        </type>
    </payloads>
    <vehicle>
        <type name="compute">
            <!-- What a thermostat would decide of zone_temp - on below
                 283.65 K, off above 284.65 K - which the bridge's channel
                 for it holds as a decision, true for on. Advice and no
                 more: the heater is the flight computer's to drive, and
                 this drives nothing. -->
            <compute name="heater_wanted">
                <function>hysteresis</function>
                <half_band>0.5</half_band>
                <setpoint>284.15</setpoint>
                <world-out>fsw.heater_wanted</world-out>
                <world-in>zone_temp</world-in>
            </compute>
            <!-- The thermometer's readings made a value, a temperature in
                 kelvin, which the bridge's channel for it holds as one. -->
            <compute name="zone_temp">
                <format>i16_be</format>
                <function>to_kelvin</function>
                <offset>273.15</offset>
                <scale>0.0625</scale>
                <world-out>fsw.zone_temp</world-out>
                <world-out>heater_wanted.zone_temp</world-out>
                <world-in>thermometer</world-in>
            </compute>
        </type>
    </vehicle>
    <tcsgui>
        <nodes>
            <node name="fsw" x="469" y="34"/>
            <node name="heater" x="34" y="34"/>
            <node name="heater_wanted" x="242" y="234"/>
            <node name="thermometer" x="34" y="134"/>
            <node name="zone_temp" x="242" y="134"/>
        </nodes>
    </tcsgui>
</configuration>
