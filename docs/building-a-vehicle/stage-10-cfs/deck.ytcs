# yaml-language-server: $schema=../../../tcslib-protocol/schema/tcspecial.schema.json

# Stage 10 of "Building a Vehicle" (docs/building-a-vehicle.rst), answering to
# a cFS flight computer: the deck of stage 9, joined to the computer's software
# bus as a peer of its Software Bus Network. Every link is a message ID on the
# bus rather than an address and port, so the tcspecial section is written
# anew, and the gateway node is a gateway_cfs; the subsystems do not change.
# The node is still called gateway, so their links to it are unchanged.

description: "A lunar lander's science deck"

tcspecial:
  # The vehicle answers to a cFS flight computer rather than to the ground. It
  # is one more peer of the computer's Software Bus Network, over SBN's UDP
  # module, and everything it takes and sends crosses that one link as cFS
  # packets: there is no command socket and no beacon socket. The far end's SBN
  # table must list tcspecial as processor 2 of spacecraft 0x42, at the address
  # and port of sbn.local.
  #
  # default_interval is how often a beacon goes while all is well, and
  # reset_interval how often after a start, until the ground has connected.
  # Each is published as tlm_msgid.
  beacon:
    default_interval: "5 s"
    reset_interval: "1 s"
    tlm_msgid: "0x4201"
  # Copied from the cFS build: its epoch, its time scale, and TAI less UTC.
  cfe_time:
    epoch: "1980-01-01T00:00:00"
    leap_seconds: "37"
    scale: "tai"
  gateway: "cfs"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  # The block of message IDs the mission allotted tcspecial: subsystem 0x42,
  # its telemetry below 0x4280 and its commands from there. Every message ID
  # below is in it.
  msgid_range:
    first: "0x4200"
    last: "0x42FF"
  # Node k's commands are published as 0x4290 plus k, and their answers as
  # 0x4210 plus k: the ground's setpoint for probe_thermostat, device id 10,
  # as 0x429A.
  payload_command:
    cmd_base: "0x4290"
    response_base: "0x4210"
  # A payload nothing in the drawing touches would be published as 0x4220 plus
  # its device id. Every payload here is drawn into the gateway node, so none
  # is, but the base is said all the same.
  payload_telemetry:
    tlm_base: "0x4220"
  # The far end: SBN v7.0.1 on processor 1, listening on SBN's own port. The
  # ident is the hash SBN prints in its start-up event.
  sbn:
    ident: "3b339a5e0f686cef822a5d6ea95004222ab7af33"
    local: "0.0.0.0:8634"
    max_message: "32768"
    peer: "127.0.0.1:2234"
    peer_processor_id: "1"
    processor_id: "2"
    release: "v7.0.1"
    spacecraft_id: "0x42"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle. Each stage of the guide has a file of its own, so
  # that one stage's starts are not counted as another's.
  state_file: "/tmp/tcspecial-deck-stage-10-cfs.state"
  # Commands to tcspecial are published as cmd_msgid, and its answers as
  # response_msgid.
  tcs_cmd:
    cmd_msgid: "0x4280"
    response_msgid: "0x4200"

# Each path is the file's from this file's directory, without its extension;
# the file is read in this file's spelling. Nothing in a path is expanded, so a
# path is written as it is.
include:
  - subdiagram: science
    path: ../common/science-logged
  - subdiagram: thermal
    path: ../common/thermal

gateways:
  - type gateway_cfs:
      # The software bus's end of the link, both ways. What comes down is
      # published as tlm_base plus the device id of the node that sent it: the
      # camera, device id 0, as 0x4240, and hull_temp, device id 5, as 0x4245.
      # The node has no address and no port: it is reached through the peer.
      # A command the bus publishes as cmd_msgid is taken by this node, which
      # the command binding on the setpoint needs.
      - gateway: gateway
        cmd_msgid: "0x4281"
        tlm_base: "0x4240"
        world-in:
          - camera
          - hull_kelvin_1
          - hull_kelvin_2
          - hull_kelvin_3
          - hull_temp
          - probe_heater
          - regolith_kelvin
          - seismometer

payloads:
  # A payload that is a program rather than a device: tcspecial starts it, and
  # it writes its readings to tcspecial over the file interfaces an app node is
  # run with (see tcsapp). It is never asked, so nothing here says when it
  # sends.
  - type app_pl:
      # The camera. ../camera.py stands in for the camera's own software: it
      # sends a small made-up frame every app-payload-arg seconds, so that the
      # stage runs on a desk with no camera. The path is from the repository's
      # root, which is where tcspecial is run from.
      - payload: camera
        app-payload-arg: "10"
        executable: "docs/building-a-vehicle/camera.py"
        world-out:
          - gateway.camera

tcs-gui:
  nodes:
    - { node: camera, x: 34, y: 600 }
    - { node: gateway, x: 790, y: 34 }
    - { node: science, x: 299, y: 53 }
    - { node: thermal, x: 299, y: 336 }
