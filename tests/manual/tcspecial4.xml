<?xml version="1.0" encoding="UTF-8"?>
<!-- TCSpecial payload set 4, one payload of every supported kind, in the
     payload configuration language.

     Equivalent to tcspecial4.yaml. The YAML is the one to read: it carries
     the comments.

     Conventions, which are the subset YAML and XML both agree on:
       - every value is a child element, never an attribute
       - a sequence is repeated sibling elements named for the field,
         and the repeats must be contiguous
       - an absent optional field is simply an omitted element
       - a nested section is a child element, as <stream> is here -->
<payload>
    <version>1.0</version>
    <description>TCSpecial payload set 4</description>
    <tcspecial>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
        <payload_command>
            <source_base>127.0.0.1:4300</source_base>
            <dest_base>0.0.0.0:4200</dest_base>
        </payload_command>
        <payload_telemetry>
            <source_base>0.0.0.0:6000</source_base>
            <dest_base>127.0.0.1:6100</dest_base>
        </payload_telemetry>
        <beacon>
            <interval_ms>5000</interval_ms>
            <send>0.0.0.0:5550</send>
            <recv>127.0.0.1:5650</recv>
        </beacon>
        <log>
            <directory>/var/log/tcspecial</directory>
            <segment_size>65536</segment_size>
        </log>
    </tcspecial>
    <payload_groups>
        <name>payload_line</name>
        <type>serial</type>
        <datarate>115200</datarate>
        <byte_length>8</byte_length>
        <stop_bits>1</stop_bits>
        <parity>none</parity>
        <packet_size>12</packet_size>
        <stream>
            <max_length>12</max_length>
            <timeout>none</timeout>
        </stream>
    </payload_groups>
    <payloads>
        <name>serial-line</name>
        <group>payload_line</group>
        <path>/tmp/tcspecial4-line</path>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
    <payloads>
        <name>udp-steady</name>
        <type>network</type>
        <protocol>udp</protocol>
        <payload_interface>localhost:5400</payload_interface>
        <packet_size>12</packet_size>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
    <payloads>
        <name>random-device</name>
        <type>device-file</type>
        <path>/dev/urandom</path>
        <packet_size>8</packet_size>
        <stale_interval_ms>1000</stale_interval_ms>
    </payloads>
    <payloads>
        <name>bus-device</name>
        <type>i2c</type>
        <path>/tmp/tcspecial4-bus</path>
        <payload_address>0x48</payload_address>
        <packet_size>12</packet_size>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
    <payloads>
        <name>clocked-peripheral</name>
        <type>spi</type>
        <path>/tmp/tcspecial4-spi</path>
        <max_speed>1000000</max_speed>
        <spi_mode>0</spi_mode>
        <packet_size>12</packet_size>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
</payload>
