#!/bin/sh
# tcsx: run one of tcspecial's examples, or list them.
#
#   tcsx [--no-memlock] [--simulate=MODE] [NAME [ARGUMENT...]]
#
# With no NAME it lists the examples, saying what each needs beyond what is
# installed, Yamcs only while YAMCS_HOME does not name it. With one it runs
# it as its make run target in the examples' Makefile does in a checkout:
# most by tcs-moc, which starts tcs-sim and tcspecial on its configuration,
# and the rest by their own ground station, which starts tcspecial itself.
# ARGUMENTs go to that ground station; for memusage, configurations among
# them are watched in place of its own.
#
#   --no-memlock     tcspecial does not lock its memory into RAM, as a desk
#                    whose limit on locked memory is too small needs
#   --simulate=MODE  the simulation mode every program is given: all, the
#                    default, as on a desk with no hardware, some or none
#
# The examples are those tcspecial-examples installs, in
# ../share/examples/tcspecial from the directory tcsx is in, and the
# programs those in its own directory; TCSX_EXAMPLES and TCSX_BIN name
# others, such as a checkout's examples/ and its target/debug. An example
# is run from a directory where examples/ names them -- a checkout's own
# root, where it has one -- since each configuration names the programs it
# runs at their paths from there. /tmp/telemetry, where the examples' logs go, is made afresh
# first, so that what is in it afterwards is that run's alone.
#
# The examples through Yamcs need a Yamcs release unpacked: YAMCS_HOME
# says where. can, gpio and iio need the kernel's dummy devices, which
# tcspecial's bin/mk-kernel-dummies makes as root.

set -eu

# Prints how to call this command.
usage() {
	echo "usage: tcsx [--no-memlock] [--simulate=MODE] [NAME [ARGUMENT...]]"
}

# Says what is wrong and stops.
#
# Arguments:
#   $@  What to say.
die() {
	echo "tcsx: $*" >&2
	exit 1
}

# The examples run by their own ground station rather than by tcs-moc.
OWN_GROUND="simple-app beacon ping ping-yamcs thermostat-yamcs memusage lander"

# The examples whose ground station goes through Yamcs.
YAMCS="ping-yamcs thermostat-yamcs memusage lander"

# The examples of several configurations, each run by a ground station in a
# directory of its own that holds no configuration; and the configurations
# that are their parts, in directories of their own, which are not listed
# or run alone.
SEVERAL="lander"
PARTS="lander-a lander-b"

# The examples whose payloads are the kernel's dummy devices.
KERNEL_DUMMIES="can gpio iio"

# How long simple-app's ground station is given to print its line, several
# times what it takes, so that a vehicle that never answers fails the run
# rather than hanging it.
SIMPLE_APP_WAITS=30

# Says whether a word is in a list.
#
# Arguments:
#   $1  The word.
#   $2  The list, words separated by spaces.
#
# Returns:
#   0 if it is, 1 if not.
among() {
	case " $2 " in
	*" $1 "*) return 0 ;;
	*) return 1 ;;
	esac
}

# Lists the examples, one a line, with what each needs that is not there:
# Yamcs only while YAMCS_HOME does not say where it is.
list() {
	yamcs=
	[ -x "${YAMCS_HOME:-}/bin/yamcsd" ] || yamcs=$YAMCS
	for dir in "$examples"/*/; do
		name=$(basename "$dir")
		! among "$name" "$PARTS" || continue
		[ -f "$dir/$name.ytcs" ] || among "$name" "$SEVERAL" || continue
		if among "$name" "$yamcs"; then
			echo "$name (needs Yamcs: YAMCS_HOME)"
		elif among "$name" "$KERNEL_DUMMIES"; then
			echo "$name (needs the kernel's dummy devices)"
		else
			echo "$name"
		fi
	done
}

here=$(cd "$(dirname "$0")" && pwd)
bin=${TCSX_BIN:-$here}
examples=${TCSX_EXAMPLES:-$here/../share/examples/tcspecial}
memlock=
simulate=all
while [ $# -gt 0 ]; do
	case $1 in
	--no-memlock) memlock=--no-memlock ;;
	--simulate=*) simulate=${1#--simulate=} ;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		usage >&2
		exit 2
		;;
	*) break ;;
	esac
	shift
done
[ -d "$examples" ] || die "no examples in $examples"
[ -d "$bin" ] || die "no programs in $bin"
# Both are named from where tcsx is started, and it runs from elsewhere.
examples=$(cd "$examples" && pwd)
bin=$(cd "$bin" && pwd)
if [ $# -eq 0 ]; then
	list
	exit 0
fi
name=$1
shift
! among "$name" "$PARTS" \
	|| die "$name is one of an example's configurations, not run" \
		"alone: tcsx lists the examples"
[ -f "$examples/$name/$name.ytcs" ] \
	|| { among "$name" "$SEVERAL" && [ -d "$examples/$name" ]; } \
	|| die "no example $name: tcsx lists them"
if among "$name" "$YAMCS"; then
	[ -x "${YAMCS_HOME:-}/bin/yamcsd" ] \
		|| die "$name needs Yamcs: set YAMCS_HOME to the directory" \
			"holding bin/yamcsd"
fi
if ! among "$name" "$OWN_GROUND"; then
	[ $# -eq 0 ] || die "$name is run by tcs-moc, which takes no ARGUMENTs"
fi

# The programs are this tcsx's, first on the path, as the Python ground
# stations look for tcspecial and tcs-verify there.
PATH=$bin:$PATH
export PATH
# A checkout's examples are run from the checkout's root, where examples/
# names them already: a tcs-moc built there starts its children with cargo
# run, which needs the tree -- its Cargo.toml to find them by, and its
# .cargo/config.toml, whose settings a build started from anywhere else
# leaves out. An installed set is run from a directory of tcsx's own, in
# which examples/ is made to name them; $top is that directory, or empty.
top=
root=$(dirname "$examples")
if [ "$(basename "$examples")" = examples ] && [ -f "$root/Cargo.toml" ]; then
	cd "$root"
else
	top=$(mktemp -d)
	trap 'rm -rf "$top"' EXIT
	ln -s "$examples" "$top/examples"
	cd "$top"
fi
rm -rf /tmp/telemetry
mkdir /tmp/telemetry

# $memlock is one word or none, so it is left unquoted throughout.
case $name in
simple-app)
	# The vehicle in the background, and the ground station, which prints
	# the line and stops at its end, in the foreground; then the vehicle
	# is stopped, with the payload program it started.
	# shellcheck disable=SC2086
	"$bin/tcspecial" --quiet --simulate="$simulate" $memlock \
		examples/simple-app/simple-app.ytcs &
	vehicle=$!
	trap 'pkill -P $vehicle || :; kill -INT $vehicle 2> /dev/null || :
		wait $vehicle || :; [ -z "$top" ] || rm -rf "$top"' EXIT
	trap 'exit 130' INT TERM
	timeout "$SIMPLE_APP_WAITS" "$bin/lorem_gateway" "$@"
	;;
beacon)
	# shellcheck disable=SC2086
	"$bin/beacon" $memlock "$@" examples/beacon/beacon.ytcs
	;;
ping)
	# shellcheck disable=SC2086
	python3 examples/ping/ping_gateway.py $memlock "$@" \
		examples/ping/ping.xtcs
	;;
ping-yamcs)
	# shellcheck disable=SC2086
	python3 examples/ping-yamcs/ping_yamcs.py --yamcs "$YAMCS_HOME" \
		$memlock "$@"
	;;
thermostat-yamcs)
	# shellcheck disable=SC2086
	python3 examples/thermostat-yamcs/thermostat_yamcs.py \
		--yamcs "$YAMCS_HOME" $memlock "$@"
	;;
lander)
	# Two tcspecials, each flying one axis, and one tcs-sim, whose
	# window the lander is flown from.
	# shellcheck disable=SC2086
	python3 examples/lander/lander_yamcs.py --yamcs "$YAMCS_HOME" \
		$memlock "$@"
	;;
memusage)
	# Its own configuration, unless the ARGUMENTs name others, each
	# a tcspecial memusage starts and watches.
	mine=examples/memusage/memusage.xtcs
	for argument in "$@"; do
		case $argument in
		*.xtcs | *.ytcs) mine= ;;
		esac
	done
	# shellcheck disable=SC2086
	python3 examples/memusage/memusage.py --yamcs "$YAMCS_HOME" \
		$memlock "$@" $mine
	;;
*)
	# shellcheck disable=SC2086
	"$bin/tcs-moc" --simulate="$simulate" $memlock \
		"examples/$name/$name.ytcs"
	;;
esac
