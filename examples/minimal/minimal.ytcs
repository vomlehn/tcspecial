# yaml-language-server: $schema=../../tcsprotocol/schema/tcspecial.schema.json

description: "One payload, its telemetry going to the ground through a gateway"

tcspecial:
  # tcspecial sends beacons from the interface the send attribute names, and
  # the MOC receives them on the address the recv attribute names.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.27:5650"
    reset_interval: "1 s"
    send: "127.0.0.28:5550"
  gateway: "radio"
  interface: "b03f49878bcc9c45e7b854c7da1bce47"
  log:
    directory: "/tmp/telemetry/minimal"
    segment_size: "65536"
  max_consolidator_inputs: "32"
  # Commands to a node are sent from source_base to tcspecial at dest_base: one
  # link for every node, each command naming its node by its device id, and its
  # answer going back to source_base.
  #
  # Simple payloads, such as this sensor, do not use payload commands: what a
  # simple payload is configured with is in this file, and it is not changed
  # while tcspecial is running. At present only applications use the
  # payload_command values.
  payload_command:
    dest_base: "127.0.0.28:4200"
    source_base: "127.0.0.27:4300"
  # tcspecial sends telemetry from the network interface source_base names,
  # plus the payload's device id, and the MOC receives it on the network
  # interface dest_base names, plus the payload's device id.
  payload_telemetry:
    dest_base: "127.0.0.27:6100"
    source_base: "127.0.0.28:6000"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle.
  state_file: "/tmp/tcspecial-minimal.state"
  # Commands to tcspecial are sent from the MOC's address, tcs_cmd.send, to
  # tcspecial at tcs_cmd.recv, and tcspecial sends its responses back to
  # tcs_cmd.send.
  tcs_cmd:
    recv: "127.0.0.28:4000"
    send: "127.0.0.27:4100"

gateways:
  - type gateway_radio:
      # The ground's end of the link. What comes down arrives at ground_base
      # plus the device id of the node that sent it: the sensor, device id
      # 1, at 127.0.0.27:5101. What the ground sends goes up to address,
      # which this node binds aboard.
      - gateway: ground
        address: "127.0.0.28:5000"
        ground_base: "127.0.0.27:5100"
        world-in: [sensor]

payloads:
  - type network:
      # Software on this host that sends its readings over UDP, each one on
      # to the ground through the gateway. Up to 16 bytes a reading, which is
      # what tcs-sim sends for it: bounded, so that what carries a reading
      # down is sized for it rather than for the largest datum there is.
      - payload: sensor
        address: "127.0.0.28:5001"
        protocol: "udp"
        world-out-type: "bytes(16)"
        world-out:
          - ground.sensor

tcs-cfge:
  nodes:
    - { node: ground, x: 469, y: 34 }
    - { node: sensor, x: 34, y: 34 }
