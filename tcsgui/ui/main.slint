import {
    Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit
} from "std-widgets.slint";
import { Copyable, CopyButton } from "../../tcsverify/ui/copy.slint";
import { Fonts } from "../../tcsui/ui/fonts.slint";
import { Colors } from "../../tcsui/ui/colors.slint";
// How a configuration is drawn, shared with tcspecial's visual window: the
// node shapes, the link lines, the ground they are drawn on, and the globals
// and structs they take. See tcsdiagram. Exported again from here so that this
// program's Rust sees them as its own.
import {
    Session, Space, Type, TerminalView, NodeView, LinkView, NodeShape,
    LinkLine, SheetGround
} from "../../tcsdiagram/ui/diagram.slint";
export { Session, Space, Type, TerminalView, NodeView, LinkView }

// One thing that might be wrong, as the concerns window shows it.
export struct ConcernRow {
    // The sentence: which node, and what about it.
    said: string,
    // The node it is about, which is what "go to it" goes to.
    node: string,
}

// One problem a configuration opened with, and what is offered for it.
export struct ProblemRow {
    // What is wrong, in the words of the fault itself.
    said: string,
    // The node it is about, by name, or empty where not having one is the
    // problem.
    node: string,
    // The name as it stands in the field, for the rows a name can mend.
    now: string,
    // Whether a name is the fix: two nodes sharing one, or a node without
    // one. Those rows get a field and a suggestion; the rest get the buttons
    // alone.
    nameable: bool,
    // Whether there is a node in the document to open or to delete.
    there: bool,
    // The one other thing this kind of problem offers, as the label on its
    // button: deleting a group, deleting a line, opening the parameters.
    // Empty where it offers none.
    action: string,
}

// One row of the palette: a family's heading, or a type to place.
//
// Headings in the list rather than a nested model: Slint's `for` takes one
// model, and a list with a flag in it is simpler to build and to read than a
// model of models.
export struct PaletteEntry {
    heading: string,
    node: NodeView,
    is-heading: bool,
    // What the editor fills in on a node placed from this entry, as
    // `name=value` pairs separated by semicolons.
    //
    // What makes one node type into several things to place: `compute` is one
    // type, and `mean`, `hysteresis`, `to_kelvin` and `process` are four
    // entries, each a compute node with its `function` already answered. The
    // pairs come from the description tree -- see tcsgui/share/nodes -- and
    // travel as text because a callback's arguments do.
    sets: string,
}

// One field of the panel: an attribute of the selected node.
export struct FieldView {
    name: string,
    value: string,
    // What the description tree says about this attribute: one line, shown at
    // the foot of a node's window while its field has the focus. Empty where
    // nothing describes it -- a section parameter, a simulator setting, an
    // attribute this build does not know.
    about: string,
    // Whether the configuration must state this one, which the panel says
    // with a mark beside the name.
    //
    // Said and not insisted on. The editor is lazy: a field left empty is a
    // question not yet answered, and an editor that marked it in red would be
    // calling an unfinished node a broken one. What must be answered before a
    // configuration flies is checked on the ground and aboard, where the
    // complaint can name the file and the line.
    required: bool,
    // A rule across the panel with this name on it, rather than a field.
    //
    // What divides a node's own attributes from the settings the simulator
    // file gives it: two files, one panel, and a line to say where one ends
    // and the other begins.
    is-heading: bool,
    // Whether this field belongs to the simulator's file rather than to the
    // configuration.
    //
    // The panel shows both and they are written to different files, so each
    // row has to say which it is: the two go to different callbacks and are
    // recorded as different edits.
    simulated: bool,
    // What kind of value this one takes, which decides what it is offered
    // with: "boolean" is a control with two states, and everything else is a
    // box to write in.
    //
    // From the description tree -- see `tcsgui::nodes::KINDS`, which is the
    // list of the words -- because what an attribute takes is a property of
    // the node type and is written down beside the node type. An empty kind
    // is text, which is what a field whose description says nothing is and
    // what every simulator setting is for now.
    kind: string,
}

// One attribute a group sets on every payload in it.
//
// Apart from FieldView because the question is different. A node's field is
// filled in or not; a group's field is filled in, not filled in, or filled in
// differently on different payloads -- and the third is worth saying, because
// typing into the field will overwrite all of them.
export struct GroupFieldView {
    name: string,
    value: string,
    differs: bool,
}

// One selection pane: a heading, and one of every node type it offers.
//
// There are two of these -- the vehicle selection pane and the payload
// selection pane -- and they are the same list of the same shapes drawn the
// same way. A component rather than the markup twice, because two copies of a
// list are two places a row's height or a heading's weight gets changed in.
component SelectionPane inherits Rectangle {
    // How large a shape is drawn here, against its size on the canvas. In
    // the markup because it is a property of the list and not of the shape;
    // tcsgui's tests read it from here. See NodeShape's transform below.
    property <float> shrink: 0.75;
    in property <string> heading: "";
    in property <[PaletteEntry]> palette: [];
    // The ground of the working pane these go in, which is what the shapes in
    // this list are coloured against: a reader picking a shape out of a list
    // on a blush ground and putting it on a blush pane has been told where it
    // goes twice, by the colour of the shape and by the colour under it.
    in property <color> ground: #f2f2f0;
    callback place-node(string, string, string);

    background: root.ground;
    border-width: 1px;
    border-color: #d8d8d4;

    ScrollView {
        VerticalLayout {
            padding: Space.step;
            spacing: Space.step;
            Text {
                text: root.heading;
                font-size: Type.body;
                font-weight: Type.bold;
                height: 18px;
            }
            // A row as tall as the shape in it. A fixed height clipped the
            // taller shapes into the row below them, which made a list of
            // fourteen types read as a list of ten and a tangle.
            for p in root.palette: Rectangle {
                height: p.is-heading
                    ? 22px
                    : p.node.height * root.shrink + Space.step;
                background: transparent;

                // A family's heading. Quiet: it is there to group the shapes
                // below it, not to be read first.
                if p.is-heading: Text {
                    x: 0;
                    y: 6px;
                    text: p.heading;
                    font-size: Type.small;
                    font-weight: Type.bold;
                    color: #6b7280;
                }

                // At three quarters of the size it is drawn on the canvas, the
                // whole of it -- outline, terminals and name -- so a list is a
                // list of the shapes rather than a column of the canvas, and
                // more of it is in view at once. Shrunk from its top left
                // corner, which is where the row starts.
                if !p.is-heading: NodeShape {
                    node: p.node;
                    transform-scale: root.shrink;
                    transform-origin: { x: 0px, y: 0px };
                }
                // The whole row, so the hit area is the row and not only the
                // shape: a rounded end's corners are not part of the shape,
                // and a press there should still place one.
                if !p.is-heading: TouchArea {
                    // Nothing placed in a read-only session.
                    enabled: !Session.read-only;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.place-node(p.node.name, p.node.node-type, p.sets);
                    }
                }
            }
            Rectangle { }
        }
    }
}

// One divider between two working panes: the line, its handle, and what a
// press lands on.
//
// A component because there are two of them and they are the same control. The
// line follows the pointer while the handle is held and the divider settles
// when the gesture ends: one change for one gesture, as a node's drag is.
// One line between two selection lists: a handle that reports how far it was
// dragged, downwards.
//
// The horizontal twin of PaneDivider, and the same arrangement for the same
// reason: the grip is a sibling of the line, so its coordinates stay where the
// line was for as long as the gesture lasts.
//
// It reports the whole column's height along with the distance, because what a
// share is depends on what it is a share of, and the arithmetic that turns the
// two into a percentage belongs in Rust where it can be tested: see
// tcsgui::drag_list_divider.
component ListDivider inherits Rectangle {
    callback moved(length, length);

    height: 7px;
    background: transparent;

    Rectangle {
        y: parent.height / 2
            + (grip.pressed ? grip.mouse-y - grip.pressed-y : 0px);
        x: 0;
        width: 100%;
        height: grip.has-hover || grip.pressed ? 2px : 1px;
        background: grip.has-hover || grip.pressed ? #6b7280 : #cbcdd1;

        // The handle: a grooved pill in the middle of the line, so that a line
        // which can be dragged does not look like one which cannot.
        Rectangle {
            x: parent.width / 2 - 20px;
            y: -6px;
            width: 40px;
            height: 13px;
            border-radius: 6px;
            border-width: 1px;
            border-color: grip.has-hover || grip.pressed ? #6b7280 : #b4b7bd;
            background: grip.pressed ? #e8e9eb : white;

            for groove in 3: Rectangle {
                x: 14px + groove * 6px;
                y: 4px;
                width: 1px;
                height: 5px;
                background: #9ca3af;
            }
        }
    }

    grip := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.row-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.moved(self.mouse-y - self.pressed-y, root.parent-height);
            }
        }
    }

    // How tall the column is, which the parent passes in: an element cannot
    // ask its parent's height without the parent saying so.
    in property <length> parent-height: 0px;
}

component PaneDivider inherits Rectangle {
    // Where the divider is, in the window's own coordinates.
    in property <length> at: 0px;
    // How far the handle was dragged, said once when the gesture ends.
    callback moved(length);

    // The grip is a sibling of the line and not a child, so its coordinates
    // stay where the line was for as long as the gesture lasts -- an offset
    // measured in a frame the offset moves cancels itself, which is a mistake
    // this file has made once already.
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    Rectangle {
        x: at + (grip.pressed ? grip.mouse-x - grip.pressed-x : 0px);
        y: 0;
        width: grip.has-hover || grip.pressed ? 2px : 1px;
        height: 100%;
        background: grip.has-hover || grip.pressed ? #6b7280 : #cbcdd1;

        // The handle: a grooved pill halfway down the line. A line that can be
        // dragged and one that cannot look identical without it, and a control
        // nobody can see is a control nobody uses.
        Rectangle {
            x: -6px;
            y: parent.height / 2 - 20px;
            width: 13px;
            height: 40px;
            border-radius: 6px;
            border-width: 1px;
            border-color: grip.has-hover || grip.pressed ? #6b7280 : #b4b7bd;
            background: grip.pressed ? #e8e9eb : white;

            for groove in 3: Rectangle {
                x: 4px;
                y: 14px + groove * 6px;
                width: 5px;
                height: 1px;
                background: #9ca3af;
            }
        }
    }

    // What a press lands on. Wider than the line, because a line a pixel wide
    // is a line nobody can hit; before the nodes in the surface, so that a
    // node held against a divider takes a press on itself rather than losing
    // it to the divider.
    grip := TouchArea {
        x: at - 7px;
        y: 0;
        width: 15px;
        height: 100%;
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.moved(self.mouse-x - self.pressed-x);
            }
        }
    }
}

// The editing surface: a bar, three selection panes and three working panes.
//
// One component because there are two windows that need it -- the top diagram
// and each open subdiagram -- and two copies of a canvas would be two places
// for a drawing rule to be changed in. What differs between the windows is
// only what they are given: a subdiagram's window is handed its own nodes and
// its own name, and is otherwise this.
component Surface inherits Rectangle {
    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    // The line a gesture is drawing, as SVG path data in canvas coordinates,
    // and empty when no gesture is running. Dashed, and in pieces because a
    // path here has no dash pattern: see tcsdiagram::route::drawing.
    in property <string> drawing-route: "";
    // The two selection panes' contents, and the two working panes' geometry.
    //
    // All four come from Rust -- see style.rs and main.rs -- because which
    // types are payloads and where the divider falls are facts about a
    // configuration rather than about a window, and they are checked by tests
    // there. Stating the divider in this file as well would be stating it
    // twice.
    in property <[PaletteEntry]> gateway-palette: [];
    in property <[PaletteEntry]> vehicle-palette: [];
    in property <[PaletteEntry]> payload-palette: [];
    in property <length> payload-divider: 0px;
    in property <length> vehicle-divider: 0px;
    in property <length> working-width: 0px;
    // How long the sheet is, in the coordinates the file holds: one length
    // for all three panes, which is what makes them scroll together. From
    // Rust -- see tcsdiagram::pane::WORKING_HEIGHT -- as the width is.
    in property <length> working-height: 0px;
    // What each pane's own tint is: light, neutral, and the light end of the
    // hue family its own nodes are drawn in, so that a node's colour says which
    // pane it belongs in. It paints two things -- the heading band at the top
    // of that working pane, and the selection pane a node of its is taken from
    // -- and not the working pane itself, which is one sheet with the other
    // two. From Rust -- see tcsdiagram::style::Ground -- for the reason the
    // tints come from there: what a colour means is a rule with tests on it,
    // and this file paints.
    in property <color> gateway-ground: white;
    in property <color> vehicle-ground: white;
    in property <color> payload-ground: white;

    // How deep undo currently goes, shown rather than guessed at: a person
    // about to abandon an afternoon's work deserves to know how much of it is
    // still reachable. One history for the whole configuration, so every
    // window shows the same two numbers.
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    // What went wrong with saving, if anything. The window's one red text.
    // Where the sheet is scrolled to, and how much of it is in view.
    //
    // Two-way, because both ends of it have something to say: a person
    // scrolling moves it, and placing a node sets it so the new node is at the
    // top of the view -- see tcsdiagram::pane::place_in. The offset is the
    // viewport's own, which is negative as it scrolls down; Rust reads it back
    // as the top of the view.
    in-out property <length> canvas-offset: 0px;
    // How much of the sheet the window is showing, which is what decides
    // whether a place is in view.
    out property <length> canvas-view-height: sheet.visible-height;

    // How many concerns there are, and how many were set aside: see the two
    // buttons in the bar.
    in property <int> concern-count: 0;
    in property <int> aside-count: 0;
    callback show-concerns();
    callback show-aside();

    in property <string> trouble: "";
    // And what the last command did, where it did something worth saying:
    // generating the Rust writes a file somebody named and changes nothing
    // else, so silence would leave them wondering whether the menu item did
    // anything. Not red, and in the same place as "saved", that line already
    // meaning "what has just happened".
    in property <string> said: "";
    // What this surface is editing: empty for the top diagram, the
    // subdiagram's name otherwise. Shown in the bar so that two windows side
    // by side cannot be confused for one another.
    in property <string> editing: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string, string, string);
    callback node-moved(string, length, length);
    // One of the two dividers between the three working panes was dragged by
    // this much. Two callbacks and not one with a name in it: which divider
    // moved is known where the gesture happened, and a string crossing the
    // boundary would be a name to keep in step in two files.
    // How the selection column is divided, as the gateway and vehicle lists'
    // shares of it, the payload list taking what is left. From Rust, where the
    // settings file keeps them: see tcsgui::Views::lists.
    in property <int> gateway-list-percent: 20;
    in property <int> vehicle-list-percent: 35;
    // And the two lines between the lists, dragged: how far it went and how
    // tall the whole column is. See tcsgui::drag_list_divider.
    callback payload-list-divider-moved(length, length);
    callback vehicle-list-divider-moved(length, length);
    callback payload-divider-moved(length);
    callback vehicle-divider-moved(length);
    callback open-subdiagram(string);
    // Write every file of the configuration now.
    callback save-clicked();
    // Drawing a link: pressed on one node, released on another.
    callback link-started(string, string);
    callback link-finished(length, length);
    // Where the pointer is while a line is being drawn. See drawing-route.
    callback link-moved(length, length);
    callback node-selected(string);
    // What a node's own menu asks for: see NodeShape's menu.
    callback node-edit(string);
    callback node-delete(string);

    // Which node is drawn as chosen. What it says about itself is in a window
    // of its own -- see NodeWindow -- so this is all the canvas needs.
    in property <string> selected: "";

    background: Colors.window;

    VerticalLayout {
        padding: Space.step;
        spacing: Space.step;

        // The bar: what can be taken back, and anything wrong.
        bar := HorizontalLayout {
            spacing: Space.step;
            min-height: 34px;

            if editing != "": Text {
                text: editing;
                font-size: Type.strong;
                font-weight: Type.bold;
                vertical-alignment: center;
            }
            // The arrow says what the button does and the words say what it
            // will do it to, which is the half worth keeping: "Undo" on a
            // button is a label anybody could have guessed, and `move
            // "payload"` is a thing only this session knows. Colourised, so
            // the icons follow the platform's foreground and go grey with the
            // button when there is nothing to take back.
            Button {
                icon: @image-url("undo.svg");
                colorize-icon: true;
                text: undo-label;
                enabled: undo-depth > 0 && !Session.read-only;
                clicked => { undo-clicked(); }
            }
            Button {
                icon: @image-url("redo.svg");
                colorize-icon: true;
                text: redo-label;
                enabled: redo-depth > 0 && !Session.read-only;
                clicked => { redo-clicked(); }
            }
            // Saving needs no button -- every edit is written as it is made --
            // and there is one anyway. It writes every file of the
            // configuration now, which is what retries a write that failed
            // and what puts right a set of files left half new by a power
            // failure between two of them. It is also an answer to somebody
            // who has been taught by every other program to save their work:
            // "it is already saved" is true and unconvincing.
            //
            // A floppy disk and no word, where undo and redo keep their words:
            // theirs say what they would be undoing, which is a thing only
            // this session knows, and this one would say "Save" beside a mark
            // every program uses for it.
            Button {
                icon: @image-url("save.svg");
                colorize-icon: true;
                accessible-label: "Save";
                enabled: !Session.read-only;
                clicked => { root.save-clicked(); }
            }

            // What might be wrong, and what somebody has decided not to act
            // on. Counted rather than listed here: the list is a window, and
            // a bar that held it would be a bar with a paragraph in it.
            //
            // Two buttons because they are two questions. The first is "is
            // there anything I have not looked at"; the second is "what did I
            // decide to leave", which is worth being able to ask again -- a
            // decision somebody cannot find is a decision they cannot change.
            if concern-count > 0: Button {
                text: concern-count
                    + (concern-count == 1 ? " concern" : " concerns");
                clicked => { root.show-concerns(); }
            }
            if aside-count > 0: Button {
                text: aside-count + " set aside";
                clicked => { root.show-aside(); }
            }

            Text {
                text: undo-depth + " edits can be undone";
                font-size: Type.body;
                vertical-alignment: center;
            }
            // Saving needs no button: every edit is written as it is made.
            // What it needs is somewhere to say when that failed.
            Text {
                text: trouble != "" ? trouble : (said != "" ? said : "saved");
                color: trouble == "" ? #2d6a4f : #c0392b;
                font-size: Type.body;
                font-weight: trouble == "" ? 400 : 700;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Rectangle { }
        }

        HorizontalLayout {
            spacing: Space.step;

            // The three selection panes: one of every node type, drawn as
            // it will be drawn on the canvas, so that what a shape means can
            // be looked up rather than remembered.
            //
            // Three of them because the canvas has three working panes, and a
            // shape's pane is decided by which list it came from: everything
            // the vehicle carries is a payload and goes on the left, the
            // ground link goes on the right, and the rest of the graph goes
            // in between. A single list would leave that rule to be
            // discovered by placing something and watching where it lands.
            //
            // Top to bottom in the order the panes are left to right, so the
            // two readings of the same rule agree.
            // Each list as tall as its own share of the column, with a line
            // between each pair that can be dragged to change the two it is
            // between. A Rectangle and placed children rather than a
            // VerticalLayout: a layout hands out what is left over, where a
            // share is a share of the whole -- and a share of the whole is
            // what somebody chose and what the settings file keeps.
            //
            // Top to bottom in the order the working panes are left to right --
            // payloads, vehicle, gateway -- so the two readings of the same
            // rule agree. The payload list takes what is left, being the
            // longest: ten of the fifteen types are payloads.
            lists := Rectangle {
                width: 180px;
                // What the shares are of. Named so the dividers can report it:
                // see ListDivider.
                property <length> whole: self.height;
                property <length> payload-tall:
                    whole - gateway-tall - vehicle-tall;
                property <length> gateway-tall:
                    whole * root.gateway-list-percent / 100;
                property <length> vehicle-tall:
                    whole * root.vehicle-list-percent / 100;

                SelectionPane {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: lists.payload-tall - 4px;
                    heading: "Payload node types";
                    ground: root.payload-ground;
                    palette: root.payload-palette;
                    place-node(name, t, sets) => {
                        root.place-node(name, t, sets);
                    }
                }
                ListDivider {
                    x: 0;
                    y: lists.payload-tall - 7px;
                    width: 100%;
                    parent-height: lists.whole;
                    moved(dy, tall) => {
                        root.payload-list-divider-moved(dy, tall);
                    }
                }
                SelectionPane {
                    x: 0;
                    y: lists.payload-tall;
                    width: 100%;
                    height: lists.vehicle-tall - 4px;
                    heading: "Vehicle node types";
                    ground: root.vehicle-ground;
                    palette: root.vehicle-palette;
                    place-node(name, t, sets) => {
                        root.place-node(name, t, sets);
                    }
                }
                ListDivider {
                    x: 0;
                    y: lists.payload-tall + lists.vehicle-tall - 7px;
                    width: 100%;
                    parent-height: lists.whole;
                    moved(dy, tall) => {
                        root.vehicle-list-divider-moved(dy, tall);
                    }
                }
                SelectionPane {
                    x: 0;
                    y: lists.payload-tall + lists.vehicle-tall;
                    width: 100%;
                    height: lists.gateway-tall;
                    heading: "Gateway node types";
                    ground: root.gateway-ground;
                    palette: root.gateway-palette;
                    place-node(name, t, sets) => {
                        root.place-node(name, t, sets);
                    }
                }
            }

            // The canvas: one sheet, scrolled.
            //
            // The three working panes are three columns of this one sheet
            // rather than three panes of their own, which is what makes them
            // the same length and makes them scroll together. Three that
            // scrolled separately would put a link's two ends at two heights
            // that have nothing to do with each other, and a diagram whose
            // lines go off the top of one column and in at the middle of
            // another cannot be read.
            //
            // The bars are the ScrollView's own, so the horizontal one sits
            // along the bottom of all three panes and the vertical one down
            // the right of them.
            sheet := ScrollView {
                horizontal-stretch: 1;
                content-width: root.working-width;
                content-height: root.working-height;
                content-y <=> root.canvas-offset;

                // One ground for all three panes, with a heading band at the
                // top of each: the panes are columns of one sheet, so one
                // sheet is what they are painted. Which pane a reader is
                // looking at is said by the band at its head and by the
                // dividers between them, and the tints are kept for the two
                // places they say something -- those bands, and the selection
                // panes a node is taken from.
                canvas := Rectangle {
                    width: root.working-width;
                    height: root.working-height;
                    background: white;
                    border-width: 1px;
                    border-color: #d8d8d4;

                    SheetGround {
                        working-width: root.working-width;
                        payload-divider: root.payload-divider;
                        vehicle-divider: root.vehicle-divider;
                        payload-ground: root.payload-ground;
                        vehicle-ground: root.vehicle-ground;
                        gateway-ground: root.gateway-ground;
                    }


                // An empty canvas looks broken rather than new, so it says
                // which way out.
                if nodes.length == 0: Text {
                    x: Space.room;
                    y: Space.room;
                    text: "Press a node type on the left to place one.";
                    font-size: Type.body;
                    font-italic: true;
                    color: #9ca3af;
                }

                // Links under nodes, so a line never crosses a label.
                for l in links: LinkLine {
                    link: l;
                }
                // And the line being drawn, under them as well: it is a link
                // that is not one yet, and it follows the pointer, so it is
                // redrawn as the hand moves rather than when the document
                // changes.
                if root.drawing-route != "": Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: root.drawing-route;
                    stroke: #6b7280;
                    stroke-width: 1.25px;
                    fill: transparent;
                }
                for n in nodes: NodeShape {
                    node: n;
                    draggable: true;
                    selected: n.name == root.selected;
                    dragged(dx, dy) => { node-moved(n.name, dx, dy); }
                    open-requested => { open-subdiagram(n.name); }
                    link-from(terminal) => { link-started(n.name, terminal); }
                    link-dropped(x, y) => { link-finished(x, y); }
                    link-dragging(x, y) => { link-moved(x, y); }
                    chosen => { node-selected(n.name); }
                    edit-requested => { node-edit(n.name); }
                    delete-requested => { node-delete(n.name); }
                }
                }

                // The two lines between the three working panes, drawn over
                // the sheet rather than on it.
                //
                // Over it because a divider is a property of the panes and not
                // of what is drawn in them: on the sheet, its handle sat
                // halfway down two thousand four hundred pixels and could not
                // be reached, and the line scrolled away from the panes it
                // divides. Here each is as tall as the window shows and its
                // handle is halfway down *that*, wherever the sheet has been
                // scrolled to.
                //
                // Shifted by the sheet's own horizontal offset, so a divider
                // stays over the column it divides when the sheet is scrolled
                // sideways.
                PaneDivider {
                    width: 100%;
                    height: 100%;
                    at: root.payload-divider + sheet.content-x;
                    moved(dx) => { root.payload-divider-moved(dx); }
                }
                PaneDivider {
                    width: 100%;
                    height: 100%;
                    at: root.vehicle-divider + sheet.content-x;
                    moved(dx) => { root.vehicle-divider-moved(dx); }
                }
            }

        }
    }
}

component AlertPanel inherits Rectangle {
    // What the alert says, as a panel: the alert window's whole contents,
    // and the dialog the main window shows over its veil when what went
    // wrong is the file the editor started on. See AlertWindow and
    // MainWindow.
    background: Colors.window;
    min-width: 360px;
    min-height: 140px;
    preferred-width: 460px;

    // What went wrong, in the words the thing that failed used: a path, a
    // reason from the operating system, the attribute a rule refused.
    in property <string> trouble: "";
    // What kind of thing it is, in one line, and what to do about it.
    //
    // Two kinds reach this window and they want different sentences: a command
    // that failed -- a write, a generation -- and something wrong with the
    // configuration itself. Both are errors and neither has thrown anything
    // away, but "press Save" is advice about the first and nonsense about the
    // second.
    in property <string> heading: "Something did not work.";
    in property <string> advice: "";

    callback acknowledged();

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Copyable {
            text: root.heading;
            font-size: Type.strong;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
        Copyable {
            text: root.trouble;
            color: #c0392b;
            font-size: Type.body;
            wrap: word-wrap;
        }
        if root.advice != "": Copyable {
            // The one thing worth saying beside the reason, because it is the
            // thing a person wants to know first and the answer is usually
            // yes: the editor is still holding the session, so whatever the
            // message says, nothing has been thrown away.
            text: root.advice;
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Space.step;
            CopyButton {
                said: root.heading + "\n" + root.trouble
                    + (root.advice != "" ? "\n" + root.advice : "");
            }
            Rectangle { }
            Button {
                text: "OK";
                clicked => { root.acknowledged(); }
            }
        }
    }
}

/// What to do about the problems a configuration opened with.
///
/// Shown when a file is opened that the editor can read and the vehicle could
/// not fly: a node named twice, a node with no name, a type this build does
/// not know, attributes that do not hold together. Each is said in the words
/// of the rule it breaks, and each row offers what can be done about that
/// kind of problem.
///
/// Doing nothing is one of the offers, and it is the one the window closes
/// with. A problem left alone stays a problem -- it is drawn in red on the
/// node it is about, counted in the alert, and `tcsverify` will refuse the
/// file -- but the node is on the canvas in its own working pane either way,
/// which is what lets somebody look at the drawing before deciding. An editor
/// that would not show a configuration until it was correct would be an
/// editor that cannot be used to correct one.
///
/// Where a name is the fix the row has a field and a suggestion, because that
/// is the one kind of problem the editor can mend by itself. Everything else
/// is somebody's decision: open the node and put it right, or take it out.
component ProblemsPanel inherits Rectangle {
    // A dialog drawn inside the main window, over the veil that greys the
    // rest of it: see MainWindow. Inside rather than a window of its own,
    // because a window of its own cannot be kept in front of the main one
    // on every desktop -- Wayland lets no program hold its windows on top --
    // and a question behind the window waiting for it is one nobody finds.
    background: Colors.window;
    border-width: 1px;
    border-color: #808080;
    border-radius: 4px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    min-width: 520px;
    min-height: 260px;
    preferred-width: 680px;
    preferred-height: 380px;

    in property <[ProblemRow]> rows;
    // Every row as one text, for the Copy button. Set from Rust beside the
    // rows.
    in property <string> everything: "";
    // Whether the names as they stand would settle what they are offered for:
    // all different, none empty, none belonging to a third node. Worked out in
    // Rust, where it can be tested: see tcsgui::names_settle.
    in property <bool> ready: false;
    // And why not, where they do not: said once, under the list, rather than
    // beside whichever row is at fault -- a sentence between rows would shift
    // the list as somebody types.
    in property <string> trouble: "";
    // Whether any row offers a name at all, which is what decides whether the
    // renaming button is there to be pressed.
    in property <bool> any-nameable: false;

    callback typed(int, string);
    callback derive(int);
    callback confirmed();
    callback edit(int);
    callback remove(int);
    // The one other thing a row offers: see ProblemRow::action.
    callback acted(int);
    callback left();
    // And the way out that answers all of them at once: see `ignored` in
    // tcsgui::settle_problems.
    callback ignored();
    // Out of the editor, which is the one answer that is not about the
    // configuration at all.
    callback quit();

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Copyable {
            text: "This configuration has problems "
                + "the vehicle would not fly with";
            font-size: Type.strong;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
        Copyable {
            text: "Each one is drawn in red on the node it is about. Put them "
                + "right here, open a node to edit it, or leave them and look "
                + "at the drawing first -- every node is on the canvas either "
                + "way.";
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Space.step;
                for row[i] in root.rows: HorizontalLayout {
                    spacing: Space.step;
                    alignment: start;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Copyable {
                            text: row.said;
                            font-size: Type.body;
                            wrap: word-wrap;
                        }
                        if row.nameable: HorizontalLayout {
                            spacing: Space.step;
                            LineEdit {
                                text: row.now;
                                read-only: Session.read-only;
                                font-size: Fonts.window;
                                horizontal-stretch: 1;
                                edited(said) => { root.typed(i, said); }
                            }
                            Button {
                                text: "Suggest";
                                enabled: !Session.read-only;
                                clicked => { root.derive(i); }
                            }
                        }
                    }
                    if row.there: Button {
                        text: "Edit";
                        enabled: !Session.read-only;
                        clicked => { root.edit(i); }
                    }
                    if row.there: Button {
                        text: "Delete";
                        enabled: !Session.read-only;
                        clicked => { root.remove(i); }
                    }
                    if row.action != "": Button {
                        text: row.action;
                        enabled: !Session.read-only;
                        clicked => { root.acted(i); }
                    }
                }
                if root.rows.length == 0: Copyable {
                    text: "Nothing is wrong.";
                    font-size: Type.body;
                    font-italic: true;
                    color: #6b7280;
                }
            }
        }

        if root.trouble != "": Copyable {
            text: root.trouble;
            font-size: Type.small;
            color: #c0392b;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Space.step;
            CopyButton { said: root.everything; }
            Rectangle { }
            // Out of the editor altogether, for a file that arrived in a
            // state somebody would rather put right elsewhere: a question
            // about a configuration should not be a reason to go looking for
            // a way to close the window it came up over. Leftmost, away from
            // the button that acts, because it is the one press here that
            // cannot be undone by pressing something else.
            Button {
                text: "Quit";
                clicked => { root.quit(); }
            }
            Button {
                text: "Leave this one";
                clicked => { root.left(); }
            }
            // Doing nothing about every one of them, which is the other way
            // out and the one somebody opening a file to look at it wants:
            // the problems stay, the nodes are drawn as they are, and nothing
            // says any of it again this session. The window's own close box
            // does this, for the reason the comment on it in main.rs gives.
            Button {
                text: "Ignore them all";
                clicked => { root.ignored(); }
            }
            if root.any-nameable: Button {
                text: "Rename";
                primary: true;
                enabled: root.ready && !Session.read-only;
                clicked => { root.confirmed(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    default-font-size: Fonts.window;
    // Saying in the title bar when this session changes nothing, which is
    // where somebody looks to see what a window is.
    title: Session.read-only
        ? "TCSpecial Configuration (read-only)"
        : "TCSpecial Configuration";
    background: Colors.window;
    // Wide enough for both working panes and both selection panes, which is
    // what the preferred width is: 960 of working area, 180 of selection
    // panes and the gaps between them. There was a 260-pixel panel here as
    // well, and what a node says about itself is a window of its own now --
    // so the working panes have those pixels.
    //
    // The minimum is smaller because a window that cannot be made to fit a
    // screen is a window that cannot be used on it: squeezed, the right of
    // the payload working pane goes off the edge, which is a nuisance rather
    // than a failure.
    min-width: 760px;
    min-height: 600px;
    preferred-width: 1180px;
    preferred-height: 820px;

    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    // Whether this window takes no presses: true while a window that came up
    // as the editor started is still being read.
    //
    // Shown and inert rather than held back. The drawing is what the question
    // is about -- somebody deciding what to do about a group nothing is in
    // wants to see the diagram it belongs to -- so the window is there to be
    // looked at from the first moment, and nothing in it can be edited behind
    // the window that is asking. Set from Rust, which knows what came up: see
    // `startup_waiting` and `listen_when_read` in main.rs. Presses are held by
    // the veil over the window, at the end of it, which greys everything
    // under it so that it looks as inactive as it is; the menu's items are
    // disabled as well, the keyboard being another way to reach them.
    in property <bool> inert: false;

    // The question about the problems the file opened with, asked in front
    // of the drawing inside this window: see ProblemsPanel. Its properties
    // and callbacks are the panel's, by the same names with "problems-" in
    // front. Set and answered from Rust: see settle_problems in main.rs.
    in property <bool> problems-up: false;
    in property <[ProblemRow]> problems-rows;
    in property <string> problems-everything: "";
    in property <bool> problems-ready: false;
    in property <string> problems-trouble: "";
    in property <bool> problems-any-nameable: false;
    callback problems-typed(int, string);
    callback problems-derive(int);
    callback problems-confirmed();
    callback problems-edit(int);
    callback problems-remove(int);
    callback problems-acted(int);
    callback problems-left();
    callback problems-ignored();
    callback problems-quit();

    // And the alert, when what went wrong is the file the editor started on:
    // said in front of the drawing in the same way. What goes wrong later is
    // said in the alert's own window. See Views::say in main.rs.
    in property <bool> alert-up: false;
    in property <string> alert-heading: "";
    in property <string> alert-trouble: "";
    in property <string> alert-advice: "";
    callback alert-acknowledged();
    // The line a gesture is drawing, as SVG path data in canvas coordinates,
    // and empty when no gesture is running. Dashed, and in pieces because a
    // path here has no dash pattern: see tcsdiagram::route::drawing.
    in property <string> drawing-route: "";
    // The two selection panes' contents, and the two working panes' geometry.
    //
    // All four come from Rust -- see style.rs and main.rs -- because which
    // types are payloads and where the divider falls are facts about a
    // configuration rather than about a window, and they are checked by tests
    // there. Stating the divider in this file as well would be stating it
    // twice.
    in property <[PaletteEntry]> gateway-palette: [];
    in property <[PaletteEntry]> vehicle-palette: [];
    in property <[PaletteEntry]> payload-palette: [];
    in property <length> payload-divider: 0px;
    in property <length> vehicle-divider: 0px;
    in property <length> working-width: 0px;
    // How long the sheet is, in the coordinates the file holds: one length
    // for all three panes, which is what makes them scroll together. From
    // Rust -- see tcsdiagram::pane::WORKING_HEIGHT -- as the width is.
    in property <length> working-height: 0px;
    // Where the sheet is scrolled to, and how much of it is in view: two-way,
    // because a person scrolling moves it and placing a node sets it.
    in-out property <length> canvas-offset: 0px;
    out property <length> canvas-view-height: surface.canvas-view-height;
    in property <color> gateway-ground: white;
    in property <color> vehicle-ground: white;
    in property <color> payload-ground: white;
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    // How many concerns there are, and how many were set aside: see the two
    // buttons in the bar.
    in property <int> concern-count: 0;
    in property <int> aside-count: 0;
    callback show-concerns();
    callback show-aside();

    in property <string> trouble: "";
    in property <string> said: "";
    in property <string> selected: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string, string, string);
    callback node-moved(string, length, length);
    // One of the two dividers between the three working panes was dragged by
    // this much. Two callbacks and not one with a name in it: which divider
    // moved is known where the gesture happened, and a string crossing the
    // boundary would be a name to keep in step in two files.
    // How the selection column is divided, as the gateway and vehicle lists'
    // shares of it, the payload list taking what is left. From Rust, where the
    // settings file keeps them: see tcsgui::Views::lists.
    in property <int> gateway-list-percent: 20;
    in property <int> vehicle-list-percent: 35;
    // And the two lines between the lists, dragged: how far it went and how
    // tall the whole column is. See tcsgui::drag_list_divider.
    callback payload-list-divider-moved(length, length);
    callback vehicle-list-divider-moved(length, length);
    callback payload-divider-moved(length);
    callback vehicle-divider-moved(length);
    callback open-subdiagram(string);
    callback save-clicked();
    callback link-started(string, string);
    callback link-finished(length, length);
    // Where the pointer is while a line is being drawn. See drawing-route.
    callback link-moved(length, length);
    callback node-selected(string);
    // What a node's own menu asks for: see NodeShape's menu.
    callback node-edit(string);
    callback node-delete(string);
    // The menu asked for what tcspecial is configured with.
    callback edit-parameters();
    // Every node to the top of its own pane: see the menu item.
    callback arrange();
    // And for the groups, the simulator's groups of settings, and the way
    // out.
    callback edit-groups();
    callback edit-simulator-groups();
    callback exit-requested();
    // Whether this session was given a simulator configuration at all.
    in property <bool> has-simulator: false;

    // The menu bar.
    //
    // What is in it is what belongs to the configuration as a whole rather
    // than to anything on the canvas: there is nothing to press on a diagram
    // that would mean "the configuration", or "the groups", or "the way out",
    // so a command is how each is reached.
    MenuBar {
        Menu {
            title: "File";
            // Saving needs no command -- every edit is written as it is made
            // -- and there is one anyway, for the three things the ordinary
            // case does not cover: retrying a write that failed once whatever
            // stopped it is put right, rewriting a set of files left half new
            // by a failure between two of them, and answering somebody who
            // has been taught by every other program to save their work. Both
            // files of a session go together, each written atomically.
            MenuItem {
                enabled: !root.inert && !Session.read-only;
                title: "Save";
                activated => { root.save-clicked(); }
            }
            MenuSeparator { }
            // The groups, which are not on the canvas either: a group is a set
            // of payloads read together, and which payloads those are is
            // written on the nodes rather than drawn between them.
            MenuItem {
                enabled: !root.inert;
                title: "Edit payload groups";
                activated => { root.edit-groups(); }
            }
            // The simulator's groups, where this session was given its file.
            // Disabled rather than hidden when it was not: a menu whose
            // entries come and go is a menu nobody learns, and "this needs a
            // second argument" is better said by a greyed entry than by its
            // absence.
            //
            // There is no entry for the simulated payloads themselves. A
            // payload's settings belong to a payload that is already on the
            // canvas, so they are in its own window under a rule: a window of
            // their own would be a second place to look for what one node
            // says about itself.
            MenuItem {
                title: "Edit simulated payload groups";
                enabled: root.has-simulator && !root.inert;
                activated => { root.edit-simulator-groups(); }
            }
            MenuSeparator { }
            MenuItem {
                enabled: !root.inert;
                title: "Exit";
                activated => { root.exit-requested(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                enabled: !root.inert;
                title: "Edit tcspecial parameters";
                activated => { root.edit-parameters(); }
            }
            MenuSeparator { }
            // Every node to the top of its own pane, nothing covering
            // anything. For a configuration read out of a file that is spread
            // over more sheet than the window shows, and for a morning's
            // dragging that has left one nobody can read.
            MenuItem {
                enabled: !root.inert && !Session.read-only;
                title: "Arrange the nodes";
                activated => { root.arrange(); }
            }
        }
    }

    surface := Surface {
        width: 100%;
        height: 100%;
        nodes: root.nodes;
        links: root.links;
        drawing-route: root.drawing-route;
        gateway-palette: root.gateway-palette;
        vehicle-palette: root.vehicle-palette;
        payload-palette: root.payload-palette;
        payload-divider: root.payload-divider;
        vehicle-divider: root.vehicle-divider;
        gateway-list-percent: root.gateway-list-percent;
        vehicle-list-percent: root.vehicle-list-percent;
        payload-list-divider-moved(dy, tall) => {
            root.payload-list-divider-moved(dy, tall);
        }
        vehicle-list-divider-moved(dy, tall) => {
            root.vehicle-list-divider-moved(dy, tall);
        }
        working-width: root.working-width;
        working-height: root.working-height;
        gateway-ground: root.gateway-ground;
        vehicle-ground: root.vehicle-ground;
        payload-ground: root.payload-ground;
        save-clicked => { root.save-clicked(); }
        undo-depth: root.undo-depth;
        redo-depth: root.redo-depth;
        undo-label: root.undo-label;
        redo-label: root.redo-label;
        trouble: root.trouble;
        concern-count: root.concern-count;
        aside-count: root.aside-count;
        show-concerns => { root.show-concerns(); }
        show-aside => { root.show-aside(); }
        said: root.said;
        canvas-offset <=> root.canvas-offset;
        undo-clicked => { root.undo-clicked(); }
        redo-clicked => { root.redo-clicked(); }
        place-node(name, t, sets) => {
            root.place-node(name, t, sets);
        }
        node-moved(n, dx, dy) => { root.node-moved(n, dx, dy); }
        payload-divider-moved(dx) => { root.payload-divider-moved(dx); }
        vehicle-divider-moved(dx) => { root.vehicle-divider-moved(dx); }
        open-subdiagram(n) => { root.open-subdiagram(n); }
        link-started(n, terminal) => { root.link-started(n, terminal); }
        link-finished(x, y) => { root.link-finished(x, y); }
        link-moved(x, y) => { root.link-moved(x, y); }
        selected: root.selected;
        node-selected(n) => { root.node-selected(n); }
        node-edit(n) => { root.node-edit(n); }
        node-delete(n) => { root.node-delete(n); }
    }

    // What makes it inert: a veil over the whole window that takes presses
    // and does nothing with them. Last but for the dialogs, so it is over the
    // surface and over the menus -- a menu is a way of editing too -- and
    // there only while it is wanted, so the ordinary window has nothing in
    // front of it.
    //
    // Grey and part clear, so that everything under it is greyed: still
    // there to be read, the drawing being what the question is about, and
    // plainly not taking presses.
    if root.inert: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #e5e7ebb3;

        TouchArea { }
    }

    // And in front of the veil, whichever is asking: never behind the window
    // waiting for it, being in it. Centred, and no larger than the window
    // leaves room for.
    if root.problems-up: ProblemsPanel {
        width: min(self.preferred-width, root.width - 2 * Space.wide);
        height: min(self.preferred-height, root.height - 2 * Space.wide);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        rows: root.problems-rows;
        everything: root.problems-everything;
        ready: root.problems-ready;
        trouble: root.problems-trouble;
        any-nameable: root.problems-any-nameable;
        typed(row, said) => { root.problems-typed(row, said); }
        derive(row) => { root.problems-derive(row); }
        confirmed => { root.problems-confirmed(); }
        edit(row) => { root.problems-edit(row); }
        remove(row) => { root.problems-remove(row); }
        acted(row) => { root.problems-acted(row); }
        left => { root.problems-left(); }
        ignored => { root.problems-ignored(); }
        quit => { root.problems-quit(); }
    }
    if root.alert-up: AlertPanel {
        width: min(self.preferred-width, root.width - 2 * Space.wide);
        height: min(max(self.min-height, self.preferred-height),
                    root.height - 2 * Space.wide);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-width: 1px;
        border-color: #808080;
        border-radius: 4px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 4px;
        heading: root.alert-heading;
        trouble: root.alert-trouble;
        advice: root.alert-advice;
        acknowledged => { root.alert-acknowledged(); }
    }
}

// One open subdiagram.
//
// The same surface as the top diagram, given that subdiagram's nodes. Several
// may be open at once, and they cannot disagree with each other or with the
// top diagram: there is one document behind all of them, and each window is
// redrawn from it after every edit.
export component SubWindow inherits Window {
    default-font-size: Fonts.window;
    title: "TCSpecial Configuration -- " + root.editing;
    background: Colors.window;
    // The same two working panes as the top diagram, so the same room: a
    // subdiagram is a page of one configuration and its payloads go on the
    // same side of it.
    min-width: 760px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 760px;

    in property <string> editing: "";
    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    // The line a gesture is drawing, as SVG path data in canvas coordinates,
    // and empty when no gesture is running. Dashed, and in pieces because a
    // path here has no dash pattern: see tcsdiagram::route::drawing.
    in property <string> drawing-route: "";
    // The two selection panes' contents, and the two working panes' geometry.
    //
    // All four come from Rust -- see style.rs and main.rs -- because which
    // types are payloads and where the divider falls are facts about a
    // configuration rather than about a window, and they are checked by tests
    // there. Stating the divider in this file as well would be stating it
    // twice.
    in property <[PaletteEntry]> gateway-palette: [];
    in property <[PaletteEntry]> vehicle-palette: [];
    in property <[PaletteEntry]> payload-palette: [];
    in property <length> payload-divider: 0px;
    in property <length> vehicle-divider: 0px;
    in property <length> working-width: 0px;
    // How long the sheet is, in the coordinates the file holds: one length
    // for all three panes, which is what makes them scroll together. From
    // Rust -- see tcsdiagram::pane::WORKING_HEIGHT -- as the width is.
    in property <length> working-height: 0px;
    // Where the sheet is scrolled to, and how much of it is in view: two-way,
    // because a person scrolling moves it and placing a node sets it.
    in-out property <length> canvas-offset: 0px;
    out property <length> canvas-view-height: surface.canvas-view-height;
    in property <color> gateway-ground: white;
    in property <color> vehicle-ground: white;
    in property <color> payload-ground: white;
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    // How many concerns there are, and how many were set aside: see the two
    // buttons in the bar.
    in property <int> concern-count: 0;
    in property <int> aside-count: 0;
    callback show-concerns();
    callback show-aside();

    in property <string> trouble: "";
    in property <string> said: "";
    in property <string> selected: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string, string, string);
    callback node-moved(string, length, length);
    // One of the two dividers between the three working panes was dragged by
    // this much. Two callbacks and not one with a name in it: which divider
    // moved is known where the gesture happened, and a string crossing the
    // boundary would be a name to keep in step in two files.
    // How the selection column is divided, and its two lines: a subdiagram is
    // a page of the same configuration, so its lists are arranged the same
    // way and dragging one of its lines arranges every window's.
    in property <int> gateway-list-percent: 20;
    in property <int> vehicle-list-percent: 35;
    callback payload-list-divider-moved(length, length);
    callback vehicle-list-divider-moved(length, length);
    callback payload-divider-moved(length);
    callback vehicle-divider-moved(length);
    callback save-clicked();
    callback link-started(string, string);
    callback link-finished(length, length);
    // Where the pointer is while a line is being drawn. See drawing-route.
    callback link-moved(length, length);
    callback node-selected(string);
    // What a node's own menu asks for: see NodeShape's menu.
    callback node-edit(string);
    callback node-delete(string);
    callback edit-parameters();
    // Every node to the top of its own pane: see the menu item.
    callback arrange();
    callback edit-groups();
    callback edit-simulator-groups();
    callback exit-requested();
    in property <bool> has-simulator: false;

    // The menu bar.
    //
    // What is in it is what belongs to the configuration as a whole rather
    // than to anything on the canvas: there is nothing to press on a diagram
    // that would mean "the configuration", or "the groups", or "the way out",
    // so a command is how each is reached.
    MenuBar {
        Menu {
            title: "File";
            // Saving needs no command -- every edit is written as it is made
            // -- and there is one anyway, for the three things the ordinary
            // case does not cover: retrying a write that failed once whatever
            // stopped it is put right, rewriting a set of files left half new
            // by a failure between two of them, and answering somebody who
            // has been taught by every other program to save their work. Both
            // files of a session go together, each written atomically.
            MenuItem {
                enabled: !Session.read-only;
                title: "Save";
                activated => { root.save-clicked(); }
            }
            MenuSeparator { }
            // The groups, which are not on the canvas either: a group is a set
            // of payloads read together, and which payloads those are is
            // written on the nodes rather than drawn between them.
            MenuItem {
                title: "Edit payload groups";
                activated => { root.edit-groups(); }
            }
            // The simulator's groups, where this session was given its file.
            // Disabled rather than hidden when it was not: a menu whose
            // entries come and go is a menu nobody learns, and "this needs a
            // second argument" is better said by a greyed entry than by its
            // absence.
            //
            // There is no entry for the simulated payloads themselves. A
            // payload's settings belong to a payload that is already on the
            // canvas, so they are in its own window under a rule: a window of
            // their own would be a second place to look for what one node
            // says about itself.
            MenuItem {
                title: "Edit simulated payload groups";
                enabled: root.has-simulator;
                activated => { root.edit-simulator-groups(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Exit";
                activated => { root.exit-requested(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Edit tcspecial parameters";
                activated => { root.edit-parameters(); }
            }
            MenuSeparator { }
            // Every node to the top of its own pane, nothing covering
            // anything. For a configuration read out of a file that is spread
            // over more sheet than the window shows, and for a morning's
            // dragging that has left one nobody can read.
            MenuItem {
                enabled: !Session.read-only;
                title: "Arrange the nodes";
                activated => { root.arrange(); }
            }
        }
    }

    surface := Surface {
        width: 100%;
        height: 100%;
        editing: root.editing;
        nodes: root.nodes;
        links: root.links;
        drawing-route: root.drawing-route;
        gateway-palette: root.gateway-palette;
        vehicle-palette: root.vehicle-palette;
        payload-palette: root.payload-palette;
        payload-divider: root.payload-divider;
        vehicle-divider: root.vehicle-divider;
        gateway-list-percent: root.gateway-list-percent;
        vehicle-list-percent: root.vehicle-list-percent;
        payload-list-divider-moved(dy, tall) => {
            root.payload-list-divider-moved(dy, tall);
        }
        vehicle-list-divider-moved(dy, tall) => {
            root.vehicle-list-divider-moved(dy, tall);
        }
        working-width: root.working-width;
        working-height: root.working-height;
        gateway-ground: root.gateway-ground;
        vehicle-ground: root.vehicle-ground;
        payload-ground: root.payload-ground;
        save-clicked => { root.save-clicked(); }
        undo-depth: root.undo-depth;
        redo-depth: root.redo-depth;
        undo-label: root.undo-label;
        redo-label: root.redo-label;
        trouble: root.trouble;
        concern-count: root.concern-count;
        aside-count: root.aside-count;
        show-concerns => { root.show-concerns(); }
        show-aside => { root.show-aside(); }
        said: root.said;
        canvas-offset <=> root.canvas-offset;
        undo-clicked => { root.undo-clicked(); }
        redo-clicked => { root.redo-clicked(); }
        place-node(name, t, sets) => {
            root.place-node(name, t, sets);
        }
        node-moved(n, dx, dy) => { root.node-moved(n, dx, dy); }
        payload-divider-moved(dx) => { root.payload-divider-moved(dx); }
        vehicle-divider-moved(dx) => { root.vehicle-divider-moved(dx); }
        link-started(n, terminal) => { root.link-started(n, terminal); }
        link-finished(x, y) => { root.link-finished(x, y); }
        link-moved(x, y) => { root.link-moved(x, y); }
        selected: root.selected;
        node-selected(n) => { root.node-selected(n); }
        node-edit(n) => { root.node-edit(n); }
        node-delete(n) => { root.node-delete(n); }
    }
}

// One group's own window.
//
// A window and not a panel on the canvas, because a group is not on the
// canvas: it is a set of payloads read together, and which payloads those are
// is written on the nodes rather than drawn between them. Its own window is
// also what lets it be left open while the diagram is worked on, which is how
// a bus address gets typed once and watched arrive on six sensors.
//
// Everything here is an edit like any other -- journalled, written as it is
// made, and taken back by Undo in the main window. The one that is not like
// any other is the list at the bottom: setting one of those writes the value
// to every payload in the group, as one edit, so that undo takes back the
// gesture and not the first of twelve consequences.
export component GroupWindow inherits Window {
    default-font-size: Fonts.window;
    title: "Group -- " + root.group;
    background: Colors.window;
    min-width: 360px;
    min-height: 320px;
    preferred-width: 420px;
    preferred-height: 480px;

    // Which group this is. The name as it stands; renaming goes through the
    // callback and comes back here.
    in property <string> group: "";
    // Every group there is, for choosing between them.
    //
    // Here rather than in a menu in the bar, which is where it was: a list of
    // what a configuration happens to contain is data, and a control that
    // holds data belongs with the form that edits it. The menu now says
    // "Edit payload groups" and this says which.
    in property <[string]> choices: [];
    in property <string> interval: "";
    // How many payloads are in it, and what they are called: a group with
    // nothing in it reads nothing on its interval, and a field set on no
    // payloads at all is a field worth saying nothing happened to.
    in property <[string]> members: [];
    in property <[GroupFieldView]> fields: [];
    // What went wrong with the last write, shown here as well as in the main
    // window: somebody typing into this one should not have to look at the
    // other to find out that nothing is reaching the disk.
    in property <string> trouble: "";

    callback renamed(string);
    callback interval-set(string);
    // One attribute, for every payload in the group.
    callback attribute-set(string, string);
    callback choose(string);
    callback add();
    callback removed();

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Text {
            text: root.group == "" ? "a group" : root.group;
            font-size: Type.title;
            font-weight: Type.bold;
        }

        HorizontalLayout {
            spacing: Space.step;
            ComboBox {
                model: root.choices;
                current-value: root.group;
                horizontal-stretch: 1;
                selected(value) => { root.choose(value); }
            }
            Button {
                text: "New";
                enabled: !Session.read-only;
                clicked => { root.add(); }
            }
        }
        Text {
            text: root.members.length == 0
                ? "no payloads are in this group, so it reads nothing"
                : root.members.length + " payload"
                    + (root.members.length == 1 ? "" : "s")
                    + ": " + root.members-text;
            font-size: Type.small;
            color: root.members.length == 0 ? #c0392b : #6b7280;
            wrap: word-wrap;
        }

        Text {
            text: "name";
            font-size: Type.small;
            color: #6b7280;
        }
        LineEdit {
            text: root.group;
            read-only: Session.read-only;
            font-size: Fonts.window;
            // On accept and not on every keystroke: a group's name is what
            // its payloads refer to, so each letter typed would be a rename
            // of the group and of every member -- a dozen edits to undo, and
            // a document briefly naming a group that nothing is in.
            accepted => { root.renamed(self.text); }
        }

        Text {
            text: "interval";
            font-size: Type.small;
            color: #6b7280;
        }
        LineEdit {
            text: root.interval;
            read-only: Session.read-only;
            placeholder-text: "500ms, 3s";
            font-size: Fonts.window;
            edited => { root.interval-set(self.text); }
        }
        Text {
            text: "How often the payloads of this group are read. It belongs "
                + "to the group and not to its members: a payload stating one "
                + "of its own is refused.";
            font-size: Type.small;
            font-italic: true;
            color: #9ca3af;
            wrap: word-wrap;
        }

        if root.fields.length > 0: Text {
            text: "every payload in this group";
            font-size: Type.strong;
            font-weight: Type.bold;
        }
        if root.fields.length > 0: Text {
            text: "Typing here writes the value to all " + root.members.length
                + " of them, as one edit. Only the attributes they all have "
                + "are offered.";
            font-size: Type.small;
            font-italic: true;
            color: #9ca3af;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Space.tight;
                for f in root.fields: VerticalLayout {
                    spacing: 1px;
                    Text {
                        // A field whose payloads disagree says so: typing in
                        // it will overwrite six different values with one,
                        // and that is worth knowing before it happens.
                        text: f.differs ? f.name + " (they differ)" : f.name;
                        font-size: Type.small;
                        color: #6b7280;
                        font-italic: f.differs;
                    }
                    LineEdit {
                        text: f.value;
                        read-only: Session.read-only;
                        placeholder-text: f.differs ? "different on each" : "";
                        font-size: Fonts.window;
                        edited => { root.attribute-set(f.name, self.text); }
                    }
                }
                Rectangle { }
            }
        }

        if root.trouble != "": Text {
            text: root.trouble;
            color: #c0392b;
            font-size: Type.body;
            font-weight: Type.bold;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Space.step;
            Rectangle { }
            Button {
                text: "Remove this group";
                enabled: root.group != "" && !Session.read-only;
                clicked => { root.removed(); }
            }
        }
    }

    // The members, as one line. Slint has no join, and a `for` inside a
    // sentence would lay the names out as separate elements that wrap
    // independently of the words around them.
    in property <string> members-text: "";
}

// What tcspecial itself is configured with.
//
// A window and not part of the canvas, because this is the one part of a
// configuration that is about the whole of it rather than about anything in
// it: where commands are taken, where beacons go, where the telemetry log is
// written. There is nothing to press on the diagram that would mean "the
// configuration", so it is reached from the menu instead.
//
// Required, which is why the fields that must be stated are marked and marked
// in red when they are empty. A graph describes what the vehicle carries and
// what is done with it, and none of that reaches the ground until these are
// answered -- so an unanswered one is a fault and not a blank.
export component ParametersWindow inherits Window {
    default-font-size: Fonts.window;
    title: "tcspecial parameters";
    background: Colors.window;
    min-width: 380px;
    min-height: 360px;
    preferred-width: 440px;
    preferred-height: 560px;

    // One per attribute of the section, in the order tcslibgs lists them:
    // what must be stated first, and the rest after.
    in property <[FieldView]> fields: [];
    // What went wrong with the last write, if anything. Shown here as well as
    // in the main window, so that somebody typing in this one is not left to
    // find out elsewhere that nothing is reaching the disk.
    in property <string> trouble: "";
    // What is wrong with what has been entered, if anything.
    //
    // Here because it belongs to no node: the section is about the
    // configuration as a whole, so there is nothing on the canvas to draw it
    // on. Empty while anything is still unanswered -- the editor says what is
    // wrong and not what is unfinished.
    in property <string> complaint: "";

    callback parameter-set(string, string);

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Text {
            text: "tcspecial parameters";
            font-size: Type.title;
            font-weight: Type.bold;
        }
        Text {
            text: "Where commands are taken, where beacons go, and where the "
                + "telemetry log is written. Every configuration must say "
                + "these: a graph says nothing about how any of it reaches "
                + "the ground until it does.";
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }
        if root.complaint != "": Text {
            text: root.complaint;
            color: #c0392b;
            font-size: Type.body;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
        Text {
            text: "Two ports, because there are two command links: a command "
                + "about the spacecraft -- ping it, arm it, restart it -- is "
                + "taken on port, and one about a payload on payload_port, so "
                + "what the ground needs in a hurry is never queued behind "
                + "what it asked for at leisure.";
            font-size: Type.small;
            font-italic: true;
            color: #9ca3af;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Space.tight;
                for f in root.fields: VerticalLayout {
                    spacing: 1px;
                    Text {
                        text: f.required ? f.name + " *" : f.name;
                        font-size: Type.small;
                        color: #6b7280;
                    }
                    LineEdit {
                        text: f.value;
                        read-only: Session.read-only;
                        font-size: Fonts.window;
                        edited => { root.parameter-set(f.name, self.text); }
                    }
                }
                Rectangle { }
            }
        }

        if root.trouble != "": Text {
            text: root.trouble;
            color: #c0392b;
            font-size: Type.body;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
    }
}

// The simulator's settings for one simulated payload, or for one of its
// groups.
//
// One window shape for both, because they are the same list of settings: a
// group carries what several simulated payloads share and a payload overrides
// any of it for itself. What differs is what the chooser at the top holds --
// the payloads of the configuration, or the groups the simulator file declares
// -- and whether there is a way to make a new one.
//
// Nothing here is drawn on the canvas, and that is not a shortcut: the
// simulator file introduces no nodes and no connections, so a drawing of it
// would be the same drawing with numbers on it. See sim.rs.
export component SimWindow inherits Window {
    default-font-size: Fonts.window;
    title: root.editing;
    background: Colors.window;
    min-width: 380px;
    min-height: 360px;
    preferred-width: 440px;
    preferred-height: 600px;

    // "Simulated payloads" or "Simulator payload groups", which is also the
    // window's title.
    in property <string> editing: "";
    // A line saying what these settings are and are not.
    in property <string> about: "";
    // What there is to choose from, and which one is chosen.
    in property <[string]> choices: [];
    in property <string> chosen: "";
    // The settings of whatever is chosen.
    in property <[FieldView]> fields: [];
    // Whether this window can make a new one, which the groups can and the
    // payloads cannot: a simulated payload stands in for a payload of the
    // configuration, so its name is the configuration's and not this file's.
    in property <bool> can-add: false;
    in property <string> trouble: "";

    callback choose(string);
    callback add();
    callback remove();
    callback setting-set(string, string);

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Text {
            text: root.editing;
            font-size: Type.title;
            font-weight: Type.bold;
        }
        Text {
            text: root.about;
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Space.step;
            ComboBox {
                model: root.choices;
                current-value: root.chosen;
                horizontal-stretch: 1;
                selected(value) => { root.choose(value); }
            }
            if root.can-add: Button {
                text: "New";
                enabled: !Session.read-only;
                clicked => { root.add(); }
            }
            if root.can-add: Button {
                text: "Remove";
                enabled: root.chosen != "" && !Session.read-only;
                clicked => { root.remove(); }
            }
        }

        if root.chosen == "": Text {
            text: root.choices.length == 0
                ? "There is nothing here yet."
                : "Choose one above.";
            font-size: Type.small;
            font-italic: true;
            color: #9ca3af;
            vertical-stretch: 1;
        }

        if root.chosen != "": ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Space.tight;
                for f in root.fields: VerticalLayout {
                    spacing: 1px;
                    Text {
                        text: f.name;
                        font-size: Type.small;
                        color: #6b7280;
                    }
                    LineEdit {
                        text: f.value;
                        read-only: Session.read-only;
                        font-size: Fonts.window;
                        edited => { root.setting-set(f.name, self.text); }
                    }
                }
                Rectangle { }
            }
        }

        if root.trouble != "": Text {
            text: root.trouble;
            color: #c0392b;
            font-size: Type.body;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
    }
}

// What one node says about itself.
//
// A window per node, and several open at once. It was a panel down the
// right-hand side, which showed whichever node was last pressed: that made
// comparing two nodes a matter of pressing one, reading, pressing the other
// and remembering -- and the one thing somebody filling in a configuration
// does constantly is compare two sensors on the same bus.
//
// So each node's attributes are a window, and the window stays until it is
// closed. Pressing another node opens another window rather than replacing
// this one, which is why closing takes a press of its own: a window that went
// away when something else was pressed would be the panel again.
//
// Two files in one window, where the editor was given the simulator's: the
// node's own attributes, a rule, and the settings the simulator file gives it.
// Each row says which file it belongs to, because they are written to
// different ones.
export component NodeWindow inherits Window {
    default-font-size: Fonts.window;
    title: root.node == "" ? "a node" : root.node;
    background: Colors.window;
    min-width: 300px;
    min-height: 260px;
    preferred-width: 340px;
    preferred-height: 560px;

    in property <string> node: "";
    in property <string> node-type: "";
    in property <string> comment: "";
    in property <[FieldView]> fields: [];
    // What the description tree says about this kind of node, shown at the
    // foot of the window while no field with something said about it has the
    // focus.
    in property <string> about: "";
    // What is wrong with what this node says, if anything. The one red text
    // here, as on the canvas.
    in property <string> fault: "";
    in property <string> trouble: "";

    // Which field has the focus, and what is said about it. The name as well
    // as the sentence, so that a field losing the focus clears only what it
    // put there: when the focus moves from one field to the next, the order
    // the two hear of it in is not something to depend on.
    property <string> focused: "";
    property <string> focused-about: "";
    out property <string> about-shown:
        root.focused-about != "" ? root.focused-about : root.about;

    callback attribute-set(string, string);
    callback sim-attribute-set(string, string);
    callback comment-set(string);
    callback closed();

    VerticalLayout {
        padding: Space.step;
        spacing: Space.tight;

        Text {
            text: root.node;
            font-size: Type.strong;
            font-weight: Type.bold;
            height: 20px;
        }
        Text {
            text: root.node-type;
            font-size: Type.small;
            color: #6b7280;
            height: 14px;
        }
        if root.fault != "": Text {
            text: root.fault;
            color: #c0392b;
            font-size: Type.small;
            font-italic: true;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Space.tight;

                for f in root.fields: VerticalLayout {
                    spacing: 1px;

                    // Where the node's own attributes end and the simulator's
                    // settings for it begin. A rule and a name, because the
                    // fields below it are written to a different file and
                    // nothing else would say so.
                    if f.is-heading: Rectangle {
                        height: Space.wide;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: #d8d8d4;
                        }
                    }
                    if f.is-heading: Text {
                        text: f.name;
                        font-size: Type.small;
                        font-weight: Type.bold;
                        color: #6b7280;
                        height: 16px;
                    }

                    if !f.is-heading: Text {
                        // A field the configuration must state says so, and
                        // says it quietly: an empty one is unanswered and not
                        // wrong.
                        text: f.required ? f.name + " *" : f.name;
                        font-size: Type.small;
                        // Italic for a setting of the simulator's file. The
                        // rule above says where one file ends and the other
                        // begins; this says it again on every row, so a
                        // reader who has scrolled past the rule still knows
                        // which file they are typing into. Two channels for
                        // one distinction, as the node shapes have.
                        font-italic: f.simulated;
                        color: #6b7280;
                        height: 14px;
                    }
                    // A true or false, which is a control with two states
                    // rather than a box to write the word in: the two answers
                    // are the whole of what the attribute takes, so offering
                    // anything else to type is offering a way to be wrong.
                    //
                    // Unticked is both "false" and a file that says nothing,
                    // those meaning the same thing -- see
                    // `tcslibgs::node::vehicle::Restart::of` -- and ticking it
                    // writes the word, so what the file ends up saying is a
                    // word somebody chose and not a box they left alone.
                    if !f.is-heading && f.kind == "boolean": CheckBox {
                        enabled: !Session.read-only;
                        text: f.value == "true" ? "true" : "false";
                        checked: f.value == "true";
                        changed has-focus => {
                            if (self.has-focus) {
                                root.focused = f.name;
                                root.focused-about = f.about;
                            } else if (root.focused == f.name) {
                                root.focused = "";
                                root.focused-about = "";
                            }
                        }
                        toggled => {
                            if (f.simulated) {
                                root.sim-attribute-set(
                                    f.name,
                                    self.checked ? "true" : "false");
                            } else {
                                root.attribute-set(
                                    f.name,
                                    self.checked ? "true" : "false");
                            }
                        }
                    }
                    if !f.is-heading && f.kind != "boolean": LineEdit {
                        read-only: Session.read-only;
                        text: f.value;
                        font-size: Type.body;
                        changed has-focus => {
                            if (self.has-focus) {
                                root.focused = f.name;
                                root.focused-about = f.about;
                            } else if (root.focused == f.name) {
                                root.focused = "";
                                root.focused-about = "";
                            }
                        }
                        edited => {
                            // Two files, two edits: a node's attribute goes to
                            // the configuration and a simulated payload's
                            // setting to the simulator's own file.
                            if (f.simulated) {
                                root.sim-attribute-set(f.name, self.text);
                            } else {
                                root.attribute-set(f.name, self.text);
                            }
                        }
                    }
                }

                Rectangle { }
            }
        }

        // What somebody wrote about this node, at the bottom and always
        // there: several lines of it, scrolling on its own.
        //
        // Out of the list of fields above rather than at the end of it, which
        // is where it was. Two reasons. A note is not an attribute -- it is
        // not written as one, it is not checked as one, and a rule between
        // them says so; and a note is the field most likely to be long, so a
        // person typing one had to scroll the whole window to see what they
        // were writing. Here it keeps its place while the attributes scroll
        // past above it.
        //
        // Several lines because that is what a note is: "0x49 after the
        // rework" and the reason for it, which the file writes as a run of
        // comment lines above the node and reads back the same way.
        Text {
            text: "comment";
            font-size: Type.small;
            color: #6b7280;
            height: 14px;
        }
        TextEdit {
            read-only: Session.read-only;
            height: 72px;
            text: root.comment;
            font-size: Fonts.window;
            wrap: word-wrap;
            edited => { root.comment-set(self.text); }
        }

        // What the description tree says: about the field being typed into,
        // or about the node while no field is. At the foot of the window, and
        // not beside each field, so that the rows stay a row each however
        // long a sentence is; read-only, because it is the tree's to say and
        // not this node's.
        Text {
            text: "about";
            font-size: Type.small;
            color: #6b7280;
            height: 14px;
        }
        TextEdit {
            read-only: true;
            height: 48px;
            text: root.about-shown;
            font-size: Fonts.window;
            wrap: word-wrap;
        }

        if root.trouble != "": Text {
            text: root.trouble;
            color: #c0392b;
            font-size: Type.small;
            font-weight: Type.bold;
            wrap: word-wrap;
        }

        // Closing takes a press, which is the whole point of a window per
        // node: one that closed itself when another node was pressed would be
        // the panel this replaced.
        HorizontalLayout {
            Rectangle { }
            Button {
                text: "Close";
                clicked => { root.closed(); }
            }
        }
    }
}

// The offer to write what the files do not have, on the way out.
//
// Normally never seen: every edit is written as it is made, so there is
// nothing to offer and Exit simply exits. What this is for is the session
// where a write failed -- a full device, a directory somebody had made
// read-only -- because leaving a session's work in a process that is ending is
// the one way this editor could lose anything.
//
// Three answers and not two. "Leave without saving" is there because somebody
// who has just been told the device is full may want to go and deal with it,
// and a program that insisted on writing first would be a program they cannot
// get out of. "Stay" is there because the menu is next to everything else and
// gets pressed by accident.
// What went wrong, said where it cannot be missed.
//
// A window and not only the red line in the bar, because the red line is the
// *state* -- "saved", or what is wrong with the last save -- and somebody
// typing into a node's own window is not looking at the bar of another. An
// error that nobody sees is an error that gets worse: a full device stays full,
// and every edit after it is one more edit the files do not have.
//
// One window, re-pointed, rather than one per error. Two of them side by side
// would be two copies of the same sentence, and the sentence is always about
// the same session.
export component AlertWindow inherits Window {
    default-font-size: Fonts.window;
    title: "tcsgui";
    background: Colors.window;
    min-width: 360px;
    min-height: 140px;
    preferred-width: 460px;

    // In front of the main window while the editor is starting: set from
    // Rust for as long as the main window takes no presses, so the window
    // asking is never behind the one waiting for it. See `on_top` in main.rs.
    in property <bool> on-top: false;
    always-on-top: root.on-top;

    in property <string> trouble: "";
    in property <string> heading: "Something did not work.";
    in property <string> advice: "";
    callback acknowledged();

    // What it says, which the main window also shows in front of itself
    // when the editor is starting: see AlertPanel.
    AlertPanel {
        trouble: root.trouble;
        heading: root.heading;
        advice: root.advice;
        acknowledged => { root.acknowledged(); }
    }
}

/// What might be wrong with the drawing, listed, with somewhere to go.
///
/// A concern is a shape that might be a mistake and might be meant: a payload
/// whose readings reach nothing, a vehicle node a stream stops at. The editor
/// will not refuse a configuration for one -- that is what a fault is for --
/// so what it owes instead is a way to find them: a count on a button, a list
/// behind it, and a press that takes you to the node.
///
/// One window for both lists, pointed at either by `aside`: what has not been
/// looked at, and what somebody looked at and left. Two windows saying almost
/// the same thing would be two windows to keep in step.
export component ConcernsWindow inherits Window {
    default-font-size: Fonts.window;
    title: "tcsgui";
    background: Colors.window;
    min-width: 420px;
    min-height: 200px;
    preferred-width: 560px;
    preferred-height: 320px;

    in property <[ConcernRow]> rows: [];
    // Every row as one text, for the Copy button. Set from Rust beside the
    // rows, where joining them is a line rather than a loop in markup.
    in property <string> everything: "";
    // Whether this is the list of what was set aside, which decides what the
    // second button on a row offers.
    in property <bool> aside: false;

    // Which row: the index into `rows`, which is what the editor holds them
    // by. A name would be a second thing to keep in step with the list.
    callback go-to(int);
    callback decided(int);
    callback closed();

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Copyable {
            text: root.aside
                ? "Set aside"
                : "Things that might be wrong";
            font-size: Type.strong;
            font-weight: Type.bold;
        }
        Copyable {
            text: root.aside
                ? "You decided to leave these. Take one up again to have it "
                    + "counted with the rest."
                : "None of these stops a configuration being read or flown. "
                    + "Set one aside if it is what you meant.";
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Space.tight;
                for row[i] in root.rows: HorizontalLayout {
                    spacing: Space.step;
                    Copyable {
                        text: row.said;
                        font-size: Type.body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    Button {
                        text: "Go to it";
                        clicked => { root.go-to(i); }
                    }
                    Button {
                        text: root.aside ? "Take up again" : "Set aside";
                        enabled: !Session.read-only;
                        clicked => { root.decided(i); }
                    }
                }
                if root.rows.length == 0: Copyable {
                    text: root.aside
                        ? "Nothing has been set aside."
                        : "Nothing to look at.";
                    font-size: Type.body;
                    font-italic: true;
                    color: #6b7280;
                }
            }
        }

        HorizontalLayout {
            spacing: Space.step;
            CopyButton { said: root.everything; }
            Rectangle { }
            Button {
                text: "Close";
                clicked => { root.closed(); }
            }
        }
    }
}

/// The question a node's Delete asks before anything goes.
///
/// Asked rather than done, because a node is not one word: it is its
/// attributes and every line that touches it, and a press next to Edit in a
/// menu is a press somebody may have meant for Edit. Undo would put it back --
/// a removal is one edit -- but an undo that has to be *discovered* is no
/// answer to a node that has gone and taken four lines with it.
export component DeleteWindow inherits Window {
    default-font-size: Fonts.window;
    title: "Delete a node";
    background: Colors.window;
    min-width: 320px;
    min-height: 150px;
    preferred-width: 400px;

    // The node this is about, and what goes with it: how many lines touch it,
    // said in words by the editor.
    in property <string> node: "";
    in property <string> carries: "";

    callback confirmed();
    callback cancelled();

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Copyable {
            text: "Delete \"" + root.node + "\"?";
            font-size: Type.strong;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
        if root.carries != "": Copyable {
            text: root.carries;
            font-size: Type.body;
            wrap: word-wrap;
        }
        Copyable {
            text: "Undo takes it back, with its attributes and its lines.";
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Space.step;
            Button {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            CopyButton {
                said: "Delete \"" + root.node + "\"?"
                    + (root.carries != "" ? "\n" + root.carries : "");
            }
            Rectangle { }
            Button {
                text: "Delete";
                clicked => { root.confirmed(); }
            }
        }
    }
}

export component LeaveWindow inherits Window {
    default-font-size: Fonts.window;
    title: "Leave tcsgui";
    background: Colors.window;
    min-width: 360px;
    min-height: 160px;
    preferred-width: 420px;

    // Why the last write failed, which is why there is anything to offer.
    in property <string> trouble: "";

    callback saved();
    callback left();
    callback stayed();

    VerticalLayout {
        padding: Space.wide;
        spacing: Space.step;

        Copyable {
            text: "There are changes the files do not have.";
            font-size: Type.strong;
            font-weight: Type.bold;
            wrap: word-wrap;
        }
        if root.trouble != "": Copyable {
            text: root.trouble;
            color: #c0392b;
            font-size: Type.body;
            wrap: word-wrap;
        }
        Copyable {
            text: "Saving writes the configuration and, where this session "
                + "was given one, the simulator's file beside it.";
            font-size: Type.small;
            color: #6b7280;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Space.step;
            Button {
                text: "Stay";
                clicked => { root.stayed(); }
            }
            CopyButton {
                said: "There are changes the files do not have."
                    + (root.trouble != "" ? "\n" + root.trouble : "");
            }
            Rectangle { }
            Button {
                text: "Leave without saving";
                clicked => { root.left(); }
            }
            Button {
                text: "Save and leave";
                primary: true;
                clicked => { root.saved(); }
            }
        }
    }
}
