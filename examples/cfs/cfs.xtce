<?xml version="1.0" encoding="UTF-8"?>
<!-- What the vehicle sends the ground, flying the configuration
     cfs: each node whose data reaches it, as a parameter named
     for the node, of the type the node sends, in a container of its own.
     The types are tcslibgs/xtce/types.xtce's, copied: a string or bytes
     after a 32-bit count of its bytes, as each is sent where the ground
     decodes it by XTCE (under Yamcs). Where no XTCE decodes it, the count
     is sent in groups of seven bits instead, least significant first, each
     in a byte whose top bit says another follows. How each gateway frames
     what it sends is the ground station's to add.

     Written by tcsverify, asked for it by its xtce option, from the
     configuration and types.xtce, and not to be edited: see "The
     configuration's own XTCE" in tcspecial's docs/design.rst. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="cfs">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <IntegerParameterType name="bytes_length" signed="false"
          sizeInBits="32">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned"/>
        <ValidRange minInclusive="0" maxInclusive="4096"/>
      </IntegerParameterType>
      <BinaryParameterType name="bytes">
        <BinaryDataEncoding>
          <SizeInBits>
            <DynamicValue>
              <ParameterInstanceRef parameterRef="bytes_length"/>
              <LinearAdjustment slope="8"/>
            </DynamicValue>
          </SizeInBits>
        </BinaryDataEncoding>
      </BinaryParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="bytes_length" parameterTypeRef="bytes_length"/>
      <Parameter name="thermometer" parameterTypeRef="bytes"/>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="thermometer_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="bytes_length"/>
          <ParameterRefEntry parameterRef="thermometer"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
</SpaceSystem>
