<?xml version="1.0" encoding="UTF-8"?>
<!--
  A tcspecial simulator configuration, written in XML.

  What tcssim needs in order to stand in for the payloads of a configuration:
  how fast each one sends, and what it does wrong. Nothing here describes a
  payload; the configuration does that, and the two are joined by name.

  As with the configuration schema, this checks the shape of the file and not
  whether it can be run: which settings a given kind of payload may state is
  that kind's own rule, and tcsverify is where those live.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- What kind of payload the simulated payloads of a <type> stand in for:
       one of the interfaces a payload is reached over, as DHType spells
       them, which is the type the configuration writes the payload under. A
       payload that is a program is the program itself and needs no
       stand-in. xs:token, so that the whitespace around a word is not part
       of it. -->
  <xs:simpleType name="kind">
    <xs:restriction base="xs:token">
      <xs:enumeration value="network"/>
      <xs:enumeration value="device-file"/>
      <xs:enumeration value="serial"/>
      <xs:enumeration value="i2c"/>
      <xs:enumeration value="spi"/>
      <xs:enumeration value="can"/>
      <xs:enumeration value="iio"/>
      <xs:enumeration value="rpmsg"/>
      <xs:enumeration value="gpio"/>
      <xs:enumeration value="hdlc"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The settings a group or a simulated payload may state. A choice
       repeated rather than xs:all, so that the order is free. -->
  <xs:group name="settings">
    <xs:choice>
      <!-- Whether the payload is simulated, true or false: from the payload
           or its group, never both. -->
      <xs:element name="simulate" type="xs:string"/>
      <xs:element name="protocol" type="xs:string"/>
      <xs:element name="payload_address" type="xs:string"/>
      <xs:element name="payload_port" type="xs:string"/>
      <xs:element name="packet_interval" type="xs:string"/>
      <xs:element name="segment_interval" type="xs:string"/>
      <xs:element name="segment_size" type="xs:string"/>
      <xs:element name="drop_percent" type="xs:string"/>
      <xs:element name="corrupt_percent" type="xs:string"/>
      <xs:element name="truncate_percent" type="xs:string"/>
      <xs:element name="jitter" type="xs:string"/>
      <xs:element name="silent_after" type="xs:string"/>
      <xs:element name="close_after" type="xs:string"/>
      <xs:element name="ignore_trigger_percent" type="xs:string"/>
      <!-- What a payload is joined to: the terminal of the physics model
           it reports or drives, and where on it a sensor sits. -->
      <xs:element name="connects" type="xs:string"/>
      <xs:element name="offset" type="xs:string"/>
      <!-- What a sensor gets wrong. -->
      <xs:element name="noise" type="xs:string"/>
      <xs:element name="accuracy" type="xs:string"/>
      <xs:element name="drift" type="xs:string"/>
      <xs:element name="drift_time" type="xs:string"/>
      <xs:element name="lag" type="xs:string"/>
    </xs:choice>
  </xs:group>

  <!-- A group of settings, named by its attribute. It says no type: a
       payload's type is the type it is written under. -->
  <xs:complexType name="group">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="settings"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- A simulated payload, named by its attribute: the payload of the
       configuration it stands in for. It may name a group to take the
       settings it does not state from. -->
  <xs:complexType name="payload">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="group" type="xs:string"/>
      <xs:group ref="settings"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- The groups, in any order. -->
  <xs:complexType name="groups">
    <xs:sequence>
      <xs:element name="group" type="group"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- One type's simulated payloads, the type named by its attribute. -->
  <xs:complexType name="typed">
    <xs:sequence>
      <xs:element name="payload" type="payload" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="kind" use="required"/>
  </xs:complexType>

  <!-- The simulated payloads, grouped by type, in any order. -->
  <xs:complexType name="payloads">
    <xs:sequence>
      <xs:element name="type" type="typed"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- What tcssim itself is told: the UDP address, as address:port, at
       which it answers whether it has made its stand-ins, required by tcssim
       to start and by a harness to wait for it; the hysteresis node it
       stands in for, if any, which is never stated with tcspecial running;
       and the seed its random numbers start from. -->
  <xs:complexType name="tcssim">
    <xs:all>
      <xs:element name="ready" type="xs:string"/>
      <xs:element name="thermostat" type="xs:string" minOccurs="0"/>
      <xs:element name="seed" type="xs:string" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- The file: each section once at most, in any order, as tcssim reads
       it. None is required as the file is read: tcssim refuses to start
       without a tcssim section, which is its rule and not the shape's. -->
  <xs:element name="simulator">
    <xs:complexType>
      <xs:all>
        <xs:element name="description" type="xs:string" minOccurs="0"/>
        <xs:element name="tcssim" type="tcssim" minOccurs="0"/>
        <xs:element name="simulated_payload_groups" type="groups"
                    minOccurs="0"/>
        <!-- No world: the world the payloads are joined to, its ambient
             temperature and its physics model, is written only in a
             simulator file in YAML. -->
        <xs:element name="simulated_payloads" type="payloads"
                    minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

</xs:schema>
