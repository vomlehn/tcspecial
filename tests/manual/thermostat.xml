<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <version>2.0</version>
    <tcspecial>
        <beacon>
            <interval_ms>5000</interval_ms>
            <recv>127.0.0.1:5650</recv>
            <send>0.0.0.0:5550</send>
        </beacon>
        <log>
            <directory>/var/log/tcspecial</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <payload_groups>
        <name>cabin_temps</name>
        <interval>3s</interval>
    </payload_groups>
    <moc>
        <name>moc</name>
        <type>moc</type>
        <address>10.0.0.1</address>
        <port>5000</port>
        <from_payload>true</from_payload>
    </moc>
    <vehicle>
        <name>k_fore</name>
        <type>compute</type>
        <format>i16_be</format>
        <function>to_kelvin</function>
        <offset>273.15</offset>
        <scale>0.0625</scale>
        <to_moc><target>moc</target></to_moc>
        <to_moc><target>mean_temp</target><input>in0</input></to_moc>
        <to_moc><target>housekeeping</target></to_moc>
        <from_payload>true</from_payload>
    </vehicle>
    <vehicle>
        <name>k_aft</name>
        <type>compute</type>
        <format>i16_be</format>
        <function>to_kelvin</function>
        <offset>273.15</offset>
        <scale>0.0625</scale>
        <to_moc><target>moc</target></to_moc>
        <to_moc><target>mean_temp</target><input>in1</input></to_moc>
        <to_moc><target>housekeeping</target></to_moc>
        <from_payload>true</from_payload>
    </vehicle>
    <vehicle>
        <name>k_bay</name>
        <type>compute</type>
        <format>u24_be</format>
        <function>to_kelvin</function>
        <offset>255.37</offset>
        <scale>0.0078</scale>
        <to_moc><target>moc</target></to_moc>
        <to_moc><target>mean_temp</target><input>in2</input></to_moc>
        <to_moc><target>housekeeping</target></to_moc>
        <from_payload>true</from_payload>
    </vehicle>
    <vehicle>
        <name>mean_temp</name>
        <type>compute</type>
        <function>mean</function>
        <inputs>in0,in1,in2</inputs>
        <to_moc><target>moc</target></to_moc>
        <to_moc><target>thermostat</target></to_moc>
        <from_payload>true</from_payload>
    </vehicle>
    <!-- setpoint is set from the ground; above and below are the two degrees -->
    <!-- either side that the heaters are switched at. -->
    <vehicle>
        <name>thermostat</name>
        <type>compute</type>
        <above>2.0</above>
        <below>2.0</below>
        <function>hysteresis</function>
        <setpoint>293.15</setpoint>
        <to_moc><target>housekeeping</target></to_moc>
        <!-- asserted below the setpoint, unasserted above it -->
        <to_payload><target>heaters</target></to_payload>
        <from_payload>true</from_payload>
    </vehicle>
    <vehicle>
        <name>housekeeping</name>
        <type>log</type>
        <directory>/var/log/tcspecial</directory>
        <format>variable_ts_rc</format>
        <from_payload>true</from_payload>
    </vehicle>
    <!-- Forward bulkhead. Two bytes, signed, big endian. -->
    <payloads>
        <name>temp_fore</name>
        <type>i2c</type>
        <address>0x48</address>
        <group>cabin_temps</group>
        <path>/dev/i2c-1</path>
        <read_size>2</read_size>
        <to_moc><target>k_fore</target></to_moc>
    </payloads>
    <!-- Aft bulkhead; same part as temp_fore. -->
    <payloads>
        <name>temp_aft</name>
        <type>i2c</type>
        <address>0x49</address>
        <group>cabin_temps</group>
        <path>/dev/i2c-1</path>
        <read_size>2</read_size>
        <to_moc><target>k_aft</target></to_moc>
    </payloads>
    <!-- Equipment bay. Three bytes, unsigned - a different part, hence its -->
    <!-- own conversion. -->
    <payloads>
        <name>temp_bay</name>
        <type>spi</type>
        <group>cabin_temps</group>
        <max_speed>1000000</max_speed>
        <path>/dev/spidev0.0</path>
        <read_size>3</read_size>
        <spi_mode>0</spi_mode>
        <to_moc><target>k_bay</target></to_moc>
    </payloads>
    <!-- Three circuits, driven together. -->
    <payloads>
        <name>heaters</name>
        <type>gpio</type>
        <direction>output</direction>
        <lines>3,4,5</lines>
        <path>/dev/gpiochip0</path>
        <from_moc>true</from_moc>
    </payloads>
    <!-- the cabin temperature the heaters are held at, in kelvin -->
    <commands>
        <from>moc</from>
        <sets>thermostat.setpoint</sets>
    </commands>
    <tcsgui>
        <nodes><name>temp_fore</name><x>40</x><y>40</y></nodes>
        <nodes><name>temp_aft</name><x>40</x><y>160</y></nodes>
        <nodes><name>temp_bay</name><x>40</x><y>280</y></nodes>
        <nodes><name>k_fore</name><x>240</x><y>40</y></nodes>
        <nodes><name>k_aft</name><x>240</x><y>160</y></nodes>
        <nodes><name>k_bay</name><x>240</x><y>280</y></nodes>
        <nodes><name>mean_temp</name><x>460</x><y>160</y></nodes>
        <nodes><name>thermostat</name><x>660</x><y>240</y></nodes>
        <nodes><name>moc</name><x>660</x><y>40</y></nodes>
        <nodes><name>heaters</name><x>860</x><y>240</y></nodes>
        <nodes><name>housekeeping</name><x>460</x><y>380</y></nodes>
    </tcsgui>
</configuration>
