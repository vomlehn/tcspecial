# yaml-language-server: $schema=../../tcsprotocol/schema/tcspecial.schema.json

# The vehicle the two ping examples share, which each includes: the ping
# node, which answers each ping it is sent. What differs between the two
# is in each example's own file: the tcspecial section and the gateway
# node, which is called gateway in both, the name the ping node's answer
# is sent to it by.

# What the files that include this one may join: the ping node, which
# the gateway node sends pings to and which answers to the gateway node.
exports:
  moc-in: [ping]
  world-out: [ping]

vehicle:
  - type ping:
      # Answers each ping with the vehicle's time on the end: see
      # tcsprotocol::node::vehicle::ping for what a ping and its answer say.
      - compute: ping
        world-out:
          - gateway.ping
        moc-in: [gateway]

tcs-gui:
  nodes:
    - { node: ping, x: 34, y: 34 }
