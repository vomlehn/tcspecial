<?xml version="1.0" encoding="UTF-8"?>
<!-- TCSpecial payload set 1, in the payload configuration language.

     Equivalent to tcspecial1.yaml -- a payload configuration may be
     written in either format, and both of this set are shipped. The YAML is
     the one to read: it carries the comments.

     Conventions, which are what XML and YAML agree on:
       - every value is a child element, never an attribute
       - a sequence is repeated sibling elements named for the field,
         and the repeats must be contiguous
       - an absent optional field is simply an omitted element -->
<payload>
    <version>1.0</version>
    <description>TCSpecial payload set 1</description>
    <tcspecial>
        <tcs_cmd_recv>0.0.0.0:4000</tcs_cmd_recv>
        <moc_cmd_send>127.0.0.1:4100</moc_cmd_send>
        <payload_interface>0.0.0.0:4001</payload_interface>
        <tcs_tc_base>0.0.0.0:6000</tcs_tc_base>
        <moc_tc_base>127.0.0.1:6100</moc_tc_base>
        <beacon_interval_ms>5000</beacon_interval_ms>
        <beacon_send>239.255.0.1:5550</beacon_send>
        <beacon_interface>127.0.0.1</beacon_interface>
        <log_dir>/var/log/tcspecial</log_dir>
        <log_segment_bytes>65536</log_segment_bytes>
    </tcspecial>
    <payload_groups>
        <name>udp_localhost</name>
        <type>network</type>
        <protocol>udp</protocol>
        <address>localhost</address>
    </payload_groups>
    <payloads>
        <name>tcp-stream</name>
        <type>network</type>
        <protocol>tcp</protocol>
        <address>localhost</address>
        <port>5000</port>
        <packet_size>12</packet_size>
    </payloads>
    <payloads>
        <name>udp-steady</name>
        <group>udp_localhost</group>
        <port>5001</port>
        <packet_size>11</packet_size>
    </payloads>
    <payloads>
        <name>random-device</name>
        <type>device-file</type>
        <path>/dev/urandom</path>
        <packet_size>1</packet_size>
    </payloads>
    <payloads>
        <name>udp-fast</name>
        <group>udp_localhost</group>
        <port>5003</port>
        <packet_size>15</packet_size>
    </payloads>
</payload>
