<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <tcspecial>
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>ad9aac4dd5a6d88dd5e78824ba8a83ac</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-thermostat.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <payload_groups>
        <name>zone_temps</name>
        <interval>100 ms</interval>
    </payload_groups>
    <gateways>
        <type name="gateway_radio">
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:5100</ground_base>
                <port>5000</port>
                <payload-in>true</payload-in>
            </gateway>
        </type>
    </gateways>
    <vehicle>
        <type name="compute">
            <!-- One temperature out of the three, by the algorithm named: -->
            <!-- median takes the middle reading, closest_mean the mean of -->
            <!-- the two that agree best. Either leaves a sensor that has -->
            <!-- gone wrong out of the answer, which a mean over all three -->
            <!-- would not, and it produces a value on every arrival, so one -->
            <!-- sensor that stops reporting is outvoted rather than -->
            <!-- stopping the vehicle from deciding anything. -->
            <compute name="ambient">
                <algorithm>median</algorithm>
                <function>vote</function>
                <inputs>in0,in1,in2</inputs>
                <payload-out><target>gateway</target></payload-out>
                <payload-out><target>thermostat</target></payload-out>
                <payload-in>true</payload-in>
            </compute>
            <compute name="temp1">
                <format>i16_be</format>
                <function>to_kelvin</function>
                <offset>273.15</offset>
                <scale>0.0625</scale>
                <payload-out><target>ambient</target><input>in0</input></payload-out>
                <payload-out><target>gateway</target></payload-out>
                <payload-out><target>housekeeping</target></payload-out>
                <payload-in>true</payload-in>
            </compute>
            <compute name="temp2">
                <format>i16_be</format>
                <function>to_kelvin</function>
                <offset>273.15</offset>
                <scale>0.0625</scale>
                <payload-out><target>ambient</target><input>in1</input></payload-out>
                <payload-out><target>gateway</target></payload-out>
                <payload-out><target>housekeeping</target></payload-out>
                <payload-in>true</payload-in>
            </compute>
            <compute name="temp3">
                <format>u24_be</format>
                <function>to_kelvin</function>
                <offset>255.37</offset>
                <scale>0.0078</scale>
                <payload-out><target>ambient</target><input>in2</input></payload-out>
                <payload-out><target>gateway</target></payload-out>
                <payload-out><target>housekeeping</target></payload-out>
                <payload-in>true</payload-in>
            </compute>
            <!-- setpoint is set from the ground; half_band is how far -->
            <!-- either side of it the heaters are switched at, the setpoint -->
            <!-- being in the middle of the band. -->
            <compute name="thermostat">
                <function>hysteresis</function>
                <half_band>2.0</half_band>
                <setpoint>293.15</setpoint>
                <!-- asserted below the setpoint, unasserted above it. Two -->
                <!-- heaters, because one failing must not leave the mass -->
                <!-- with no way to be warmed: either alone holds the band, -->
                <!-- and both together hold it twice as fast. -->
                <gateway-out><target>heaters_1</target></gateway-out>
                <gateway-out><target>heaters_2</target></gateway-out>
                <payload-out><target>gateway</target></payload-out>
                <payload-out><target>housekeeping</target></payload-out>
                <payload-in>true</payload-in>
            </compute>
        </type>
        <type name="log">
            <compute name="housekeeping">
                <directory>/tmp/telemetry</directory>
                <format>variable_ts_rc</format>
                <payload-in>true</payload-in>
            </compute>
        </type>
    </vehicle>
    <payloads>
        <!-- Every payload is the far end of a UDP socket, which tcssim -->
        <!-- stands in for with nothing more than a socket, so that the -->
        <!-- example runs on any desk and touches no hardware. The buses -->
        <!-- these parts would be on aboard - I2C, SPI, GPIO - are flown -->
        <!-- against stand-ins by make stand-ins-test and make -->
        <!-- kernel-stand-ins-test. -->
        <type name="network">
            <!-- Two heaters, both near the sensors on the same thermal -->
            <!-- mass, each driven by what the thermostat decides - 1 for -->
            <!-- on, 0 for off. Separate nodes, so that one can be stopped -->
            <!-- from the ground while the other goes on holding the -->
            <!-- temperature. -->
            <payload name="heaters_1">
                <address>127.0.0.1</address>
                <port>5204</port>
                <protocol>udp</protocol>
                <gateway-in>true</gateway-in>
            </payload>
            <payload name="heaters_2">
                <address>127.0.0.1</address>
                <port>5205</port>
                <protocol>udp</protocol>
                <gateway-in>true</gateway-in>
            </payload>
            <!-- One of three sensors of the same place, a trio, so that the -->
            <!-- temperature survives one of them going wrong. Two bytes, -->
            <!-- signed, big endian. -->
            <payload name="temp_1">
                <address>127.0.0.1</address>
                <group>zone_temps</group>
                <port>5201</port>
                <protocol>udp</protocol>
                <payload-out><target>temp1</target></payload-out>
            </payload>
            <!-- The second of the trio; the same part as temp_1. -->
            <payload name="temp_2">
                <address>127.0.0.1</address>
                <group>zone_temps</group>
                <port>5202</port>
                <protocol>udp</protocol>
                <payload-out><target>temp2</target></payload-out>
            </payload>
            <!-- The third. A different part: three bytes, unsigned, its own -->
            <!-- scale and so its own conversion, so that no one part number -->
            <!-- can take the whole trio out. -->
            <payload name="temp_3">
                <address>127.0.0.1</address>
                <group>zone_temps</group>
                <port>5203</port>
                <protocol>udp</protocol>
                <payload-out><target>temp3</target></payload-out>
            </payload>
        </type>
    </payloads>
    <!-- the zone temperature the heaters are held at, in kelvin -->
    <commands>
        <from>gateway</from>
        <sets>thermostat.setpoint</sets>
    </commands>
    <tcsgui>
        <nodes>
            <node name="ambient" x="469" y="166"/>
            <node name="gateway" x="790" y="34"/>
            <node name="heaters_1" x="34" y="393"/>
            <node name="heaters_2" x="34" y="470"/>
            <node name="housekeeping" x="469" y="374"/>
            <node name="temp1" x="242" y="34"/>
            <node name="temp2" x="242" y="166"/>
            <node name="temp3" x="242" y="280"/>
            <node name="temp_1" x="34" y="34"/>
            <node name="temp_2" x="34" y="166"/>
            <node name="temp_3" x="34" y="280"/>
            <node name="thermostat" x="601" y="242"/>
        </nodes>
    </tcsgui>
</configuration>
