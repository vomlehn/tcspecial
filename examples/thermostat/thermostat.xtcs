<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <tcspecial>
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>ad9aac4dd5a6d88dd5e78824ba8a83ac</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-thermostat.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <include>../thermostat-common/thermostat</include>
    <gateways>
        <type name="gateway_radio">
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:5100</ground_base>
                <port>5000</port>
                <world-in>ambient</world-in>
                <world-in>gpio-in-tmass</world-in>
                <world-in>temp1</world-in>
                <world-in>temp2</world-in>
                <world-in>temp3</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <!-- The three sensors of the zone, two on an I2C bus and one -->
        <!-- on a SPI bus, as a vehicle would carry them. On a desk each -->
        <!-- is reached over UDP at its stand_in, where tcssim answers -->
        <!-- with the zone's temperature, so that they touch no -->
        <!-- hardware; flown, without stand-ins, the buses are opened. -->
        <type name="i2c_tmass">
            <!-- One of three sensors of the same place, a trio, so that the -->
            <!-- temperature survives one of them going wrong. Two bytes, -->
            <!-- signed, big endian. -->
            <payload name="temp_1">
                <address>0x48</address>
                <group>zone_temps</group>
                <path>/dev/i2c-1</path>
                <read_size>2</read_size>
                <stand_in>127.0.0.1:5201</stand_in>
                <world-out>temp1.temp_1</world-out>
            </payload>
            <!-- The second of the trio; the same part as temp_1, on the -->
            <!-- same bus. -->
            <payload name="temp_2">
                <address>0x49</address>
                <group>zone_temps</group>
                <path>/dev/i2c-1</path>
                <read_size>2</read_size>
                <stand_in>127.0.0.1:5202</stand_in>
                <world-out>temp2.temp_2</world-out>
            </payload>
        </type>
        <type name="spi_tmass">
            <!-- The third. A different part on a different bus: three -->
            <!-- bytes, unsigned, its own scale and so its own conversion, -->
            <!-- so that no one bus and no one part number can take the -->
            <!-- whole trio out. -->
            <payload name="temp_3">
                <group>zone_temps</group>
                <max_speed>1000000</max_speed>
                <path>/dev/spidev0.0</path>
                <read_size>3</read_size>
                <spi_mode>0</spi_mode>
                <stand_in>127.0.0.1:5203</stand_in>
                <world-out>temp3.temp_3</world-out>
            </payload>
        </type>
    </payloads>
    <tcsgui>
        <nodes>
            <node name="../thermostat-common/thermostat" x="563" y="374"/>
            <node name="gateway" x="790" y="34"/>
            <node name="temp_1" x="34" y="34"/>
            <node name="temp_2" x="34" y="166"/>
            <node name="temp_3" x="53" y="299"/>
        </nodes>
    </tcsgui>
</configuration>
