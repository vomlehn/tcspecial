<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <description>The thermostat, through Yamcs, over CCSDS</description>
    <tcspecial>
        <!-- The thermostat example with Yamcs at the ground end. The
             gateway is yamcs, so every packet on every link to the ground
             carries a CCSDS primary header: the beacon, the commands and
             their answers, and each reading and decision the gateway node
             sends down. Each link says its APID; the gateway node's
             sources count theirs on from its apid_base.

             Every port is in the seventeen thousands, which no other
             example uses, so this one can be left running beside the
             thermostat example itself. -->
        <beacon>
            <apid>0x110</apid>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:17510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:17500</send>
        </beacon>
        <gateway>yamcs</gateway>
        <interface>ad9aac4dd5a6d88dd5e78824ba8a83ac</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:17300</dest_base>
            <source_base>127.0.0.1:17310</source_base>
        </payload_command>
        <!-- A payload nothing in the drawing touches would report to
             dest_base plus its device id, as telemetry of APID apid_base
             plus that device id. This vehicle has none, but a
             configuration that answers to Yamcs says where their APIDs
             would begin all the same. -->
        <payload_telemetry>
            <apid_base>0x500</apid_base>
            <dest_base>127.0.0.1:17410</dest_base>
            <source_base>0.0.0.0:17400</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-thermostat-yamcs.state</state_file>
        <!-- Yamcs sends its commands from a port the system chooses, and
             takes the answers on the same socket, so the commands are taken
             from any port of this host - port 0 - and each answer goes back
             to the port its command came from. -->
        <tcs_cmd>
            <apid>0x111</apid>
            <recv>0.0.0.0:17200</recv>
            <send>127.0.0.1:0</send>
        </tcs_cmd>
    </tcspecial>
    <include name="thermostat-common" path="../thermostat-common/thermostat"/>
    <gateways>
        <type name="gateway_yamcs">
            <!-- Yamcs's end of the link. Each reading drawn into this node
                 comes down to Yamcs at ground_base plus its source's device
                 id (temp3 is the eighth of the twelve names, here and in
                 the file this one includes, device id 7, so 17707) as
                 telemetry of APID apid_base plus that device id, 0x407.
                 What Yamcs sends up to address:port goes as a telecommand
                 of APID apid_base. -->
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <apid_base>0x400</apid_base>
                <ground_base>127.0.0.1:17700</ground_base>
                <port>17600</port>
                <world-in>ambient</world-in>
                <world-in>gpio-out-tmass1</world-in>
                <world-in>gpio-out-tmass2</world-in>
                <world-in>temp1</world-in>
                <world-in>temp2</world-in>
                <world-in>temp3</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <!-- The three sensors of the zone, two on an I2C bus and one -->
        <!-- on a SPI bus, as a vehicle would carry them. On a desk each -->
        <!-- is reached over UDP at its sim_address, where tcssim answers -->
        <!-- with the zone's temperature, so that they touch no -->
        <!-- hardware; flown, with no simulated devices, the buses are -->
        <!-- opened. -->
        <type name="i2c_tmass">
            <!-- One of three sensors of the same place, a trio, so that the -->
            <!-- temperature survives one of them going wrong. Two bytes, -->
            <!-- signed, big endian. -->
            <payload name="temp_1">
                <address>0x48</address>
                <group>zone_temps</group>
                <path>/dev/i2c-1</path>
                <read_size>2</read_size>
                <sim_address>127.0.0.1:17801</sim_address>
                <world-out>temp1.temp_1</world-out>
            </payload>
            <!-- The second of the trio; the same part as temp_1, on the -->
            <!-- same bus. -->
            <payload name="temp_2">
                <address>0x49</address>
                <group>zone_temps</group>
                <path>/dev/i2c-1</path>
                <read_size>2</read_size>
                <sim_address>127.0.0.1:17802</sim_address>
                <world-out>temp2.temp_2</world-out>
            </payload>
        </type>
        <type name="spi_tmass">
            <!-- The third. A different part on a different bus: three -->
            <!-- bytes, unsigned, its own scale and so its own conversion, -->
            <!-- so that no one bus and no one part number can take the -->
            <!-- whole trio out. -->
            <payload name="temp_3">
                <group>zone_temps</group>
                <max_speed>1000000</max_speed>
                <path>/dev/spidev0.0</path>
                <read_size>3</read_size>
                <spi_mode>0</spi_mode>
                <sim_address>127.0.0.1:17803</sim_address>
                <world-out>temp3.temp_3</world-out>
            </payload>
        </type>
    </payloads>
    <tcsgui>
        <nodes>
            <node name="thermostat-common" x="242" y="166"/>
            <node name="gateway" x="790" y="34"/>
            <node name="temp_1" x="34" y="34"/>
            <node name="temp_2" x="34" y="166"/>
            <node name="temp_3" x="34" y="280"/>
        </nodes>
    </tcsgui>
</configuration>
