# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "A payload that is a program, sending a line of text a word at a
  time"

tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-simple-app.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

gateway:
  # The ground's end of the vehicle's data. tcspecial sends
  # what each node drawn into it produces as UDP datagrams to
  # ground_base's address, at its port plus that node's
  # device id: lorem is id 1, so its words go to 127.0.0.1:5101. Ground
  # software gets them from this node with a function call,
  # tcslib::gateway::GatewayReceiver::receive: run `lorem_gateway` to be that
  # ground. It states no address or port of its own, because nothing comes back
  # up.
  - name: gateway-1
    type: gateway_radio
    ground_base: "127.0.0.1:5100"
    payload-in: true

payloads:
  # A payload that is a program rather than a device: it is never
  # asked, and reports one word of its line at a time, then a packet
  # holding the line terminator. `app-payload-arg` is which line it
  # sends, counting from one.
  # 
  # The program is a Python 3 script beside this file, named relative
  # to the repository's root because that is where tcspecial is
  # run from: see examples/Makefile.
  - name: lorem
    type: app_pl
    app-payload-arg: "1"
    executable: "examples/simple-app/lorem_pl.py"
    payload-out:
      - target: gateway-1

tcsgui:
  nodes:
    - { name: gateway-1, x: 790, y: 129 }
    - { name: lorem, x: 15, y: 204 }
