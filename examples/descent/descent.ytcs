# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "A lander's terminal descent: a radar altimeter's altitude
  flown down by a guidance program throttling the engine, a Doppler
  velocimeter for the ground, and a switch that says when it is down"

tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "c4d65b8e01d6d67e37dac523e739f09a"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-descent.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

gateways:
  - type gateway_radio:
      - gateway: gateway
        address: "127.0.0.1"
        ground_base: "127.0.0.1:5100"
        port: "5000"
        world-in: [altitude, descent_rate, guidance, touchdown]

vehicle:
  - type compute:
      # The radar's two bytes are centimetres, unsigned, most significant
      # first: up to 655 metres, which is above where the descent starts.
      - compute: altitude
        format: "u16_be"
        function: "to_value"
        offset: "0"
        scale: "0.01"
        unit: "m"
        world-out:
          - gateway.altitude
          - guidance.altitude
        world-in: [radar]
      # The velocimeter's two bytes are centimetres a second, signed: up is
      # more than nought, so a descent is less.
      - compute: descent_rate
        format: "i16_be"
        function: "to_value"
        offset: "0"
        scale: "0.01"
        unit: "m/s"
        world-out:
          - gateway.descent_rate
        world-in: [doppler]
      # The throttle, from the altitude: a program, flying a descent that
      # slows as the ground nears and cutting the engine half a metre up. A
      # Python 3 script beside this file, named relative to the repository's
      # root because that is where tcspecial is run from. Its answers are a
      # ratio, which is what the engine's throttle takes.
      - compute: guidance
        executable: "examples/descent/guidance.py"
        function: "process"
        timeout: "1 s"
        unit: "ratio"
        moc-out:
          - engine.guidance
        world-out:
          - gateway.guidance
        world-in: [altitude]

payloads:
  # Every payload is the far end of a UDP socket, which tcssim plays, so
  # that the example runs on any desk and touches no hardware.
  - type network:
      # The Doppler velocimeter, five a second.
      - payload: doppler
        address: "127.0.0.1"
        port: "5402"
        protocol: "udp"
        world-out:
          - descent_rate.doppler
      # The engine's throttle, driven by what guidance answers.
      - payload: engine
        address: "127.0.0.1"
        port: "5404"
        protocol: "udp"
        moc-in: [guidance]
      # The radar altimeter, which sends ten readings a second.
      - payload: radar
        address: "127.0.0.1"
        port: "5401"
        protocol: "udp"
        world-out:
          - altitude.radar
      # The switch on a landing leg, whose 1 is the ground's word that the
      # lander is down: straight to the ground.
      - payload: touchdown
        address: "127.0.0.1"
        port: "5403"
        protocol: "udp"
        world-out:
          - gateway.touchdown
