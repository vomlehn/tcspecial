# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

# The vehicle the two thermostat examples share, which each includes:
# the three conversions and the vote between them, the thermostat and
# its log, the heaters and the lines that sense them, the group the
# sensors are read in, and the setpoint the ground may set. What
# differs between the two is in each example's own file: the
# tcspecial section, the gateway node, and the three sensors, whose
# ports differ so that both examples can run at once. The gateway
# node is called gateway in both, which is the name the links here
# send to it by and the command binding takes the setpoint from.

# What the examples that include this file may join: the three
# conversions, whose readings arrive from the sensors in each example's
# own file, and every reading that leaves for the gateway node there.
exports:
  world-in: [temp1, temp2, temp3]
  world-out: [ambient, gpio-in-tmass, temp1, temp2, temp3]

payload_groups:
  - name: "zone_temps"
    interval: "1 s"

vehicle:
  - type compute:
      # One temperature out of the three, by the algorithm named: median
      # takes the middle reading, closest_mean the mean of the two that
      # agree best. Either leaves a sensor that has gone wrong out of the
      # answer, which a mean over all three would not, and it produces a
      # value on every arrival, so one sensor that stops reporting is
      # outvoted rather than stopping the vehicle from deciding anything.
      - compute: ambient
        algorithm: "median"
        function: "vote"
        world-out:
          - gateway.ambient
          - thermostat.ambient
        world-in: [in0, in1, in2]
      - compute: temp1
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        world-out:
          - ambient.in0
          - gateway.temp1
          - housekeeping.temp1
        world-in: [temp_1]
      - compute: temp2
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        world-out:
          - ambient.in1
          - gateway.temp2
          - housekeeping.temp2
        world-in: [temp_2]
      - compute: temp3
        format: "u24_be"
        function: "to_kelvin"
        offset: "255.37"
        scale: "0.0078"
        world-out:
          - ambient.in2
          - gateway.temp3
          - housekeeping.temp3
        world-in: [temp_3]
      # setpoint is set from the ground; half_band is how far either side
      # of it the heaters are switched at, the setpoint being in the middle
      # of the band.
      - compute: thermostat
        function: "thermostat"
        half_band: "2.0"
        setpoint: "293.15"
        # asserted below the setpoint, unasserted above it. Two heaters, because
        # one failing must not leave the mass with no way to be warmed: either
        # alone holds the band while the orbit is warm, and both together hold
        # it in the cold too, each switched through a line of its own. What it
        # decides goes to the heaters and the log and not to the ground: the
        # ground is told what the heaters are doing, by gpio-in-tmass, which a
        # heater that has failed does not hide.
        moc-out:
          - gpio-out-tmass1.thermostat
          - gpio-out-tmass2.thermostat
        world-out:
          - housekeeping.thermostat
        world-in: [ambient]
  - type log:
      - compute: housekeeping
        directory: "/tmp/telemetry"
        format: "variable_ts_rc"
        world-in: [gpio-in-tmass, temp1, temp2, temp3, thermostat]

payloads:
  # The heaters and the lines that sense them, on the thermal mass, through
  # the kernel's simulated chip, which bin/mk-kernel-stand-ins makes: lines
  # 2 to 5, which leaves 0 and 1 to the gpio example.
  - type gpio:
      # Two lines on the thermal mass, one sensing each heater: high while it
      # is heating. Read every second for what they are, rather than for
      # when they change, so the ground hears the heaters' state on a beat
      # and a lost report is made good by the next; one bit a line, each a
      # sixteen-byte record -- when, which line, what it is -- to the ground
      # and the log. Disabled from the ground, it reports nothing at all.
      - payload: gpio-in-tmass
        edge: "none"
        lines: "2,3"
        path: "/dev/gpiochip1"
        state_interval: "1 s"
        world-out:
          - gateway.gpio-in-tmass
          - housekeeping.gpio-in-tmass
      # The two heaters' switches, each a line the thermostat drives -- 1 for
      # on, 0 for off. One payload each, so that one can be stopped from the
      # ground while the other goes on warming the mass.
      - payload: gpio-out-tmass1
        direction: "output"
        lines: "4"
        path: "/dev/gpiochip1"
        moc-in: [thermostat]
      - payload: gpio-out-tmass2
        direction: "output"
        lines: "5"
        path: "/dev/gpiochip1"
        moc-in: [thermostat]

commands:
  # the zone temperature the heaters are held at, in kelvin
  - { from: gateway, sets: thermostat.setpoint }

tcsgui:
  nodes:
    - { node: ambient, x: 469, y: 166 }
    - { node: gpio-in-tmass, x: 91, y: 544 }
    - { node: gpio-out-tmass1, x: 34, y: 393 }
    - { node: gpio-out-tmass2, x: 34, y: 469 }
    - { node: housekeeping, x: 469, y: 450 }
    - { node: temp1, x: 261, y: 34 }
    - { node: temp2, x: 261, y: 166 }
    - { node: temp3, x: 261, y: 280 }
    - { node: thermostat, x: 601, y: 242 }
