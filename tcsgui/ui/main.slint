import { Button, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";

// The two scales, stated once.
//
// Every padding, gap and text size in this window comes from here. They were
// literals before -- 4, 6, 8 and 10 pixels of padding, six different text
// sizes -- each chosen when the piece it was in got written, which is how a
// window comes to look assembled rather than designed. A scale also answers
// the question a literal provokes: "why is this one different" has an answer
// when the answer is "it is the next step up".
export global Space {
    // Four steps, doubling. Enough for every gap this window needs and few
    // enough to be remembered.
    out property <length> tight: 4px;
    out property <length> step: 8px;
    out property <length> wide: 16px;
    out property <length> room: 24px;
}

export global Type {
    // Four steps. The per-node label sizes are not from here -- they are a
    // channel for telling node types apart and live in style.rs -- but
    // everything the window says in its own voice is.
    out property <length> small: 10px;
    out property <length> body: 12px;
    out property <length> strong: 14px;
    out property <length> title: 18px;

    // And the two weights a system face is sure to have.
    out property <int> regular: 400;
    out property <int> bold: 700;
}


// What a node looks like on the canvas, and the rules the looks obey.
//
// Two rules, and both are enforced in Rust as well -- see style.rs, whose
// tests fail if either is broken:
//
//   * nothing is told apart by colour alone. Every node type differs from
//     every other in at least two of outline, border width, shading and size,
//     so a reader who sees no colour still sees distinguishable shapes.
//   * red means something is wrong. No type, no selection and no link is red.
//
// Everything here is drawn from Slint's own primitives: a Rectangle with
// square corners, one with a border-radius, one with a radius of half its
// width for a circle, and Rectangles a pixel or two wide for lines. No images
// and no icon font, so nothing can fail to load.

// One terminal of a node: whether this type has it, and where it is drawn.
//
// The geometry is computed in Rust -- see style::terminal_at -- for the reason
// the link routes are: arithmetic in a layout language is hard to read and
// impossible to test.
// One thing that might be wrong, as the concerns window shows it.
export struct ConcernRow {
    // The sentence: which node, and what about it.
    said: string,
    // The node it is about, which is what "go to it" goes to.
    node: string,
}

export struct TerminalView {
    shown: bool,
    x: length,
    y: length,
    // Whether the arrow points right, which is to say towards the payloads,
    // and so which arrow is drawn. See style::Corner::rightward.
    rightward: bool,
}

export struct NodeView {
    name: string,
    // The type's spelling, which is the configuration's word for it.
    node-type: string,
    x: length,
    y: length,
    width: length,
    height: length,
    // square | rounded | circle | keyed | pointed
    outline: string,
    // The outline as path data, in this node's own coordinates, for the
    // outlines a corner radius cannot draw. Empty for the ones it can, which
    // is every outline but the pointed one. Rust's arithmetic rather than the
    // markup's, for the same reason the link routes are: see style::shape_of.
    shape: string,
    // solid | hatched | open | double
    shading: string,
    border: length,
    // How the label is set: the fifth channel that is not colour. A face, a
    // size, a weight and an italic, chosen per type in style.rs.
    face: string,
    label-size: length,
    label-weight: int,
    label-italic: bool,
    tint: color,
    // Something is wrong with this node, which is what paints it red: the
    // outline, the label and the terminals, so colour is never the only thing
    // carrying it -- a faulty node is also drawn in the one shape no real type
    // uses.
    //
    // What is wrong is not here. It was drawn under the name, which is a
    // sentence inside a box forty-eight pixels tall and a paragraph in the
    // middle of a diagram; it is said in the node's own window, and put in
    // front of somebody once in the alert. See tcsgui::Views::alert_faults.
    faulty: bool,
    selected: bool,
    // What a closed subdiagram holds: how many nodes, and how many lines
    // cross its edge. Empty for every other type.
    //
    // A node's own comment is not here any more: a note somebody wrote about a
    // sensor belongs in that node's window, beside the attributes it is about,
    // and on the canvas it was a paragraph in the middle of a diagram.
    summary: string,
    // Whether this node is a diagram of its own and can be opened.
    openable: bool,
    // Which terminals this type has, drawn as a small rectangle in a corner
    // with an arrow pointing the way the data goes. Only the ones the type
    // actually has: a drawing that showed four on every node would be a
    // drawing that says nothing about what may be linked to what.
    //
    // Two rows, which are the two streams. Along the top, left to right, what
    // the ground sends: it arrives at `moc-in` and leaves at `moc-out`.
    // Along the bottom, right to left, what comes back: it arrives at
    // `payload-in` and leaves at `payload-out`. The arrows therefore point the
    // way the canvas itself is laid out -- the ground is the leftmost working
    // pane and the payloads the rightmost -- so a reader who has worked that
    // out once need not read the names again. The table is in style.rs, taken
    // from tcslibgs::graph::terminals.
    moc-in: TerminalView,
    moc-out: TerminalView,
    payload-in: TerminalView,
    payload-out: TerminalView,
    // How much room a terminal takes along an edge, which is what the label
    // is padded by on whichever side carries one. From style.rs, like the
    // sizes above, so that the one statement of how large a terminal is
    // drawn is the one the box and the padding are both taken from.
    terminal-column: length,
}

// One row of the palette: a family's heading, or a type to place.
//
// Headings in the list rather than a nested model: Slint's `for` takes one
// model, and a list with a flag in it is simpler to build and to read than a
// model of models.
export struct PaletteEntry {
    heading: string,
    node: NodeView,
    is-heading: bool,
    // What the editor fills in on a node placed from this entry, as
    // `name=value` pairs separated by semicolons.
    //
    // What makes one node type into several things to place: `compute` is one
    // type, and `mean`, `hysteresis`, `to_kelvin` and `process` are four
    // entries, each a compute node with its `function` already answered. The
    // pairs come from the description tree -- see tcsgui/share/nodes -- and
    // travel as text because a callback's arguments do.
    sets: string,
}

// One field of the panel: an attribute of the selected node.
export struct FieldView {
    name: string,
    value: string,
    // Whether the configuration must state this one, which the panel says
    // with a mark beside the name.
    //
    // Said and not insisted on. The editor is lazy: a field left empty is a
    // question not yet answered, and an editor that marked it in red would be
    // calling an unfinished node a broken one. What must be answered before a
    // configuration flies is checked on the ground and aboard, where the
    // complaint can name the file and the line.
    required: bool,
    // A rule across the panel with this name on it, rather than a field.
    //
    // What divides a node's own attributes from the settings the simulator
    // file gives it: two files, one panel, and a line to say where one ends
    // and the other begins.
    is-heading: bool,
    // Whether this field belongs to the simulator's file rather than to the
    // configuration.
    //
    // The panel shows both and they are written to different files, so each
    // row has to say which it is: the two go to different callbacks and are
    // recorded as different edits.
    simulated: bool,
}

// One attribute a group sets on every payload in it.
//
// Apart from FieldView because the question is different. A node's field is
// filled in or not; a group's field is filled in, not filled in, or filled in
// differently on different payloads -- and the third is worth saying, because
// typing into the field will overwrite all of them.
export struct GroupFieldView {
    name: string,
    value: string,
    differs: bool,
}

export struct LinkView {
    // What it is drawn in, which says which stream it carries: the payload's
    // own data in the payloads' family, what the ground sends in the ground's.
    // One shade lighter than the lightest node of that panel, so a line reads
    // as a line. See tcsgui::line_ink.
    ink: color,
    // The route, the arrowhead at its end, and the marker in the middle of its
    // longest run, as SVG path data in canvas coordinates.
    //
    // Computed in Rust -- see route.rs -- because a route is arithmetic, and
    // arithmetic in a layout language is hard to read and impossible to test.
    // Three paths because one is stroked and the others filled, and a Path
    // takes one of each.
    route: string,
    head: string,
    marker: string,
    // Where the label goes, which is the only geometry the markup still needs.
    label-x: length,
    label-y: length,
    // A link into a named input is drawn wide, one into a node's only input
    // narrow. A second channel beside the label, so a crowded diagram can be
    // read without tracing every line to its end.
    wide: bool,
    label: string,
    // What somebody wrote about this connection.
    comment: string,
}

// Diagonal hatching, drawn with narrow lines inside whatever shape asks for
// it.
//
// A Path rather than a row of rotated rectangles: a Rectangle has no rotation,
// and a Path is what Slint draws lines with. The pattern is stated once in a
// hundred-by-hundred viewbox and scaled to the element, so one string serves
// every size of node, and the parent clips it so a circle's hatching stays
// inside the circle.
component Hatching inherits Rectangle {
    in property <color> ink;
    clip: true;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: ink;
        stroke-width: 1px;
        commands: "M 0 40 L 40 0 M 0 70 L 70 0 M 0 100 L 100 0 M 30 100 L 100 30 M 60 100 L 100 60";
    }
}

// One terminal of a node: where a link may be attached.
//
// A rectangle with an arrow in it, and the arrow is the whole point -- the
// name says which way the data travels and so does the arrow, so the drawing
// and the file say the same thing. Drawn as one filled path in a viewbox the
// size of the box, which is how everything else here is drawn: no image and no
// icon font, so nothing can fail to load.
component Terminal inherits Rectangle {
    in property <color> ink;
    // Whether the arrow points right, which is to say towards the payloads.
    in property <bool> rightward;
    // Whether this is where data arrives. Both kinds answer a press, because
    // a link may be drawn either way about: from the source that feeds it or
    // from the sink that wants feeding. Which was pressed is what says which
    // end of the link the other one is.
    in property <bool> sink;


    // A link is being drawn from this terminal, and then let go of -- at this
    // point, measured from the terminal's own corner.
    //
    // The release is reported by the terminal the gesture *started* on, not by
    // the one it finished over, because that is how a pointer works: a press
    // grabs it, so every event until the release goes to the thing that was
    // pressed. What is under the pointer at the end is a question about where
    // the nodes are, and the answer is worked out in Rust where the geometry
    // is -- see `terminal_under`.
    callback grabbed();
    callback released(length, length);
    // And where the pointer is while it is held, so the line being drawn can
    // follow it: reported by the terminal the gesture started on, as the
    // release is, because a press grabs the pointer.
    callback dragged(length, length);

    width: 24px;
    height: 10px;
    border-width: 1px;
    border-color: ink;
    border-radius: 1px;
    // Filled while the pointer is over it, as the old round handles were: a
    // target that answers the pointer is a target somebody can see they have
    // hit before they let go.
    background: touch.has-hover ? ink.with-alpha(0.45) : ink.with-alpha(0.10);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                grabbed();
            }
            if (event.kind == PointerEventKind.up) {
                released(self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                dragged(self.mouse-x, self.mouse-y);
            }
        }
    }

    // The arrow, which says which way the data on this terminal travels
    // across the canvas: the ground is the leftmost working pane and the
    // payloads the rightmost, so the payload's own data points left and what
    // the ground sends points right.
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 10;
        fill: ink;
        commands: rightward
            ? "M 4 3.5 L 13 3.5 L 13 1 L 20 5 L 13 9 L 13 6.5 L 4 6.5 Z"
            : "M 20 3.5 L 11 3.5 L 11 1 L 4 5 L 11 9 L 11 6.5 L 20 6.5 Z";
    }
}

// One node.
//
// The outline is chosen by name rather than by a number so that the markup
// reads as the table in style.rs does: square corners are hardware, rounded
// are software aboard, a circle is an end of the graph, and a keyed rectangle
// is an interface that is driven rather than read.
component NodeShape inherits Rectangle {
    in property <NodeView> node;
    // Whether this one can be dragged. False in the palette, where a press
    // places a node rather than moving this one.
    in property <bool> draggable: false;
    // Whether the panel is showing this one.
    in property <bool> selected: false;
    // Told once, when the gesture finishes: one edit for one drag, so undo
    // takes a node back to where it started rather than one pixel back.
    callback dragged(length, length);
    // This node is a diagram of its own and somebody asked to see it.
    callback open-requested();
    // A link is being drawn: pressed on the handle of one node, released over
    // another.
    // A link is being drawn: the terminal pressed is remembered, and where
    // the pointer was let go of says what the other end is. The name of the
    // terminal pressed is the whole of what the first half says; the second
    // half is a point on the canvas.
    callback link-from(string);
    callback link-dropped(length, length);
    // Where the pointer is while a line is being drawn from one of this
    // node's terminals. See Terminal::dragged.
    callback link-dragging(length, length);
    // This node was pressed, so it is the one the panel should show.
    callback chosen();
    // What the menu a click opens asks for: the node's attributes, or the
    // node's removal. See the menu itself, below the grip.
    callback edit-requested();
    callback delete-requested();

    // The error colour, and the only place in this file it appears.
    //
    // A single definition so that "is anything red" is a question with one
    // answer: if this is the only red, then red on the canvas means a fault
    // and nothing else.
    property <color> error-ink: #c0392b;

    property <color> ink: node.faulty ? error-ink : node.tint;

    // While a drag is running the node follows the pointer by this much, and
    // the document still says where it was: nothing is recorded until the
    // gesture ends.
    property <length> drag-x: draggable && grip.pressed
        ? grip.mouse-x - grip.pressed-x
        : 0px;
    property <length> drag-y: draggable && grip.pressed
        ? grip.mouse-y - grip.pressed-y
        : 0px;

    x: node.x;
    y: node.y;
    width: node.width;
    height: node.height;
    background: transparent;

    // Everything that is drawn, offset by the drag.
    //
    // The drawn parts move and the node does not, which is what makes a drag
    // measurable at all. `grip` below is a child of the node rather than of
    // this, so its coordinates stay where the node was for as long as the
    // gesture lasts -- and an offset measured in a frame that the offset
    // itself moves cancels every movement it makes. A node bound the other way
    // round sits exactly where it started, however far it is dragged, which is
    // what it used to do.
    //
    // Nothing is lost by the grip staying put: a press grabs the pointer, so
    // the events keep arriving wherever the pointer goes.
    moving := Rectangle {
        x: drag-x;
        y: drag-y;
        width: 100%;
        height: 100%;
        background: transparent;
        // The shape itself. One Rectangle, with the corner radius saying
        // which outline this is: 0 for square, a quarter of the height for
        // rounded, half the width for a circle. A keyed shape is this with a
        // corner squared off by the triangle below it.
        //
        // An outline a radius cannot draw arrives as path data instead, and
        // then this Rectangle keeps the geometry and the shadow and draws
        // neither border nor ground: the paths below it are the shape.
        body := Rectangle {
            width: 100%;
            height: 100%;
            // A hover state everywhere one is possible. The handles and the open
            // mark had one and the node itself did not, which reads as half
            // finished -- and a surface that answers the pointer is a surface
            // whose parts look pressable before they are pressed.
            border-width: node.shape != ""
                ? 0px
                : (grip.has-hover ? node.border + 1px : node.border);
            border-color: ink;

            // While it is being dragged, a node lifts off the canvas. Not
            // decoration: a drag that has started and a press that has not look
            // identical otherwise, and the one thing a person wants to know
            // mid-gesture is whether the thing is moving.
            drop-shadow-blur: grip.pressed ? 12px : 0px;
            drop-shadow-color: grip.pressed ? #00000033 : transparent;
            drop-shadow-offset-y: grip.pressed ? 3px : 0px;
            // Half the shorter side, not half the width: every node is one
            // width now, so an end of the graph is wider than it is tall and
            // half its width would be a radius larger than the shape.
            border-radius: node.outline == "circle"
                ? min(self.width, self.height) / 2
                : node.outline == "rounded"
                    ? self.height / 4
                    : 0px;
            background: node.shape != ""
                ? transparent
                : (node.shading == "solid"
                    ? ink.with-alpha(0.18)
                    : node.shading == "double"
                        ? ink.with-alpha(0.08)
                        : transparent);

            // A shaped outline: the path, stroked and filled the way the
            // Rectangle above would have been. One pixel to one coordinate --
            // the viewbox is the node's own size -- so the line keeps its
            // width instead of being stretched with the shape.
            //
            // Dropped three pixels under itself while dragging, which is the
            // lift the Rectangle gets from its drop-shadow: a Path has none,
            // and the one thing a person wants to know mid-gesture is whether
            // the thing is moving. Drawn first, so it is under the shape.
            if node.shape != "" && grip.pressed: Path {
                y: 3px;
                width: 100%;
                height: 100%;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: node.shape;
                fill: #00000033;
            }
            if node.shape != "": Path {
                width: 100%;
                height: 100%;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: node.shape;
                stroke: ink;
                stroke-width: grip.has-hover ? node.border + 1px : node.border;
                fill: node.shading == "solid"
                    ? ink.with-alpha(0.18)
                    : node.shading == "double"
                        ? ink.with-alpha(0.08)
                        : transparent;
            }

            // Hatched shading, inside whatever the outline turned out to be.
            if node.shading == "hatched": Hatching {
                width: 100%;
                height: 100%;
                ink: ink.with-alpha(0.45);
                border-radius: parent.border-radius;
            }

            // The second outline of a doubled shape, which is the third
            // non-colour channel at work: a doubled square and a solid square
            // differ without either of them being a different colour.
            if node.shading == "double": Rectangle {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                border-width: 1px;
                border-color: ink;
                border-radius: max(0px, parent.border-radius - 3px);
                background: transparent;
            }
        }

        // The key: a square corner cut into an otherwise rounded shape, which is
        // what says "driven" without a word or a colour.
        if node.outline == "keyed": Rectangle {
            x: 0;
            y: 0;
            width: root.width / 4;
            height: node.border;
            background: ink;
        }
        if node.outline == "keyed": Rectangle {
            x: 0;
            y: 0;
            width: node.border;
            height: root.height / 4;
            background: ink;
        }

        // The name, and under it the type. The type is shown always and not only
        // on hover: a diagram whose shapes have to be remembered is a diagram that
        // is read wrongly under pressure.
        //
        // Padded away from whichever side carries terminals, and horizontally
        // rather than vertically: the label stays where it was, in the middle
        // of the node, and simply stops short of the corner boxes. Reserving
        // a row at the top and the bottom instead would leave sixteen pixels
        // for a name on the shortest node.
        VerticalLayout {
            padding: Space.tight;
            padding-left: (node.moc-in.shown || node.payload-out.shown)
                ? node.terminal-column : Space.tight;
            padding-right: (node.moc-out.shown || node.payload-in.shown)
                ? node.terminal-column : Space.tight;
            spacing: 1px;
            alignment: center;

            Text {
                text: node.name;
                font-family: node.face == "mono" ? "monospace" : "";
                font-size: node.label-size;
                font-weight: node.label-weight;
                font-italic: node.label-italic;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: node.node-type;
                font-family: node.face == "mono" ? "monospace" : "";
                font-size: Type.small;
                horizontal-alignment: center;
                overflow: elide;
            }
            // What a closed subdiagram holds: how many nodes, and how many
            // lines cross its edge. The two things worth knowing about a
            // diagram you are not looking at.
            //
            // Not a node's comment, which this used to show as well. A note
            // somebody wrote about a sensor belongs in that node's own window,
            // beside the attributes it is about: on the canvas it was a
            // paragraph in the middle of a diagram, and a diagram is read for
            // its shape.
            if node.summary != "": Text {
                text: node.summary;
                font-size: Type.small;
                font-italic: true;
                color: #555555;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // A subdiagram is opened from a mark in its own corner.
        //
        // Not a double press on the box: a single press already drags it, and a
        // gesture that means one thing or another depending on timing is a
        // gesture that does the wrong one under pressure. A mark that says
        // "there is more in here" is also the only hint a closed box gives that
        // it can be opened at all.
        // The middle of the top edge, which is the one place on a node that
        // no terminal is in: the four of them hold the four corners.
        if node.openable: Rectangle {
            x: (root.width - 14px) / 2;
            y: 4px;
            width: 14px;
            height: 14px;
            border-width: 1px;
            border-color: ink;
            background: open-touch.has-hover ? ink.with-alpha(0.25) : transparent;

            // Two narrow lines making a cross, which reads as "expand" without a
            // word or an icon file.
            Rectangle {
                x: 3px;
                y: 6px;
                width: 8px;
                height: 1px;
                background: ink;
            }
            Rectangle {
                x: 6px;
                y: 3px;
                width: 1px;
                height: 8px;
                background: ink;
            }

            open-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: MouseCursor.pointer;
                clicked => { open-requested(); }
            }
        }

        // The area a drag is taken from, over the whole node so that a press
        // anywhere on it moves it.
        //
        // Last so it is above the shape and the label; a TouchArea under them
        // would be a node that can only be dragged by its edges.
        if selected: Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-width: 2px;
            border-color: #333333;
            border-radius: body.border-radius + 4px;
            background: transparent;
        }
    }

    // What a click on a node offers. Shown by the grip below, at the point
    // that was pressed, rather than by a right-click: a left click is what
    // somebody does to a thing they want something from, and this window has
    // nowhere else to put a node's own commands -- a node is not in the menu
    // bar, which is for the configuration as a whole.
    //
    // First among the node's children, so the grip and the terminals are
    // above it and a press reaches them: this one is here to be shown by
    // name, not to answer the pointer itself.
    menu := ContextMenuArea {
        enabled: draggable;
        Menu {
            // Edit first, because it is what nearly every click wants, and it
            // is what a click used to do on its own.
            MenuItem {
                title: "Edit";
                activated => { root.edit-requested(); }
            }
            MenuItem {
                title: "Delete";
                activated => { root.delete-requested(); }
            }
        }
    }

    grip := TouchArea {
        width: 100%;
        height: 100%;
        enabled: draggable;
        mouse-cursor: draggable ? MouseCursor.grab : MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                // Choosing and dragging are the same press: a node you have
                // started to move is the node you are interested in, and
                // making them separate gestures would mean pressing twice to
                // do the obvious thing.
                chosen();
            }
            if (event.kind == PointerEventKind.up) {
                // A press that moved nothing is a click, and a click asks what
                // there is to do with this node. One that moved is a drag, and
                // the editor is told where the node went.
                //
                // Told apart here rather than in Rust because the menu has to
                // be shown by the element that owns it, at the point that was
                // pressed. Rust is told only about the drag, and still asks
                // the same question of it -- a gesture that works out to no
                // movement records no edit.
                if (self.mouse-x == self.pressed-x && self.mouse-y == self.pressed-y) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                } else {
                    dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
    }

    // The terminals: a link may be attached to each, and a type is drawn with
    // the ones it has and no others. In its corners, inside the shape, so that
    // the box a person presses and the box the line arrives at are the same
    // box.
    //
    // After the grip and not inside `moving`, which is a choice about what a
    // press on a corner means: the grip covers the whole node, so anything
    // under it is a thing the pointer cannot reach, and a press on a terminal
    // has to draw a link rather than start a drag. The drag offset is applied
    // here by hand for the same reason -- these are outside the group that
    // carries it, and a terminal that stayed put while its node moved would be
    // a line attached to where the node used to be.
    if node.moc-in.shown: Terminal {
        x: node.moc-in.x + drag-x;
        y: node.moc-in.y + drag-y;
        rightward: node.moc-in.rightward;
        dragged(x, y) => {
            link-dragging(node.x + node.moc-in.x + x, node.y + node.moc-in.y + y);
        }
        sink: true;
        ink: ink;
        grabbed => { link-from("moc-in"); }
        released(x, y) => {
            link-dropped(node.x + node.moc-in.x + x, node.y + node.moc-in.y + y);
        }
    }
    if node.moc-out.shown: Terminal {
        x: node.moc-out.x + drag-x;
        y: node.moc-out.y + drag-y;
        rightward: node.moc-out.rightward;
        dragged(x, y) => {
            link-dragging(node.x + node.moc-out.x + x, node.y + node.moc-out.y + y);
        }
        sink: false;
        ink: ink;
        grabbed => { link-from("moc-out"); }
        // Where the pointer was let go of, in the canvas's own coordinates:
        // the node is placed at node.x and the terminal sits at its own offset
        // inside it, so the two and the pointer's offset from the terminal's
        // corner are the whole of it.
        released(x, y) => {
            link-dropped(node.x + node.moc-out.x + x, node.y + node.moc-out.y + y);
        }
    }
    if node.payload-in.shown: Terminal {
        x: node.payload-in.x + drag-x;
        y: node.payload-in.y + drag-y;
        rightward: node.payload-in.rightward;
        dragged(x, y) => {
            link-dragging(node.x + node.payload-in.x + x, node.y + node.payload-in.y + y);
        }
        sink: true;
        ink: ink;
        grabbed => { link-from("payload-in"); }
        released(x, y) => {
            link-dropped(
                node.x + node.payload-in.x + x,
                node.y + node.payload-in.y + y
            );
        }
    }
    if node.payload-out.shown: Terminal {
        x: node.payload-out.x + drag-x;
        y: node.payload-out.y + drag-y;
        rightward: node.payload-out.rightward;
        dragged(x, y) => {
            link-dragging(node.x + node.payload-out.x + x, node.y + node.payload-out.y + y);
        }
        sink: false;
        ink: ink;
        grabbed => { link-from("payload-out"); }
        released(x, y) => {
            link-dropped(node.x + node.payload-out.x + x, node.y + node.payload-out.y + y);
        }
    }

    // Selection, which is a third outline rather than a colour change: a
    // selected node and a faulty one must not be confusable, and a selected
    // faulty node has to show both.
}

// One link: its route and the arrow at the end of it.
//
// Both are path data from Rust, in canvas coordinates, so this spans the whole
// canvas and gives its Paths a viewbox the same size -- one coordinate, one
// pixel. The alternative was a bounding box per link and the arithmetic to go
// with it, which is what route.rs now holds and tests instead.
//
// Stroked and filled are two Paths because Slint gives one Path one of each,
// and an arrowhead wants to be filled while a line wants to be stroked.
component LinkLine inherits Rectangle {
    in property <LinkView> link;
    // The link's own, which says which stream it carries. See LinkView::ink.
    in property <color> ink: link.ink;

    width: 100%;
    height: 100%;
    background: transparent;

    line := Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: link.route;
        stroke: ink;
        // The wide and narrow weights: a link into a named input is wide, so
        // a crowded diagram can be read without tracing every line to its
        // end. Twice what they were, because a line is what a reader of a
        // diagram follows and these are now carrying a colour as well.
        stroke-width: link.wide ? 5px : 2.5px;
        fill: transparent;
    }

    // Which way the data goes. Implied before this by which end the line left,
    // which is to say not said at all: a reader had to open the file.
    head := Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: link.head;
        fill: ink;
    }

    // And again out in the middle of the run, where there is room to see it.
    // The head sits where the line meets a node, which is the one place a
    // diagram is already crowded and the one place two links between the same
    // pair of nodes look alike; this is what tells them apart at a glance.
    if link.marker != "": Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: link.marker;
        fill: ink;
    }

    // Which input the link arrives at, where it says so. Text rather than
    // only a line weight, because a name is what the configuration file will
    // show and the two should agree.
    if link.label != "": Text {
        x: link.label-x;
        y: link.label-y - 14px;
        text: link.label;
        font-size: Type.small;
        color: ink;
    }
    // And what somebody wrote about the connection, under the line.
    if link.comment != "": Text {
        x: link.label-x;
        y: link.label-y + 4px;
        text: link.comment;
        font-size: Type.small;
        font-italic: true;
        color: #6b7280;
    }
}

// One selection pane: a heading, and one of every node type it offers.
//
// There are two of these -- the vehicle selection pane and the payload
// selection pane -- and they are the same list of the same shapes drawn the
// same way. A component rather than the markup twice, because two copies of a
// list are two places a row's height or a heading's weight gets changed in.
component SelectionPane inherits Rectangle {
    in property <string> heading: "";
    in property <[PaletteEntry]> palette: [];
    // The ground of the working pane these go in, which is what the shapes in
    // this list are coloured against: a reader picking a shape out of a list
    // on a blush ground and putting it on a blush pane has been told where it
    // goes twice, by the colour of the shape and by the colour under it.
    in property <color> ground: #f2f2f0;
    callback place-node(string, string, string);

    background: root.ground;
    border-width: 1px;
    border-color: #d8d8d4;

    ScrollView {
        VerticalLayout {
            padding: Space.step;
            spacing: Space.step;
            Text {
                text: root.heading;
                font-size: Type.body;
                font-weight: Type.bold;
                height: 18px;
            }
            // A row as tall as the shape in it. A fixed height clipped the
            // taller shapes into the row below them, which made a list of
            // fourteen types read as a list of ten and a tangle.
            for p in root.palette: Rectangle {
                height: p.is-heading ? 22px : p.node.height + Space.step;
                background: transparent;

                // A family's heading. Quiet: it is there to group the shapes
                // below it, not to be read first.
                if p.is-heading: Text {
                    x: 0;
                    y: 6px;
                    text: p.heading;
                    font-size: Type.small;
                    font-weight: Type.bold;
                    color: #6b7280;
                }

                if !p.is-heading: NodeShape {
                    node: p.node;
                }
                // The whole row, so the hit area is the row and not only the
                // shape: a rounded end's corners are not part of the shape,
                // and a press there should still place one.
                if !p.is-heading: TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.place-node(p.node.name, p.node.node-type, p.sets); }
                }
            }
            Rectangle { }
        }
    }
}

// One divider between two working panes: the line, its handle, and what a
// press lands on.
//
// A component because there are two of them and they are the same control. The
// line follows the pointer while the handle is held and the divider settles
// when the gesture ends: one change for one gesture, as a node's drag is.
component PaneDivider inherits Rectangle {
    // Where the divider is, in the window's own coordinates.
    in property <length> at: 0px;
    // How far the handle was dragged, said once when the gesture ends.
    callback moved(length);

    // The grip is a sibling of the line and not a child, so its coordinates
    // stay where the line was for as long as the gesture lasts -- an offset
    // measured in a frame the offset moves cancels itself, which is a mistake
    // this file has made once already.
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    Rectangle {
        x: at + (grip.pressed ? grip.mouse-x - grip.pressed-x : 0px);
        y: 0;
        width: grip.has-hover || grip.pressed ? 2px : 1px;
        height: 100%;
        background: grip.has-hover || grip.pressed ? #6b7280 : #cbcdd1;

        // The handle: a grooved pill halfway down the line. A line that can be
        // dragged and one that cannot look identical without it, and a control
        // nobody can see is a control nobody uses.
        Rectangle {
            x: -6px;
            y: parent.height / 2 - 20px;
            width: 13px;
            height: 40px;
            border-radius: 6px;
            border-width: 1px;
            border-color: grip.has-hover || grip.pressed ? #6b7280 : #b4b7bd;
            background: grip.pressed ? #e8e9eb : white;

            for groove in 3: Rectangle {
                x: 4px;
                y: 14px + groove * 6px;
                width: 5px;
                height: 1px;
                background: #9ca3af;
            }
        }
    }

    // What a press lands on. Wider than the line, because a line a pixel wide
    // is a line nobody can hit; before the nodes in the surface, so that a
    // node held against a divider takes a press on itself rather than losing
    // it to the divider.
    grip := TouchArea {
        x: at - 7px;
        y: 0;
        width: 15px;
        height: 100%;
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.moved(self.mouse-x - self.pressed-x);
            }
        }
    }
}

// The editing surface: a bar, three selection panes and three working panes.
//
// One component because there are two windows that need it -- the top diagram
// and each open subdiagram -- and two copies of a canvas would be two places
// for a drawing rule to be changed in. What differs between the windows is
// only what they are given: a subdiagram's window is handed its own nodes and
// its own name, and is otherwise this.
component Surface inherits Rectangle {
    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    // The line a gesture is drawing, as SVG path data in canvas coordinates,
    // and empty when no gesture is running. Dashed, and in pieces because a
    // path here has no dash pattern: see tcsgui::route::drawing.
    in property <string> drawing-route: "";
    // The two selection panes' contents, and the two working panes' geometry.
    //
    // All four come from Rust -- see style.rs and main.rs -- because which
    // types are payloads and where the divider falls are facts about a
    // configuration rather than about a window, and they are checked by tests
    // there. Stating the divider in this file as well would be stating it
    // twice.
    in property <[PaletteEntry]> moc-palette: [];
    in property <[PaletteEntry]> vehicle-palette: [];
    in property <[PaletteEntry]> payload-palette: [];
    in property <length> moc-divider: 0px;
    in property <length> vehicle-divider: 0px;
    in property <length> working-width: 0px;
    // How long the sheet is, in the coordinates the file holds: one length
    // for all three panes, which is what makes them scroll together. From
    // Rust -- see tcsgui::pane::WORKING_HEIGHT -- as the width is.
    in property <length> working-height: 0px;
    // What each working pane is painted: light, neutral, and the light end of
    // the hue family its own nodes are drawn in, so that a node's colour says
    // which pane it belongs in. From Rust -- see tcsgui::style::Ground -- for
    // the reason the tints come from there: what a colour means is a rule with
    // tests on it, and this file paints.
    in property <color> moc-ground: white;
    in property <color> vehicle-ground: white;
    in property <color> payload-ground: white;

    // How deep undo currently goes, shown rather than guessed at: a person
    // about to abandon an afternoon's work deserves to know how much of it is
    // still reachable. One history for the whole configuration, so every
    // window shows the same two numbers.
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    // What went wrong with saving, if anything. The window's one red text.
    // Where the sheet is scrolled to, and how much of it is in view.
    //
    // Two-way, because both ends of it have something to say: a person
    // scrolling moves it, and placing a node sets it so the new node is at the
    // top of the view -- see tcsgui::pane::place_in. The offset is the
    // viewport's own, which is negative as it scrolls down; Rust reads it back
    // as the top of the view.
    in-out property <length> canvas-offset: 0px;
    // How much of the sheet the window is showing, which is what decides
    // whether a place is in view.
    out property <length> canvas-view-height: sheet.visible-height;

    // How many concerns there are, and how many were set aside: see the two
    // buttons in the bar.
    in property <int> concern-count: 0;
    in property <int> aside-count: 0;
    callback show-concerns();
    callback show-aside();

    in property <string> trouble: "";
    // And what the last command did, where it did something worth saying:
    // generating the Rust writes a file somebody named and changes nothing
    // else, so silence would leave them wondering whether the menu item did
    // anything. Not red, and in the same place as "saved", that line already
    // meaning "what has just happened".
    in property <string> said: "";
    // What this surface is editing: empty for the top diagram, the
    // subdiagram's name otherwise. Shown in the bar so that two windows side
    // by side cannot be confused for one another.
    in property <string> editing: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string, string, string);
    callback node-moved(string, length, length);
    // One of the two dividers between the three working panes was dragged by
    // this much. Two callbacks and not one with a name in it: which divider
    // moved is known where the gesture happened, and a string crossing the
    // boundary would be a name to keep in step in two files.
    callback moc-divider-moved(length);
    callback vehicle-divider-moved(length);
    callback open-subdiagram(string);
    // Write every file of the configuration now.
    callback save-clicked();
    // Drawing a link: pressed on one node, released on another.
    callback link-started(string, string);
    callback link-finished(length, length);
    // Where the pointer is while a line is being drawn. See drawing-route.
    callback link-moved(length, length);
    callback node-selected(string);
    // What a node's own menu asks for: see NodeShape's menu.
    callback node-edit(string);
    callback node-delete(string);

    // Which node is drawn as chosen. What it says about itself is in a window
    // of its own -- see NodeWindow -- so this is all the canvas needs.
    in property <string> selected: "";

    background: #fbfbfa;

    VerticalLayout {
        padding: Space.step;
        spacing: Space.step;

        // The bar: what can be taken back, and anything wrong.
        bar := HorizontalLayout {
            spacing: Space.step;
            min-height: 34px;

            if editing != "": Text {
                text: editing;
                font-size: Type.strong;
                font-weight: Type.bold;
                vertical-alignment: center;
            }
            // The arrow says what the button does and the words say what it
            // will do it to, which is the half worth keeping: "Undo" on a
            // button is a label anybody could have guessed, and `move
            // "payload"` is a thing only this session knows. Colourised, so
            // the icons follow the platform's foreground and go grey with the
            // button when there is nothing to take back.
            Button {
                icon: @image-url("undo.svg");
                colorize-icon: true;
                text: undo-label;
                enabled: undo-depth > 0;
                clicked => { undo-clicked(); }
            }
            Button {
                icon: @image-url("redo.svg");
                colorize-icon: true;
                text: redo-label;
                enabled: redo-depth > 0;
                clicked => { redo-clicked(); }
            }
            // Saving needs no button -- every edit is written as it is made --
            // and there is one anyway. It writes every file of the
            // configuration now, which is what retries a write that failed
            // and what puts right a set of files left half new by a power
            // failure between two of them. It is also an answer to somebody
            // who has been taught by every other program to save their work:
            // "it is already saved" is true and unconvincing.
            //
            // A floppy disk and no word, where undo and redo keep their words:
            // theirs say what they would be undoing, which is a thing only
            // this session knows, and this one would say "Save" beside a mark
            // every program uses for it.
            Button {
                icon: @image-url("save.svg");
                colorize-icon: true;
                accessible-label: "Save";
                clicked => { root.save-clicked(); }
            }

            // What might be wrong, and what somebody has decided not to act
            // on. Counted rather than listed here: the list is a window, and
            // a bar that held it would be a bar with a paragraph in it.
            //
            // Two buttons because they are two questions. The first is "is
            // there anything I have not looked at"; the second is "what did I
            // decide to leave", which is worth being able to ask again -- a
            // decision somebody cannot find is a decision they cannot change.
            if concern-count > 0: Button {
                text: concern-count + (concern-count == 1 ? " concern" : " concerns");
                clicked => { root.show-concerns(); }
            }
            if aside-count > 0: Button {
                text: aside-count + " set aside";
                clicked => { root.show-aside(); }
            }

            Text {
                text: undo-depth + " edits can be undone";
                font-size: Type.body;
                vertical-alignment: center;
            }
            // Saving needs no button: every edit is written as it is made.
            // What it needs is somewhere to say when that failed.
            Text {
                text: trouble != "" ? trouble : (said != "" ? said : "saved");
                color: trouble == "" ? #2d6a4f : #c0392b;
                font-size: Type.body;
                font-weight: trouble == "" ? 400 : 700;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Rectangle { }
        }

        HorizontalLayout {
            spacing: Space.step;

            // The three selection panes: one of every node type, drawn as
            // it will be drawn on the canvas, so that what a shape means can
            // be looked up rather than remembered.
            //
            // Three of them because the canvas has three working panes, and a
            // shape's pane is decided by which list it came from: the ground
            // link goes on the left, everything the vehicle carries is a
            // payload and goes on the right, and the rest of the graph goes
            // in between. A single list would leave that rule to be
            // discovered by placing something and watching where it lands.
            //
            // Top to bottom in the order the panes are left to right, so the
            // two readings of the same rule agree.
            VerticalLayout {
                width: 180px;
                spacing: Space.step;

                SelectionPane {
                    heading: "MOC node types";
                    ground: root.moc-ground;
                    palette: root.moc-palette;
                    // One type, so one row: the ground link is the only thing
                    // that goes in its pane.
                    vertical-stretch: 0;
                    place-node(name, t, sets) => { root.place-node(name, t, sets); }
                }
                SelectionPane {
                    heading: "Vehicle node types";
                    ground: root.vehicle-ground;
                    palette: root.vehicle-palette;
                    vertical-stretch: 1;
                    place-node(name, t, sets) => { root.place-node(name, t, sets); }
                }
                SelectionPane {
                    heading: "Payload node types";
                    ground: root.payload-ground;
                    palette: root.payload-palette;
                    // The taller share: ten of the fourteen types are
                    // payloads, and a pane that scrolls through ten rows four
                    // at a time is a pane nobody finds the tenth in.
                    vertical-stretch: 2;
                    place-node(name, t, sets) => { root.place-node(name, t, sets); }
                }
            }

            // The canvas: one sheet, scrolled.
            //
            // The three working panes are three columns of this one sheet
            // rather than three panes of their own, which is what makes them
            // the same length and makes them scroll together. Three that
            // scrolled separately would put a link's two ends at two heights
            // that have nothing to do with each other, and a diagram whose
            // lines go off the top of one column and in at the middle of
            // another cannot be read.
            //
            // The bars are the ScrollView's own, so the horizontal one sits
            // along the bottom of all three panes and the vertical one down
            // the right of them.
            sheet := ScrollView {
                horizontal-stretch: 1;
                content-width: root.working-width;
                content-height: root.working-height;
                content-y <=> root.canvas-offset;

                canvas := Rectangle {
                    width: root.working-width;
                    height: root.working-height;
                    background: white;
                    border-width: 1px;
                    border-color: #d8d8d4;

                // The three working panes, each on its own ground.
                //
                // Under the grid and under everything else: a ground is what
                // the pane is made of, and the grid, the labels, the lines and
                // the nodes are drawn on it. The dividers are drawn over the
                // sheet, so the edge between two grounds is also a line
                // somebody can take hold of.
                Rectangle {
                    x: 0;
                    y: 0;
                    width: root.moc-divider;
                    height: 100%;
                    background: root.moc-ground;
                }
                Rectangle {
                    x: root.moc-divider;
                    y: 0;
                    width: root.vehicle-divider - root.moc-divider;
                    height: 100%;
                    background: root.vehicle-ground;
                }
                Rectangle {
                    x: root.vehicle-divider;
                    y: 0;
                    width: root.working-width - root.vehicle-divider;
                    height: 100%;
                    background: root.payload-ground;
                }

                // A faint grid, which the nodes snap to.
                //
                // It gives the surface some depth and makes the alignment
                // visible -- a diagram whose nodes line up looks deliberate,
                // and a grid is what says they are lined up rather than
                // nearly. Coarse on purpose: a dot at every snap would be
                // thousands of elements and a texture rather than a guide.
                for n in 24: Rectangle {
                    x: n * 64px;
                    y: 0;
                    width: 1px;
                    height: 100%;
                    background: #f3f4f6;
                }
                for n in 16: Rectangle {
                    x: 0;
                    y: n * 64px;
                    width: 100%;
                    height: 1px;
                    background: #f3f4f6;
                }

                // And which pane is which, left to right. Named, because
                // the rule about what may go where is worth one word at the
                // top of each: the ground link on the left, the vehicle's own
                // graph in the middle, and what it carries on the right.
                //
                // Light grey and italic, which is this window's way of saying
                // "not part of the drawing": a label in the colour and the
                // face of a node would read as something placed. The same grey
                // as the hint below.
                //
                // In the top left corner of each pane and *under* the nodes,
                // which is the order they are written in here. A node may
                // cover a label: the label is there to be found when the pane
                // is empty and when somebody has lost their bearings, and a
                // pane that reserved a row for it would be a pane with a row
                // nothing can be put in.
                Text {
                    x: Space.step;
                    y: Space.tight;
                    text: "MOC";
                    font-size: Type.small;
                    font-italic: true;
                    color: #9ca3af;
                }
                Text {
                    x: root.moc-divider + Space.step;
                    y: Space.tight;
                    text: "Vehicle";
                    font-size: Type.small;
                    font-italic: true;
                    color: #9ca3af;
                }
                Text {
                    x: root.vehicle-divider + Space.step;
                    y: Space.tight;
                    text: "Payloads";
                    font-size: Type.small;
                    font-italic: true;
                    color: #9ca3af;
                }

                // An empty canvas looks broken rather than new, so it says
                // which way out.
                if nodes.length == 0: Text {
                    x: Space.room;
                    y: Space.room;
                    text: "Press a node type on the left to place one.";
                    font-size: Type.body;
                    font-italic: true;
                    color: #9ca3af;
                }

                // Links under nodes, so a line never crosses a label.
                for l in links: LinkLine {
                    link: l;
                }
                // And the line being drawn, under them as well: it is a link
                // that is not one yet, and it follows the pointer, so it is
                // redrawn as the hand moves rather than when the document
                // changes.
                if root.drawing-route != "": Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: root.drawing-route;
                    stroke: #6b7280;
                    stroke-width: 1.25px;
                    fill: transparent;
                }
                for n in nodes: NodeShape {
                    node: n;
                    draggable: true;
                    selected: n.name == root.selected;
                    dragged(dx, dy) => { node-moved(n.name, dx, dy); }
                    open-requested => { open-subdiagram(n.name); }
                    link-from(terminal) => { link-started(n.name, terminal); }
                    link-dropped(x, y) => { link-finished(x, y); }
                    link-dragging(x, y) => { link-moved(x, y); }
                    chosen => { node-selected(n.name); }
                    edit-requested => { node-edit(n.name); }
                    delete-requested => { node-delete(n.name); }
                }
                }

                // The two lines between the three working panes, drawn over
                // the sheet rather than on it.
                //
                // Over it because a divider is a property of the panes and not
                // of what is drawn in them: on the sheet, its handle sat
                // halfway down two thousand four hundred pixels and could not
                // be reached, and the line scrolled away from the panes it
                // divides. Here each is as tall as the window shows and its
                // handle is halfway down *that*, wherever the sheet has been
                // scrolled to.
                //
                // Shifted by the sheet's own horizontal offset, so a divider
                // stays over the column it divides when the sheet is scrolled
                // sideways.
                PaneDivider {
                    width: 100%;
                    height: 100%;
                    at: root.moc-divider + sheet.content-x;
                    moved(dx) => { root.moc-divider-moved(dx); }
                }
                PaneDivider {
                    width: 100%;
                    height: 100%;
                    at: root.vehicle-divider + sheet.content-x;
                    moved(dx) => { root.vehicle-divider-moved(dx); }
                }
            }

        }
    }
}

export component MainWindow inherits Window {
    title: "TCSpecial Configuration";
    background: #fbfbfa;
    // Wide enough for both working panes and both selection panes, which is
    // what the preferred width is: 960 of working area, 180 of selection
    // panes and the gaps between them. There was a 260-pixel panel here as
    // well, and what a node says about itself is a window of its own now --
    // so the working panes have those pixels.
    //
    // The minimum is smaller because a window that cannot be made to fit a
    // screen is a window that cannot be used on it: squeezed, the right of
    // the payload working pane goes off the edge, which is a nuisance rather
    // than a failure.
    min-width: 760px;
    min-height: 600px;
    preferred-width: 1180px;
    preferred-height: 820px;

    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    // The line a gesture is drawing, as SVG path data in canvas coordinates,
    // and empty when no gesture is running. Dashed, and in pieces because a
    // path here has no dash pattern: see tcsgui::route::drawing.
    in property <string> drawing-route: "";
    // The two selection panes' contents, and the two working panes' geometry.
    //
    // All four come from Rust -- see style.rs and main.rs -- because which
    // types are payloads and where the divider falls are facts about a
    // configuration rather than about a window, and they are checked by tests
    // there. Stating the divider in this file as well would be stating it
    // twice.
    in property <[PaletteEntry]> moc-palette: [];
    in property <[PaletteEntry]> vehicle-palette: [];
    in property <[PaletteEntry]> payload-palette: [];
    in property <length> moc-divider: 0px;
    in property <length> vehicle-divider: 0px;
    in property <length> working-width: 0px;
    // How long the sheet is, in the coordinates the file holds: one length
    // for all three panes, which is what makes them scroll together. From
    // Rust -- see tcsgui::pane::WORKING_HEIGHT -- as the width is.
    in property <length> working-height: 0px;
    // Where the sheet is scrolled to, and how much of it is in view: two-way,
    // because a person scrolling moves it and placing a node sets it.
    in-out property <length> canvas-offset: 0px;
    out property <length> canvas-view-height: surface.canvas-view-height;
    in property <color> moc-ground: white;
    in property <color> vehicle-ground: white;
    in property <color> payload-ground: white;
    in property <int> undo-depth: 0;
    in property <int> redo-depth: 0;
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    // How many concerns there are, and how many were set aside: see the two
    // buttons in the bar.
    in property <int> concern-count: 0;
    in property <int> aside-count: 0;
    callback show-concerns();
    callback show-aside();

    in property <string> trouble: "";
    in property <string> said: "";
    in property <string> selected: "";

    callback undo-clicked();
    callback redo-clicked();
    callback place-node(string, string, string);
    callback node-moved(string, length, length);
    // One of the two dividers between the three working panes was dragged by
    // this much. Two callbacks and not one with a name in it: which divider
    // moved is known where the gesture happened, and a string crossing the
    // boundary would be a name to keep in step in two files.
    callback moc-divider-moved(length);
    callback vehicle-divider-moved(length);
    callback open-subdiagram(string);
    callback save-clicked();
    callback link-started(string, string);
    callback link-finished(length, length);
    // Where the pointer is while a line is being drawn. See drawing-route.
    callback link-moved(length, length);
    callback node-selected(string);
    // What a node's own menu asks for: see NodeShape's menu.
    callback node-edit(string);
    callback node-delete(string);
    // The menu asked for what tcspecial is configured with.
    callback edit-parameters();
    // Write this configuration as Rust, where the tcspecial section's
    // `rust-code` says: see tcsgui::codegen.
    callback generate-rust();
    // Every node to the top of its own pane: see the menu item.
    callback arrange();
    // And for the groups, the simulator's groups of settings, and the way
    // out.
    callback edit-groups();
    callback edit-simulator-groups();
    callback exit-requested();
    // Whether this session was given a simulator configuration at all.
    in property <bool> has-simulator: false;

    // The menu bar.
    //
    // What is in it is what belongs to the configuration as a whole rather
    // than to anything on the canvas: there is nothing to press on a diagram
    // that would mean "the configuration", or "the groups", or "the way out",
    // so a command is how each is reached.
    MenuBar {
        Menu {
            title: "File";
            // Saving needs no command -- every edit is written as it is made
            // -- and there is one anyway, for the three things the ordinary
            // case does not cover: retrying a write that failed once whatever
            // stopped it is put right, rewriting a set of files left half new
            // by a failure between two of them, and answering somebody who
            // has been taught by every other program to save their work. Both
            // files of a session go together, each written atomically.
            MenuItem {
                title: "Save";
                activated => { root.save-clicked(); }
            }
            MenuSeparator { }
            // The groups, which are not on the canvas either: a group is a set
            // of payloads read together, and which payloads those are is
            // written on the nodes rather than drawn between them.
            MenuItem {
                title: "Edit payload groups";
                activated => { root.edit-groups(); }
            }
            // The simulator's groups, where this session was given its file.
            // Disabled rather than hidden when it was not: a menu whose
            // entries come and go is a menu nobody learns, and "this needs a
            // second argument" is better said by a greyed entry than by its
            // absence.
            //
            // There is no entry for the simulated payloads themselves. A
            // payload's settings belong to a payload that is already on the
            // canvas, so they are in its own window under a rule: a window of
            // their own would be a second place to look for what one node
            // says about itself.
            MenuItem {
                title: "Edit simulated payload groups";
                enabled: root.has-simulator;
                activated => { root.edit-simulator-groups(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Exit";
                activated => { root.exit-requested(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Edit tcspecial parameters";
                activated => { root.edit-parameters(); }
            }
            MenuSeparator { }
            // Every node to the top of its own pane, nothing covering
            // anything. For a configuration read out of a file that is spread
            // over more sheet than the window shows, and for a morning's
            // dragging that has left one nobody can read.
            MenuItem {
                title: "Arrange the nodes";
                activated => { root.arrange(); }
            }
            MenuSeparator { }
            // The configuration as Rust, compiled into tcspecial along with
            // the node types it uses. Asked for rather than done on every
            // save: a half-finished configuration in a file somebody's build
            // is reading would be a build of something nobody meant.
            MenuItem {
                title: "Generate Rust code";
                activated => { root.generate-rust(); }
            }
        }
    }

    surface := Surface {
        width: 100%;
        height: 100%;
        nodes: root.nodes;
        links: root.links;
        drawing-route: root.drawing-route;
        moc-palette: root.moc-palette;
        vehicle-palette: root.vehicle-palette;
        payload-palette: root.payload-palette;
        moc-divider: root.moc-divider;
        vehicle-divider: root.vehicle-divider;
        working-width: root.working-width;
        working-height: root.working-height;
        moc-ground: root.moc-ground;
        vehicle-ground: root.vehicle-ground;
        payload-ground: root.payload-ground;
        save-clicked => { root.save-clicked(); }
        undo-depth: root.undo-depth;
        redo-depth: root.redo-depth;
        undo-label: root.undo-label;
        redo-label: root.redo-label;
        trouble: root.trouble;
        concern-count: root.concern-count;
        aside-count: root.aside-count;
        show-concerns => { root.show-concerns(); }
        show-aside => { root.show-aside(); }
        said: root.said;
        canvas-offset <=> root.canvas-offset;
        undo-clicked => { root.undo-clicked(); }
        redo-clicked => { root.redo-clicked(); }
        place-node(name, t, sets) => { root.place-node(name, t, sets); }
        node-moved(n, dx, dy) => { root.node-moved(n, dx, dy); }
        moc-divider-moved(dx) => { root.moc-divider-moved(dx); }
        vehicle-divider-moved(dx) => { root.vehicle-divider-moved(dx); }
        open-subdiagram(n) => { root.open-subdiagram(n); }
        link-started(n, terminal) => { root.link-started(n, terminal); }
        link-finished(x, y) => { root.link-finished(x, y); }
        link-moved(x, y) => { root.link-moved(x, y); }
        selected: root.selected;
        node-selected(n) => { root.node-selected(n); }
        node-edit(n) => { root.node-edit(n); }
        node-delete(n) => { root.node-delete(n); }
    }
}

// One open subdiagram.
//
// The same surface as the top diagram, given that subdiagram's nodes. Several
// may be open at once, and they cannot disagree with each other or with the
// top diagram: there is one document behind all of them, and each window is
// redrawn from it after every edit.
export component SubWindow inherits Window {
    title: "TCSpecial Configuration -- " + root.editing;
    background: #fbfbfa;
    // The same two working panes as the top diagram, so the same room: a
    // subdiagram is a page of one configuration and its payloads go on the
    // same side of it.
    min-width: 760px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 760px;

    in property <string> editing: "";
    in property <[NodeView]> nodes: [];
    in property <[LinkView]> links: [];
    // The line a gesture is drawing, as SVG path data in canvas coordinates,
    // and empty when no gesture is running. Dashed, and in pieces because a
    // path here has no dash pattern: see tcsgui::route::drawing.
    in property <string> drawing-route: "";
    // The two selection panes' contents, and the two working panes' geometry.
    //
    // All four come from Rust -- see style.rs and main.rs -- because which
    // types are payloads and where the divider falls are facts about a
    // configuration rather than about a window, and they are checked by tests
