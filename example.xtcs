<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="tcsgui/share/schema/tcspecial.xsd">
    <description>The ground link alone, ready for payloads to be added</description>
    <tcspecial>
        <beacon>
            <default_interval>1 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>ad9aac4dd5a6d88dd5e78824ba8a83ac</interface>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <state_file>/tmp/tcspecial-example.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <gateway name="gateway-1">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:5100</ground_base>
                <port>5000</port>
                <world-in>spi-1</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <type name="spi">
            <payload name="spi-1">
                <max_speed>1000000</max_speed>
                <path>/dev/spidev0.0</path>
                <spi_mode>0</spi_mode>
                <stand_in>127.0.0.1:7951</stand_in>
                <world-out>gateway-1.spi-1</world-out>
            </payload>
        </type>
    </payloads>
    <tcsgui>
        <nodes>
            <node name="gateway-1" x="469" y="34"/>
            <node name="spi-1" x="15" y="34"/>
        </nodes>
    </tcsgui>
</configuration>
