<?xml version="1.0" encoding="UTF-8"?>
<!-- Every type a link between two of tcspecial's nodes can carry, stated
     once: see "Typed links" in docs/tcspecial-design.rst. A terminal of a node
     carries one of these, or a structure of them that its configuration writes,
     and a link is valid only where the types at its two ends are the same.

     Each type has a container of its own holding one datum of it, so that
     tcs-xtce generates a codec for each: what an app node's packet holds,
     and what the ground is sent, for a datum of that type. Every number is
     most significant byte first.

     The value types are the units: each a 32-bit signed count of its
     unit's step, calibrated into the unit. They are the one table of units:
     tcslib-protocol/src/unit_table.rs is generated from them by
     `make unit-table` in tcslib-protocol/, from each type's name, its unit's
     symbol, its calibrator and its two tcspecial ancillary data, so a
     unit is added here and nowhere else. A step is a millionth for most,
     so that a reading is never rounded by being carried, and a thousandth
     where a millionth would leave too little range: an altitude in
     micro-metres reaches only 2 km, a thrust in micro-newtons only 2 kN.

     Strings and bytes hold at most 4096 bytes, tcslib-protocol's DATUM_BYTES,
     each after a 32-bit count of how many there are.

     This document is part of the interface: its digest and link.xtce's together
     are the interface digest, regenerated with `make interface-digest` in
     tcslib-protocol/. The Rust in tcslib-protocol/src/types_packet.rs is
     generated from it by `make types-packet` there. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="TcsTypes">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <!-- Whole numbers. -->
      <IntegerParameterType name="u8" signed="false" sizeInBits="8">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="u16" signed="false" sizeInBits="16">
        <IntegerDataEncoding sizeInBits="16" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="u32" signed="false" sizeInBits="32">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="u64" signed="false" sizeInBits="64">
        <IntegerDataEncoding sizeInBits="64" encoding="unsigned"/>
      </IntegerParameterType>
      <IntegerParameterType name="i8" signed="true" sizeInBits="8">
        <IntegerDataEncoding sizeInBits="8" encoding="twosComplement"/>
      </IntegerParameterType>
      <IntegerParameterType name="i16" signed="true" sizeInBits="16">
        <IntegerDataEncoding sizeInBits="16" encoding="twosComplement"/>
      </IntegerParameterType>
      <IntegerParameterType name="i32" signed="true" sizeInBits="32">
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement"/>
      </IntegerParameterType>
      <IntegerParameterType name="i64" signed="true" sizeInBits="64">
        <IntegerDataEncoding sizeInBits="64" encoding="twosComplement"/>
      </IntegerParameterType>
      <!-- True or false, as one byte: 1 or 0. -->
      <BooleanParameterType name="boolean">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </BooleanParameterType>
      <!-- The value types, one per unit. -->
      <FloatParameterType name="kelvin" sizeInBits="64"
          shortDescription="Temperature.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">kelvin</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-kelvin</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>K</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="volt" sizeInBits="64"
          shortDescription="Potential: a bus or a cell.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">volts</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-volts</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>V</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="ampere" sizeInBits="64"
          shortDescription="Current: a load, a source, a bus.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">amperes</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-amperes</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>A</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="watt" sizeInBits="64"
          shortDescription="Power.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">watts</AncillaryData>
          <AncillaryData name="tcspecial.step">milliwatts</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>W</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="metre" sizeInBits="64"
          shortDescription="Length: an altitude, a distance.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">metres</AncillaryData>
          <AncillaryData name="tcspecial.step">millimetres</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>m</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="metre_per_second" sizeInBits="64"
          shortDescription="Speed.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">metres a second</AncillaryData>
          <AncillaryData
              name="tcspecial.step">micro-metres a second</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>m/s</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="newton" sizeInBits="64"
          shortDescription="Force: a thrust.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">newtons</AncillaryData>
          <AncillaryData name="tcspecial.step">millinewtons</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>N</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="kilogram_per_second" sizeInBits="64"
          shortDescription="A flow of mass: what an engine burns.">
        <AncillaryDataSet>
          <AncillaryData
              name="tcspecial.name">kilograms a second</AncillaryData>
          <AncillaryData
              name="tcspecial.step">milligrams a second</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>kg/s</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="ratio" sizeInBits="64"
          shortDescription="A fraction of a whole: a charge, a throttle.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">a ratio</AncillaryData>
          <AncillaryData name="tcspecial.step">millionths</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>ratio</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <!-- Text and opaque data, at most 4096 bytes, after a 32-bit count. -->
      <StringParameterType name="string">
        <StringDataEncoding encoding="UTF-8">
          <Variable maxSizeInBits="32800">
            <LeadingSize sizeInBitsOfSizeTag="32"/>
          </Variable>
        </StringDataEncoding>
      </StringParameterType>
      <IntegerParameterType name="bytes_length" signed="false"
          sizeInBits="32">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned"/>
        <ValidRange minInclusive="0" maxInclusive="4096"/>
      </IntegerParameterType>
      <BinaryParameterType name="bytes">
        <BinaryDataEncoding>
          <SizeInBits>
            <DynamicValue>
              <ParameterInstanceRef parameterRef="bytes_length"/>
              <LinearAdjustment slope="8"/>
            </DynamicValue>
          </SizeInBits>
        </BinaryDataEncoding>
      </BinaryParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="u8_datum" parameterTypeRef="u8"/>
      <Parameter name="u16_datum" parameterTypeRef="u16"/>
      <Parameter name="u32_datum" parameterTypeRef="u32"/>
      <Parameter name="u64_datum" parameterTypeRef="u64"/>
      <Parameter name="i8_datum" parameterTypeRef="i8"/>
      <Parameter name="i16_datum" parameterTypeRef="i16"/>
      <Parameter name="i32_datum" parameterTypeRef="i32"/>
      <Parameter name="i64_datum" parameterTypeRef="i64"/>
      <Parameter name="boolean_datum" parameterTypeRef="boolean"/>
      <Parameter name="kelvin_datum" parameterTypeRef="kelvin"/>
      <Parameter name="volt_datum" parameterTypeRef="volt"/>
      <Parameter name="ampere_datum" parameterTypeRef="ampere"/>
      <Parameter name="watt_datum" parameterTypeRef="watt"/>
      <Parameter name="metre_datum" parameterTypeRef="metre"/>
      <Parameter name="metre_per_second_datum"
          parameterTypeRef="metre_per_second"/>
      <Parameter name="newton_datum" parameterTypeRef="newton"/>
      <Parameter name="kilogram_per_second_datum"
          parameterTypeRef="kilogram_per_second"/>
      <Parameter name="ratio_datum" parameterTypeRef="ratio"/>
      <Parameter name="string_datum" parameterTypeRef="string"/>
      <Parameter name="bytes_length" parameterTypeRef="bytes_length"/>
      <Parameter name="bytes_datum" parameterTypeRef="bytes"/>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="u8_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="u8_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="u16_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="u16_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="u32_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="u32_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="u64_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="u64_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="i8_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="i8_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="i16_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="i16_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="i32_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="i32_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="i64_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="i64_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="boolean_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="boolean_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="kelvin_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="kelvin_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="volt_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="volt_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="ampere_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="ampere_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="watt_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="watt_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="metre_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="metre_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="metre_per_second_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="metre_per_second_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="newton_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="newton_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="kilogram_per_second_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="kilogram_per_second_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="ratio_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="ratio_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="string_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="string_datum"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="bytes_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="bytes_length"/>
          <ParameterRefEntry parameterRef="bytes_datum"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
</SpaceSystem>
