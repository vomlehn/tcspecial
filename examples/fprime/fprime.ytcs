# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "Answering to an F´ flight computer: a reading, the
  temperature made of it and what a thermostat would decide of that, to its
  bridge component, and a command from it to a heater"

tcspecial:
  # Every port is in the nine thousands, which no other example uses, so this
  # one can be left running while another is looked at.
  #
  # The vehicle answers to an F´ flight computer rather than to the ground.
  # Its links are the radio's -- UDP, in the radio's protocol -- because the
  # far end of each is the F´ deployment's TcsBridge component, which is a
  # ground station built on tcslib-c as far as tcspecial can tell.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:9510"
    reset_interval: "1 s"
    send: "0.0.0.0:9500"
  gateway: "fprime"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:9300"
    source_base: "127.0.0.1:9310"
  payload_telemetry:
    dest_base: "127.0.0.1:9410"
    source_base: "0.0.0.0:9400"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-fprime.state"
  tcs_cmd:
    recv: "0.0.0.0:9200"
    send: "127.0.0.1:9210"

gateways:
  - type gateway_fprime:
      # The F´ bridge's end of the link, both ways. What the bridge sends goes
      # up to address:port, which this node binds aboard, and leaves it by
      # gateway-out for the heater. What comes down arrives at bridge_base plus
      # the device id of the node that sent it, and the bridge gives it the F´
      # ID fprime_id_base plus that same id: heater_wanted, device id 2, arrives
      # at 127.0.0.1:9702 as 0x3002, the thermometer, device id 3, at
      # 127.0.0.1:9703 as 0x3003, and zone_temp, device id 4, at
      # 127.0.0.1:9704 as 0x3004.
      - gateway: fsw
        address: "127.0.0.1"
        bridge_base: "127.0.0.1:9700"
        fprime_id_base: "0x3000"
        port: "9600"
        gateway-out:
          - target: heater
        payload-in: true

payloads:
  - type network:
      # A heater, driven by what the flight computer sends -- 1 for on, 0 for
      # off -- the far end of a UDP socket.
      - payload: heater
        address: "127.0.0.1"
        port: "9001"
        protocol: "udp"
        gateway-in: true
      # A thermometer, two bytes, signed, big endian, in sixteenths of a degree,
      # whose readings go to the flight computer as they are, and to zone_temp
      # to be made a temperature.
      - payload: thermometer
        address: "127.0.0.1"
        port: "9002"
        protocol: "udp"
        payload-out:
          - target: fsw
          - target: zone_temp

vehicle:
  - type compute:
      # What a thermostat would decide of zone_temp -- on below 283.65 K, off
      # above 284.65 K -- which the bridge's channel for it holds as a decision,
      # true for on. Advice and no more: the heater is the flight computer's to
      # drive, and this drives nothing.
      - compute: heater_wanted
        function: "hysteresis"
        half_band: "0.5"
        setpoint: "284.15"
        payload-out:
          - target: fsw
        payload-in: true
      # The thermometer's readings made a value, a temperature in kelvin, which
      # the bridge's channel for it holds as one.
      - compute: zone_temp
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        payload-out:
          - target: fsw
          - target: heater_wanted
        payload-in: true

tcsgui:
  nodes:
    - { node: fsw, x: 469, y: 34 }
    - { node: heater, x: 34, y: 34 }
    - { node: heater_wanted, x: 242, y: 234 }
    - { node: thermometer, x: 34, y: 134 }
    - { node: zone_temp, x: 242, y: 134 }
