# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json


tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-thermostat.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

include:
  - ../thermostat-common/thermostat

gateways:
  - type gateway_radio:
      - gateway: gateway
        address: "127.0.0.1"
        ground_base: "127.0.0.1:5100"
        port: "5000"
        payload-in: true

payloads:
  # The sensors are each the far end of a UDP socket, which tcssim stands in
  # for with nothing more than a socket, so that they touch no hardware. The
  # buses these parts would be on aboard -- I2C, SPI -- are flown against
  # stand-ins by make stand-ins-test and make kernel-stand-ins-test.
  - type network:
      # One of three sensors of the same place, a trio, so that the
      # temperature survives one of them going wrong. Two bytes, signed,
      # big endian.
      - payload: temp_1
        address: "127.0.0.1"
        group: "zone_temps"
        port: "5201"
        protocol: "udp"
        payload-out:
          - target: temp1
      # The second of the trio; the same part as temp_1.
      - payload: temp_2
        address: "127.0.0.1"
        group: "zone_temps"
        port: "5202"
        protocol: "udp"
        payload-out:
          - target: temp2
      # The third. A different part: three bytes, unsigned, its own scale and
      # so its own conversion, so that no one part number can take the whole
      # trio out.
      - payload: temp_3
        address: "127.0.0.1"
        group: "zone_temps"
        port: "5203"
        protocol: "udp"
        payload-out:
          - target: temp3

tcsgui:
  nodes:
    - { node: ../thermostat-common/thermostat, x: 242, y: 166 }
    - { node: gateway, x: 790, y: 34 }
    - { node: temp_1, x: 34, y: 34 }
    - { node: temp_2, x: 34, y: 166 }
    - { node: temp_3, x: 34, y: 280 }
