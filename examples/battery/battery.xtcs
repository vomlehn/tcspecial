<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <description>A spacecraft's power bus: a solar array and a battery, a power monitor asked over a serial line, the battery's charge counted by a program, and a load shed when the charge runs low</description>
    <tcspecial>
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-battery.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <gateway name="gateway">
                <address>127.0.0.1</address>
                <ground_base>127.0.0.1:5100</ground_base>
                <port>5000</port>
                <world-in>battery_amps</world-in>
                <world-in>bus_volts</world-in>
                <world-in>charge</world-in>
                <world-in>shedding</world-in>
            </gateway>
        </type>
    </gateways>
    <vehicle>
        <type name="compute">
            <!-- The shunt's two bytes are milliamperes, signed, most
                 significant first: charging is more than nought,
                 discharging less. -->
            <compute name="battery_amps">
                <function>to_value</function>
                <offset>0</offset>
                <scale>0.001</scale>
                <type-in>i16</type-in>
                <type-out>ampere</type-out>
                <world-out>charge.battery_amps</world-out>
                <world-out>gateway.battery_amps</world-out>
                <world-in>shunt</world-in>
            </compute>
            <!-- The power monitor's two bytes are millivolts, unsigned, most
                 significant first: up to 65 volts, which is twice the bus. -->
            <compute name="bus_volts">
                <function>to_value</function>
                <offset>0</offset>
                <scale>0.001</scale>
                <type-in>u16</type-in>
                <type-out>volt</type-out>
                <world-out>gateway.bus_volts</world-out>
                <world-in>monitor</world-in>
            </compute>
            <!-- The battery's state of charge, which nothing aboard
                 measures: a program counts the charge in and out from the
                 shunt's readings, coulomb by coulomb, and answers the
                 fraction of its capacity the battery holds. A Python 3
                 script beside this file, named relative to the repository's
                 root because that is where tcspecial is run from. -->
            <compute name="charge">
                <executable>examples/battery/charge.py</executable>
                <function>process</function>
                <timeout>1 s</timeout>
                <type-in>ampere</type-in>
                <type-out>ratio</type-out>
                <world-out>gateway.charge</world-out>
                <world-out>shedding.charge</world-out>
                <world-in>battery_amps</world-in>
            </compute>
            <!-- Sheds the science load when the charge runs low: asserted
                 below the band, shedding it, and unasserted above it,
                 restoring it. -->
            <compute name="shedding">
                <function>thermostat</function>
                <half_band>0.1</half_band>
                <setpoint>0.4</setpoint>
                <type-in>ratio</type-in>
                <type-out>u8</type-out>
                <moc-out>science.shedding</moc-out>
                <world-out>gateway.shedding</world-out>
                <world-in>charge</world-in>
            </compute>
        </type>
    </vehicle>
    <payloads>
        <type name="network">
            <!-- The science instrument's power switch, driven by what shedding
                 decides: 1 to shed it, 0 to restore it. -->
            <payload name="science">
                <address>127.0.0.1</address>
                <moc-in-type>u8</moc-in-type>
                <port>5302</port>
                <protocol>udp</protocol>
                <moc-in>shedding</moc-in>
            </payload>
            <!-- The shunt in the battery's lead, which sends its current
                 twice a second of its own accord. -->
            <payload name="shunt">
                <address>127.0.0.1</address>
                <port>5301</port>
                <protocol>udp</protocol>
                <world-out-type>i16</world-out-type>
                <world-out>battery_amps.shunt</world-out>
            </payload>
        </type>
        <type name="serial">
            <!-- The power monitor, on a serial line: asked for the bus voltage
                 twice a second, it answers two bytes. -->
            <payload name="monitor">
                <byte_length>8</byte_length>
                <datarate>9600</datarate>
                <max_length>2</max_length>
                <path>/tmp/tcs-battery-monitor</path>
                <read_timeout>none</read_timeout>
                <stop_bits>1</stop_bits>
                <trigger>"V?\r"</trigger>
                <trigger_interval>500 ms</trigger_interval>
                <world-out-type>u16</world-out-type>
                <world-out>bus_volts.monitor</world-out>
            </payload>
        </type>
    </payloads>
    <commands>
        <from>gateway</from>
        <sets>shedding.setpoint</sets>
    </commands>
</configuration>
