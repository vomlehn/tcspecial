#!/bin/sh
# tcs-container-remove: tcs-container remove, as a command of its own: remove
# packages from the container.
#
#   tcs-container-remove [--distro kubuntu|fedora] [ARGUMENT...]
#
# Runs bin/tcs-container beside it with the command remove, passing --distro,
# when it comes first, and every other argument as tcs-container takes them.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = --distro ]; then
	[ $# -ge 2 ] || {
		echo "usage: tcs-container-remove [--distro DISTRO]" \
			"[ARGUMENT...]" >&2
		exit 2
	}
	distro=$2
	shift 2
	exec "$here/tcs-container" --distro "$distro" remove "$@"
fi
exec "$here/tcs-container" remove "$@"
