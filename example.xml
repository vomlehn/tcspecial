<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <version>2.0</version>
    <description>One payload on a UDP link, its telemetry going to the ground</description>
    <tcspecial>
        <beacon>
            <interval_ms>5000</interval_ms>
            <recv>127.0.0.1:5650</recv>
            <send>0.0.0.0:5550</send>
        </beacon>
        <log>
            <directory>/var/log/tcspecial</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <payload_groups>
        <name>every_second</name>
        <interval>1s</interval>
    </payload_groups>
    <payloads>
        <name>payload</name>
        <type>network</type>
        <address>127.0.0.1</address>
        <group>every_second</group>
        <port>5100</port>
        <protocol>udp</protocol>
        <trigger>01</trigger>
        <!-- Up: every datagram the payload sends goes to the ground as it
             arrives. A link is an attribute of the node it leaves, named
             after the data source it leaves by. -->
        <to_moc>moc</to_moc>
        <!-- And the other end of the ground's link, recorded here: the same
             line as the moc node's to_payload, written at the end it arrives
             at so that this entry says what it is connected to both ways. -->
        <from_moc>moc</from_moc>
    </payloads>
    <moc>
        <name>moc</name>
        <type>moc</type>
        <address>127.0.0.1</address>
        <port>5000</port>
        <!-- Down: what the ground sends reaches the payload, leaving by the
             ground link's own to_payload. -->
        <to_payload>payload</to_payload>
        <!-- And the other end of the payload's link. -->
        <from_payload>payload</from_payload>
    </moc>
    <!-- What the editor arranged: where each node was drawn. -->
    <tcsgui>
        <nodes><name>payload</name><x>744</x><y>160</y></nodes>
        <nodes><name>moc</name><x>24</x><y>40</y></nodes>
    </tcsgui>
</configuration>
