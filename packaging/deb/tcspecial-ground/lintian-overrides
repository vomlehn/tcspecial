# This is an add-on package, not one of the distribution's, so it lives
# under /opt/tcs, as FHS 3.0 section 3.13 lays out /opt/<package>; every
# TCS package shares the one tree.
tcspecial-ground: dir-or-file-in-opt

# /etc/ld.so.conf.d/tcspecial-ground.conf is how the loader finds
# /opt/tcs/lib, which is not on its path otherwise.
tcspecial-ground: package-modifies-ld.so-search-path

# lintian looks for a library only in the directories ldconfig searches
# by default, so it does not see that this one, in /opt/tcs/lib, is found
# through the ld.so.conf.d file above; the trigger is what has ldconfig
# read that file and the library.
tcspecial-ground: package-has-unnecessary-activation-of-ldconfig-trigger

# The YAML parser compiled in is unsafe-libyaml-norway, by way of
# serde_norway: libyaml translated mechanically from C into Rust, built
# from source with the rest of the program and updated through Cargo.lock.
# There is no C library in it that could be linked against the system's
# libyaml instead.
tcspecial-ground: embedded-library libyaml *

# The package is not uploaded to Debian, so its first changelog entry has
# no bug asking for it to close.
tcspecial-ground: initial-upload-closes-no-bugs
