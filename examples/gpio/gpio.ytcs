# yaml-language-server: $schema=../../tcslib-protocol/schema/tcspecial.schema.json

description: "Discrete lines of a GPIO chip: a switch's level to the ground,
  and the ground's 1 or 0 driving a lamp"

tcspecial:
  # Every port is in the thirty-two hundreds to thirty-seven hundreds, ending
  # in 20 or 30, which no other example uses, so this one can be left running
  # while another is looked at.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:3530"
    reset_interval: "1 s"
    send: "0.0.0.0:3520"
  gateway: "radio"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:3320"
    source_base: "127.0.0.1:3330"
  payload_telemetry:
    dest_base: "127.0.0.1:3430"
    source_base: "0.0.0.0:3420"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle.
  state_file: "/tmp/tcspecial-gpio.state"
  tcs_cmd:
    recv: "0.0.0.0:3220"
    send: "127.0.0.1:3230"

gateways:
  - type gateway_radio:
      # The ground's end of the link, both ways. What the ground sends goes up
      # to address:port, which this node binds aboard, and leaves it by
      # moc-out for the lamp. What comes down arrives at ground_base plus
      # the device id of the node that sent it: the switch, device id 2, at
      # 127.0.0.1:3722.
      - gateway: moc
        address: "127.0.0.1"
        ground_base: "127.0.0.1:3720"
        port: "3620"
        moc-out:
          - lamp.moc
        world-in: [switch]

payloads:
  # Two lines of one chip: a lamp the ground drives, a gpio_out, and a
  # switch the ground is told about, a gpio_in. The chip here is
  # /dev/gpiochip1, which is what the kernel's gpio-sim chip is numbered on a
  # host with one chip of its own; bin/mk-kernel-dummies makes that chip and
  # prints the number it was given, which is the path to write here.
  - type gpio_in:
      # A switch on line 0. Twice a second what it is goes to the ground, as
      # the u8 its one line is bit 0 of.
      - payload: switch
        lines: "0"
        path: "/dev/gpiochip1"
        state_interval: "500 ms"
        world-out:
          - moc.switch
  - type gpio_out:
      # A lamp on line 1, driven by what the ground sends: the u8 1 to light
      # it, 0 to put it out, and anything else refused.
      - payload: lamp
        lines: "1"
        path: "/dev/gpiochip1"
        moc-in: [moc]

tcs-gui:
  nodes:
    - { node: moc, x: 469, y: 34 }
    - { node: lamp, x: 34, y: 134 }
    - { node: switch, x: 34, y: 34 }
