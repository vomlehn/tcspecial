# tcspecial under systemd, which is the supervisor the design requires: every
# failure that ends the process -- a restart that cannot exec, a crash -- is
# answered by starting it again. Installed and not enabled; a vehicle that
# flies it enables it with `systemctl enable --now tcspecial`.
#
# The configuration is the mission's own and no package ships one, so the
# service does nothing until one is put at the path below. An XML
# configuration is named in a drop-in (`systemctl edit tcspecial`) that sets
# ExecStart and the condition to the .xml file.
#
# No --simulate on the command line: left out it is none, the flight setting,
# under which tcspecial refuses every stand-in.

[Unit]
Description=tcspecial flight software: the vehicle's payloads as a graph
Documentation=file://@PREFIX@/share/doc/tcspecial/docs/manual.html
ConditionPathExists=@SYSCONFDIR@/tcspecial/tcspecial.yaml
Wants=network-online.target
After=network-online.target
# Started again however often it ends. systemd's default gives up after five
# starts in ten seconds, and a vehicle whose flight software has stopped
# being restarted has nothing left to receive the command that would fix it.
StartLimitIntervalSec=0

[Service]
Type=simple
# Where a relative state_file or log.directory in the configuration lands:
# the variable data the tcspecial package made for it.
WorkingDirectory=@LOCALSTATEDIR@/tcspecial
ExecStart=@PREFIX@/bin/tcspecial @SYSCONFDIR@/tcspecial/tcspecial.yaml
Restart=always
# Long enough that a start that fails at once does not spin a processor,
# short enough to be nothing next to the link's own latency.
RestartSec=1

[Install]
WantedBy=multi-user.target
