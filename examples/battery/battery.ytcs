# yaml-language-server: $schema=../../tcslib-protocol/schema/tcspecial.schema.json

description: "A spacecraft's power bus: a solar array and a battery, a
  power monitor asked over a serial line, the battery's charge counted by a
  program, and a load shed when the charge runs low"

tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle.
  state_file: "/tmp/tcspecial-battery.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

gateways:
  - type gateway_radio:
      - gateway: gateway
        address: "127.0.0.1"
        ground_base: "127.0.0.1:5100"
        port: "5000"
        world-in: [battery_amps, bus_volts, charge, shedding]

vehicle:
  - type compute:
      # The shunt's two bytes are milliamperes, signed, most significant
      # first: charging is more than nought, discharging less.
      - compute: battery_amps
        function: "to_value"
        offset: "0"
        scale: "0.001"
        type-in: "i16"
        type-out: "ampere"
        world-out:
          - charge.battery_amps
          - gateway.battery_amps
        world-in: [shunt]
      # The power monitor's two bytes are millivolts, unsigned, most
      # significant first: up to 65 volts, which is twice the bus.
      - compute: bus_volts
        function: "to_value"
        offset: "0"
        scale: "0.001"
        type-in: "u16"
        type-out: "volt"
        world-out:
          - gateway.bus_volts
        world-in: [monitor]
      # The battery's state of charge, which nothing aboard measures: a
      # program counts the charge in and out from the shunt's readings,
      # coulomb by coulomb, and answers the fraction of its capacity the
      # battery holds. A program rather than a built-in, because how a
      # battery's charge is estimated is a mission's own business. It is a
      # Python 3 script beside this file, named relative to the repository's
      # root because that is where tcspecial is run from.
      - compute: charge
        executable: "examples/battery/charge.py"
        function: "process"
        timeout: "1 s"
        type-in: "ampere"
        type-out: "ratio"
        world-out:
          - gateway.charge
          - shedding.charge
        world-in: [battery_amps]
      # Sheds the science load when the charge runs low: asserted below the
      # band, shedding it, and unasserted above it, restoring it. The band is
      # wide, a fifth of the battery, so that one eclipse sheds it once
      # rather than the load chattering on and off at the edge.
      - compute: shedding
        function: "thermostat"
        half_band: "0.1"
        setpoint: "0.4"
        type-in: "ratio"
        type-out: "u8"
        moc-out:
          - science.shedding
        world-out:
          - gateway.shedding
        world-in: [charge]

payloads:
  # Every payload is the far end of a UDP socket or a serial line, which
  # tcs-sim plays, so that the example runs on any desk and touches no
  # hardware.
  - type network:
      # The science instrument's power switch, driven by what shedding decides
      # -- 1 to shed it, 0 to restore it.
      - payload: science
        address: "127.0.0.1"
        moc-in-type: "u8"
        port: "5302"
        protocol: "udp"
        moc-in: [shedding]
      # The shunt in the battery's lead, which sends its current twice a
      # second of its own accord.
      - payload: shunt
        address: "127.0.0.1"
        port: "5301"
        protocol: "udp"
        world-out-type: "i16"
        world-out:
          - battery_amps.shunt
  - type serial:
      # The power monitor, on a serial line: asked for the bus voltage twice a
      # second, it answers two bytes.
      - payload: monitor
        byte_length: "8"
        datarate: "9600"
        max_length: "2"
        path: "/tmp/tcs-battery-monitor"
        read_timeout: "none"
        stop_bits: "1"
        trigger: '"V?\r"'
        trigger_interval: "500 ms"
        world-out-type: "u16"
        world-out:
          - bus_volts.monitor

commands:
  # the state of charge the science load is shed around, as a fraction
  - { from: gateway, sets: shedding.setpoint }
