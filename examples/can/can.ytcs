# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "A payload on a CAN bus: its frames to the ground, and the
  ground's commands to it as frames"

tcspecial:
  # Every port is in the thirty-two hundreds to thirty-seven hundreds, ending
  # in 00 or 10, which no other example uses, so this one can be left running
  # while another is looked at.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:3510"
    reset_interval: "1 s"
    send: "0.0.0.0:3500"
  gateway: "radio"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:3300"
    source_base: "127.0.0.1:3310"
  payload_telemetry:
    dest_base: "127.0.0.1:3410"
    source_base: "0.0.0.0:3400"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-can.state"
  tcs_cmd:
    recv: "0.0.0.0:3200"
    send: "127.0.0.1:3210"

gateways:
  - type gateway_radio:
      # The ground's end of the link, both ways. What the ground sends goes up
      # to address:port, which this node binds aboard, and leaves it by
      # moc-out for the motor's commands. What comes down arrives at
      # ground_base plus the device id of the node that sent it: the motor's
      # status, device id 2, at 127.0.0.1:3702.
      - gateway: moc
        address: "127.0.0.1"
        ground_base: "127.0.0.1:3700"
        port: "3600"
        moc-out:
          - motor_command.moc
        world-in: [motor_status]

payloads:
  # A motor controller on the CAN bus vcan0, which sends its status in frames
  # carrying the identifier 0x123 and takes commands in frames carrying 0x124:
  # two identifiers, so two payloads, each of whose sockets hears its own
  # identifier and nothing else on the bus. vcan0 is the kernel's virtual
  # bus, which bin/mk-kernel-dummies makes; on a vehicle it is the
  # controller's interface, such as can0.
  - type can:
      # Each command the ground sends goes to the motor as one frame, so a
      # command is at most eight bytes, which is all a classic frame carries.
      - payload: motor_command
        can_id: "0x124"
        interface: "vcan0"
        moc-in: [moc]
      # Each status frame goes to the ground as it arrives.
      - payload: motor_status
        can_id: "0x123"
        interface: "vcan0"
        world-out:
          - moc.motor_status

tcsgui:
  nodes:
    - { node: moc, x: 469, y: 34 }
    - { node: motor_command, x: 34, y: 134 }
    - { node: motor_status, x: 34, y: 34 }
