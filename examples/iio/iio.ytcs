# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json

description: "A sensor's sample buffer, read through the IIO subsystem, its
  samples going to the ground"

tcspecial:
  # Every port is in the thirty-two hundreds to thirty-seven hundreds, ending
  # in 40 or 50, which no other example uses, so this one can be left running
  # while another is looked at.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:3550"
    reset_interval: "1 s"
    send: "0.0.0.0:3540"
  gateway: "radio"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:3340"
    source_base: "127.0.0.1:3350"
  payload_telemetry:
    dest_base: "127.0.0.1:3450"
    source_base: "0.0.0.0:3440"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-iio.state"
  tcs_cmd:
    recv: "0.0.0.0:3240"
    send: "127.0.0.1:3250"

gateway:
  # The ground's end of the link. Nothing goes up to an IIO sensor, which is
  # read and never written, so nothing leaves this node by gateway-out; what
  # comes down arrives at ground_base plus the device id of the node that
  # sent it: the sensor, device id 1, at 127.0.0.1:3741.
  - name: ground
    type: gateway_radio
    address: "127.0.0.1"
    port: "3640"
    ground_base: "127.0.0.1:3740"
    payload-in: true

payloads:
  # A sensor's buffer, which hands over whole sample sets as they are taken.
  # Which channels are in a set and how often one is taken are the sensor's
  # settings, made in sysfs by whoever brings it up, and nothing here. The
  # device is /dev/iio:device1, which is what the kernel's iio_dummy sensor
  # is numbered on a host with one sensor of its own;
  # bin/mk-kernel-stand-ins makes that sensor, enables its buffer and prints
  # the number it was given, which is the path to write here.
  - name: sensor
    type: iio
    path: "/dev/iio:device1"
    payload-out:
      - target: ground

tcsgui:
  nodes:
    - { name: ground, x: 469, y: 34 }
    - { name: sensor, x: 34, y: 34 }
