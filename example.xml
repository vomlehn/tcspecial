<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="tcsgui/share/schema/tcspecial.xsd">
    <version>2.0</version>
    <description>One payload on a UDP link, its telemetry going to the ground</description>
    <tcspecial>
        <beacon>
            <interval>1 s</interval>
        </beacon>
    </tcspecial>
    <payload_groups>
        <name>every_second</name>
        <interval>1 s</interval>
    </payload_groups>
    <moc>
        <name>moc-1</name>
        <type>moc</type>
    </moc>
    <tcsgui>
        <nodes><name>moc-1</name><x>469</x><y>34</y></nodes>
    </tcsgui>
</configuration>
