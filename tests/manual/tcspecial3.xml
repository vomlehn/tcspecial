<?xml version="1.0" encoding="UTF-8"?>
<!-- TCSpecial payload set 3, in the payload configuration language.

     Equivalent to tcspecial3.yaml - a payload configuration may be
     written in either format, and both of this set are shipped. The YAML is
     the one to read: it carries the comments.

     Conventions, which are what XML and YAML agree on:
       - every value is a child element, never an attribute
       - a sequence is repeated sibling elements named for the field,
         and the repeats must be contiguous
       - an absent optional field is simply an omitted element -->
<payload>
    <version>1.0</version>
    <description>TCSpecial payload set 3</description>
    <tcspecial>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
        <payload_command>
            <source_base>127.0.0.1:4300</source_base>
            <dest_base>0.0.0.0:4200</dest_base>
        </payload_command>
        <payload_telemetry>
            <source_base>0.0.0.0:6000</source_base>
            <dest_base>127.0.0.1:6100</dest_base>
        </payload_telemetry>
        <beacon>
            <interval>5 s</interval>
            <send>0.0.0.0:5550</send>
            <recv>127.0.0.1:5650</recv>
        </beacon>
        <log>
            <directory>/var/log/tcspecial</directory>
            <segment_size>65536</segment_size>
        </log>
    </tcspecial>
    <payloads>
        <name>auto-send</name>
        <type>network</type>
        <protocol>tcp</protocol>
        <payload_interface>localhost:5000</payload_interface>
        <packet_size>12</packet_size>
        <stale_interval_ms>3000</stale_interval_ms>
    </payloads>
</payload>
