    // twice.
    in property <[PaletteEntry]> moc-palette: [];
    in property <[PaletteEntry]> vehicle-palette: [];
    in property <[PaletteEntry]> payload-palette: [];
    in property <length> moc-divider: 0px;
    in property <length> vehicle-divider: 0px;
    in property <length> working-width: 0px;
    // How long the sheet is, in the coordinates the file holds: one length
    // for all three panes, which is what makes them scroll together. From
    // Rust -- see tcsgui::pane::WORKING_HEIGHT -- as the width is.
