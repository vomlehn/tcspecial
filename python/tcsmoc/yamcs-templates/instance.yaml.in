# A tcspecial example's Yamcs instance: its services, its mission database and
# its streams, which are the same whatever the tcspecial configuration says.
# Written by $writer from this template,
# python/tcsmoc/yamcs-templates/instance.yaml.in, which adds what the
# configuration says, worked out by tcsprotocol/yamcs.py so that it is
# stated in one place: the dataLinks -- the command links, the beacon, an uplink
# to each gateway_yamcs node and a link on each port a source's data arrives at
# -- and the command streams, streamConfig's tc, that route each command to its
# link.
services:
  - class: org.yamcs.archive.XtceTmRecorder
  - class: org.yamcs.archive.ParameterRecorder
  - class: org.yamcs.archive.AlarmRecorder
  - class: org.yamcs.archive.EventRecorder
  - class: org.yamcs.archive.ReplayServer
  - class: org.yamcs.archive.CommandHistoryRecorder
  - class: org.yamcs.ProcessorCreatorService
    args:
      name: realtime
      type: realtime

# tcspecial's own XTCE, as it is, and the wrapper that puts a CCSDS header
# around it, written by tcsprotocol/yamcs.py with every APID the
# configuration counts. A node's interface document, as the ping node's
# tcsprotocol/xtce/ping.xtce, is not among them: its command must go behind
# the header, which a command cannot be put behind from outside, so the wrapper
# holds a copy of what it states, and Yamcs is not given a ping that goes
# without one.
mdb:
  - type: xtce
    args:
      file: $xtce_dir/link.xtce
  - type: xtce
    args:
      file: $xtce_dir/fixed.xtce
  - type: xtce
    args:
      file: $xtce_dir/beacon.xtce
  - type: xtce
    args:
      file: $run_dir/tcs-ccsds.xtce

# Every packet carries a CCSDS primary header and no time stamp, so Yamcs
# stamps each with the time it arrived, and fills in each command's sequence
# count and length as it goes.
streamConfig:
  tm:
    - name: tm_realtime
      rootContainer: /TcsYamcs/CCSDSPacket
  cmdHist: [cmdhist_realtime]
  event: [events_realtime]
  param: [pp_realtime]
  parameterAlarm: [alarms_realtime]
