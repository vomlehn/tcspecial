<?xml version="1.0" encoding="UTF-8"?>
<!-- Equivalent to tcspecial.json and tcspecial.yaml. All three must deserialize
     into an identical PayloadConfig; tests/format_equivalence.rs enforces it.

     Conventions this file must follow, because they are the subset JSON,
     YAML, and XML all agree on:
       - every value is a child element, never an attribute
       - a sequence is repeated sibling elements named for the field
         (<payloads> here), and the repeats must be contiguous
       - an absent optional field is simply an omitted element -->
<payload>
    <version>1.0</version>
    <description>Two data handlers, one of each endpoint kind</description>
    <tcspecial>
        <address>0.0.0.0</address>
        <port>4000</port>
        <protocol>udp</protocol>
        <beacon_interval_ms>5000</beacon_interval_ms>
        <beacon_address>239.255.0.2:6550</beacon_address>
        <beacon_interface>127.0.0.1</beacon_interface>
        <log_dir>/var/log/tcspecial</log_dir>
        <log_segment_bytes>65536</log_segment_bytes>
    </tcspecial>
    <payload_groups>
        <name>udp_localhost</name>
        <type>network</type>
        <protocol>udp</protocol>
        <address>localhost</address>
        <packet_size>12</packet_size>
    </payload_groups>
    <payloads>
        <dh_id>0</dh_id>
        <name>udp-grouped</name>
        <group>udp_localhost</group>
        <port>5000</port>
    </payloads>
    <payloads>
        <dh_id>1</dh_id>
        <name>device-alone</name>
        <type>device</type>
        <path>/dev/ttyS0</path>
        <packet_size>64</packet_size>
    </payloads>
</payload>
