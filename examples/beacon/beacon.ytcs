# yaml-language-server: $schema=../../tcslib-protocol/schema/tcspecial.schema.json

description: "A beacon, and a ground station that watches it"

tcspecial:
  # What this example is about. tcspecial sends a beacon from send every
  # interval and the ground station receives it at recv, so these two are the
  # whole of the link the example shows.
  #
  # The ports are this example's own, a hundred above the ones the others use,
  # so that the beacon watcher can be left running while another example is
  # looked at.
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5750"
    reset_interval: "1 s"
    send: "0.0.0.0:5650"
  gateway: "radio"
  interface: "c7820f9bfe585feab72247ece0a2261d"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4400"
    source_base: "127.0.0.1:4500"
  payload_telemetry:
    dest_base: "127.0.0.1:6300"
    source_base: "0.0.0.0:6200"
  # tcspecial keeps in this file which configuration the next start is to run,
  # the last one the ground confirmed, and how many starts of it have ended
  # before a matching CONNECT, so on a vehicle it must be on storage that
  # survives a power cycle.
  state_file: "/tmp/tcspecial-beacon.state"
  tcs_cmd:
    recv: "0.0.0.0:4600"
    send: "127.0.0.1:4700"

payloads:
  - type network:
      # A beacon is sent because tcspecial is running rather than because a
      # payload has anything to say, so this example needs a payload only
      # because a configuration describes a vehicle and a vehicle with nothing
      # aboard is not one. Its readings go to the ground over payload_telemetry,
      # as any payload's do when nothing aboard touches them.
      - payload: sensor
        address: "127.0.0.1"
        port: "5101"
        protocol: "udp"

tcs-gui:
  nodes:
    - { node: sensor, x: 34, y: 34 }
