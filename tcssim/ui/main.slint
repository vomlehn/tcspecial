import { Button, GroupBox, LineEdit, VerticalBox, HorizontalBox, SpinBox, ScrollView, GridBox } from "std-widgets.slint";
import { Copyable, CopyButton } from "../../tcsverify/ui/copy.slint";
import { Fonts } from "../../tcsui/ui/fonts.slint";
// What was found wrong as the program started, shown before this window: the
// one window tcsmoc and tcssim share, beside tcsverify, whose report it shows.
export { StartupWindow, StartupLine } from "../../tcsverify/ui/startup.slint";

// One simulated payload: what the tcspecial configuration file says about the
// data handler it stands in for, what the simulator configuration file says
// about how to simulate it, and what it has done since it started.
//
// Nothing in this window names a payload or fixes how many there are. Rust
// reads them from the two files and hands them over as this model, so a
// payload added to or removed from the files adds or removes a panel.
export struct PayloadInfo {
    // From the tcspecial configuration file
    name: string,
    // Which payload of that configuration this is, counted from nought in the
    // order the file describes them.
    dev-id: int,
    config: string,
    packet-size: int,
    // Everything both files said about this payload, as Rust read them. Held
    // ready rather than fetched when asked: the files are read once, at
    // startup, and nothing can change them while the window is up.
    parameters: string,
    // What is wrong with the packet and segment sizes together, and empty
    // when they agree. Rust decides it -- once at startup and again on every
    // edit -- so the panel has an answer to obey rather than a rule to
    // apply.
    sizes-problem: string,
    // Whether this payload answers requests. The payload configuration
    // decides it, and the panel shows a received line only for such a
    // payload: nothing is ever sent to one that sends on its own, so the line
    // would say the same thing for the whole run.
    triggered: bool,
    // From the simulator configuration file, and editable here afterwards
    segment-size: int,
    packet-interval: int,
    segment-interval: int,
    // From the running simulation
    status: string,
    last-sent-time: string,
    last-sent-data: string,
    last-recv-time: string,
    last-recv-data: string,
    packets-sent: int,
    packets-recv: int,
}

component PayloadPanel inherits Rectangle {
    in property <string> payload-name: "Payload 0";
    in property <int> dev-id: 0;
    in property <string> payload-config: "TCP localhost:5000";
    in property <string> payload-status: "Stopped";
    in property <int> packet-size: 12;
    in property <int> segment-size: 12;
    in property <int> packet-interval: 1000;
    in property <int> segment-interval: 1000;
    in property <string> last-sent-time: "--:--:--";
    in property <string> last-sent-data: "";
    in property <string> last-recv-time: "--:--:--";
    in property <string> last-recv-data: "";
    in property <int> packets-sent: 0;
    in property <int> packets-recv: 0;
    in property <string> parameters: "";
    in property <string> sizes-problem: "";
    in property <bool> triggered: false;

    callback transfer-clicked();
    // One callback per spin box, each carrying the value just set. The panel
    // holds no state of its own: what a spin box shows is what the model says,
    // so an edit has to go back to the model to be seen.
    callback packet-size-edited(int);
    callback segment-size-edited(int);
    callback packet-interval-edited(int);
    callback segment-interval-edited(int);

    background: #f0f0f0;
    border-color: #808080;
    border-width: 1px;

    VerticalLayout {
        padding: 4px;
        spacing: 2px;
        sizes-popup := PopupWindow {
            x: 4px;
            y: 4px;
            width: 290px;
            height: 100px;
            // Closed by a press outside it, not by any press: a press inside
            // is somebody selecting what it says to copy it.
            close-policy: close-on-click-outside;

            Rectangle {
                background: white;
                border-color: #c00000;
                border-width: 1px;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 4px;
                        Copyable {
                            text: payload-name + ": these sizes cannot be sent";
                            font-weight: 700;
                            font-size: Fonts.window;
                            color: #c00000;
                        }
                        CopyButton {
                            said: payload-name + ": these sizes cannot be sent\n" + sizes-problem;
                        }
                    }
                    Copyable {
                        text: sizes-problem;
                        font-size: Fonts.window;
                    }
                }
            }
        }

        parameters-popup := PopupWindow {
            x: 4px;
            y: 4px;
            width: 300px;
            height: 240px;
            // As above: a press inside is somebody selecting.
            close-policy: close-on-click-outside;

            Rectangle {
                background: white;
                border-color: #808080;
                border-width: 1px;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 4px;
                        Copyable {
                            text: payload-name + " parameters";
                            font-weight: 700;
                            font-size: Fonts.window;
                        }
                        CopyButton {
                            said: payload-name + " parameters\n" + parameters;
                        }
                    }

                    // Scrolled rather than sized to the text: how many lines
                    // there are depends on the kind of payload and on how
                    // many faults were asked for, and a popup tall enough for
                    // the longest of them would be taller than the window.
                    ScrollView {
                        parameters-text := Copyable {
                            // The lines are columns of name and value, so
                            // they only line up in a font whose characters
                            // are one width -- and they are not wrapped, a
                            // column broken in two being no column.
                            font-family: Fonts.mono;
                            font-size: Fonts.window;
                            wrap: no-wrap;
                            text: parameters;
                        }
                    }
                }
            }
        }


        // Header row - combine name and status
        HorizontalLayout {
            spacing: 4px;
            height: 18px;
            // The name and the number of the payload, which is its place in
            // the payload configuration -- the first payload the file
            // describes is 0. Nothing states it: the file's order decides it,
            // and tcsmoc counts the same way, so a payload is the same number
            // in both windows.
            Text {
                text: payload-name + " (dev id " + dev-id + ")";
                font-size: Fonts.window;
                font-weight: 700;
                vertical-alignment: top;
            }
            Text {
                text: payload-status;
                font-size: Fonts.window;
                font-weight: payload-status == "Running" ? 400 : 700;
                vertical-alignment: top;
                color: payload-status == "Running" ? black : red;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            height: 18px;
            Text {
                text: "Config: " + payload-config;
                font-size: Fonts.window;
                vertical-alignment: top;
            }
        }

        // The two sizes, side by side.
        //
        // A floor rather than a height, as the row of buttons below is: a
        // SpinBox is thirty pixels tall in this style and a row told to be
        // twenty-two did not shrink it, it let it hang six pixels over the
        // row beneath. And a spacing, which was nought: every label sat
        // against the box it names and every box against the next label.
        HorizontalLayout {
            min-height: 30px;
            spacing: 6px;
            Text { text: "Pkt:"; vertical-alignment: center; font-size: Fonts.window; }
            SpinBox {
                value: packet-size;
                minimum: 1;
                maximum: 32;
                edited(v) => {
                    packet-size-edited(v);
                    // Said at once, and taken back at once: an open popup
                    // still saying these sizes cannot be sent, after the edit
                    // that made them sendable, would be the wrong answer left
                    // on the screen.
                    if (sizes-problem != "") {
                        sizes-popup.show();
                    } else {
                        sizes-popup.close();
                    }
                }
            }
            Text { text: "Seg:"; vertical-alignment: center; font-size: Fonts.window; }
            SpinBox {
                value: segment-size;
                minimum: 1;
                maximum: 32;
                edited(v) => {
                    segment-size-edited(v);
                    // Said at once, and taken back at once: an open popup
                    // still saying these sizes cannot be sent, after the edit
                    // that made them sendable, would be the wrong answer left
                    // on the screen.
                    if (sizes-problem != "") {
                        sizes-popup.show();
                    } else {
                        sizes-popup.close();
                    }
                }
            }
        }

        HorizontalLayout {
            min-height: 30px;
            spacing: 6px;
            Text { text: "Pkt Int:"; vertical-alignment: center; font-size: Fonts.window; }
            SpinBox {
                value: packet-interval;
                minimum: 0;
                maximum: 10000;
                edited(v) => { packet-interval-edited(v); }
            }
            Text { text: "Seg Int:"; vertical-alignment: center; font-size: Fonts.window; }
            SpinBox {
                value: segment-interval;
                minimum: 0;
                maximum: 10000;
                edited(v) => { segment-interval-edited(v); }
            }
        }

        // A floor rather than a height. A Button is as tall as the style
        // makes it -- thirty-two pixels here -- and a row told to be
        // twenty-four did not shrink the buttons, it let them hang six pixels
        // over the row below and draw across the "Sent:" line.
        controls-row := HorizontalLayout {
            min-height: 32px;
            spacing: 6px;
            // One button, labelled with what pressing it will do. There were
            // two, Start and Stop, and either was pressable whatever the
            // payload was already doing: a Stop on a payload that was not
            // sending did nothing and read as though it had.
            //
            // Enable and Disable, which are the MOC's words for the same two
            // presses: the two windows are read side by side, and a payload
            // that is Disabled here and Disabled there is one state said one
            // way. It said Send and Silent -- the payload's own words for what
            // it does, since the payload is the thing that sends -- and that
            // left the reader translating.
            //
            // The label comes from the status this panel already shows, and
            // Rust reads the same status back to decide which way a press
            // goes, so the button and what it does cannot disagree.
            //
            // First in the row, because enabling and disabling the payload is
            // what a panel is opened to do.
            Button {
                text: payload-status == "Running" ? "Disable" : "Enable";
                // Nothing to press while the two sizes describe something
                // that cannot be sent: a segment is a piece of a packet, and
                // a piece larger than the whole is not a thing to start.
                enabled: sizes-problem == "";
                clicked => { transfer-clicked(); }
            }
            // What the two files said about this payload. On the same row as
            // the controls, so the panel is no taller for it: a row of its
            // own would cost every panel a row's height and the window a row
            // of panels.
            //
            // Neither button may be the last child of the row: Slint's
            // testing backend does not report a layout's final child, and the
            // tests press both of these. The spare room below is what stands
            // at the end -- nothing invisible would do, a Rectangle or an
            // empty Text there not being reported either.
            Button {
                text: "Configuration";
                clicked => { parameters-popup.show(); }
            }
            // The row's spare room, so the buttons are the width of their own
            // labels rather than stretched across the panel. It is also what
            // lets a test see them: Slint's testing backend does not report
            // the last child of a layout, and this is now the last child.
            Rectangle { }
        }

        // The three rows of data the panel ends with.
        sent-row := HorizontalLayout {
            height: 14px;
            Text { text: "Sent: " + last-sent-time + " " + last-sent-data; font-size: Fonts.window; }
        }
        // The line stays and its contents go, for a payload that is never
        // spoken to: a payload that sends on its own would read
        // "Recv: --:--:--" from the first packet to the last, which is a row
        // spent saying that nothing can happen here. The row itself is kept
        // so that every panel is the same shape and the rows below it do not
        // move from one panel to the next.
        recv-row := HorizontalLayout {
            height: 14px;
            if triggered : Text {
                text: "Recv: " + last-recv-time + " " + last-recv-data;
                font-size: Fonts.window;
            }
        }
        // The received count goes the same way the received line does, and
        // for the same reason: a payload that sends on its own is never
        // spoken to, so "0 recv" is a number that cannot become anything
        // else. What it sent is all there is to count.
        packets-row := HorizontalLayout {
            height: 14px;
            if triggered : Text {
                text: "Pkts: " + packets-sent + " sent / " + packets-recv + " recv";
                font-size: Fonts.window;
            }
            if !triggered : Text {
                text: "Pkts: " + packets-sent + " sent";
                font-size: Fonts.window;
            }
        }
    }
}

// What a panel comes to, asked of a window that is never opened.
//
// A panel laid out alone reports what it wants; one in the grid is stretched
// to its cell and reports what it was given, so the grid cannot be asked.
//
// Its own component, and deliberately not a hidden panel inside MainWindow.
// A child of a window is something the window has to make room for, whatever
// its visibility, so a panel parked in there had a say in the window's size
// and the window came up refusing to be resized. Nothing here is ever shown:
// Rust builds one, reads the two lengths, and drops it.
export component PanelProbe inherits Window {
    default-font-size: Fonts.window;
    probe := PayloadPanel { }
    out property <length> panel-width: probe.preferred-width;
    out property <length> panel-height: probe.preferred-height;
}

export component MainWindow inherits Window {
    default-font-size: Fonts.window;
    title: "TCSpecial Payload Simulator";
    background: white;

    // One row of panels and the chrome, which is the least the window is ever
    // opened at -- a tcspecial configuration of one payload. How much more it
    // opens at is Rust's to say: see rows_of_room() in grid.rs.
    //
    // The two lengths rather than a number: this was 302px when a panel was
    // 210 tall, and stayed 302 when the panel became 176.
    min-height: root.panel-height + root.chrome-height;
    min-width: root.panel-width + root.chrome-width;

    // The simulated payloads, read from the configuration files by Rust.
    in-out property <[PayloadInfo]> payload-model: [];

    // How many panels to a row, from the width the window actually has.
    //
    // Worked out here rather than handed over by Rust, because the answer
    // changes while the program runs: a window dragged wider has room for
    // another column and now uses it, where a count settled at startup left a
    // wide window with a narrow grid and the panels scrolling under it.
    //
    // Never more columns than there are payloads -- a fourth column for three
    // payloads is an empty one -- and never fewer than one, which is what an
    // empty configuration gets.
    //
    // Rust opens the window wide enough for the columns it means to have; see
    // grid::columns_for. Because it sizes the window to exactly that many
    // panels' width plus the chrome, the floor below comes out at the same
    // number it asked for.
    property <int> columns: Math.max(
        1,
        Math.min(
            payload-model.length,
            Math.floor((root.width - root.chrome-width) / root.panel-width)
        )
    );

    // One callback for the one button a panel has. Which way a press goes is
    // Rust's to decide, from the status the button's own label comes from.
    callback transfer-payload(int);
    callback config-payload(int, int, int, int, int);
    callback quit-clicked();

    // What a panel comes to, measured by PanelProbe and handed over.
    //
    // These were constants in grid.rs as well, kept in step with this file by
    // hand, and the keeping went wrong in three ways at once: a panel was
    // called 210 tall where its rows take 176, which showed as a band of
    // nothing under the packet count; 320 wide where it wants 328, so the
    // widest row was squeezed; and when the height was corrected the cell
    // default and the window's own floor were left behind, which clipped the
    // last row of a one-panel window. There is one of each number now, and it
    // is measured.
    in property <length> panel-width;
    in property <length> panel-height;

    // Everything the window needs besides the panels: the padding round the
    // whole of it, the heading, the row holding the quit button, and the
    // grid's own padding inside the scrolling area.
    out property <length> chrome-width: outer.padding * 2 + grid.padding * 2;
    out property <length> chrome-height: outer.padding * 2
        + heading.height
        + quit-row.height
        + grid.padding * 2;


    outer := VerticalLayout {
        padding: 4px;
        spacing: 0px;

        heading := Text {
            text: "Simulated Payloads";
            font-size: 18px;
            height: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        scroll := ScrollView {
            // The panels keep to the top of the scrolling area.
            //
            // The area is commonly taller than the grid: the window opens
            // with room for a row the payloads may not fill, which
            // rows_of_room() in grid.rs asks for on purpose. That spare room
            // was being split above and below the grid, because a scrolling
            // area centres content shorter than itself -- so a window with
            // five panels in two rows showed a hundred and thirteen pixels of
            // nothing above the first panel and as much below the last. The
            // spare room belongs under the panels, where it reads as room for
            // a row that has not arrived rather than as a gap.
            //
            // The Rectangle is what holds it there: a child of a layout with
            // no height of its own takes what is left over, and the grid,
            // which states its height, takes none of it.
            VerticalLayout {
                    grid := GridBox {
                    spacing: 0px;
                    height: payload-model.length == 0
                        ? 0px
                        : Math.ceil(payload-model.length / columns) * panel-height;

                    for p[i] in payload-model: PayloadPanel {
                        row: Math.floor(i / columns);
                        col: Math.mod(i, columns);
                        // A minimum rather than a size: the window opens at
                        // exactly this, and the layout stretches the panels if it
                        // is made larger. Below it the two spin boxes on a row
                        // stop fitting side by side.
                        min-width: panel-width;
                        min-height: panel-height;

                        payload-name: p.name;
                        dev-id: p.dev-id;
                        payload-config: p.config;
                        payload-status: p.status;
                        packet-size: p.packet-size;
                        segment-size: p.segment-size;
                        packet-interval: p.packet-interval;
                        segment-interval: p.segment-interval;
                        last-sent-time: p.last-sent-time;
                        last-sent-data: p.last-sent-data;
                        last-recv-time: p.last-recv-time;
                        last-recv-data: p.last-recv-data;
                        packets-sent: p.packets-sent;
                        packets-recv: p.packets-recv;
                        parameters: p.parameters;
                        sizes-problem: p.sizes-problem;
                        triggered: p.triggered;

                        transfer-clicked => { transfer-payload(i); }

                        // An edit changes the model, so the spin box keeps showing
                        // it, and then tells Rust the whole set for this payload.
                        packet-size-edited(v) => {
                            payload-model[i].packet-size = v;
                            config-payload(i, v, p.segment-size, p.packet-interval, p.segment-interval);
                    }
                    segment-size-edited(v) => {
                        payload-model[i].segment-size = v;
                        config-payload(i, p.packet-size, v, p.packet-interval, p.segment-interval);
                    }
                    packet-interval-edited(v) => {
                        payload-model[i].packet-interval = v;
                        config-payload(i, p.packet-size, p.segment-size, v, p.segment-interval);
                    }
                    segment-interval-edited(v) => {
                        payload-model[i].segment-interval = v;
                        config-payload(i, p.packet-size, p.segment-size, p.packet-interval, v);
                    }
                    }
                }
                Rectangle { }
            }
        }

        quit-row := HorizontalLayout {
            height: 40px;
            Rectangle { }
            Button {
                text: "Quit All";
                clicked => { quit-clicked(); }
            }
        }
    }
}
