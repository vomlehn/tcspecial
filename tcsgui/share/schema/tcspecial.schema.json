{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vomlehn/tcspecial/schema/tcspecial.schema.json",
  "title": "tcspecial configuration, version 2",
  "description": "The shape of a version 2 configuration: which sections there are, what an entry may say, and which words are words. Not whether it can be flown -- which attributes a node of a given type must state, whether two payloads claim one socket, whether a mean's inputs are the ones its links bind are rules about meaning, tested against real buses, and tcsverify is the one place they live. A file this accepts may still be refused, and the refusal will say why.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Which language this file is written in. A configuration that has not said has not said what it is, and the beacon carries it so the ground can check what is flying.",
      "const": "2.0"
    },
    "description": {
      "type": "string"
    },
    "include": {
      "description": "Other files this one is made of, by name without an extension: named rather than discovered, so the set of files a configuration is made of is itself written down.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tcspecial": {
      "description": "What tcspecial itself is configured with: where commands are taken, where beacons go, where the telemetry log is written. Everything optional here, because the editor has to be able to write a section somebody is halfway through filling in; what must be answered before a configuration flies is tcsverify's to say.",
      "type": "object",
      "properties": {
        "tcs_cmd": {
          "type": "object",
          "properties": {
            "recv": {
              "description": "Where tcspecial receives commands about the spacecraft and sends its responses.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            },
            "send": {
              "description": "Where the MOC sends them from and receives the responses.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        "payload_command": {
          "type": "object",
          "properties": {
            "source_base": {
              "description": "The MOC's end, counted on by the payload's id.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            },
            "dest_base": {
              "description": "tcspecial's end, counted on by the payload's id.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        "payload_telemetry": {
          "type": "object",
          "properties": {
            "source_base": {
              "description": "Where a payload's telemetry leaves tcspecial, counted on by its id.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            },
            "dest_base": {
              "description": "Where it arrives at the ground, counted on by its id.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        "beacon": {
          "type": "object",
          "properties": {
            "interval_ms": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ],
              "description": "How often a beacon is sent."
            },
            "send": {
              "description": "The socket tcspecial sends beacons from.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            },
            "recv": {
              "description": "The socket tcsmoc receives them on.",
              "type": "string",
              "pattern": "^[^:]+:[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        "log": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string"
            },
            "segment_size": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "rust-code-path": {
          "description": "Where tcsgui writes the Rust it generates from this configuration, relative to the configuration's own directory or absolute. The one attribute of this section that is about building the software rather than about running it: nothing aboard reads it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "payload_groups": {
      "description": "Sets of payloads read on one interval, so that readings which will be compared are taken as close to together as the hardware allows.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "interval": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "A whole number with a unit: 500ms, 3s."
          }
        },
        "required": [
          "name",
          "interval"
        ],
        "additionalProperties": false
      }
    },
