<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsprotocol/schema/tcspecial.xsd">
    <tcspecial>
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/var/log/tcspecial</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <state_file>/tmp/tcspecial-thermostat.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <payload_groups>
        <name>zone_temps</name>
        <interval>100 ms</interval>
    </payload_groups>
    <gateways>
        <type name="gateway_radio">
            <gateway name="gateway">
                <address>10.0.0.1</address>
                <ground_base>10.0.0.2:5100</ground_base>
                <port>5000</port>
                <world-in>ambient</world-in>
                <world-in>temp1</world-in>
                <world-in>temp2</world-in>
                <world-in>temp3</world-in>
                <world-in>thermostat</world-in>
            </gateway>
        </type>
    </gateways>
    <vehicle>
        <type name="compute">
            <!-- One temperature out of the three, by the algorithm named:
                 median takes the middle reading, closest_mean the mean of
                 the two that agree best. Either leaves a sensor that has
                 gone wrong out of the answer, which a mean over all three
                 would not, and it produces a value on every arrival, so one
                 sensor that stops reporting is outvoted rather than
                 stopping the vehicle from deciding anything. -->
            <compute name="ambient">
                <algorithm>median</algorithm>
                <carries>kelvin</carries>
                <function>vote</function>
                <world-out>gateway.ambient</world-out>
                <world-out>thermostat.ambient</world-out>
                <world-in>in0</world-in>
                <world-in>in1</world-in>
                <world-in>in2</world-in>
            </compute>
            <compute name="temp1">
                <function>to_kelvin</function>
                <offset>273.15</offset>
                <scale>0.0625</scale>
                <type-in>i16</type-in>
                <world-out>ambient.in0</world-out>
                <world-out>gateway.temp1</world-out>
                <world-out>housekeeping.temp1</world-out>
                <world-in>temp_1</world-in>
            </compute>
            <compute name="temp2">
                <function>to_kelvin</function>
                <offset>273.15</offset>
                <scale>0.0625</scale>
                <type-in>i16</type-in>
                <world-out>ambient.in1</world-out>
                <world-out>gateway.temp2</world-out>
                <world-out>housekeeping.temp2</world-out>
                <world-in>temp_2</world-in>
            </compute>
            <compute name="temp3">
                <function>to_kelvin</function>
                <offset>255.37</offset>
                <scale>0.0078</scale>
                <type-in>u32</type-in>
                <world-out>ambient.in2</world-out>
                <world-out>gateway.temp3</world-out>
                <world-out>housekeeping.temp3</world-out>
                <world-in>temp_3</world-in>
            </compute>
            <!-- setpoint is set from the ground; half_band is how far
                 either side of it the heaters are switched at, the setpoint
                 being in the middle of the band. -->
            <compute name="thermostat">
                <function>thermostat</function>
                <half_band>2.0</half_band>
                <setpoint>293.15</setpoint>
                <type-in>kelvin</type-in>
                <type-out>u8</type-out>
                <!-- asserted below the setpoint, unasserted above it. Two
                     heaters, because one failing must not leave the mass
                     with no way to be warmed: either alone holds the band
                     while the orbit is warm, and both together hold it in
                     the cold too. -->
                <moc-out>heaters_1.thermostat</moc-out>
                <moc-out>heaters_2.thermostat</moc-out>
                <world-out>gateway.thermostat</world-out>
                <world-out>housekeeping.thermostat</world-out>
                <world-in>ambient</world-in>
            </compute>
        </type>
        <type name="log">
            <compute name="housekeeping">
                <directory>/var/log/tcspecial</directory>
                <format>variable_ts_rc</format>
                <world-in>temp1</world-in>
                <world-in>temp2</world-in>
                <world-in>temp3</world-in>
                <world-in>thermostat</world-in>
            </compute>
        </type>
    </vehicle>
    <payloads>
        <type name="gpio_out">
            <!-- Two heaters, each three circuits driven together, both near
                 the sensors on the same thermal mass. Separate nodes rather
                 than six lines on one, so that one can be stopped from the
                 ground while the other goes on warming the mass. -->
            <payload name="heaters_1">
                <lines>3,4,5</lines>
                <path>/dev/gpiochip0</path>
                <moc-in>thermostat</moc-in>
            </payload>
            <payload name="heaters_2">
                <lines>6,7,8</lines>
                <path>/dev/gpiochip0</path>
                <moc-in>thermostat</moc-in>
            </payload>
        </type>
        <type name="i2c">
            <!-- One of three sensors of the same place, a trio, so that the
                 temperature survives one of them going wrong. Two bytes,
                 signed, big endian. -->
            <payload name="temp_1">
                <address>0x48</address>
                <group>zone_temps</group>
                <path>/dev/i2c-1</path>
                <read_size>2</read_size>
                <world-out-type>i16</world-out-type>
                <world-out>temp1.temp_1</world-out>
            </payload>
            <!-- The second of the trio; the same part as temp_1, on the
                 same bus. -->
            <payload name="temp_2">
                <address>0x49</address>
                <group>zone_temps</group>
                <path>/dev/i2c-1</path>
                <read_size>2</read_size>
                <world-out-type>i16</world-out-type>
                <world-out>temp2.temp_2</world-out>
            </payload>
        </type>
        <type name="spi">
            <!-- The third. A different part on a different bus: three
                 bytes, unsigned, its own scale and so its own conversion,
                 so that no one bus and no one part number can take the
                 whole trio out. -->
            <payload name="temp_3">
                <format>u24_be</format>
                <group>zone_temps</group>
                <max_speed>1000000</max_speed>
                <path>/dev/spidev0.0</path>
                <read_size>3</read_size>
                <spi_mode>0</spi_mode>
                <world-out-type>u32</world-out-type>
                <world-out>temp3.temp_3</world-out>
            </payload>
        </type>
    </payloads>
    <!-- the zone temperature the heaters are held at, in kelvin -->
    <commands>
        <from>gateway</from>
        <sets>thermostat.setpoint</sets>
    </commands>
    <tcs-gui>
        <nodes>
            <node name="ambient" x="469" y="166"/>
            <node name="gateway" x="790" y="34"/>
            <node name="heaters_1" x="34" y="393"/>
            <node name="heaters_2" x="34" y="470"/>
            <node name="housekeeping" x="469" y="374"/>
            <node name="temp1" x="242" y="34"/>
            <node name="temp2" x="242" y="166"/>
            <node name="temp3" x="242" y="280"/>
            <node name="temp_1" x="34" y="34"/>
            <node name="temp_2" x="34" y="166"/>
            <node name="temp_3" x="34" y="280"/>
            <node name="thermostat" x="601" y="242"/>
        </nodes>
    </tcs-gui>
</configuration>
