<?xml version="1.0" encoding="UTF-8"?>
<!-- One payload on a UDP link, its telemetry going to the ground.

     Equivalent to example.yaml -- a configuration may be written in either
     format, and both of this one are kept. The YAML is the one to read: it
     carries the comments, including how to run it.

     Conventions, which are what XML and YAML agree on:
       - every value is a child element, never an attribute
       - a sequence is repeated sibling elements named for the field,
         and the repeats must be contiguous
       - an absent optional field is simply an omitted element -->
<configuration>
    <version>2.0</version>
    <description>One payload on a UDP link, its telemetry going to the ground</description>
    <!-- What tcspecial itself is configured with: where commands are taken,
         where beacons go, and where the telemetry log is written. Required of
         every configuration; see example.yaml for what the two ports are
         for. -->
    <tcspecial>
        <tcspecial_command>0.0.0.0:4000</tcspecial_command>
        <moc_command>127.0.0.1:4100</moc_command>
        <payload_interface>0.0.0.0:4001</payload_interface>
        <tcspecial_tc_base>0.0.0.0:6000</tcspecial_tc_base>
        <moc_tc_base>127.0.0.1:6100</moc_tc_base>
        <beacon_interval_ms>5000</beacon_interval_ms>
        <beacon_address>239.255.0.1:5550</beacon_address>
        <beacon_interface>127.0.0.1</beacon_interface>
        <log_dir>/var/log/tcspecial</log_dir>
        <log_segment_bytes>65536</log_segment_bytes>
    </tcspecial>
    <groups>
        <name>every_second</name>
        <interval>1s</interval>
    </groups>
    <nodes>
        <name>payload</name>
        <type>network</type>
        <protocol>udp</protocol>
        <address>127.0.0.1</address>
        <port>5100</port>
        <group>every_second</group>
        <!-- What is written to ask for the next reading, and what allows the
             link down to this payload at all: see example.yaml -->
        <trigger>01</trigger>
        <!-- In the payload working pane, the right-hand quarter of the
             editor's canvas -->
        <editor><x>744</x><y>160</y></editor>
    </nodes>
    <nodes>
        <name>moc</name>
        <type>moc</type>
        <address>127.0.0.1</address>
        <port>5000</port>
        <editor><x>24</x><y>40</y></editor>
    </nodes>
    <links>
        <from>payload</from>
        <to>moc</to>
    </links>
    <links>
        <from>moc</from>
        <to>payload</to>
    </links>
</configuration>
