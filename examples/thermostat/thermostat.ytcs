# yaml-language-server: $schema=../../tcsgui/share/schema/tcspecial.schema.json


tcspecial:
  beacon:
    default_interval: "5 s"
    recv: "127.0.0.1:5650"
    reset_interval: "1 s"
    send: "0.0.0.0:5550"
  gateway: "radio"
  interface: "ad9aac4dd5a6d88dd5e78824ba8a83ac"
  log:
    directory: "/tmp/telemetry"
    segment_size: "65536"
  payload_command:
    dest_base: "0.0.0.0:4200"
    source_base: "127.0.0.1:4300"
  payload_telemetry:
    dest_base: "127.0.0.1:6100"
    source_base: "0.0.0.0:6000"
  # tcspecial counts its starts in this file, which must be on storage
  # that survives a power cycle on a vehicle.
  state_file: "/tmp/tcspecial-thermostat.state"
  tcs_cmd:
    recv: "0.0.0.0:4000"
    send: "127.0.0.1:4100"

payload_groups:
  - name: "zone_temps"
    interval: "100 ms"

gateways:
  - type gateway_radio:
      - gateway: gateway
        address: "127.0.0.1"
        ground_base: "127.0.0.1:5100"
        port: "5000"
        payload-in: true

vehicle:
  - type compute:
      # One temperature out of the three, by the algorithm named: median
      # takes the middle reading, closest_mean the mean of the two that
      # agree best. Either leaves a sensor that has gone wrong out of the
      # answer, which a mean over all three would not, and it produces a
      # value on every arrival, so one sensor that stops reporting is
      # outvoted rather than stopping the vehicle from deciding anything.
      - compute: ambient
        algorithm: "median"
        function: "vote"
        inputs: "in0,in1,in2"
        payload-out:
          - target: gateway
          - target: thermostat
        payload-in: true
      - compute: temp1
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        payload-out:
          - target: ambient
            input: in0
          - target: gateway
          - target: housekeeping
        payload-in: true
      - compute: temp2
        format: "i16_be"
        function: "to_kelvin"
        offset: "273.15"
        scale: "0.0625"
        payload-out:
          - target: ambient
            input: in1
          - target: gateway
          - target: housekeeping
        payload-in: true
      - compute: temp3
        format: "u24_be"
        function: "to_kelvin"
        offset: "255.37"
        scale: "0.0078"
        payload-out:
          - target: ambient
            input: in2
          - target: gateway
          - target: housekeeping
        payload-in: true
      # setpoint is set from the ground; half_band is how far either side
      # of it the heaters are switched at, the setpoint being in the middle
      # of the band.
      - compute: thermostat
        function: "hysteresis"
        half_band: "2.0"
        setpoint: "293.15"
        # asserted below the setpoint, unasserted above it. Two heaters, because
        # one failing must not leave the mass with no way to be warmed: either
        # alone holds the band while the orbit is warm, and both together hold
        # it in the cold too, each switched through a line of its own. What it
        # decides goes to the heaters and the log and not to the ground: the
        # ground is told what the heaters are doing, by gpio-in-tmass, which a
        # heater that has failed does not hide.
        gateway-out:
          - target: gpio-out-tmass1
          - target: gpio-out-tmass2
        payload-out:
          - target: housekeeping
        payload-in: true
  - type log:
      - compute: housekeeping
        directory: "/tmp/telemetry"
        format: "variable_ts_rc"
        payload-in: true

payloads:
  # The heaters and the lines that sense them, on the thermal mass, through
  # the kernel's simulated chip, which bin/mk-kernel-stand-ins makes: lines
  # 2 to 5, which leaves 0 and 1 to the gpio example.
  - type gpio:
      # Two lines on the thermal mass, one sensing each heater: high while it
      # is heating. Read every second for what they are, rather than for
      # when they change, so the ground hears the heaters' state on a beat
      # and a lost report is made good by the next; one bit a line, each a
      # sixteen-byte record -- when, which line, what it is -- to the ground
      # and the log. Disabled from the ground, it reports nothing at all.
      - payload: gpio-in-tmass
        edge: "none"
        lines: "2,3"
        path: "/dev/gpiochip1"
        state_interval: "1 s"
        payload-out:
          - target: gateway
          - target: housekeeping
      # The two heaters' switches, each a line the thermostat drives -- 1 for
      # on, 0 for off. One payload each, so that one can be stopped from the
      # ground while the other goes on warming the mass.
      - payload: gpio-out-tmass1
        direction: "output"
        lines: "4"
        path: "/dev/gpiochip1"
        gateway-in: true
      - payload: gpio-out-tmass2
        direction: "output"
        lines: "5"
        path: "/dev/gpiochip1"
        gateway-in: true
  # The sensors are each the far end of a UDP socket, which tcssim stands in
  # for with nothing more than a socket, so that they touch no hardware. The
  # buses these parts would be on aboard -- I2C, SPI -- are flown against
  # stand-ins by make stand-ins-test and make kernel-stand-ins-test.
  - type network:
      # One of three sensors of the same place, a trio, so that the
      # temperature survives one of them going wrong. Two bytes, signed,
      # big endian.
      - payload: temp_1
        address: "127.0.0.1"
        group: "zone_temps"
        port: "5201"
        protocol: "udp"
        payload-out:
          - target: temp1
      # The second of the trio; the same part as temp_1.
      - payload: temp_2
        address: "127.0.0.1"
        group: "zone_temps"
        port: "5202"
        protocol: "udp"
        payload-out:
          - target: temp2
      # The third. A different part: three bytes, unsigned, its own scale and
      # so its own conversion, so that no one part number can take the whole
      # trio out.
      - payload: temp_3
        address: "127.0.0.1"
        group: "zone_temps"
        port: "5203"
        protocol: "udp"
        payload-out:
          - target: temp3

commands:
  # the zone temperature the heaters are held at, in kelvin
  - { from: gateway, sets: thermostat.setpoint }

tcsgui:
  nodes:
    - { node: ambient, x: 469, y: 166 }
    - { node: gateway, x: 790, y: 34 }
    - { node: gpio-in-tmass, x: 242, y: 470 }
    - { node: gpio-out-tmass1, x: 34, y: 393 }
    - { node: gpio-out-tmass2, x: 34, y: 470 }
    - { node: housekeeping, x: 469, y: 374 }
    - { node: temp1, x: 242, y: 34 }
    - { node: temp2, x: 242, y: 166 }
    - { node: temp3, x: 242, y: 280 }
    - { node: temp_1, x: 34, y: 34 }
    - { node: temp_2, x: 34, y: 166 }
    - { node: temp_3, x: 34, y: 280 }
    - { node: thermostat, x: 601, y: 242 }
