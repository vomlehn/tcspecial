<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcslibgs/schema/tcspecial.xsd">
    <description>A payload that is a program, sending a line of text a word at a time</description>
    <tcspecial>
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:5650</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:5550</send>
        </beacon>
        <gateway>radio</gateway>
        <interface>c7820f9bfe585feab72247ece0a2261d</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:4200</dest_base>
            <source_base>127.0.0.1:4300</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:6100</dest_base>
            <source_base>0.0.0.0:6000</source_base>
        </payload_telemetry>
        <!-- tcspecial keeps in this file which configuration the next start is
             to run, the last one the ground confirmed, and how many starts of
             it have ended before a matching CONNECT, so on a vehicle it must be
             on storage that survives a power cycle. -->
        <state_file>/tmp/tcspecial-simple-app.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:4000</recv>
            <send>127.0.0.1:4100</send>
        </tcs_cmd>
    </tcspecial>
    <gateways>
        <type name="gateway_radio">
            <!-- The ground's end of the vehicle's data. tcspecial -->
            <!-- sends what each node drawn into it produces as UDP -->
            <!-- datagrams to ground_base's address, at its port plus -->
            <!-- that node's device id: lorem is id 1, so its words go -->
            <!-- to 127.0.0.1:5101. Ground software gets them from this node -->
            <!-- with a function call, -->
            <!-- tcslib::gateway::GatewayReceiver::receive: run -->
            <!-- `lorem_gateway` to be that ground. It states no address or -->
            <!-- port of its own, because nothing comes back up. -->
            <gateway name="gateway-1">
                <ground_base>127.0.0.1:5100</ground_base>
                <world-in>lorem</world-in>
            </gateway>
        </type>
    </gateways>
    <payloads>
        <!-- A payload that is a program rather than a device: it is never -->
        <!-- asked, and reports one word of its line at a time, then a -->
        <!-- packet holding the line terminator. `app-payload-arg` is which -->
        <!-- line it sends, counting from one. -->
        <type name="app_pl">
            <!-- The program is a Python 3 script beside this file, named -->
            <!-- relative to the repository's root because that is -->
            <!-- where tcspecial is run from: see examples/Makefile. -->
            <payload name="lorem">
                <app-payload-arg>1</app-payload-arg>
                <executable>examples/simple-app/lorem_pl.py</executable>
                <world-out>gateway-1.lorem</world-out>
            </payload>
        </type>
    </payloads>
    <tcsgui>
        <nodes>
            <node name="gateway-1" x="790" y="129"/>
            <node name="lorem" x="15" y="204"/>
        </nodes>
    </tcsgui>
</configuration>
