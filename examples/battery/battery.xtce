<?xml version="1.0" encoding="UTF-8"?>
<!-- What the vehicle sends the ground, flying the configuration
     battery: each node whose data reaches it, as a parameter named
     for the node, of the type the node sends, in a container of its own.
     The types are tcslibgs/xtce/types.xtce's, copied. A string or bytes
     is all of what carries it, and no count is sent before it: its
     length, and bytes_length, are what the ground is given by how it is
     framed. How each gateway frames what it sends is the ground
     station's to add.

     Written by tcsverify, asked for it by its xtce option, from the
     configuration and types.xtce, and not to be edited: see "The
     configuration's own XTCE" in tcspecial's docs/design.rst. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214" name="battery">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <IntegerParameterType name="u8" signed="false" sizeInBits="8">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </IntegerParameterType>
      <FloatParameterType name="volt" sizeInBits="64"
          shortDescription="Potential: a bus or a cell.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">volts</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-volts</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>V</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="ampere" sizeInBits="64"
          shortDescription="Current: a load, a source, a bus.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">amperes</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-amperes</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>A</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
      <FloatParameterType name="ratio" sizeInBits="64"
          shortDescription="A fraction of a whole: a charge, a throttle.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">a ratio</AncillaryData>
          <AncillaryData name="tcspecial.step">millionths</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>ratio</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="battery_amps" parameterTypeRef="ampere"/>
      <Parameter name="bus_volts" parameterTypeRef="volt"/>
      <Parameter name="charge" parameterTypeRef="ratio"/>
      <Parameter name="shedding" parameterTypeRef="u8"/>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="battery_amps_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="battery_amps"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="bus_volts_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="bus_volts"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="charge_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="charge"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="shedding_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="shedding"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
</SpaceSystem>
