<?xml version="1.0" encoding="UTF-8"?>
<!-- What the vehicle sends the ground, flying the configuration
     thermostat-yamcs: each node whose data reaches it, as a parameter named
     for the node, of the type the node sends, in a container of its own.
     Each attribute a command binding sets is a command, as the SET_NODE
     that sets it goes, its value an argument of the attribute's type.
     The types are tcslib-protocol/xtce/types.xtce's, copied: a string or bytes
     after a 32-bit count of its bytes, as each is sent where the ground
     decodes it by XTCE (under Yamcs). Where no XTCE decodes it, the count
     is sent in groups of seven bits instead, least significant first, each
     in a byte whose top bit says another follows. How each gateway frames
     what it sends is the ground station's to add.

     Written by tcsverify, asked for it by its xtce option, from the
     configuration and types.xtce, and not to be edited: see "The
     configuration's own XTCE" in tcspecial's docs/tcspecial-design.rst. -->
<SpaceSystem xmlns="http://www.omg.org/spec/XTCE/20250214"
    name="thermostat-yamcs">
  <TelemetryMetaData>
    <ParameterTypeSet>
      <IntegerParameterType name="u8" signed="false" sizeInBits="8">
        <IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </IntegerParameterType>
      <FloatParameterType name="kelvin" sizeInBits="64"
          shortDescription="Temperature.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">kelvin</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-kelvin</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>K</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatParameterType>
    </ParameterTypeSet>
    <ParameterSet>
      <Parameter name="consensus_temp" parameterTypeRef="kelvin"/>
      <Parameter name="gpio-out-tmass1" parameterTypeRef="u8"/>
      <Parameter name="gpio-out-tmass2" parameterTypeRef="u8"/>
      <Parameter name="to_k1" parameterTypeRef="kelvin"/>
      <Parameter name="to_k2" parameterTypeRef="kelvin"/>
      <Parameter name="to_k3" parameterTypeRef="kelvin"/>
    </ParameterSet>
    <ContainerSet>
      <SequenceContainer name="consensus_temp_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="consensus_temp"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="gpio-out-tmass1_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="gpio-out-tmass1"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="gpio-out-tmass2_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="gpio-out-tmass2"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="to_k1_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="to_k1"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="to_k2_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="to_k2"/>
        </EntryList>
      </SequenceContainer>
      <SequenceContainer name="to_k3_packet">
        <EntryList>
          <ParameterRefEntry parameterRef="to_k3"/>
        </EntryList>
      </SequenceContainer>
    </ContainerSet>
  </TelemetryMetaData>
  <CommandMetaData>
    <ArgumentTypeSet>
      <IntegerArgumentType name="u32" signed="false" sizeInBits="32">
        <IntegerDataEncoding sizeInBits="32" encoding="unsigned"/>
      </IntegerArgumentType>
      <FloatArgumentType name="kelvin" sizeInBits="64"
          shortDescription="Temperature.">
        <AncillaryDataSet>
          <AncillaryData name="tcspecial.name">kelvin</AncillaryData>
          <AncillaryData name="tcspecial.step">micro-kelvin</AncillaryData>
        </AncillaryDataSet>
        <UnitSet>
          <Unit>K</Unit>
        </UnitSet>
        <IntegerDataEncoding sizeInBits="32" encoding="twosComplement">
          <DefaultCalibrator>
            <PolynomialCalibrator>
              <Term coefficient="0.000001" exponent="1"/>
            </PolynomialCalibrator>
          </DefaultCalibrator>
        </IntegerDataEncoding>
      </FloatArgumentType>
    </ArgumentTypeSet>
    <MetaCommandSet>
      <MetaCommand name="set_thermostat_setpoint">
        <ArgumentList>
          <Argument name="Sequence" argumentTypeRef="u32"/>
          <Argument name="Value" argumentTypeRef="kelvin"/>
        </ArgumentList>
        <CommandContainer name="set_thermostat_setpoint_packet">
          <EntryList>
            <FixedValueEntry name="Opcode" binaryValue="32" sizeInBits="8"/>
            <ArgumentRefEntry argumentRef="Sequence"/>
            <FixedValueEntry name="Node" sizeInBits="32"
                binaryValue="00000007"/>
            <FixedValueEntry name="Attribute" sizeInBits="72"
                binaryValue="08736574706F696E74"/>
            <FixedValueEntry name="ValueLength" sizeInBits="16"
                binaryValue="0004"/>
            <ArgumentRefEntry argumentRef="Value"/>
          </EntryList>
        </CommandContainer>
      </MetaCommand>
    </MetaCommandSet>
  </CommandMetaData>
</SpaceSystem>
