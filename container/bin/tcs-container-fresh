#!/bin/sh
# tcs-container-fresh: tcs-container fresh, as a command of its own: throw the
# container away and start a new one.
#
#   tcs-container-fresh [--distro kubuntu|fedora] [ARGUMENT...]
#
# Runs bin/tcs-container beside it with the command fresh, passing --distro,
# when it comes first, and every other argument as tcs-container takes them.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = --distro ]; then
	[ $# -ge 2 ] || {
		echo "usage: tcs-container-fresh [--distro DISTRO]" \
			"[ARGUMENT...]" >&2
		exit 2
	}
	distro=$2
	shift 2
	exec "$here/tcs-container" --distro "$distro" fresh "$@"
fi
exec "$here/tcs-container" fresh "$@"
