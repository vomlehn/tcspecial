import {
    Button, GroupBox, LineEdit, ListView, GridBox, StandardListView,
    ScrollView
} from "std-widgets.slint";
import { Copyable, CopyButton } from "../../tcsverify/ui/copy.slint";
// The beacon's panel, shared with the other ground programs: see tcsui. What
// it shows is worked out in Rust, from what tcslib::beacon reports.
import { BeaconPanel } from "../../tcsui/ui/beacon.slint";
import { PingPanel } from "../../tcsui/ui/ping.slint";
import { Fonts } from "../../tcsui/ui/fonts.slint";
import { Colors } from "../../tcsui/ui/colors.slint";
// What was found wrong as the program started, shown before this window: the
// one window tcsmoc and tcssim share, beside tcsverify, whose report it shows.
export { StartupWindow, StartupLine } from "../../tcsverify/ui/startup.slint";

// One data handler, as the tcspecial configuration file describes it plus what
// tcspecial reports about it at run time.
//
// The window has no knowledge of which data handlers exist: Rust reads them
// from the tcspecial configuration file and hands them over as this model, so a
// handler added to or removed from that file adds or removes a panel here.
export struct DHInfo {
    // From the configuration file
    name: string,
    /// Which payload of the configuration this is, counted from nought in the
    /// order the file describes them.
    dev-id: int,
    config: string,
    packet-size: int,
    // From tcspecial, by way of the command interpreter
    status: string,
    // What the ground itself received from this payload: the time the last
    // message arrived, shown as "Last recv", and the data it carried, shown
    // as "From payload".
    //
    // The readings a panel shows of the data. The spacecraft's own account of
    // what it last sent and last received was shown above them and is not any
    // more: what an operator wants from a panel is what reached the ground,
    // and the spacecraft's claim about it cost two more lines saying nearly
    // the same thing.
    oc-time: string,
    oc-data: string,
    packets-recv: int,
    // Everything both configuration files said about this handler, as Rust
    // read them at startup. Held ready rather than fetched when asked:
    // nothing can change the files while the window is up, and this is not
    // telemetry -- no part of it is asked of the spacecraft.
    parameters: string,
    // Which of this node's attributes the configuration lets the ground set,
    // for the line that says so: "setpoint", or "setpoint, band". Empty for a
    // node no command binding names, which is most of them.
    //
    // From the configuration and not from the spacecraft: what may be set is
    // written in the file both ends read, which is the whole point of writing
    // it there.
    settable: string,
    // The one the field starts with, which is the first of them. A node with
    // one binding -- the ordinary case -- then needs nothing typed but the
    // value.
    setting: string,
}

component DHPanel inherits Rectangle {
    in property <string> dh-name: "DH0";
    in property <int> dev-id: 0;
    in property <string> dh-config: "UDP localhost:5000";
    in property <string> dh-status: "Stopped";
    in property <int> packet-size: 12;
    in property <string> oc-time: "--:--:--";
    in property <string> oc-data: "";
    in property <int> packets-recv: 0;
    in property <string> parameters: "";
    in property <string> settable: "";
    in property <string> setting: "";

    callback enable-clicked();
    callback disable-clicked();
    // The attribute and the value, as they were typed. Which node they are
    // about is the panel's, which the parent supplies when it connects this.
    callback set-clicked(string, string);

    background: #f0f0f0;
    border-color: #808080;
    border-width: 1px;


    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        // Every row says the least it can be read in. Without that the
        // panel has no floor at all -- a Text will shrink to nothing and clip
        // its own glyphs rather than refuse -- and PANEL_HEIGHT would be a
        // guess about font metrics instead of the sum of these, which
        // every_panels_data_is_inside_the_window measures.
        // The name and the status, with a gap between them: the row set no
        // spacing, so "tcp-stream (dev id 0)" ended at the pixel "Unknown"
        // began at and the two read as one string.
        header-row := HorizontalLayout {
            min-height: 20px;
            spacing: 4px;
            // The name and the number of the payload, which is its place in
            // the payload configuration -- the first payload the file
            // describes is 0. Nothing states it: the file's order is what
            // decides it, and both windows count the same way, so a payload
            // is the same number in each.
            Text {
                text: dh-name + " (dev id " + dev-id + ")";
                font-size: Fonts.window;
                font-weight: 700;
            }
            Text {
                text: dh-status;
                color: dh-status == "Active" ? #008000 : #808080;
            }
        }

        // A floor rather than a height. Twelve pixels is three short of what
        // a line of this text takes, and a row that cannot shrink its text
        // does not refuse -- it clips it, which reads as a font that sits too
        // low rather than as a row that is too short.
        config-row := HorizontalLayout {
            min-height: 12px;
            Text {
                text: "Config: " + dh-config;
                font-size: Fonts.window;
            }
        }

        size-row := HorizontalLayout {
            min-height: 16px;
            // No packet interval: how often a payload produces a packet is a
            // property of a simulation rather than of a payload, so it lives in
            // the simulator's own file and tcssim is what shows it.
            Text {
                text: "Packet Size: " + packet-size + " bytes";
                font-size: Fonts.window;
            }
        }

        // Two buttons, one per command, each saying what it sends. Enable
        // starts the handler and Disable stops it, and both are pressable
        // whatever the handler is doing: tcspecial answers a START_DH for a
        // handler already running and a STOP_DH for one already stopped
        // without doing harm, and what an operator wants when a panel looks
        // wrong is what the spacecraft says to the command, which a button
        // that cannot be pressed does not say.
        //
        // Enable first, because that is the press a panel is opened to make;
        // the status beside the name says which of the two has taken effect.
        //
        // All three on one row, which is what sets the panel's width: three
        // buttons side by side are wider than any line of text in the panel.
        // Configuration is last because the two commands are what a panel is
        // opened to press. It was abbreviated to Config to spend less of that
        // width; it is spelled out now, as tcssim's is, so that the two
        // windows name one button one way, and PANEL_WIDTH pays for it.
        commands-row := HorizontalLayout {
            spacing: 4px;

            Button {
                text: "Enable";
                clicked => { enable-clicked(); }
            }

            Button {
                text: "Disable";
                clicked => { disable-clicked(); }
            }

            // What the two configuration files said about this handler.
            Button {
                text: "Configuration";
                clicked => { parameters-popup.show(); }
            }
        }

        parameters-popup := PopupWindow {
            x: 4px;
            y: 4px;
            width: 300px;
            height: 340px;
            // Closed by a press outside it, not by any press: a press inside
            // is somebody selecting what it says to copy it.
            close-policy: close-on-click-outside;

            Rectangle {
                background: white;
                border-color: #808080;
                border-width: 1px;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 4px;
                        Copyable {
                            text: dh-name + " parameters";
                            font-weight: 700;
                            font-size: Fonts.window;
                        }
                        CopyButton {
                            said: dh-name + " parameters\n" + parameters;
                        }
                    }

                    // Scrolled rather than sized to the text: how many lines
                    // there are depends on the kind of payload and on how
                    // many faults the simulator file asked for, and a popup
                    // tall enough for the longest of them would be taller
                    // than the window.
                    ScrollView {
                        Copyable {
                            // The lines are columns of name and value, so
                            // they only line up in a font whose characters
                            // are one width -- and they are not wrapped, a
                            // column broken in two being no column.
                            font-family: Fonts.mono;
                            font-size: Fonts.window;
                            wrap: no-wrap;
                            text: parameters;
                        }
                    }

                    // What the ground may set on this node, and the field to
                    // set it with. The attribute is typed rather than chosen
                    // from a list because a node has one binding in the
                    // ordinary case and the field is already filled with it:
                    // a list of one is a control that asks for a decision
                    // nobody has to make.
                    if settable != "": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "The ground may set: " + settable;
                            font-size: Fonts.window;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            attribute-field := LineEdit {
                                text: setting;
                                font-size: Fonts.window;
                                min-width: 80px;
                            }
                            Text {
                                text: "=";
                                vertical-alignment: center;
                            }
                            value-field := LineEdit {
                                placeholder-text: "value";
                                font-size: Fonts.window;
                                min-width: 60px;
                            }
                            Button {
                                text: "Set";
                                clicked => {
                                    set-clicked(attribute-field.text,
                                                value-field.text);
                                }
                            }
                        }
                    }

                    // And a node no binding names says so, rather than
                    // showing a field whose every press would be refused.
                    if settable == "": Text {
                        text: "No command binding names this node, "
                            + "so nothing on it may be set from the ground.";
                        font-size: Fonts.window;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // The two rows of data the panel ends with. They are named because
        // they are the rows that go missing: a panel given less height than
        // it needs loses them off the bottom first, and
        // every_panels_data_is_inside_the_window finds them by these names
        // and requires them to be where they can be seen.
        //
        // Labelled lines rather than a group box each. A group box spends
        // some sixty-five pixels on its title and padding to hold one line of
        // ten point text, and two of them were half the height of the panel:
        // three rows of panels then wanted a window taller than a 1080 line
        // screen.
        //
        // What arrived from the payload: when, and what. Two lines, because
        // they are read for different things -- whether anything is still
        // coming, and what it was.
        //
        // Both are the ground's own reading. There were two rows above these
        // carrying the spacecraft's account of what it last sent and last
        // received, which is a different claim: these say something reached
        // the ground.
        last-recv-row := HorizontalLayout {
            spacing: 4px;
            min-height: 14px;
            // No indicator beside this time says whether what arrived was
            // recent enough: nothing states how often a payload's data
            // should arrive. A node produces when something reaches it, and
            // a thermostat that emits only when its decision changes has no
            // rate to be judged against. An indicator that could never change
            // is worse than no indicator.
            Text {
                text: "Last recv:";
                font-size: Fonts.window;
                vertical-alignment: center;
            }
            Text {
                text: oc-time;
                font-size: Fonts.window;
                vertical-alignment: center;
            }
        }

        from-payload-row := HorizontalLayout {
            spacing: 4px;
            min-height: 14px;
            Text {
                text: "From payload:";
                font-size: Fonts.window;
                vertical-alignment: center;
            }
            Text {
                text: oc-data;
                font-size: Fonts.window;
                vertical-alignment: center;
            }
        }

        // How many packets have arrived from this payload, counted by the
        // ground that received them -- as the two lines above are. It was a
        // byte count out of the spacecraft's own statistics, and the wrong
        // half of them: the bytes its handler had read from the ground, which
        // is the direction nobody sends in, so the line read "0 bytes" for a
        // payload that was sending steadily.
        counters-row := HorizontalLayout {
            min-height: 14px;
            Text {
                text: "Recv: " + packets-recv + " recv";
                font-size: Fonts.window;
            }
        }
    }
}

export enum MenuAction {
    ping, arm-restart, restart, query, query-dh, start-dh, stop-dh
}

// Asked when tcspecial announces a configuration other than the one this MOC
// read: the digest in its beacons, computed from the files it read, is not the
// digest this MOC computed from the files it read. Then the panels may say a
// source's data arrives where the vehicle does not send it, so the operator
// decides whether to go on.
//
// Asked inside the main window, in front of its panels, rather than in a
// window of its own: the main window takes no presses while it is up, and a
// window of its own cannot be kept in front of the main one on every desktop
// -- Wayland lets no program hold its windows on top -- so a question behind
// the window waiting for it would leave nothing anybody could press.
component DiffersPanel inherits Rectangle {
    background: Colors.window;
    border-width: 1px;
    border-color: #808080;
    border-radius: 4px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    min-width: 420px;
    preferred-width: 560px;

    // Both digests, and which file this MOC read.
    in property <string> message: "";

    callback continue-anyway();
    callback quit();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Copyable {
            text: "tcspecial is serving a different configuration";
            font-size: Fonts.window;
            font-weight: 700;
            color: #c0392b;
        }
        Copyable {
            text: root.message;
            font-size: Fonts.window;
        }
        Copyable {
            text: "The panels may show sources where the vehicle "
                + "does not send them. Continue anyway?";
            font-size: Fonts.window;
            color: #6b7280;
        }
        HorizontalLayout {
            spacing: 8px;
            CopyButton {
                said: "tcspecial is serving a different configuration\n"
                    + root.message;
            }
            Rectangle { }
            Button {
                text: "Quit";
                clicked => { root.quit(); }
            }
            Button {
                text: "Continue anyway";
                clicked => { root.continue-anyway(); }
            }
        }
    }
}

// What the window says of a command pressed when it should not go, or should
// be thought about first: an error, closed with OK, for a command refused
// unsent while this station is not matched with the vehicle; or an advisory,
// with Go on and Cancel, for a restart pressed before a CONNECT has been
// answered. What it says is Rust's: see `vehicle::refused_unmatched` and
// `vehicle::advise_before_restart`.
//
// Asked inside the main window, in front of the veil, as DiffersPanel is and
// for its reason: a window of its own cannot be kept in front of this one on
// every desktop. Copyable, as every popup is.
component NoticePanel inherits Rectangle {
    background: Colors.window;
    border-width: 1px;
    border-color: #808080;
    border-radius: 4px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    min-width: 420px;
    preferred-width: 560px;

    in property <string> heading: "";
    in property <string> message: "";
    // Whether it asks -- Go on or Cancel -- rather than tells, with OK.
    in property <bool> asks: false;

    callback go-on();
    callback cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Copyable {
            text: root.heading;
            font-size: Fonts.window;
            font-weight: 700;
            // Red for an error and amber for an advisory, and never the
            // colour alone: the heading and the buttons say which it is.
            color: root.asks ? #b45309 : #c0392b;
        }
        Copyable {
            text: root.message;
            font-size: Fonts.window;
        }
        HorizontalLayout {
            spacing: 8px;
            CopyButton {
                said: root.heading + "\n" + root.message;
            }
            Rectangle { }
            if root.asks: Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            if root.asks: Button {
                text: "Go on";
                clicked => { root.go-on(); }
            }
            if !root.asks: Button {
                text: "OK";
                clicked => { root.cancel(); }
            }
        }
    }
}

// What a panel comes to, asked of a window that is never opened.
//
// A panel laid out alone reports what it wants; one in the grid is stretched
// to its cell and reports what it was given. Its own component rather than a
// hidden panel in MainWindow: a child of a window is something the window has
// to make room for, whatever its visibility, and a panel parked in there had
// a say in the window's size. Nothing here is shown -- Rust builds one, reads
// the two lengths, and drops it.
export component PanelProbe inherits Window {
    default-font-size: Fonts.window;
    probe := DHPanel { }
    out property <length> panel-width: probe.preferred-width;
    out property <length> panel-height: probe.preferred-height;
}

export component MainWindow inherits Window {
    default-font-size: Fonts.window;
    title: "TCSpecial MOC Simulator";
    // Rust opens the window at the size the panel count calls for; these are
    // only the floors, below which the command interpreter's controls stop
    // fitting side by side and the grid stops having room for a row of
    // panels. The height is one row of panels and the chrome below:
    // panel-height as PanelProbe measures it, 204, and chrome-height, 476.
    // A window of only this, which is what the panel tests open, that is
    // short of a row cuts a panel's last line off, and
    // every_panel_shows_what_arrived_from_its_payload is what notices.
    min-width: 739px;
    // One row of panels and the chrome, which is the least the window is ever
    // opened at -- a tcspecial configuration of one handler. How much more it
    // opens at is Rust's to say: see rows_of_room() in main.rs.
    min-height: 680px;
    background: Colors.window;

    // Whether this window takes no presses: true while a question is waiting
    // to be answered -- see DiffersPanel, and `ask_whether_to_continue` in
    // main.rs, which sets it. The panels stay there to be read, greyed by the
    // veil over them; nothing can be commanded behind the question.
    in property <bool> inert: false;

    // The question about a configuration other than the one this MOC read,
    // asked in front of the panels inside this window: see DiffersPanel.
    in property <bool> differs-up: false;
    in property <string> differs-message: "";
    callback differs-continue-anyway();
    callback differs-quit();

    // What a command pressed while this station is not matched comes to,
    // said in front of the panels inside this window: see NoticePanel. The
    // veil is up with it, so that nothing else is pressed meanwhile.
    in property <bool> notice-up: false;
    in property <string> notice-heading: "";
    in property <string> notice-message: "";
    in property <bool> notice-asks: false;
    callback notice-go-on();
    callback notice-cancel();

    // The checksum the last beacon carried, in the form the window shows a
    // checksum, or nothing until a beacon has: kept by the beacon watch, for
    // the pop-ups to name beside this station's own. Not shown by itself,
    // the beacon's panel saying it already.
    in-out property <string> beacon-checksum: "";

    in-out property <string> ci-status: "Disconnected";
    in-out property <string> ci-address: "127.0.0.1:4000";
    in-out property <string> last-response: "";
    // The configuration ARM Restart and Initiate restart restart onto: what
    // the operator typed -- nothing, for this window's own; a configuration
    // file; or a checksum of 32 lower-case hex digits -- and what Rust made
    // of it, shown beside it before anything is sent.
    in-out property <string> restart-target: "";
    in-out property <string> restart-target-shown: "";
    callback restart-target-edited(string);

    // When the last command went out and when its answer came back, over the
    // link the buttons above use. Under Last Response, which says what the
    // answer was: a response that is slow to come and one that never comes
    // read alike until the two times are beside it.
    //
    // The placeholder every other time in the window uses, until there has
    // been a command to time.
    in-out property <string> cmd-sent-time: "--:--:--";
    in-out property <string> cmd-recv-time: "--:--:--";
    // How many packets have come from the vehicle, data and answers, and how
    // many of them were processed, malformed or dropped for a configuration
    // mismatch: see `packets_said` in vehicle.rs. In the row the two times
    // are in, so that it costs the window no height.
    in-out property <string> vehicle-packets: "Packets: 0 received";
    in-out property <color> indicator-color: #c0c0c0;

    // The data handlers, read from the tcspecial configuration file by Rust.
    in-out property <[DHInfo]> dh-model: [];

    // How many panels to a row, from the width the window actually has.
    //
    // Worked out here rather than handed over by Rust, because the answer
    // changes while the program runs: a window dragged wider has room for
    // another column and now uses it, where a count settled at startup left a
    // wide window with a narrow grid and the panels scrolling under it.
    //
    // Never more columns than there are handlers, and never fewer than one.
    // Rust opens the window wide enough for the columns the handler count
    // calls for -- see columns_for in main.rs -- and because it opens it at
    // exactly that many panels' width, gaps and chrome included, the count
    // below comes out at the number asked for.
    property <int> columns: Math.max(
        1,
        Math.min(
            dh-model.length,
            Math.floor(
                (root.width - root.chrome-width + root.grid-spacing)
                / (root.panel-width + root.grid-spacing)
            )
        )
    );

    // One panel's height, which has to agree with PANEL_HEIGHT in main.rs:
    // Rust sizes the window by it and every panel claims at least this much.
    //
    // It is what a panel's own contents need, measured rather than guessed:
    // the sum of the floors the panel's rows declare, which the layout tests
    // in main.rs read off a window they open headlessly. It was 210 for a
    // long time against the 259 the panel then took, and the three rows of
    // data at the bottom of every panel paid the difference.
    // What the window is built from, and the one place each of these numbers
    // exists.
    //
    // A panel's size is measured: `probe` is a panel of its own, laid out and
    // never drawn, and what it says it wants is what a cell is made. It was a
    // pair of numbers here and another pair in main.rs, and they disagreed --
    // a panel was called 180 tall where its rows want 162, and 256 wide
    // against the 255 they take.
    //
    // A panel in the grid cannot be asked instead: it is stretched to its
    // cell, so it reports the size it was given. That stretching is what made
    // the buttons fifty pixels tall -- every row of a panel states a floor
    // rather than a height, so a panel given more than it needs hands the
    // surplus to its rows.
    in property <length> panel-width;
    in property <length> panel-height;

    // The gap between one panel and the next, and what the window spends
    // around the grid.
    //
    // The chrome is stated rather than measured, which the two panel figures
    // above are not. It cannot be measured the same way: it is the window
    // less the scrolling area, and a ScrollView reports a preferred size of
    // its own that has nothing to do with what it holds -- 360x403 whatever
    // the grid comes to. So this is one declared number in the file that owns
    // the layout, read by Rust rather than copied into it, and
    // `every_panels_data_is_inside_the_window` is what measures it: the
    // window it opens has to have room for every panel and no more than a
    // row to spare.
    //
    // Height: everything above and below the grid -- both group box headings,
    // the command interpreter's controls, the row holding Quit, the padding
    // round them all, and the grid's own padding inside the scrolling area. 436
    // since the beacon's box took a title and its message took a second line
    // where the window is too narrow for it in one, which together are 38 more
    // than the row above the grid had been; 476 since the restart target's
    // row, a line edit and the spacing above it. Width: the padding of the scrolling
    // area and of the grid inside it. The width was 30 in main.rs and wanted
    // 36, and the column gaps were left out of the window's width altogether,
    // so a three-column grid stood twenty-six pixels wider than the area it
    // scrolled in and the last column was cut off.
    out property <length> grid-spacing: 10px;
    out property <length> chrome-width: 36px;
    out property <length> chrome-height: 476px;

    // Rows follow from the panel count and the column count.
    property <int> grid-rows:
        Math.max(1, Math.ceil(dh-model.length / Math.max(1, columns)));

    // When the last beacon arrived, and the placeholder until one has. The
    // same text the panels' time lines come up with, so the window says one
    // thing about having received nothing.
    in-out property <string> beacon-last-recv: "--:--:--";

    // What the last beacon said: the build flying and the digest of the
    // configuration it read. "<none>" until one arrives, said rather than
    // left empty so that an unfilled line reads as the spacecraft not having
    // spoken rather than as the window not having been written.
    in-out property <string> beacon-last-msg: "<none>";
    // What the field beside the indicator says of a restart: see
    // `tcsui::RESTARTED_CONNECT`.
    in-out property <string> beacon-restart: "";

    callback link-clicked();
    callback ping-clicked();
    // Whether the configuration has a ping node the ground can reach both
    // ways, and so whether there is a Ping node button: see
    // `tcslib::ping::route_of`. Not the PING above, which asks whether the
    // command link reaches the vehicle; this asks a node of the vehicle the
    // time and times the answer.
    in property <bool> can-ping-node: false;
    callback ping-node-clicked();
    // Whether the configuration has a value or a switch that reaches the
    // ground, and so whether there is a Plot button: see plot.rs.
    in property <bool> can-plot: false;
    callback plot-clicked();
    callback query-all-clicked();
    // One callback for the one button a panel has. Which command it sends is
    // Rust's to decide, from the status the button's own label comes from.
    callback enable-dh(int);
    callback disable-dh(int);
    // Which panel, which attribute, and what to set it to.
    callback set-dh(int, string, string);
    callback quit-clicked();
    callback menu-action(MenuAction);

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        // CI Control Section
        GroupBox {
            title: "Command Interpreter";
            // Its own height and not a pixel more. Without this it stretches
            // like the data handler group below it, and since a ScrollView
            // can always be made smaller, every pixel the two of them argued
            // over went here: the buttons came out half again as tall as they
            // should be and the panels lost the room they needed.
            vertical-stretch: 0;

            VerticalLayout {
                spacing: 8px;

                // What the MOC has of the spacecraft, in two boxes side by
                // side: the link it talks over, and the beacon that arrives
                // whether it talks or not.
                //
                // The first holds everything about the link to tcspecial -- a
                // label naming it, the address it goes to, the button that
                // takes it up and down, and the status that button sets. The
                // border is what makes those a group rather than four things
                // that happen to sit near each other. The MOC starts both
                // tcspecial and tcssim, and the command interpreter all of
                // this reaches is tcspecial's; tcssim is on the far side of it
                // and is not disconnected by this.
                HorizontalLayout {
                    // Keeps the boxes to their contents rather than
                    // stretching them the width of the group: with the
                    // address field inside one of them, nothing is left
                    // beside them to take up the row.
                    alignment: start;
                    spacing: 8px;

                    Rectangle {
                        border-width: 1px;
                        border-color: #808080;
                        border-radius: 4px;

                        VerticalLayout {
                            // The border's own room, counted into
                            // CHROME_HEIGHT in main.rs.
                            padding: 6px;
                            spacing: 2px;
                            // Centred, because the beacon's box beside this
                            // one is the taller and the row is as tall as it:
                            // the surplus goes above and below, rather than
                            // into the rows, where it would stretch the
                            // Connect button.
                            alignment: center;

                            Text {
                                text: "tcspecial link";
                                horizontal-alignment: center;
                                font-italic: true;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: "Address:";
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    text <=> ci-address;
                                    min-width: 150px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                // One button, offering whichever of the
                                // two the link is not: there is never a
                                // Connect to press on a link that is up, and
                                // the label is what the press means. Rust
                                // reads the same status back to find out
                                // which it was.
                                Button {
                                    text: ci-status == "Connected"
                                        ? "Disconnect"
                                        : "Connect";
                                    clicked => { link-clicked(); }
                                }
                                Text {
                                    text: "Status: " + ci-status;
                                    color: ci-status == "Connected"
                                        ? #008000
                                        : #ff0000;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // The beacon, beside the link rather than down among the
                    // commands, because it says the same kind of thing: what
                    // is arriving from the spacecraft on its own, as against
                    // what the link beside it is asking for. It is not the
                    // link, which the panel's own border says.
                    //
                    // The panel is tcsui's, so that this window and the
                    // beacon example show an operator the same thing: see
                    // ../../tcsui/ui/beacon.slint.
                    BeaconPanel {
                        indicator-color: root.indicator-color;
                        last-received: root.beacon-last-recv;
                        last-message: root.beacon-last-msg;
                        restart: root.beacon-restart;
                        shows-restart: true;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        text: "Command";
                        clicked => { popup.show(); }
                    }

                    popup := PopupWindow {
                        x: 50px;
                        y: 50px;
                        width: 150px;
                        height: 220px;

                        Rectangle {
                            background: white;
                            border-color: gray;
                            border-width: 1px;

                            VerticalLayout {
                                padding: 5px;
                                Button {
                                    text: "Ping"; 
                                    clicked => {
                                        menu-action(MenuAction.ping);
                                        popup.close();
                                    }
                                }
                                Button { 
                                    text: "ARM Restart";
                                    clicked => {
                                        menu-action(MenuAction.arm-restart);
                                        popup.close();
                                    } 
                                }
                                Button {
                                    text: "Initiate restart";
                                    clicked => {
                                        menu-action(MenuAction.restart);
                                        popup.close();
                                    }
                                }
                                Button {
                                    text: "Query"; 
                                    clicked => {
                                        menu-action(MenuAction.query);
                                        popup.close();
                                    } 
                                }
                                Button { 
                                    text: "Query DH"; 
                                    clicked => {
                                        menu-action(MenuAction.query-dh);
                                        popup.close();
                                    } 
                                }
                                Button { 
                                    text: "Start DH"; 
                                    clicked => {
                                        menu-action(MenuAction.start-dh);
                                        popup.close();
                                    } 
                                }
                                Button { 
                                    text: "Stop DH"; 
                                    clicked => {
                                        menu-action(MenuAction.stop-dh);
                                        popup.close();
                                    } 
                                }
                            }
                        }
                    }

                    // In the row the Command button is in, so that it costs
                    // the window no height: the panel it opens is a window of
                    // its own.
                    if can-ping-node: Button {
                        text: "Ping node";
                        clicked => { ping-node-clicked(); }
                    }

                    // The plot window, where the configuration has a value
                    // or a switch that reaches the ground: in this row for
                    // the reason Ping node is.
                    if can-plot: Button {
                        text: "Plot";
                        clicked => { plot-clicked(); }
                    }

                }

                // What a restart restarts onto, under the button that sends
                // it: the field, and what the field comes to, checksum and
                // file.
                restart-target-row := HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Restart target:";
                        vertical-alignment: center;
                    }
                    LineEdit {
                        accessible-label: "Restart target";
                        text <=> restart-target;
                        placeholder-text: "this configuration, a file, or a checksum";
                        min-width: 260px;
                        edited(text) => { restart-target-edited(text); }
                    }
                    Text {
                        text: restart-target-shown;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "Last Response: " + last-response;
                        font-size: Fonts.window;
                    }
                }

                command-times-row := HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Last sent:"; font-size: Fonts.window; }
                    Text { text: cmd-sent-time; font-size: Fonts.window; }
                    Text { text: "Last rcvd:"; font-size: Fonts.window; }
                    Text { text: cmd-recv-time; font-size: Fonts.window; }
                    Text { text: vehicle-packets; font-size: Fonts.window; }
                }
            }
        }

        // Data Handlers Section
        GroupBox {
            title: "Data Handlers";
            // The one thing that takes up the slack, or gives it up.
            vertical-stretch: 1;

            scroll := ScrollView {
                // The panels keep their own height, and the spare room goes
                // under them.
                //
                // Without the Rectangle the grid takes the whole of the
                // scrolling area and stretches its rows to fill it: a panel
                // came out 275 tall where it wants 162, and its rows, which
                // state floors rather than heights, shared out the surplus --
                // which is how a Button ended up fifty pixels tall.
                VerticalLayout {
                    grid := GridBox {
                            spacing: root.grid-spacing;
                        // No height of its own. It used to claim grid-rows *
                        // panel-height, which the panels then overran, and a
                        // ScrollView centres content shorter than itself: that
                        // is where the gap under the Data Handlers heading came
                        // from, with the panels hanging off the bottom at the
                        // same time. Each panel asks for the height it needs
                        // instead, and the grid is as tall as they come to.
                        for dh[i] in dh-model: DHPanel {
                            min-height: root.panel-height;
                            width: root.panel-width;
                            row: Math.floor(i / Math.max(1, root.columns));
                            col: Math.mod(i, Math.max(1, root.columns));
                            dh-name: dh.name;
                            dev-id: dh.dev-id;
                            dh-config: dh.config;
                            dh-status: dh.status;
                            packet-size: dh.packet-size;
                            oc-time: dh.oc-time;
                            oc-data: dh.oc-data;
                            packets-recv: dh.packets-recv;
                            parameters: dh.parameters;
                            settable: dh.settable;
                            setting: dh.setting;
                            enable-clicked => { enable-dh(i); }
                            disable-clicked => { disable-dh(i); }
                            set-clicked(attribute, value) => {
                                set-dh(i, attribute, value);
                            }
                        }
                    }
                    Rectangle { }
                }
            }
        }

        // Quit Button
        HorizontalLayout {
            vertical-stretch: 0;
            Rectangle { }
            Button {
                text: "Quit";
                clicked => { quit-clicked(); }
            }
        }
    }

    // What makes it inert: a veil over the whole window that takes presses
    // and does nothing with them, there only while it is wanted. Grey and
    // part clear, so that everything under it is greyed: still there to be
    // read, and plainly not taking presses.
    if root.inert || root.notice-up: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #e5e7ebb3;

        TouchArea { }
    }

    // A notice about a command, in front of the veil and behind the question
    // below, which is about the whole window and so comes first.
    if root.notice-up: NoticePanel {
        width: min(self.preferred-width, root.width - 32px);
        height: self.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        heading: root.notice-heading;
        message: root.notice-message;
        asks: root.notice-asks;
        go-on => { root.notice-go-on(); }
        cancel => { root.notice-cancel(); }
    }

    // And in front of the veil, the question it is waiting for: never behind
    // the window, being in it. Centred, and no wider than the window leaves
    // room for.
    if root.differs-up: DiffersPanel {
        width: min(self.preferred-width, root.width - 32px);
        height: self.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        message: root.differs-message;
        continue-anyway => { root.differs-continue-anyway(); }
        quit => { root.differs-quit(); }
    }
}


// One value's trace in the plot window: its path, in pixels across its
// panel, its colour, and its name with its latest reading for the legend.
export struct TraceShown {
    said: string,
    commands: string,
    // A dot where each reading is, as path commands in the same pixels.
    dots: string,
    colour: color,
}

// One tick of a panel's axis: how far down the panel, in pixels, and its
// value.
export struct TickShown {
    y: float,
    said: string,
}

// The values in one unit: the unit's name, their traces, the axis's ticks,
// and how far down each thermostat setpoint in this unit is, in pixels. Where
// a thermostat's band is drawn behind it (see plot.rs's `Band`), `banded`,
// what the legend says of the band, and how far down its edges are, in
// pixels: setpoint plus twice the half band, plus once, minus once and minus
// twice.
export struct PanelShown {
    unit: string,
    traces: [TraceShown],
    ticks: [TickShown],
    setpoints: [float],
    banded: bool,
    band-said: string,
    // The simulated world's ambient temperature, where it is drawn: how far
    // down, in pixels, and what is written on its rule.
    ambiented: bool,
    ambient: float,
    ambient-said: string,
    too-high: float,
    high: float,
    low: float,
    too-low: float,
}

// A stretch of time a switch was in one state, in pixels across the plot.
export struct SpanShown {
    x: float,
    width: float,
    on: bool,
}

// One switch: its name and what it drives, its state in words, and its
// spans.
export struct SwitchShown {
    label: string,
    state: string,
    spans: [SpanShown],
}

// The plot window, opened by Plot: every value that reaches the ground, a
// panel for each unit, and every switch's decisions under them, over the
// span chosen with the buttons at the top. What is drawn is worked out in
// Rust: see plot.rs, which says what is plotted and why. A window of its own
// for the reason the ping panel is one.
//
// The colours are Okabe and Ito's, told apart with each common kind of
// colour blindness, and never alone: each trace is named in its panel's
// legend with its latest reading, each switch's state is said in words, and
// a setpoint's rule is labelled. A switch on is bluish green, the colour
// people read as on; a trace may be the same green, being a line on a panel
// where a switch is a strip under them with "on" written in it.
//
// A thermostat's band is drawn behind its panel's traces in their yellow and
// vermillion paled toward white -- 25% of #F0E442 and 15% of #D55E00 -- so
// pale that every trace keeps most of the contrast it has on white. A pale
// yellow and a pale red can look alike to a reader with red-green colour
// blindness, so each region is said in words at the panel's left, each edge
// is a line, and the legend names the band. A switch is drawn on its own
// strip under the panels, in full bluish green with "on" written in it, and
// nothing of a switch is drawn on a panel.
export component PlotWindow inherits Window {
    default-font-size: Fonts.window;
    title: "tcsmoc: plot";
    background: Colors.window;
    preferred-width: 820px;
    preferred-height: 620px;
    min-width: 520px;
    min-height: 400px;

    in property <[PanelShown]> panels;
    in property <[SwitchShown]> switches;
    // What the span is, over the plot.
    in property <string> said: "";
    // Which span button is chosen: its place in plot.rs's `Span::ALL`.
    in-out property <int> span: 0;
    callback span-chosen(int);
    // Each panel's size, which Rust draws the paths to. The panels share
    // the plotting area's height, a gap between each, and each has its
    // legend on a strip of its own above it, so that the legend never hides
    // what is drawn.
    out property <length> plot-width: area.width - root.axis-width - root.gap;
    out property <length> panel-height: root.slot-height - root.legend-height;
    property <length> slot-height:
        (area.height - (root.panels.length - 1) * root.gap)
            / max(1, root.panels.length);

    property <color> switch-on: #009E73;
    property <color> switch-off: #D4D8DD;
    // Okabe and Ito's yellow and vermillion, paled toward white.
    property <color> band-near: #FBF8D0;
    property <color> band-far: #F9E7D9;
    // A band's edges: darker than the ticks' rules, lighter and thinner
    // than a setpoint's.
    property <color> band-edge: #A8A29E;
    property <color> band-words: #4B5563;
    property <color> rule: #E5E7EB;
    property <color> edge: #9CA3AF;
    property <length> axis-width: 92px;
    property <length> gap: 8px;
    property <length> legend-height: 24px;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.said;
                font-italic: true;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            for name[i] in ["10 s", "1 min", "10 min", "Whole run"]: Button {
                text: name;
                primary: root.span == i;
                clicked => {
                    root.span = i;
                    root.span-chosen(i);
                }
            }
        }

        area := Rectangle {
            vertical-stretch: 1;
            min-height: 200px;

            for panel[p] in root.panels: Rectangle {
                x: 0;
                y: p * (root.slot-height + root.gap);
                width: parent.width;
                height: root.slot-height;

                // The legend: the unit, then each trace's colour, name and
                // latest reading.
                HorizontalLayout {
                    x: root.axis-width + root.gap;
                    y: 0;
                    width: root.plot-width;
                    height: root.legend-height;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: panel.unit;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    for trace in panel.traces: HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 18px;
                            height: 3px;
                            y: (parent.height - self.height) / 2;
                            background: trace.colour;
                        }
                        Text {
                            text: trace.said;
                            font-family: Fonts.mono;
                            vertical-alignment: center;
                        }
                    }
                    if panel.band-said != "": Text {
                        text: panel.band-said;
                        color: root.band-words;
                        font-italic: true;
                        vertical-alignment: center;
                    }
                }

                // The axis: each tick's value, centred on its rule. The top
                // and bottom ones stand out of the panel by half a line,
                // beside the legend's strip and into the gap below, where
                // nothing else is written in the axis's column.
                for tick in panel.ticks: Text {
                    x: 0;
                    width: root.axis-width;
                    y: root.legend-height + tick.y * 1px - self.height / 2;
                    text: tick.said;
                    horizontal-alignment: right;
                    font-family: Fonts.mono;
                }

                Rectangle {
                    x: root.axis-width + root.gap;
                    y: root.legend-height;
                    width: root.plot-width;
                    height: root.panel-height;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: root.edge;
                    clip: true;

                    // The band, behind everything else: white where the
                    // reading is held, pale yellow a half band either side,
                    // pale red beyond, each region said in words at the
                    // left and each edge a line. A region too thin for its
                    // words goes without them; the legend still names the
                    // band.
                    if panel.banded: Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: max(0px, panel.too-high * 1px);
                            background: root.band-far;
                        }
                        Rectangle {
                            x: 0;
                            y: panel.too-high * 1px;
                            width: parent.width;
                            height: (panel.high - panel.too-high) * 1px;
                            background: root.band-near;
                        }
                        Rectangle {
                            x: 0;
                            y: panel.low * 1px;
                            width: parent.width;
                            height: (panel.too-low - panel.low) * 1px;
                            background: root.band-near;
                        }
                        Rectangle {
                            x: 0;
                            y: panel.too-low * 1px;
                            width: parent.width;
                            height: max(0px,
                                        parent.height - panel.too-low * 1px);
                            background: root.band-far;
                        }
                        for edge in [panel.too-high, panel.high, panel.low,
                                     panel.too-low]: Rectangle {
                            x: 0;
                            y: edge * 1px;
                            width: parent.width;
                            height: 1px;
                            background: root.band-edge;
                        }
                        Text {
                            x: 4px;
                            y: panel.too-high * 1px - self.height;
                            visible: panel.too-high * 1px >= self.height;
                            text: "too high";
                            color: root.band-words;
                            font-italic: true;
                        }
                        Text {
                            x: 4px;
                            y: panel.high * 1px - self.height;
                            visible: (panel.high - panel.too-high) * 1px
                                     >= self.height;
                            text: "high";
                            color: root.band-words;
                            font-italic: true;
                        }
                        Text {
                            x: 4px;
                            y: panel.low * 1px + 1px;
                            visible: (panel.too-low - panel.low) * 1px
                                     >= self.height;
                            text: "low";
                            color: root.band-words;
                            font-italic: true;
                        }
                        Text {
                            x: 4px;
                            y: panel.too-low * 1px + 1px;
                            visible: parent.height - panel.too-low * 1px
                                     >= self.height;
                            text: "too low";
                            color: root.band-words;
                            font-italic: true;
                        }
                    }

                    for tick in panel.ticks: Rectangle {
                        x: 0;
                        y: tick.y * 1px;
                        width: parent.width;
                        height: 1px;
                        background: root.rule;
                    }

                    // Each setpoint, a rule darker and thicker than the
                    // ticks', and said in words at its right end, so that it
                    // is told from them by more than its shade.
                    for setpoint in panel.setpoints: Rectangle {
                        x: 0;
                        y: setpoint * 1px - 1px;
                        width: parent.width;
                        height: 2px;
                        background: #6B7280;
                        Text {
                            x: parent.width - self.width - 4px;
                            y: -self.height;
                            text: "setpoint";
                            color: #4B5563;
                            font-italic: true;
                        }
                    }

                    // The simulated world's ambient temperature: a dashed
                    // rule, told from a setpoint's solid one by its dashes
                    // and by its words, which say whose figure it is: at the
                    // right end, clear of the band's words at the left, and
                    // under the rule where the setpoint's are over theirs,
                    // so the two are not written over each other where the
                    // rules are close. On the rule and not in the legend,
                    // which is full already.
                    // A dash every ten pixels, six long.
                    for dash in panel.ambiented ? floor(parent.width / 10px)
                                                : 0: Rectangle {
                        x: dash * 10px;
                        y: panel.ambient * 1px - 1px;
                        width: 6px;
                        height: 2px;
                        background: #4B5563;
                    }
                    if panel.ambiented: Text {
                        x: parent.width - self.width - 4px;
                        y: panel.ambient * 1px + 2px;
                        text: panel.ambient-said;
                        color: #4B5563;
                        font-italic: true;
                    }

                    for trace in panel.traces: Path {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: trace.commands;
                        stroke: trace.colour;
                        stroke-width: 2px;
                    }

                    // A dot on each trace where each reading arrived, in the
                    // trace's colour, so that what was read is told from the
                    // line drawn between readings.
                    for trace in panel.traces: Path {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: trace.dots;
                        fill: trace.colour;
                    }
                }
            }
        }

        // Each switch, under the panels and as wide as them, so that a
        // change lines up with the values above it: one strip a switch,
        // labelled with what it drives, so that with two heaters on two
        // thermostats, which is on, or both, is read straight off them. Full
        // bluish green with "on" written in it while on, which neither band
        // tint is.
        for switch in root.switches: HorizontalLayout {
            spacing: root.gap;
            Text {
                width: root.axis-width;
                text: switch.state;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-weight: 700;
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: switch.label; }
                Rectangle {
                    height: 20px;
                    border-width: 1px;
                    border-color: root.edge;
                    clip: true;
                    for span in switch.spans: Rectangle {
                        x: span.x * 1px;
                        y: 0;
                        width: span.width * 1px;
                        height: parent.height;
                        background: span.on ? root.switch-on
                                            : root.switch-off;
                        // Black on bluish green, 6.1 to 1; left out where
                        // the span is too narrow to hold it.
                        Text {
                            x: 4px;
                            visible: span.on
                                     && parent.width >= self.width + 8px;
                            text: "on";
                            color: #000000;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // The switches' two colours, in words.
        if root.switches.length > 0: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Rectangle {
                width: 14px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                background: root.switch-on;
            }
            Text { text: "switch on"; vertical-alignment: center; }
            Rectangle { width: 10px; }
            Rectangle {
                width: 14px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                background: root.switch-off;
            }
            Text { text: "switch off"; vertical-alignment: center; }
        }
    }
}

// The ping panel, in a window of its own beside the MOC's, opened by Ping
// node. A window rather than a row of the main one, because the main
// window's height is stated -- see `chrome-height` -- and seven more rows
// in it would cost every panel below them their room.
export component PingWindow inherits Window {
    default-font-size: Fonts.window;
    title: "tcsmoc: ping";
    background: Colors.window;
    in property <string> node: "ping";
    in property <string> sent;
    in property <string> sent-time;
    in property <string> received;
    in property <string> received-time;
    in property <string> round-trip;
    in property <string> up;
    in property <string> down;
    callback send-clicked();

    // Enter or Space sends a ping from the moment the window opens.
    forward-focus: panel;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        // Titled with the node, so that the box says what it is pinging.
        panel := PingPanel {
            title: "Pinging " + root.node;
            sent: root.sent;
            sent-time: root.sent-time;
            received: root.received;
            received-time: root.received-time;
            round-trip: root.round-trip;
            up: root.up;
            down: root.down;
            send-clicked => { root.send-clicked(); }
        }
    }
}
