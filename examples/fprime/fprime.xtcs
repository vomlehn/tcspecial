<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../tcsgui/share/schema/tcspecial.xsd">
    <description>Answering to an F´ flight computer: a reading, the temperature made of it and what a thermostat would decide of that, to its bridge component, and a command from it to a heater</description>
    <tcspecial>
        <!-- Every port is in the nine thousands, which no other example
             uses, so this one can be left running while another is looked
             at.

             The vehicle answers to an F´ flight computer rather than to the
             ground. Its links are the radio's - UDP, in the radio's protocol
             - because the far end of each is the F´ deployment's TcsBridge
             component, which is a ground station built on tcslib-c as far as
             tcspecial can tell. -->
        <beacon>
            <default_interval>5 s</default_interval>
            <recv>127.0.0.1:9510</recv>
            <reset_interval>1 s</reset_interval>
            <send>0.0.0.0:9500</send>
        </beacon>
        <gateway>fprime</gateway>
        <interface>ad9aac4dd5a6d88dd5e78824ba8a83ac</interface>
        <log>
            <directory>/tmp/telemetry</directory>
            <segment_size>65536</segment_size>
        </log>
        <payload_command>
            <dest_base>0.0.0.0:9300</dest_base>
            <source_base>127.0.0.1:9310</source_base>
        </payload_command>
        <payload_telemetry>
            <dest_base>127.0.0.1:9410</dest_base>
            <source_base>0.0.0.0:9400</source_base>
        </payload_telemetry>
        <!-- tcspecial counts its starts in this file, which must be on
             storage that survives a power cycle on a vehicle. -->
        <state_file>/tmp/tcspecial-fprime.state</state_file>
        <tcs_cmd>
            <recv>0.0.0.0:9200</recv>
            <send>127.0.0.1:9210</send>
        </tcs_cmd>
    </tcspecial>
    <!-- The F´ bridge's end of the link, both ways. What the bridge sends
         goes up to address:port, which this node binds aboard, and leaves it
         by gateway-out for the heater. What comes down arrives at bridge_base
         plus the device id of the node that sent it, and the bridge gives it
         the F´ ID fprime_id_base plus that same id: the thermometer, device id
         2, arrives at 127.0.0.1:9702 as 0x3002, zone_temp, device id 3, at
         127.0.0.1:9703 as 0x3003, and heater_wanted, device id 4, at
         127.0.0.1:9704 as 0x3004. -->
    <gateway>
        <name>fsw</name>
        <type>gateway_fprime</type>
        <address>127.0.0.1</address>
        <port>9600</port>
        <bridge_base>127.0.0.1:9700</bridge_base>
        <fprime_id_base>0x3000</fprime_id_base>
        <payload-in>true</payload-in>
        <gateway-out><target>heater</target></gateway-out>
    </gateway>
    <!-- A heater, driven by what the flight computer sends - 1 for on, 0 for
         off - the far end of a UDP socket. -->
    <payloads>
        <name>heater</name>
        <type>network</type>
        <protocol>udp</protocol>
        <address>127.0.0.1</address>
        <port>9001</port>
        <gateway-in>true</gateway-in>
    </payloads>
    <!-- A thermometer, two bytes, signed, big endian, in sixteenths of a
         degree, whose readings go to the flight computer as they are, and to
         zone_temp to be made a temperature. -->
    <payloads>
        <name>thermometer</name>
        <type>network</type>
        <protocol>udp</protocol>
        <address>127.0.0.1</address>
        <port>9002</port>
        <payload-out><target>fsw</target></payload-out>
        <payload-out><target>zone_temp</target></payload-out>
    </payloads>
    <!-- After the payloads, so that the thermometer keeps device id 2: a
         node's device id is its place in the file.

         The thermometer's readings made a value, a temperature in kelvin,
         which the bridge's channel for it holds as one. -->
    <vehicle>
        <name>zone_temp</name>
        <type>compute</type>
        <format>i16_be</format>
        <function>to_kelvin</function>
        <offset>273.15</offset>
        <scale>0.0625</scale>
        <payload-in>true</payload-in>
        <payload-out><target>fsw</target></payload-out>
        <payload-out><target>heater_wanted</target></payload-out>
    </vehicle>
    <!-- What a thermostat would decide of zone_temp - on below 283.65 K, off
         above 284.65 K - which the bridge's channel for it holds as a
         decision, true for on. Advice and no more: the heater is the flight
         computer's to drive, and this drives nothing. -->
    <vehicle>
        <name>heater_wanted</name>
        <type>compute</type>
        <function>hysteresis</function>
        <half_band>0.5</half_band>
        <setpoint>284.15</setpoint>
        <payload-in>true</payload-in>
        <payload-out><target>fsw</target></payload-out>
    </vehicle>
    <tcsgui>
        <nodes><name>fsw</name><x>469</x><y>34</y></nodes>
        <nodes><name>heater</name><x>34</x><y>34</y></nodes>
        <nodes><name>thermometer</name><x>34</x><y>134</y></nodes>
        <nodes><name>zone_temp</name><x>242</x><y>134</y></nodes>
        <nodes><name>heater_wanted</name><x>242</x><y>234</y></nodes>
    </tcsgui>
</configuration>
